---
// URL antigua del validador de puerta (/qr/<slug>, antes con ?token=qrvalidator): ahora es /validador/<slug>.
// Se conserva para los links y marcadores guardados.
import { validatorEventPath } from "../../lib/validatorApp";

export const prerender = false;

return Astro.redirect(validatorEventPath(String(Astro.params.slug || "")), 301);
---
