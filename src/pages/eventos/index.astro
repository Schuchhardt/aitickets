---
import { getSupabaseAdmin } from "../../lib/auth-helpers";
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import EventList from "../../components/EventList.vue";
import Layout from '../../layouts/Layout.astro';
import { zonedDateTimeToDate, getZonedParts } from "../../utils/dateHelpers.js";
import { DEMO_EVENT_SLUGS, isDemoEventSlug, getDemoFunctionDate } from "../../lib/demoEvent.mjs";
import { currentCoverMeta } from "../../lib/eventCoverMeta";
import "../../styles/global.css";

export const prerender = false;

// Listado público (C3): publicados, públicos y próximos. Columnas explícitas (C4: nunca secret_location).
// Al final van siempre los eventos de demostración (src/lib/demoEvent.mjs, privados para no indexarse),
// con su fecha dinámica, para mostrar cómo se ve un evento real.
const supabase = getSupabaseAdmin();
const now = new Date();
const todaySantiago = getZonedParts(now)?.date || now.toISOString().slice(0, 10);

// cover_meta (proporción real de la portada) arma la grilla masonry sin saltos; si la columna no existe
// (deploy preview sin migrar) se reintenta sin ella
const BASE_COLUMNS = "id, slug, name, title, image_url, location, start_date, end_date";
async function loadCards(withMeta: boolean): Promise<[any, any]> {
  const columns = withMeta ? `${BASE_COLUMNS}, cover_meta` : BASE_COLUMNS;
  return Promise.all([
    supabase
      .from("events")
      .select(columns)
      .eq("status", "published")
      .or("accessibility.is.null,accessibility.eq.public")
      .not("slug", "is", null),
    supabase.from("events").select(columns).eq("status", "published").in("slug", [...DEMO_EVENT_SLUGS]),
  ]);
}
let [realRes, demoRes] = await loadCards(true);
if (realRes.error?.code === "42703" || demoRes.error?.code === "42703") [realRes, demoRes] = await loadCards(false);

if (realRes.error) console.error("Error al obtener eventos:", realRes.error);
if (demoRes.error) console.error("Error al obtener eventos demo:", demoRes.error);
const demoEvents = (demoRes.data || [])
  .map((e: any) => ({ ...e, start_date: null, end_date: null }))
  .sort((a: any, b: any) => DEMO_EVENT_SLUGS.indexOf(a.slug) - DEMO_EVENT_SLUGS.indexOf(b.slug));
const events = [...(realRes.data || []).filter((e: any) => !isDemoEventSlug(e.slug)), ...demoEvents];

const eventIds = (events || []).map((e) => e.id);
const empty = { data: [] as any[], error: null };
const [{ data: dates, error: datesError }, { data: tagRows, error: tagsError }, { data: ticketRows, error: ticketsError }] =
  eventIds.length
    ? await Promise.all([
        supabase
          .from("event_dates")
          .select("event_id, date, start_time, end_time")
          .in("event_id", eventIds)
          .order("date", { ascending: true })
          .order("start_time", { ascending: true }),
        supabase.from("event_tags").select("event_id, category_tags(name)").in("event_id", eventIds),
        supabase.from("event_tickets").select("event_id, price, is_gift").in("event_id", eventIds),
      ])
    : [empty, empty, empty];

if (datesError) console.error("Error al obtener fechas de eventos:", datesError);
if (tagsError) console.error("Error al obtener categorías de eventos:", tagsError);
if (ticketsError) console.error("Error al obtener entradas de eventos:", ticketsError);

// Categorías (para los filtros y la etiqueta de la tarjeta) y precio "desde" (sin cortesías)
const categoriesByEvent = new Map<number, string[]>();
for (const row of tagRows || []) {
  const tag: any = Array.isArray(row.category_tags) ? row.category_tags[0] : row.category_tags;
  const name = tag?.name?.trim();
  if (!name) continue;
  const list = categoriesByEvent.get(row.event_id) || [];
  if (!list.includes(name)) list.push(name);
  categoriesByEvent.set(row.event_id, list);
}
const pricesByEvent = new Map<number, number[]>();
for (const t of ticketRows || []) {
  if (t.is_gift) continue;
  const list = pricesByEvent.get(t.event_id) || [];
  list.push(Number(t.price) || 0);
  pricesByEvent.set(t.event_id, list);
}

const slugById = new Map(events.map((e) => [e.id, e.slug]));
const datesByEvent = new Map<number, any[]>();
for (const d of dates || []) {
  const list = datesByEvent.get(d.event_id) || [];
  const slug = slugById.get(d.event_id);
  const date = isDemoEventSlug(slug) ? getDemoFunctionDate(d.date, now, slug) : String(d.date).slice(0, 10);
  list.push({ date, start_time: d.start_time, end_time: d.end_time });
  datesByEvent.set(d.event_id, list);
}

const eventData = (events || [])
  .map((e) => {
    const eventDates = datesByEvent.get(e.id) || [];
    const upcomingDates = eventDates.filter((d) => d.date >= todaySantiago);
    const lastDate = eventDates.length ? eventDates[eventDates.length - 1].date : null;
    const isUpcoming =
      !e.end_date || new Date(e.end_date) >= now || (lastDate !== null && lastDate >= todaySantiago);
    // Próxima función (para ordenar); si no hay event_dates, start_date
    const nextStart = upcomingDates.length
      ? zonedDateTimeToDate(upcomingDates[0].date, upcomingDates[0].start_time)
      : e.start_date
        ? new Date(e.start_date)
        : null;
    const firstStart = eventDates.length ? zonedDateTimeToDate(eventDates[0].date, eventDates[0].start_time) : null;
    const prices = pricesByEvent.get(e.id) || [];
    const paid = prices.filter((p) => p > 0);
    const meta = currentCoverMeta(e.cover_meta, e.image_url);
    const { cover_meta: _meta, ...card } = e;
    return {
      ...card,
      is_demo: isDemoEventSlug(e.slug),
      categories: categoriesByEvent.get(e.id) || [],
      is_free: prices.length > 0 && paid.length === 0,
      min_price: paid.length ? Math.min(...paid) : null,
      image_ratio: meta?.width && meta?.height ? Number((meta.width / meta.height).toFixed(4)) : null,
      start_date: e.start_date || firstStart?.toISOString() || null,
      dates: upcomingDates.length ? upcomingDates : eventDates,
      _isUpcoming: isUpcoming,
      // Los demo van siempre después de los eventos reales
      _sortKey: (isDemoEventSlug(e.slug) ? 1e15 : 0) + (nextStart ? nextStart.getTime() : 1e14),
    };
  })
  .filter((e) => e._isUpcoming)
  .sort((a, b) => a._sortKey - b._sortKey)
  .map(({ _isUpcoming, _sortKey, ...e }) => e);
---

<Layout
  title="Próximos eventos en Chile – Compra tus entradas | AI Tickets"
  description="Encuentra los próximos eventos en Chile: stand-up, teatro, música y más. Compra tus entradas online de forma segura con AI Tickets."
  canonical="/eventos"
>
  <AppHeader client:idle/>
  <main>
    <EventList events={eventData} today={todaySantiago} client:idle />
  </main>
  <AppFooter client:idle/>
</Layout>
