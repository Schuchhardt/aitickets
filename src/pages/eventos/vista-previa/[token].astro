---
// /eventos/vista-previa/<token> — ruta ANTERIOR de la vista previa privada de un evento. Los links nuevos son
// /eventos/<slug>?preview=<token> (src/pages/eventos/[slug].astro); esta sigue abriendo los ya compartidos.
// El token lo crean el panel o la API de productores (src/lib/eventPreview.ts). Nunca se indexa ni se cachea,
// no envía Referer (el token va en la URL) y no registra visitas en las analíticas del evento.
// Los bots de vista previa de links (WhatsApp, Slack…) reciben una página genérica sin datos del evento.
import AppHeader from "../../../components/AppHeader.vue";
import AppFooter from "../../../components/AppFooter.vue";
import EventDetail from "../../../components/EventDetail.vue";
import EventMetaTags from "../../../components/EventMetaTags.astro";
import EventPreviewUnavailable from "../../../components/EventPreviewUnavailable.astro";
import { getPublicEventData } from "../../../lib/eventPage";
import { previewCookieName, resolvePreviewToken, isPreviewToken, PREVIEW_COOKIE_PATH } from "../../../lib/eventPreview";
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/global.css";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Netlify-CDN-Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");

const token = Astro.params.token || "";
const cookieName = isPreviewToken(token) ? previewCookieName(token) : null;
const resolved = await resolvePreviewToken(token, {
  userAgent: Astro.request.headers.get("user-agent"),
  cookieNonce: cookieName ? Astro.cookies.get(cookieName)?.value || null : null,
});

let result = null as Awaited<ReturnType<typeof getPublicEventData>>;
if (resolved.ok) {
  if (resolved.setCookie) {
    Astro.cookies.set(resolved.setCookie.name, resolved.setCookie.value, {
      path: PREVIEW_COOKIE_PATH,
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: "lax",
      ...(resolved.setCookie.maxAge ? { maxAge: resolved.setCookie.maxAge } : { maxAge: 60 * 60 * 24 * 365 }),
    });
  }
  result = await getPublicEventData(undefined, { previewEventId: resolved.eventId });
  // El evento debe seguir perteneciendo a la organización que creó el link
  if (result && Number(result.eventData.organization_id) !== resolved.orgId) result = null;
}

const reason = resolved.ok ? (result ? null : "not_found") : resolved.reason;
if (reason && reason !== "bot") Astro.response.status = reason === "not_found" ? 404 : 410;

const eventData = result?.eventData;
---
<Layout title={eventData ? `Vista previa: ${eventData.name} | AI Tickets` : "Vista previa privada | AI Tickets"} noindex={true} analytics={false}>
  {eventData && result && (
    <EventMetaTags
      slot="head"
      event={eventData}
      title={`Vista previa: ${eventData.name}`}
      description={result.seo.description}
      canonicalPath={result.seo.canonicalPath}
      noindex={true}
    />
  )}
  {!eventData && <AppHeader client:idle />}
  <main class={eventData ? undefined : "pt-16"}>
    {eventData ? (
      <EventDetail event={eventData} siteMode={false} client:idle />
    ) : (
      <EventPreviewUnavailable reason={reason || "not_found"} />
    )}
  </main>
  <AppFooter client:idle />
</Layout>
