---
import AppFooter from "../../components/AppFooter.vue";
import EventDetail from "../../components/EventDetail.vue";
import EventAssistant from "../../components/EventAssistant.vue";
import EventMetaTags from "../../components/EventMetaTags.astro";
import { getPublicEventData } from "../../lib/eventPage";
import { resolveEventSlugRedirect, slugRedirectResponse } from "../../lib/eventSlug";
import { getSupabaseAdmin } from "../../lib/auth-helpers";
import { getSessionContext } from "../../lib/supabaseServer";
import Layout from '../../layouts/Layout.astro';
import "../../styles/global.css";

import { notFound } from "../../lib/notFound";
import { cachePublicPage } from "../../lib/cdnCache";
import { getTrustedTenantProxy } from "../../lib/sites";

export const prerender = false;

// Toda la carga (evento, entradas/stock, funciones, SEO) vive en src/lib/eventPage.ts,
// compartida con los sitios de productor (/o/[site]/eventos/[slug]).
let result = await getPublicEventData(Astro.params.slug, { locals: Astro.locals });

// Borrador: el equipo de la productora (con sesión) lo ve en modo vista previa. Para compartirlo con
// alguien sin cuenta se usa un link privado (/eventos/vista-previa/<token>, ver src/lib/eventPreview.ts).
if (!result && Astro.params.slug && Astro.cookies.get("sb-access-token")) {
  const session = await getSessionContext(Astro);
  if (session) {
    const { data: own } = await getSupabaseAdmin()
      .from("events")
      .select("id")
      .eq("slug", Astro.params.slug)
      .eq("organization_id", session.dbUser.organization_id)
      .maybeSingle();
    if (own) {
      result = await getPublicEventData(undefined, { previewEventId: Number(own.id) });
      Astro.response.headers.set("Cache-Control", "private, no-store");
      Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
    }
  }
}

// Slug anterior de un evento publicado o con registrados (src/lib/eventSlug.ts) => 301 al slug vigente
if (!result) {
  const currentSlug = await resolveEventSlugRedirect(Astro.params.slug);
  if (currentSlug) return slugRedirectResponse(`/eventos/${currentSlug}${Astro.url.search}`);
}

// Borradores (para el público), eventos inexistentes o slugs inválidos => 404 real (src/pages/404.astro)
if (!result) {
  return notFound();
}

const { eventData, seo } = result;

// Página pública (no la vista previa del dueño): igual para todos => se sirve desde el CDN de Netlify
// (src/lib/cdnCache.ts). Cualquier cambio del productor la vacía al instante; el TTL corto solo acota el atraso
// del stock mostrado (la compra lo valida en el servidor). Los demo no cambian: TTL más largo.
if (!eventData.is_preview && !getTrustedTenantProxy(Astro.request)) {
  cachePublicPage(Astro.response.headers, eventData.is_demo ? { sMaxAge: 60, staleWhileRevalidate: 600 } : { sMaxAge: 30, staleWhileRevalidate: 60 });
}
const visitEventId = eventData.is_preview ? null : eventData.id;
const pageTitle = seo.title;
const metaDescription = seo.description;
const canonicalPath = seo.canonicalPath;
---
<Layout>
  <EventMetaTags
    slot="head"
    event={eventData}
    title={pageTitle}
    description={metaDescription}
    canonicalPath={canonicalPath}
    noindex={seo.noindex}
  />
  <script is:inline>
    // Atribución (C10): guardar ?ref= y utm_* para enviarlos con la compra
    (function () {
      try {
        var p = new URLSearchParams(window.location.search);
        var ref = p.get('ref');
        var source = p.get('utm_source');
        var medium = p.get('utm_medium');
        var campaign = p.get('utm_campaign');
        if (!ref && !source && !medium && !campaign) return;
        var clip = function (v) { return v ? String(v).slice(0, 128) : null; };
        sessionStorage.setItem('aitickets_attribution', JSON.stringify({
          ref: clip(ref),
          utm: { source: clip(source), medium: clip(medium), campaign: clip(campaign) },
          landing_at: new Date().toISOString()
        }));
      } catch (e) { /* sessionStorage no disponible */ }
    })();
  </script>
  <script is:inline define:vars={{ visitEventId }}>
    // Visita (event_visits): la página puede venir del CDN, así que la registra el navegador (/api/events/visit)
    if (visitEventId) {
      try {
        var vp = new URLSearchParams(window.location.search);
        fetch('/api/events/visit', {
          method: 'POST',
          keepalive: true,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_id: visitEventId,
            referrer: document.referrer || null,
            utm_source: vp.get('utm_source'),
            utm_medium: vp.get('utm_medium'),
            utm_campaign: vp.get('utm_campaign')
          })
        }).catch(function () {});
      } catch (e) { /* sin fetch: no se registra */ }
    }
  </script>
  <main>
    <EventDetail event={eventData} siteMode={false} client:idle/>
  </main>
  <!-- Sin botón flotante: se abre desde la página ("Pregúntale al asistente" y el ícono de la barra en mobile) -->
  <EventAssistant event={eventData} launcher={false} client:idle/>
  <AppFooter client:idle/>
</Layout>
