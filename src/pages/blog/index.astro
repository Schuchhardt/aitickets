---
// Portada del blog: temas (por tipo de evento y por funcionalidad), los artículos recientes y las guías fijas.
import { getCollection } from "astro:content";
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import CallToAction from "../../components/CallToAction.vue";
import CtaTracking from "../../components/landing/CtaTracking.astro";
import Layout from "../../layouts/Layout.astro";
import { listPublishedPosts, listTopics, readingMinutes } from "../../lib/blog";
import { BLOG_PAGES_TAG, cachePublicPage } from "../../lib/cdnCache";
import "../../styles/global.css";

export const prerender = false;

const [posts, topics, guides] = await Promise.all([listPublishedPosts({ limit: 60 }), listTopics(), getCollection("guias")]);
const topicById = new Map(topics.map((t) => [t.id, t]));
const withPosts = new Set(posts.map((p) => p.topic_id));
const niches = topics.filter((t) => t.kind === "niche" && withPosts.has(t.id));
const features = topics.filter((t) => t.kind === "feature" && withPosts.has(t.id));
const dateFmt = new Intl.DateTimeFormat("es-CL", { day: "numeric", month: "short", year: "numeric", timeZone: "America/Santiago" });
cachePublicPage(Astro.response.headers, { sMaxAge: 1800, staleWhileRevalidate: 86400, tag: BLOG_PAGES_TAG });
---

<Layout
    title="Blog para productores de eventos en Chile | AI Tickets"
    description="Guías prácticas para organizar, difundir y vender entradas: stand-up, teatro, conciertos, fiestas, seminarios y talleres. Con datos y fuentes."
    canonical="/blog"
>
    <link slot="head-extra" rel="alternate" type="application/rss+xml" title="Blog de AI Tickets" href="/blog/rss.xml" />
    <AppHeader client:idle />
    <main class="font-['Prompt']">
        <section class="bg-black text-white px-4 pt-32 pb-16">
            <div class="container mx-auto md:px-8 max-w-5xl">
                <h1 class="text-3xl md:text-5xl font-bold font-['Unbounded']">Blog para productores</h1>
                <p class="mt-4 text-lg text-white/80 max-w-2xl">Cómo producir, difundir y llenar tus eventos en Chile: lo práctico, con números y fuentes.</p>
                {(niches.length > 0 || features.length > 0) && (
                    <div class="mt-8 flex flex-wrap gap-2">
                        {[...niches, ...features].map((t) => (
                            <a href={`/blog/tema/${t.slug}`} class="px-3 py-1 rounded-full border border-white/30 text-sm hover:bg-white hover:text-black transition">{t.name}</a>
                        ))}
                    </div>
                )}
            </div>
        </section>

        <section class="px-4 py-16 bg-white">
            <div class="container mx-auto md:px-8 max-w-5xl">
                {posts.length === 0 ? (
                    <p class="text-gray-600">Pronto publicaremos los primeros artículos. Mientras tanto, revisa nuestras guías.</p>
                ) : (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {posts.map((p) => {
                            const t = p.topic_id ? topicById.get(p.topic_id) : null;
                            return (
                                <a href={`/blog/${p.slug}`} class="block p-6 rounded-xl border border-gray-200 hover:border-black transition">
                                    {t && <p class="text-xs uppercase tracking-wide text-lime-700 font-semibold">{t.name}</p>}
                                    <h2 class="mt-1 text-lg font-semibold font-['Unbounded']">{p.title}</h2>
                                    <p class="mt-2 text-sm text-gray-600">{p.excerpt || p.description}</p>
                                    <p class="mt-3 text-xs text-gray-400">
                                        {p.published_at ? dateFmt.format(new Date(p.published_at)) : ""} · {readingMinutes(p.word_count)} min
                                    </p>
                                </a>
                            );
                        })}
                    </div>
                )}
            </div>
        </section>

        <section class="px-4 py-16 bg-slate-100">
            <div class="container mx-auto md:px-8 max-w-5xl">
                <h2 class="text-2xl font-bold font-['Unbounded'] mb-6">Guías esenciales</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {guides.map((g) => (
                        <a href={`/guias/${g.id}`} class="block p-6 rounded-xl bg-white border border-gray-200 hover:border-black transition">
                            <p class="font-semibold font-['Unbounded']">{g.data.cardTitle}</p>
                            <p class="mt-2 text-sm text-gray-600">{g.data.description}</p>
                        </a>
                    ))}
                </div>
            </div>
        </section>
        <CallToAction campaign="blog_index" />
    </main>
    <AppFooter client:idle />
    <CtaTracking />
</Layout>
