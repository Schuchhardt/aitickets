---
// Inicio del sitio de un productor: aitickets.cl/o/<slug> o su dominio propio (vía middleware).
import SiteLayout from "../../../layouts/SiteLayout.astro";
import SiteMetaTags from "../../../components/sites/SiteMetaTags.astro";
import Clasico from "../../../components/sites/templates/Clasico.vue";
import Nocturno from "../../../components/sites/templates/Nocturno.vue";
import Minimal from "../../../components/sites/templates/Minimal.vue";
import Festival from "../../../components/sites/templates/Festival.vue";
import SitePage from "../../../components/sites/SitePage.vue";
import { getSiteBanners, getSiteEvents, publicSiteProps, siteShareImageSource, siteUrl } from "../../../lib/sites";
import { sanitizeRichText } from "../../../lib/sanitize";
import { defaultSections, isNicheTemplate, sanitizeSections } from "../../../lib/siteTemplates";
import { stripHtml, truncate } from "../../../lib/eventPage";
import { loadSiteForPage } from "../_site";

import { notFound } from "../../../lib/notFound";

export const prerender = false;

const loaded = await loadSiteForPage(Astro);
if (!loaded) {
  return notFound();
}
const { site, preview, base, template, owner } = loaded;

const [events, banners] = await Promise.all([getSiteEvents(site), getSiteBanners(site)]);
const props = publicSiteProps(site, template);
const aboutHtml = sanitizeRichText(site.content?.about || "");

const TEMPLATES = { clasico: Clasico, nocturno: Nocturno, minimal: Minimal, festival: Festival } as const;
const Template = (TEMPLATES as Record<string, any>)[template] || Clasico;

// Secciones (src/lib/siteTemplates.ts): las guardadas o, en una plantilla de nicho sin secciones (o al probar una
// plantilla con ?plantilla=), las sugeridas. Sin secciones y en una plantilla general se usa la plantilla original.
// ?editor=1 (solo el dueño): vista previa en vivo del editor, que redibuja con el borrador sin guardar.
const live = owner && Astro.url.searchParams.get("editor") === "1";
const savedSections = Array.isArray(site.content?.sections) ? sanitizeSections(site.content.sections) : null;
const sections = savedSections || (isNicheTemplate(template) || live ? defaultSections(template) : null);

// SEO: canónico en el origen del sitio (dominio propio > /o/<slug>). noindex hasta tener eventos publicados.
const canonicalUrl = siteUrl(site, "/");
const title = truncate(site.seo?.title || `${props.name} – Próximos eventos y entradas`, 70);
const description = truncate(
  site.seo?.description ||
    stripHtml(aboutHtml) ||
    `Próximos eventos de ${props.name}. Compra tus entradas online de forma segura.`,
  158
);
const ogImage = await siteShareImageSource(site, { banners, events });
const noindex = preview || live || site.is_demo || events.length === 0;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: props.name,
  url: canonicalUrl,
  ...(props.theme.logo_url ? { logo: props.theme.logo_url } : {}),
  ...(Object.values(props.socials).length ? { sameAs: Object.values(props.socials) } : {}),
}).replace(/</g, "\\u003c");
---
<SiteLayout theme={props.theme} preview={preview} favicon={props.theme.logo_url}>
  <SiteMetaTags
    slot="head"
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
    siteName={props.name}
    siteSlug={site.slug}
    imageUrl={ogImage}
    noindex={noindex}
    jsonLd={jsonLd}
  />
  {sections ? (
    live ? (
      <SitePage client:load site={props} sections={sections} events={events} banners={banners} aboutHtml={aboutHtml} base={base} fallbackName={site.org?.public_name || ""} live />
    ) : (
      <SitePage site={props} sections={sections} events={events} banners={banners} aboutHtml={aboutHtml} base={base} fallbackName="" live={false} />
    )
  ) : (
    <Template site={props} events={events} banners={banners} aboutHtml={aboutHtml} base={base} />
  )}
</SiteLayout>
