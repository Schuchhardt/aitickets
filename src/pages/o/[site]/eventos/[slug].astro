---
// Evento dentro del sitio del productor. Mismos datos que /eventos/[slug] (src/lib/eventPage.ts), pero
// solo si el evento pertenece a la organización del sitio. El canónico sigue siendo
// aitickets.cl/eventos/<slug>. En un dominio propio, "Comprar" lleva al checkout en aitickets.cl
// (purchaseUrlFor, #comprar abre el modal automáticamente).
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import SiteHeader from "../../../../components/sites/SiteHeader.vue";
import SiteFooter from "../../../../components/sites/SiteFooter.vue";
import EventDetail from "../../../../components/EventDetail.vue";
import EventMetaTags from "../../../../components/EventMetaTags.astro";
import { getPublicEventData } from "../../../../lib/eventPage";
import { publicSiteProps, purchaseUrlFor, siteCanonicalOrigin } from "../../../../lib/sites";
import { isDemoEventSlug } from "../../../../lib/demoEvent.mjs";
import { loadSiteForPage } from "../../_site";
import { resolveEventSlugRedirect, slugRedirectResponse } from "../../../../lib/eventSlug";

import { notFound } from "../../../../lib/notFound";

export const prerender = false;

const loaded = await loadSiteForPage(Astro);
if (!loaded) {
  return notFound();
}
const { site, preview, base, template } = loaded;
const eventSlug = Astro.params.slug;

// El sitio demo solo muestra el evento demo; los demás, solo eventos de su organización
if (site.is_demo && !isDemoEventSlug(eventSlug)) {
  return notFound();
}

const result = await getPublicEventData(eventSlug, {
  organizationId: site.is_demo ? undefined : site.organization_id,
  siteOrigin: siteCanonicalOrigin(site),
  locals: Astro.locals,
});
if (!result) {
  // Slug anterior de un evento de esta organización (src/lib/eventSlug.ts) => 301 al slug vigente
  const currentSlug = site.is_demo ? null : await resolveEventSlugRedirect(eventSlug, { organizationId: site.organization_id });
  if (currentSlug) {
    return slugRedirectResponse(`${base}/eventos/${encodeURIComponent(currentSlug)}${Astro.url.search}`);
  }
  return notFound();
}

const { seo } = result;
const eventData = { ...result.eventData, purchase_url: purchaseUrlFor(site, result.eventData.slug) };
const props = publicSiteProps(site, template);
const title = seo.title.replace(/\| AI Tickets$/, `| ${props.name}`);
// Visita (event_visits): la registra el navegador (/api/events/visit), igual que en /eventos/[slug]
const visitEventId = preview ? null : eventData.id;
---
<SiteLayout theme={props.theme} preview={preview} favicon={props.theme.logo_url}>
  <EventMetaTags
    slot="head"
    event={eventData}
    title={title}
    description={seo.description}
    canonicalPath={seo.canonicalPath}
    noindex={seo.noindex || preview}
  />
  <script>
    // Atribución (C10): último toque por evento, 7 días (src/lib/attribution.js). El id del evento va en el main.
    import { captureAttribution } from "../../../../lib/attribution.js";
    const host = document.querySelector("[data-attribution-event-id]");
    captureAttribution(host?.getAttribute("data-attribution-event-id") || null, window.location.search);
  </script>
  <script is:inline define:vars={{ visitEventId }}>
    if (visitEventId) {
      try {
        var vp = new URLSearchParams(window.location.search);
        fetch('/api/events/visit', {
          method: 'POST',
          keepalive: true,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_id: visitEventId,
            referrer: document.referrer || null,
            ref: vp.get('ref'),
            utm_source: vp.get('utm_source'),
            utm_medium: vp.get('utm_medium'),
            utm_campaign: vp.get('utm_campaign')
          })
        }).catch(function () {});
      } catch (e) { /* sin fetch: no se registra */ }
    }
  </script>
  <SiteHeader site={props} base={base} variant="light" />
  <main class="bg-white text-gray-900" data-attribution-event-id={eventData.id}>
    <EventDetail event={eventData} siteMode={true} client:idle />
  </main>
  <SiteFooter site={props} base={base} />
</SiteLayout>
