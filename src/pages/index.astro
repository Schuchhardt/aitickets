---
// Portada (/): la ticketera para cualquier tipo de evento. Cuenta una historia con las fotos de cada nicho: el hero con
// un mosaico de todos los escenarios, una card por nicho que lleva a su landing (vestida con sus colores), la semana de
// una función de principio a fin con fotos de nichos distintos, el precio, la IA, las preguntas frecuentes y el cierre.
// Misma base que /organizadores (landing.css, LandingHeader, LandingMotion, tokens y movimiento lp-); los montos y
// plazos salen de fees.mjs / legal.mjs y las respuestas de dinero de PRODUCER_FAQ.
export const prerender = true;
import AppFooter from "../components/AppFooter.vue";
import LandingHeader from "../components/landing/LandingHeader.vue";
import LandingMobileBar from "../components/landing/LandingMobileBar.vue";
import LandingFaq from "../components/landing/LandingFaq.vue";
import LandingMotion from "../components/landing/LandingMotion.astro";
import CtaTracking from "../components/landing/CtaTracking.astro";
import AiSection from "../components/landing/organizadores/AiSection.astro";
import HomeHero from "../components/landing/home/HomeHero.astro";
import HomeMarquee from "../components/landing/home/HomeMarquee.astro";
import HomeNiches from "../components/landing/home/HomeNiches.astro";
import HomeStory from "../components/landing/home/HomeStory.astro";
import HomePricing from "../components/landing/home/HomePricing.astro";
import HomeClosing from "../components/landing/home/HomeClosing.astro";
import HomeTracking from "../components/landing/home/HomeTracking.astro";
import Layout from '../layouts/Layout.astro';
import { publishUrl } from "../components/landing/links.js";
import { PRODUCER_FAQ } from "../data/producerFaq";
import { LEGAL } from "../lib/legal";
import { SERVICE_FEE_PERCENT_LABEL } from "../../netlify/lib/fees.mjs";
// Fuente del H1: precargada para que el cambio de fuente no mueva el hero (CLS)
import unboundedWoff2 from "@fontsource/unbounded/files/unbounded-latin-700-normal.woff2?url";
import "../styles/global.css";
import "../styles/landing.css";

const SITE_URL = (import.meta.env.SITE_URL || "https://aitickets.cl").replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: LEGAL.brand,
    url: SITE_URL,
    logo: `${SITE_URL}/apple-touch-icon.png`,
    email: LEGAL.supportEmail,
    areaServed: "CL",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "AI Tickets para productores",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: SITE_URL,
    description: "Ticketera online para productores de eventos en Chile: stand-up, teatro, música en vivo, clubs, fiestas, talleres, seminarios y academias. Varias funciones por evento, links de venta por promotor, check-in con QR y pago por función.",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "CLP",
      description: `Sin mensualidad y 0% de comisión para el productor. El comprador paga un cargo por servicio de ${SERVICE_FEE_PERCENT_LABEL} + IVA.`,
    },
  },
];
---

<Layout
  title="Ticketera para productores de eventos en Chile | AI Tickets"
  description="Vende entradas para tu stand-up, obra, tocata, fiesta, taller o seminario. Un link por promotor, check-in con QR y cobro por función. Sin mensualidad y 0% de comisión para el productor."
  canonical="/"
>
  <link slot="head-extra" rel="preload" as="font" type="font/woff2" href={unboundedWoff2} crossorigin />
  <LandingMotion />
  <LandingHeader client:idle publishHref={publishUrl("home_header")} />
  <main class="lp ev-motion">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <HomeHero />
    <HomeMarquee />
    <HomeNiches />
    <HomeStory />
    <HomePricing />
    <AiSection />
    <section class="lp-section lp-surface faq" aria-labelledby="faq-title" data-lp-section="faq">
      <div class="lp-wrap faq-wrap" data-lp-reveal>
        <h2 id="faq-title" class="lp-h2 faq-title" data-lp-step>Preguntas frecuentes</h2>
        <div data-lp-step><LandingFaq client:visible items={PRODUCER_FAQ} idPrefix="home-faq" /></div>
      </div>
    </section>
    <HomeClosing />
  </main>
  <AppFooter client:idle />
  <LandingMobileBar client:idle publishHref={publishUrl("home_mobile_bar")} />
  <CtaTracking />
  <HomeTracking />
</Layout>

<style>
  .faq-wrap {
    max-width: 760px;
  }
  .faq-title {
    margin-bottom: 16px;
  }
  @media (min-width: 1024px) {
    .faq-title {
      margin-bottom: 24px;
    }
  }
</style>
