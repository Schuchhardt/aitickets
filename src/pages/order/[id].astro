---
// Página de una orden (event_orders.id, uuid). Es el link que recibe el comprador por correo:
// muestra sus entradas con QR y, solo aquí (y en /ticket), la dirección secreta del evento.
// secret_location solo se consulta/serializa si la orden está pagada y tiene al menos una entrada no anulada.
// Los datos del comprador salen de event_orders.buyer_* (R2), no del registro compartido `attendees`.
import { getSupabaseAdmin } from "../../lib/auth-helpers";
import { descriptionToHtml } from "../../lib/sanitize";
import { LEGAL } from "../../lib/legal";
import { SERVICE_FEE_TAX_LABEL, orderFeeBreakdown, serviceFeeLabelFor } from "../../../netlify/lib/fees.mjs";
import { orderDiscount, discountLineLabel } from "../../../netlify/lib/discounts.mjs";
import Layout from "../../layouts/Layout.astro";
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import EventHeader from "../../components/EventHeader.vue";
import EventTabs from "../../components/EventTabs.vue";
import TicketInfo from "../../components/TicketInfo.vue";
import EventDetails from "../../components/EventDetails.vue";
import { formatLocalDate, formatLocalTime } from "../../utils/dateHelpers.js";

import "../../styles/global.css";

export const prerender = false;

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const { id } = Astro.params;
const supabase = getSupabaseAdmin();

let tickets: any[] = [];
let event: any = null;
let orderInfo: any = null;
let attendeeInfo: any = null;
let errorMessage: string | null = null;
let pendingMessage: string | null = null;

const formatVenue = (loc: any) => {
  if (!loc) return "";
  const venue = loc.venues || {};
  return [loc.display_name || venue.name || (loc.name && loc.name !== "Main" ? loc.name : null), loc.address_line1_override || venue.address_line1, loc.city_override || venue.city]
    .filter(Boolean)
    .filter((v: string, i: number, arr: string[]) => arr.indexOf(v) === i)
    .join(", ");
};

if (!id || !UUID_RE.test(id)) {
  errorMessage = "Orden no encontrada";
} else {
  try {
    const ORDER_COLS = "id, created_at, status, event_id, attendee_id, amount, ticket_fee, total_payment, ticket_qty, buyer_first_name, buyer_last_name, buyer_email";
    // Columnas opcionales, de la más completa a la mínima: descuento (202609300200) e IVA del cargo (202609290100)
    let orderData: any = null;
    for (const cols of [`${ORDER_COLS}, service_fee_tax, discount_amount, discount_code`, `${ORDER_COLS}, service_fee_tax`, ORDER_COLS]) {
      const { data, error: orderError } = await supabase.from("event_orders").select(cols).eq("id", id).maybeSingle();
      orderData = data;
      if (!orderError || !["42703", "PGRST204"].includes(String(orderError.code || ""))) break;
    }

    if (!orderData) {
      errorMessage = "Orden no encontrada";
    } else {
      orderInfo = orderData;

      const { data: eventData } = await supabase
        .from("events")
        .select("id, name, title, slug, description, image_url, location, start_date, end_date")
        .eq("id", orderData.event_id)
        .maybeSingle();

      if (!eventData) {
        errorMessage = "Evento no encontrado";
      } else {
        event = { ...eventData, description: descriptionToHtml(eventData.description) };

        const [{ data: eventDates }, { data: faqs }, { data: categories }, { data: attendee }] = await Promise.all([
          supabase
            .from("event_dates")
            .select("id, date, start_time, end_time, event_location_id, event_locations ( name, display_name, address_line1_override, city_override, venues ( name, address_line1, city ) )")
            .eq("event_id", event.id)
            .order("date", { ascending: true })
            .order("start_time", { ascending: true }),
          supabase.from("event_faqs").select("question, answer").eq("event_id", event.id),
          supabase.from("event_tags").select("category_tags(name)").eq("event_id", event.id),
          orderData.buyer_email
            ? Promise.resolve({ data: null })
            : supabase.from("attendees").select("first_name, last_name, email").eq("id", orderData.attendee_id).maybeSingle(),
        ]);

        const defaultDate = {
          date: event.start_date,
          start_time: event.start_date
            ? new Date(event.start_date).toLocaleTimeString("es-CL", { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false, timeZone: "America/Santiago" })
            : null,
          end_time: event.end_date
            ? new Date(event.end_date).toLocaleTimeString("es-CL", { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false, timeZone: "America/Santiago" })
            : null,
        };
        event.dates = eventDates?.length ? eventDates : event.start_date ? [defaultDate] : [];
        event.faqs = faqs || [];
        event.tags = (categories || []).map((c: any) => c.category_tags?.name).filter(Boolean);
        event.address = formatVenue(eventDates?.[0]?.event_locations) || event.location || "";
        // R2: comprador de esta orden (fallback al registro attendees para órdenes antiguas)
        attendeeInfo = orderData.buyer_email
          ? { first_name: orderData.buyer_first_name, last_name: orderData.buyer_last_name, email: orderData.buyer_email }
          : attendee || null;

        const { data: ticketsData, error: ticketsError } = await supabase
          .from("event_attendees")
          .select("id, qr_code, status, validated_at, event_tickets ( ticket_name, price, event_date_id )")
          .eq("event_order_id", id);

        if (ticketsError) {
          console.error("Error al obtener tickets:", ticketsError.message);
          errorMessage = "Error al cargar las entradas";
        } else {
          tickets = (ticketsData || []).map((ticketData: any) => {
            // R1: entrada de una función específica -> solo esa función
            const fnId = ticketData.event_tickets?.event_date_id;
            const fnDates = fnId != null ? (event?.dates || []).filter((d: any) => String(d.id) === String(fnId)) : [];
            return {
            id: ticketData.id,
            event_name: event?.name || "Evento",
            event_dates: fnDates.length ? fnDates : event?.dates || [],
            ticket_name: ticketData.event_tickets?.ticket_name || "Entrada General",
            attendee_name: `${attendeeInfo?.first_name || ""} ${attendeeInfo?.last_name || ""}`.trim(),
            attendee_email: attendeeInfo?.email || "",
            // Entrada anulada (p. ej. orden reembolsada): no se muestra el QR
            qr_code: ticketData.status === "cancelled" ? null : ticketData.qr_code || null,
            status: ticketData.status,
            };
          });
        }

        // Dirección secreta: solo para órdenes pagadas con al menos una entrada vigente
        const hasLiveTicket = (ticketsData || []).some((t: any) => t.status !== "cancelled");
        if (orderData.status === "paid" && hasLiveTicket) {
          const { data: secretRow } = await supabase.from("events").select("secret_location").eq("id", event.id).maybeSingle();
          if (secretRow?.secret_location) event.secret_location = secretRow.secret_location;
        }

        if (orderData.status !== "paid") {
          if (orderData.status === "processing") {
            pendingMessage = "¡Pago recibido! Estamos emitiendo tus entradas; aparecerán aquí y en tu correo en unos minutos.";
          } else if (orderData.status === "pending") {
            pendingMessage = "Estamos confirmando tu pago. Tus entradas aparecerán aquí y llegarán a tu correo apenas se confirme (recarga la página en unos minutos).";
          } else if (orderData.status === "refunded") {
            pendingMessage = "Esta orden fue reembolsada: sus entradas fueron anuladas y ya no sirven para ingresar al evento.";
          } else if (["rejected", "cancelled", "failed", "expired"].includes(orderData.status)) {
            pendingMessage = "El pago de esta orden no se completó, por lo que no tiene entradas asociadas.";
          } else {
            pendingMessage = `Esta orden está en revisión. Si ya pagaste, escríbenos a ${LEGAL.supportEmail} indicando el número de orden.`;
          }
        }
      }
    }
  } catch (error: any) {
    console.error("Error cargando la orden:", error?.message);
    errorMessage = "Error interno del servidor";
  }
}

// amount = subtotal; ticket_fee = cargo por servicio neto; service_fee_tax = IVA del cargo
const breakdown = orderInfo ? orderFeeBreakdown(orderInfo) : null;
// Descuento: amount ya viene descontado; el subtotal a precio de lista es amount + descuento
const discount = orderInfo ? orderDiscount(orderInfo) : { code: "", amount: 0 };
const totalPaid = orderInfo
  ? Number(orderInfo.total_payment ?? breakdown?.total) || 0
  : 0;
const clp = (n: number) => `$${Math.round(Number(n) || 0).toLocaleString("es-CL")}`;
---

<Layout title={event?.name ? `Tus entradas: ${event.name} | AI Tickets` : "Tu orden | AI Tickets"} noindex>
  <AppHeader client:idle />
  <main class="flex flex-col items-center min-h-screen bg-gray-100">
    <div class="max-w-6xl mx-auto w-full px-4 lg:px-0">

      {errorMessage ? (
        <div class="mt-12 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg">
          <h2 class="text-xl font-semibold font-[Unbounded] mb-2">Error</h2>
          <p>{errorMessage}</p>
        </div>
      ) : (
        <>
          <div class="mt-16 lg:mt-12 bg-white rounded-lg shadow-lg p-6">
            <h3 class="text-lg font-bold font-[Unbounded] text-gray-800 mb-4 break-words">
              🎟️ Orden #{orderInfo?.id}
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-gray-600 font-[Prompt] break-words">
              <div>
                <span class="font-semibold">Cliente:</span>
                <p>{attendeeInfo?.first_name} {attendeeInfo?.last_name}</p>
                <p>{attendeeInfo?.email}</p>
              </div>
              <div>
                <span class="font-semibold">Fecha de compra:</span>
                <p>{orderInfo?.created_at ? `${formatLocalDate(orderInfo.created_at, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })} a las ${formatLocalTime(orderInfo.created_at)} hrs` : 'N/A'}</p>
              </div>
              <div>
                <span class="font-semibold">{orderInfo?.status === 'paid' ? 'Total pagado:' : 'Total:'}</span>
                <p class="text-lg font-bold text-green-600">
                  {totalPaid > 0 ? `$${totalPaid.toLocaleString('es-CL')}` : 'Gratis'}
                </p>
                {breakdown && (breakdown.fee > 0 || discount.amount > 0) && (
                  <dl class="mt-1 space-y-0.5 text-xs text-gray-500" data-testid="order-fee-breakdown">
                    {discount.amount > 0 && (
                      <>
                        <div class="flex justify-between gap-2"><dt>Entradas</dt><dd>{clp(breakdown.subtotal + discount.amount)}</dd></div>
                        <div class="flex justify-between gap-2 text-lime-700" data-testid="order-discount-line"><dt>{discountLineLabel(discount.code)}</dt><dd>-{clp(discount.amount)}</dd></div>
                      </>
                    )}
                    <div class="flex justify-between gap-2"><dt>Subtotal</dt><dd>{clp(breakdown.subtotal)}</dd></div>
                    {breakdown.feeNet > 0 && (
                      <div class="flex justify-between gap-2"><dt>{serviceFeeLabelFor(breakdown.subtotal, breakdown.feeNet)}</dt><dd>{clp(breakdown.feeNet)}</dd></div>
                    )}
                    {breakdown.feeIva > 0 && (
                      <div class="flex justify-between gap-2"><dt>{SERVICE_FEE_TAX_LABEL}</dt><dd>{clp(breakdown.feeIva)}</dd></div>
                    )}
                  </dl>
                )}
              </div>
            </div>
          </div>

          {pendingMessage && (
            <div class="mt-6 bg-amber-50 border border-amber-300 text-amber-800 px-4 py-3 rounded-lg font-[Prompt]">
              {pendingMessage}
            </div>
          )}

          <EventDetails event={event} client:load />

          {tickets.length > 0 && (
            <div class="mt-6">
              <h2 class="text-xl font-semibold font-[Unbounded] text-gray-800 mb-4">
                {tickets.length === 1 ? 'Tu Entrada' : `Tus Entradas (${tickets.length})`}
              </h2>

              <div class="space-y-6">
                {tickets.map((ticket, index) => (
                  <div class="relative">
                    {tickets.length > 1 && (
                      <div class="text-sm text-gray-500 font-[Prompt] mb-2">
                        Entrada {index + 1} de {tickets.length}
                      </div>
                    )}
                    <TicketInfo ticket={ticket} event={event} client:only />
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="w-full mt-8 mb-8">
            <details class="bg-white p-4 rounded-lg shadow-lg">
              <summary class="text-lg font-semibold cursor-pointer font-[Unbounded]">
                Detalles del Evento
              </summary>
              <div class="mt-4">
                <EventHeader event={event} client:idle />
                <EventTabs event={event} client:only />
              </div>
            </details>
          </div>
        </>
      )}
    </div>
  </main>
  <AppFooter client:idle />
</Layout>
