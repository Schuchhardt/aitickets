---
import AppHeader from "../components/AppHeader.vue";
import AppFooter from "../components/AppFooter.vue";
import TicketInfo from "../components/TicketInfo.vue";
import EventDetails from "../components/EventDetails.vue";
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import { getSupabaseAdmin } from "../lib/auth-helpers";
import { sendTicketsEmail } from "./api/_lib/server-utils";
import { LEGAL } from "../lib/legal";
import { verifyFlowReturnToken } from "../../netlify/lib/payments/flow.mjs";
import { orderFeeBreakdown } from "../../netlify/lib/fees.mjs";

export const prerender = false;

// urlReturn de Flow: el navegador llega aquí por POST con el `token` del pago.
// Esta página SOLO muestra el estado: el webhook /api/payment-confirmation es quien marca la orden
// como pagada, emite las entradas y envía el correo. Red de seguridad: si la orden está pagada y el correo
// aún no se envió (p. ej. Resend falló en el webhook), se dispara /api/send-tickets-email (idempotente).
const supabase = getSupabaseAdmin();

// Configuración de seguridad
const request = Astro.request;

// Si no es POST, redirigir usando localStorage del cliente
if (request.method !== 'POST') {
  // En lugar de mostrar error, renderizamos una página que redirige desde el cliente
  const redirectPage = `
    <!DOCTYPE html>
    <html>
    <head>
      <meta charset="UTF-8">
      <meta name="robots" content="noindex, nofollow">
      <title>Redirigiendo...</title>
    </head>
    <body>
      <script>
        // Buscar la compra más reciente en localStorage
        let mostRecentPurchase = null;
        let mostRecentDate = null;
        
        // Recorrer todas las claves del localStorage buscando compras de eventos
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith('purchase_event_')) {
            try {
              const orders = JSON.parse(localStorage.getItem(key) || '[]');
              if (orders.length > 0) {
                // Obtener la orden más reciente de este evento
                const latestOrder = orders[orders.length - 1];
                const purchaseDate = new Date(latestOrder.purchaseDate);
                
                if (!mostRecentDate || purchaseDate > mostRecentDate) {
                  mostRecentDate = purchaseDate;
                  mostRecentPurchase = latestOrder;
                }
              }
            } catch (e) {
              console.error('Error al leer localStorage:', e);
            }
          }
        }
        
        // Redirigir al evento más reciente o a la página principal
        if (mostRecentPurchase && mostRecentPurchase.eventSlug) {
          window.location.href = '/eventos/' + mostRecentPurchase.eventSlug;
        } else {
          window.location.href = '/';
        }
      </script>
      <div style="font-family: sans-serif; text-align: center; padding: 50px;">
        <h2>Redirigiendo...</h2>
        <p>Si no eres redirigido automáticamente, <a href="/">haz clic aquí</a>.</p>
      </div>
    </body>
    </html>
  `;
  
  return new Response(redirectPage, {
    status: 200,
    headers: {
      'Content-Type': 'text/html; charset=utf-8',
      'X-Robots-Tag': 'noindex, nofollow',
    },
  });
}

const allowedOrigins = ['https://aitickets.cl', 'https://www.aitickets.cl', 'https://www.flow.cl', 'https://sandbox.flow.cl'];
const origin = request.headers.get('origin');
if (origin && origin !== 'null' && !allowedOrigins.includes(origin)) {
  return new Response('Origen no permitido', { status: 403 });
}

type ViewState = 'paid' | 'processing' | 'pending' | 'review' | 'rejected' | 'cancelled' | 'refunded' | 'error';

let state: ViewState = 'error';
let paymentStatusMessage = 'No se recibió la información necesaria para verificar tu pago.';
let order: any = null;
let eventData: any = null;
let tickets: any[] = [];
let totalPaid = 0;
let purchase: any = null;      // payload GA4 `purchase` (solo si está pagada)
let purchaseData: any = null;  // resumen para localStorage ("Mis entradas")

const formData = await request.formData();
const token = formData.get('token');

if (typeof token === 'string' && token) {
  try {
    const verified = await verifyFlowReturnToken(token);

    if (!verified.ok) {
      paymentStatusMessage = 'No se pudo verificar el estado de tu pago en este momento. Revisa tu correo o intenta más tarde.';
    } else {
      const flowPayment: any = verified.payment;
      const commerceOrder = verified.orderId;

      if (!commerceOrder) {
        paymentStatusMessage = 'No encontramos tu orden. Por favor, contacta a soporte.';
      } else {
        const ORDER_COLS = 'id, status, event_id, amount, ticket_fee, total_payment, ticket_qty, ticket_details, created_at, email_sent_at, buyer_first_name, buyer_email';
        let { data: orderData, error: orderError }: { data: any; error: any } = await supabase
          .from('event_orders')
          .select(`${ORDER_COLS}, service_fee_tax`)
          .eq('id', commerceOrder)
          .maybeSingle();
        if (orderError) {
          // Base sin la columna service_fee_tax (202609290100)
          ({ data: orderData } = await supabase.from('event_orders').select(ORDER_COLS).eq('id', commerceOrder).maybeSingle());
        }

        if (!orderData) {
          paymentStatusMessage = 'No encontramos tu orden. Por favor, contacta a soporte.';
        } else {
          order = orderData;
          // Total cobrado = subtotal + cargo por servicio + IVA del cargo (total_payment es lo que confirmó Flow)
          totalPaid = Number(orderData.total_payment ?? orderFeeBreakdown(orderData).total) || 0;

          const { data: eventInfo } = await supabase
            .from('events')
            .select('id, name, title, slug, image_url, location, start_date, end_date')
            .eq('id', orderData.event_id)
            .maybeSingle();
          eventData = eventInfo ? { ...eventInfo, address: eventInfo.location } : null;

          if (orderData.status === 'paid') {
            state = 'paid';
            paymentStatusMessage = '¡Gracias por tu compra! Tu pago fue confirmado.';
            const { data: ticketsInfo } = await supabase
              .from('event_attendees')
              .select('id, qr_code, status, event_tickets ( ticket_name )')
              .eq('event_order_id', orderData.id);
            tickets = (ticketsInfo || []).map((t: any) => ({
              id: t.id,
              qr_code: t.qr_code,
              status: t.status,
              ticket_name: t.event_tickets?.ticket_name || 'Entrada',
            }));
            if (!orderData.email_sent_at && tickets.length) {
              const mail = await sendTicketsEmail(new URL(request.url), orderData.id);
              if (!mail.ok) console.error(`payment-confirmation: no se pudo enviar el correo de la orden ${orderData.id} (${mail.status})`);
            }
          } else if (orderData.status === 'review') {
            // Pago recibido pero requiere revisión manual (monto no coincide o sin stock): no prometer entradas
            state = 'review';
            paymentStatusMessage = `Recibimos tu pago, pero tu orden requiere una revisión manual. Nuestro equipo te contactará por correo; si tienes dudas escríbenos a ${LEGAL.supportEmail} indicando tu número de orden.`;
          } else if (orderData.status === 'refunded') {
            state = 'refunded';
            paymentStatusMessage = 'Esta orden fue reembolsada y sus entradas fueron anuladas.';
          } else if (flowPayment.status === 2) {
            // Flow ya cobró pero el webhook aún no termina de procesar la orden
            state = 'processing';
            paymentStatusMessage = '¡Pago recibido! Estamos emitiendo tus entradas; llegarán a tu correo en unos minutos.';
          } else if (flowPayment.status === 1) {
            state = 'pending';
            paymentStatusMessage = 'Tu pago está pendiente de confirmación. Te enviaremos las entradas por correo apenas se confirme.';
          } else if (flowPayment.status === 3 || orderData.status === 'rejected') {
            state = 'rejected';
            paymentStatusMessage = 'Tu pago fue rechazado. Puedes intentarlo nuevamente o usar otro medio de pago.';
          } else if (flowPayment.status === 4 || orderData.status === 'cancelled' || orderData.status === 'expired') {
            state = 'cancelled';
            paymentStatusMessage = 'El pago fue anulado. Si crees que es un error, contacta a soporte.';
          } else {
            paymentStatusMessage = 'No pudimos determinar el estado de tu pago. Por favor, contacta a soporte.';
          }

          if (state === 'paid' && eventData) {
            const lines = Array.isArray(orderData.ticket_details) ? orderData.ticket_details : [];
            purchase = {
              transaction_id: orderData.id,
              value: totalPaid,
              tax: orderFeeBreakdown(orderData).feeIva,
              currency: 'CLP',
              items: lines.map((l: any) => ({
                item_id: `${eventData.id}-${l.id}`,
                item_name: `${eventData.name} - ${l.name}`,
                item_category: 'event_ticket',
                price: Number(l.price) || 0,
                quantity: Number(l.quantity) || 1,
              })),
            };
            purchaseData = {
              orderId: orderData.id,
              eventId: eventData.id,
              eventSlug: eventData.slug,
              eventName: eventData.name,
              eventStartDate: eventData.start_date,
              amount: totalPaid,
              ticketsCount: tickets.length,
              tickets: tickets.map((t) => ({ id: t.id, ticket_name: t.ticket_name })),
            };
          }
        }
      }
    }
  } catch (err: any) {
    console.error('Error verificando pago:', err?.message);
    paymentStatusMessage = 'No se pudo verificar el estado de tu pago en este momento. Revisa tu correo o intenta más tarde.';
  }
}

const orderUrl = order ? `/order/${order.id}` : null;
// "Intentar de nuevo": vuelve al paso "Pagar" del checkout con la misma selección (los datos del comprador los
// recuerda el navegador). Si las entradas ya no están a la venta, el checkout cae al paso 1.
const retryLines = Array.isArray(order?.ticket_details) ? order.ticket_details : [];
const retryEntradas = retryLines
  .filter((l: any) => Number(l?.id) > 0 && Number(l?.quantity) > 0)
  .map((l: any) => `${Number(l.id)}:${Number(l.quantity)}`)
  .join(',');
const retryUrl = eventData?.slug
  ? `/eventos/${eventData.slug}${retryEntradas ? `?checkout=1&paso=2&entradas=${encodeURIComponent(retryEntradas)}` : ''}`
  : '/eventos';
const firstName = String(order?.buyer_first_name || '').trim().split(/\s+/)[0] || '';
const ticketCount = tickets.length || Number(order?.ticket_qty) || 0;
const isSuccess = state === 'paid' || state === 'processing';
const isFailed = state === 'rejected' || state === 'cancelled';
const title = state === 'paid'
  ? `¡Listo${firstName ? `, ${firstName}` : ''}! Tienes ${ticketCount} ${ticketCount === 1 ? 'entrada' : 'entradas'} para ${eventData?.name || 'el evento'}.`
  : state === 'processing'
    ? '¡Pago recibido! Estamos emitiendo tus entradas.'
    : isFailed
      ? 'El pago no se completó. No se hizo ningún cobro.'
      : paymentStatusMessage;
const body = state === 'paid'
  ? (order?.buyer_email ? `Te las enviamos a ${order.buyer_email}. También puedes verlas aquí:` : 'Te las enviamos por correo. También puedes verlas aquí:')
  : state === 'processing'
    ? 'Llegarán a tu correo en unos minutos.'
    : isFailed
      ? 'Puedes intentarlo de nuevo con los mismos datos.'
      : '';
---
<Layout title="Confirmación de pago | AI Tickets" noindex>
  <AppHeader client:idle />

  <main class="pc ev-motion">
    <div class="pc-card">
      {isSuccess && (
        <div class="pc-check" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0A0A0B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path class="pc-check-path" d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        </div>
      )}
      <h1 class="pc-title" tabindex="-1">{title}</h1>
      {body && <p class="pc-body">{body}</p>}

      {isFailed && (
        <a href={retryUrl} class="ev-btn ev-btn-primary pc-cta">Intentar de nuevo</a>
      )}
      {state === 'error' && (
        <a href={eventData?.slug ? `/eventos/${eventData.slug}` : '/eventos'} class="ev-btn ev-btn-primary pc-cta">Volver al evento</a>
      )}

      {state === 'paid' && tickets.length > 0 && (
        <div class="pc-tickets">
          {tickets.map((ticketItem: any) => (
            <TicketInfo ticket={ticketItem} event={eventData} client:only />
          ))}
        </div>
      )}

      {(isSuccess || state === 'pending') && orderUrl && (
        <a href={orderUrl} class="ev-btn ev-btn-secondary pc-cta">Ver mis entradas</a>
      )}

      {order && eventData && <EventDetails event={eventData} client:load />}

      {order && (
        <p class="pc-meta">Orden {order.id}{totalPaid > 0 ? ` · Total $${totalPaid.toLocaleString('es-CL')}` : ''}</p>
      )}
    </div>
  </main>

  <AppFooter />

  {purchase && (
    <script define:vars={{ purchase, purchaseData }}>
      // GA4 purchase: una sola vez por orden (recargar la página no duplica la conversión)
      try {
        const gaKey = 'ga_purchase_' + purchase.transaction_id;
        if (!sessionStorage.getItem(gaKey)) {
          window.gtag?.('event', 'purchase', purchase);
          sessionStorage.setItem(gaKey, '1');
        }
      } catch (e) { /* storage o gtag no disponibles */ }

      // Guardar la compra para "Mis entradas" en la página del evento y limpiar el flujo de reserva
      try {
        const key = 'purchase_event_' + purchaseData.eventId;
        const orders = JSON.parse(localStorage.getItem(key) || '[]');
        if (!orders.some((o) => o.orderId === purchaseData.orderId)) {
          orders.push({ ...purchaseData, purchaseDate: new Date().toISOString() });
          localStorage.setItem(key, JSON.stringify(orders));
        }
        localStorage.removeItem('selectedTickets_event_' + purchaseData.eventId);
        localStorage.removeItem('buyerInfo_event_' + purchaseData.eventId);
        localStorage.removeItem('currentStep_event_' + purchaseData.eventId);
      } catch (e) { /* storage no disponible */ }
    </script>
  )}
</Layout>

<style>
  .pc {
    min-height: 70vh;
    background: var(--surface-1);
    padding: 40px 16px 56px;
    font-family: "Prompt", system-ui, sans-serif;
    color: var(--text-1);
  }
  .pc-card {
    max-width: 640px;
    margin: 0 auto;
    background: var(--surface-0);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-card);
    padding: 32px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  .pc-check {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--brand-lime);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: ev-pop 320ms var(--ease-spring) both;
  }
  .pc-check-path {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    animation: ev-draw 240ms var(--ease-out) 160ms forwards;
  }
  .pc-title {
    font-family: "Unbounded", system-ui, sans-serif;
    font-size: 22px;
    line-height: 30px;
    font-weight: 700;
    text-wrap: balance;
    outline: none;
  }
  .pc-body {
    font-size: 15px;
    line-height: 23px;
    color: var(--text-2);
    max-width: 46ch;
    overflow-wrap: anywhere;
  }
  .pc-cta {
    width: 100%;
    max-width: 360px;
    text-decoration: none;
  }
  .pc-tickets {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
    text-align: left;
    margin-top: 8px;
  }
  .pc-card :global(.font-\[Prompt\]) { text-align: left; }
  .pc-card > :global(div.mt-6) { width: 100%; text-align: left; }
  .pc-meta {
    font-size: 12px;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }
  @media (min-width: 768px) {
    .pc-card { padding: 40px; }
    .pc-title { font-size: 26px; line-height: 34px; }
  }
</style>

