---
export const prerender = true;
import "../styles/global.css";
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Presentación de AI Tickets para productores de eventos</title>
    <meta name="description" content="Conoce AI Tickets: la plataforma chilena para vender entradas online con 0% de comisión para el productor, pagos, QR y check-in.">
    <link rel="canonical" href="https://aitickets.cl/presentacion">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="AI Tickets">
    <meta property="og:locale" content="es_CL">
    <meta property="og:title" content="Presentación de AI Tickets para productores de eventos">
    <meta property="og:description" content="Conoce AI Tickets: la plataforma chilena para vender entradas online con 0% de comisión para el productor, pagos, QR y check-in.">
    <meta property="og:url" content="https://aitickets.cl/presentacion">
    <meta property="og:image" content="https://aitickets.cl/aitickets_preview.png">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      html, body {
        height: 100%;
        overflow: hidden;
        background: #000;
        color: #FEFEFE;
        font-family: 'Prompt', sans-serif;
      }
      
      .presentation {
        height: 100vh;
        width: 100vw;
        position: relative;
      }
      
      .slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 4rem;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.5s ease, transform 0.5s ease;
        transform: translateX(50px);
      }
      
      .slide.active {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
      }
      
      .slide.prev {
        transform: translateX(-50px);
      }
      
      h1, h2 {
        font-family: 'Unbounded', sans-serif;
        font-weight: 500;
        text-align: center;
        line-height: 1.2;
      }
      
      h1 {
        font-size: clamp(2rem, 5vw, 4rem);
        margin-bottom: 1.5rem;
      }
      
      h2 {
        font-size: clamp(1.5rem, 3.5vw, 2.5rem);
        margin-bottom: 2rem;
      }
      
      p, li {
        font-size: clamp(1rem, 2vw, 1.4rem);
        line-height: 1.8;
        max-width: 900px;
      }
      
      ul {
        list-style: none;
        text-align: left;
        max-width: 800px;
      }
      
      li {
        margin-bottom: 1rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
      }
      
      li::before {
        content: attr(data-icon);
        font-size: 1.5rem;
        flex-shrink: 0;
      }
      
      .highlight-green {
        color: #9AE600;
      }
      
      .highlight-pink {
        color: #D84ABF;
      }
      
      .highlight-cyan {
        color: #709EFF;
      }
      
      .subtitle {
        color: #9AE600;
        font-size: clamp(1rem, 2vw, 1.5rem);
        margin-top: 1rem;
      }
      
      /* Backgrounds */
      .bg-gradient-cyan {
        background: linear-gradient(135deg, #000 0%, #1a3a5c 100%);
      }
      
      .bg-gradient-green {
        background: linear-gradient(135deg, #000 0%, #1a3d00 100%);
      }
      
      .bg-gradient-pink {
        background: linear-gradient(135deg, #000 0%, #3d1a35 100%);
      }
      
      /* Navigation */
      .nav-controls {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 1rem;
        align-items: center;
        z-index: 100;
        background: rgba(0,0,0,0.8);
        padding: 1rem 2rem;
        border-radius: 50px;
        border: 1px solid rgba(154, 230, 0, 0.3);
      }
      
      .nav-btn {
        background: transparent;
        border: 2px solid #9AE600;
        color: #9AE600;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        font-size: 1.2rem;
      }
      
      .nav-btn:hover {
        background: #9AE600;
        color: #000;
      }
      
      .nav-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }
      
      .slide-counter {
        color: #9AE600;
        font-family: 'Unbounded', sans-serif;
        font-size: 1rem;
        min-width: 80px;
        text-align: center;
      }
      
      /* Progress bar */
      .progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 4px;
        background: #9AE600;
        transition: width 0.3s ease;
        z-index: 100;
      }
      
      /* Cards grid */
      .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        max-width: 1000px;
        margin-top: 2rem;
      }
      
      .card {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(154, 230, 0, 0.3);
        border-radius: 16px;
        padding: 1.5rem;
        text-align: left;
      }
      
      .card h3 {
        font-family: 'Unbounded', sans-serif;
        font-size: 1.2rem;
        margin-bottom: 0.5rem;
      }
      
      .card p {
        font-size: 0.95rem;
        opacity: 0.8;
      }
      
      .card.green { border-color: #9AE600; }
      .card.green h3 { color: #9AE600; }
      
      .card.cyan { border-color: #709EFF; }
      .card.cyan h3 { color: #709EFF; }
      
      .card.pink { border-color: #D84ABF; }
      .card.pink h3 { color: #D84ABF; }
      
      /* Steps */
      .steps {
        display: flex;
        gap: 2rem;
        margin-top: 2rem;
        flex-wrap: wrap;
        justify-content: center;
      }
      
      .step {
        text-align: center;
        max-width: 280px;
      }
      
      .step-number {
        font-family: 'Unbounded', sans-serif;
        font-size: 3rem;
        color: #9AE600;
        margin-bottom: 0.5rem;
      }
      
      .step h3 {
        font-family: 'Unbounded', sans-serif;
        font-size: 1.2rem;
        margin-bottom: 0.5rem;
      }
      
      .step p {
        font-size: 1rem;
        opacity: 0.8;
      }
      
      /* Quote */
      .quote {
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        font-style: italic;
        max-width: 800px;
        text-align: center;
        line-height: 1.6;
        position: relative;
        padding: 2rem;
      }
      
      .quote::before {
        content: '"';
        font-size: 6rem;
        color: #9AE600;
        position: absolute;
        top: -1rem;
        left: -1rem;
        opacity: 0.5;
        font-family: Georgia, serif;
      }
      
      .quote-author {
        margin-top: 1.5rem;
        font-style: normal;
        color: #9AE600;
        font-size: 1.2rem;
      }
      
      /* Pricing table */
      .pricing {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        max-width: 1000px;
        margin-top: 2rem;
      }
      
      @media (max-width: 768px) {
        .pricing {
          grid-template-columns: 1fr;
        }
      }
      
      .price-card {
        background: rgba(255,255,255,0.03);
        border-radius: 20px;
        padding: 2rem;
        text-align: center;
        border: 2px solid rgba(255,255,255,0.1);
        transition: transform 0.3s ease, border-color 0.3s ease;
      }
      
      .price-card:hover {
        transform: translateY(-5px);
      }
      
      .price-card.featured {
        border-color: #709EFF;
        background: rgba(112, 158, 255, 0.1);
      }
      
      .price-card h3 {
        font-family: 'Unbounded', sans-serif;
        font-size: 1.3rem;
        margin-bottom: 0.5rem;
      }
      
      .price-card .percentage {
        font-family: 'Unbounded', sans-serif;
        font-size: 3rem;
        margin: 1rem 0;
      }
      
      .price-card ul {
        text-align: left;
        font-size: 0.9rem;
      }
      
      .price-card li {
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
      }
      
      .price-card li::before {
        content: '✓';
        color: #9AE600;
      }
      
      /* CTA Button */
      .cta-button {
        display: inline-block;
        background: #9AE600;
        color: #000;
        padding: 1rem 3rem;
        border-radius: 50px;
        font-family: 'Unbounded', sans-serif;
        font-size: 1.2rem;
        text-decoration: none;
        margin-top: 2rem;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
      }
      
      .cta-button:hover {
        transform: scale(1.05);
        box-shadow: 0 0 30px rgba(154, 230, 0, 0.5);
      }
      
      /* Metrics */
      .metrics {
        display: flex;
        gap: 3rem;
        margin-top: 2rem;
        flex-wrap: wrap;
        justify-content: center;
      }
      
      .metric {
        text-align: center;
      }
      
      .metric-value {
        font-family: 'Unbounded', sans-serif;
        font-size: 3rem;
        color: #9AE600;
      }
      
      .metric-label {
        font-size: 1rem;
        opacity: 0.8;
      }
      
      /* Logo */
      .logo {
        position: fixed;
        top: 2rem;
        left: 2rem;
        font-family: 'Unbounded', sans-serif;
        font-size: 1.2rem;
        color: #9AE600;
        z-index: 100;
        text-decoration: none;
      }
      
      /* Keyboard hints */
      .keyboard-hint {
        position: fixed;
        bottom: 6rem;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.8rem;
        opacity: 0.5;
        z-index: 100;
      }
      
      kbd {
        background: rgba(255,255,255,0.1);
        padding: 0.3rem 0.6rem;
        border-radius: 4px;
        margin: 0 0.2rem;
      }
      
      /* Comparison table */
      .comparison {
        max-width: 900px;
        margin-top: 2rem;
        width: 100%;
      }
      
      .comparison table {
        width: 100%;
        border-collapse: collapse;
      }
      
      .comparison th, .comparison td {
        padding: 1rem;
        text-align: left;
        border-bottom: 1px solid rgba(255,255,255,0.1);
      }
      
      .comparison th {
        font-family: 'Unbounded', sans-serif;
        font-size: 0.9rem;
      }
      
      .comparison td:first-child {
        font-weight: 500;
      }
      
      .check { color: #9AE600; }
      .cross { color: #D84ABF; }
      .warn { color: #FFB800; }

      /* Fullscreen button */
      .fullscreen-btn {
        position: fixed;
        top: 2rem;
        right: 2rem;
        background: transparent;
        border: 1px solid rgba(154, 230, 0, 0.5);
        color: #9AE600;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        z-index: 100;
        transition: all 0.3s ease;
      }
      
      .fullscreen-btn:hover {
        background: rgba(154, 230, 0, 0.1);
      }
      
      /* Responsive */
      @media (max-width: 768px) {
        .slide {
          padding: 2rem 1.5rem 6rem;
        }
        
        .nav-controls {
          padding: 0.8rem 1.5rem;
        }
        
        .nav-btn {
          width: 40px;
          height: 40px;
        }
        
        .steps {
          flex-direction: column;
          align-items: center;
        }
        
        .cards-grid {
          grid-template-columns: 1fr;
        }
        
        .keyboard-hint {
          display: none;
        }
        
        .logo {
          font-size: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <a href="/" class="logo">AI Tickets</a>
    <button class="fullscreen-btn" id="fullscreenBtn">⛶ Pantalla completa</button>
    
    <div class="progress-bar" id="progressBar"></div>
    
    <div class="presentation" id="presentation">
      
      <!-- SLIDE 1: Portada -->
      <div class="slide active" data-slide="1">
        <h1>¿Y si cada función <span class="highlight-green">estuviera llena</span>?</h1>
        <p class="subtitle">AI Tickets - La ticketera que llena tus funciones.</p>
      </div>
      
      <!-- SLIDE 2: El Dolor -->
      <div class="slide" data-slide="2">
        <h2 class="highlight-pink">¿Te suena familiar?</h2>
        <ul>
          <li data-icon="😫">"Cambiamos el horario y no pudimos avisar a todos a tiempo"</li>
          <li data-icon="📉">"Lunes y martes siempre están vacíos"</li>
          <li data-icon="🤯">"Paso más tiempo en la planilla que produciendo"</li>
          <li data-icon="📱">"La gente pregunta lo mismo mil veces por mensaje"</li>
          <li data-icon="💸">"Invertimos en publicidad pero no sabemos si funcionó"</li>
        </ul>
      </div>
      
      <!-- SLIDE 3: El Costo -->
      <div class="slide bg-gradient-pink" data-slide="3">
        <h2>El costo real de <span class="highlight-pink">seguir igual</span></h2>
        <ul>
          <li data-icon="📊">Funciones "flojas" con asientos vacíos</li>
          <li data-icon="⏰">Horas en tareas manuales: planillas, mensajes, listas en la puerta</li>
          <li data-icon="😤">Asistentes que no se enteran de un cambio</li>
          <li data-icon="💰">Plata en publicidad sin saber qué canal vendió</li>
          <li data-icon="⌛">Esperar semanas para recibir lo recaudado</li>
        </ul>
        <p class="subtitle" style="margin-top: 2rem;">"Cada función con asientos vacíos es plata que no vuelve."</p>
      </div>
      
      <!-- SLIDE 4: La Solución -->
      <div class="slide bg-gradient-green" data-slide="4">
        <h2>Imagina una herramienta que:</h2>
        <ul>
          <li data-icon="✅">Vende tus entradas online las 24 horas, con Webpay</li>
          <li data-icon="✅">Avisa por email a tus asistentes si cambia algo del evento</li>
          <li data-icon="✅">Te ayuda a promocionar cada función con posts hechos con IA</li>
          <li data-icon="✅">Te muestra qué canal te trae visitas y ventas</li>
          <li data-icon="✅">Te transfiere lo recaudado 48–72 h después de cada función</li>
        </ul>
        <p class="subtitle" style="margin-top: 2rem; font-size: 2rem;">Eso es <span class="highlight-green">AI Tickets</span>.</p>
      </div>
      
      <!-- SLIDE 5: Cómo Funciona -->
      <div class="slide" data-slide="5">
        <h2 class="highlight-cyan">Así de fácil es empezar</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <h3>Crea tu evento</h3>
            <p>Sube tus funciones, fechas y entradas en minutos. Te ayudamos a armar el primero.</p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <h3>Comparte el link</h3>
            <p>Tu página de venta queda lista. Tus compradores pagan con Webpay (vía Flow).</p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <h3>Recibe a tu público</h3>
            <p>Entradas QR por email, recordatorio 24 h antes y check-in desde el celular.</p>
          </div>
        </div>
      </div>
      
      <!-- SLIDE 6: Beneficio 1 - Promoción -->
      <div class="slide" data-slide="6">
        <h2><span class="highlight-green">"Los lunes ya no son un problema"</span></h2>
        <ul>
          <li data-icon="✨">Posts para Instagram y Facebook generados con IA desde tu evento</li>
          <li data-icon="🔗">Links con UTM para saber qué canal vende más</li>
          <li data-icon="📊">Visitas, ventas, ciudad y hora peak de cada evento</li>
          <li data-icon="🤖">Un asistente con IA en tu página responde las dudas de los compradores</li>
        </ul>
        <p class="subtitle" style="margin-top: 2rem;">Próximamente: WhatsApp y cupones de descuento.</p>
      </div>
      
      <!-- SLIDE 7: Beneficio 2 - Comunicación -->
      <div class="slide" data-slide="7">
        <h2 class="highlight-pink">"Cambió la función. ¿Cómo aviso a todos?"</h2>
        <ul>
          <li data-icon="✅">Si editas un evento publicado, tus asistentes reciben un email automático</li>
          <li data-icon="✅">Recordatorio automático por email 24 h antes de la función</li>
          <li data-icon="✅">El asistente con IA responde con la info y preguntas frecuentes de tu evento</li>
          <li data-icon="✅">Cada comprador recibe su entrada QR por email al instante</li>
        </ul>
        <p class="subtitle" style="margin-top: 2rem;">"Menos mensajes repetidos, asistentes mejor informados."</p>
      </div>
      
      <!-- SLIDE 8: Beneficio 3 - Operación -->
      <div class="slide" data-slide="8">
        <h2 class="highlight-cyan">Tu equipo, tu control</h2>
        <div class="cards-grid" style="grid-template-columns: repeat(2, 1fr);">
          <div class="card cyan">
            <h3>👥 Equipo con roles</h3>
            <p>Admin, editor y validador para la puerta</p>
          </div>
          <div class="card cyan">
            <h3>🎟️ Cortesías</h3>
            <p>Emite entradas de cortesía desde el panel</p>
          </div>
        </div>
        <ul style="margin-top: 2rem;">
          <li data-icon="✅">Varias fechas y horarios en un mismo evento</li>
          <li data-icon="✅">"Duplicar evento" para tus shows recurrentes</li>
          <li data-icon="✅">Exporta tus órdenes a CSV</li>
        </ul>
      </div>
      
      <!-- SLIDE 9: Próximamente -->
      <div class="slide bg-gradient-pink" data-slide="9">
        <h2>Lo que <span class="highlight-pink">viene</span></h2>
        <p style="text-align: center; margin-bottom: 1rem; opacity: 0.8;">Aún no disponible. Te avisamos cuando esté listo.</p>
        <div class="cards-grid">
          <div class="card pink">
            <h3>💬 WhatsApp</h3>
            <p>Próximamente</p>
          </div>
          <div class="card pink">
            <h3>🏷️ Cupones de descuento</h3>
            <p>Próximamente</p>
          </div>
          <div class="card pink">
            <h3>💳 MercadoPago</h3>
            <p>Próximamente</p>
          </div>
          <div class="card pink">
            <h3>🌐 Dominio propio</h3>
            <p>Próximamente</p>
          </div>
        </div>
      </div>
      
      <!-- SLIDE 10: Check-in -->
      <div class="slide" data-slide="10">
        <h2 class="highlight-green">Entrada sin filas, sin estrés</h2>
        <ul>
          <li data-icon="📱">Escanea el QR desde tu celular, sin instalar nada</li>
          <li data-icon="📶">Si se cae la señal, sigue validando con la lista descargada y sincroniza después</li>
          <li data-icon="🚫">Detecta entradas ya usadas o de otro evento</li>
          <li data-icon="👥">Suma validadores a tu equipo para la puerta</li>
        </ul>
        <p class="subtitle" style="margin-top: 2rem;">"Tu equipo en puerta solo saluda. El sistema hace el resto."</p>
      </div>
      
      <!-- SLIDE 11: Piloto -->
      <div class="slide" data-slide="11">
        <h2 class="highlight-green">Estamos en piloto</h2>
        <p style="text-align: center; max-width: 800px; margin: 1rem auto; opacity: 0.9;">
          Estamos trabajando codo a codo con los primeros productores de stand-up y teatro independiente.
          Si te sumas ahora, te ayudamos personalmente a armar tus eventos y tu opinión define lo que construimos.
        </p>
        <div class="cards-grid" style="margin-top: 2rem;">
          <div class="card green">
            <h3>🎤 Stand-up</h3>
            <p>Funciones semanales</p>
          </div>
          <div class="card cyan">
            <h3>🎭 Teatro independiente</h3>
            <p>Temporadas con varias funciones</p>
          </div>
          <div class="card pink">
            <h3>🎶 Productoras chicas</h3>
            <p>Sin equipo técnico</p>
          </div>
        </div>
      </div>
      
      <!-- SLIDE 12: Para quién -->
      <div class="slide" data-slide="12">
        <div class="quote">
          Hecho para productores que hacen funciones todas las semanas y no quieren pelearse con la tecnología.
          <br><br>
          Tú haces el show. Nosotros te ayudamos a venderlo.
          <div class="quote-author">— Equipo AI Tickets</div>
        </div>
      </div>
      
      <!-- SLIDE 13: Precio -->
      <div class="slide" data-slide="13">
        <h2>Un solo precio, claro</h2>
        <p style="text-align: center; margin-bottom: 1rem; opacity: 0.8;">Sin mensualidad. Sin costos fijos. Sin permanencia.</p>
        <div class="pricing" style="grid-template-columns: 1fr; max-width: 560px;">
          <div class="price-card featured">
            <h3 class="highlight-cyan">PARA EL PRODUCTOR</h3>
            <div class="percentage highlight-green">0%</div>
            <p style="margin-bottom: 1rem;">de comisión. El comprador paga un cargo por servicio de 10%.</p>
            <ul>
              <li>Venta online con Webpay (vía Flow)</li>
              <li>Funciones múltiples y entradas QR</li>
              <li>Check-in desde el celular</li>
              <li>Posts con IA y asistente IA en tu página</li>
              <li>Analítica por evento y canal</li>
            </ul>
            <p style="margin-top: 1rem; opacity: 0.8;">Te transferimos lo recaudado 48–72 h después de cada función.</p>
          </div>
        </div>
      </div>
      
      <!-- SLIDE 14: Comparativa -->
      <div class="slide" data-slide="14">
        <h2 class="highlight-cyan">¿Por qué AI Tickets?</h2>
        <div class="comparison">
          <table>
            <thead>
              <tr>
                <th></th>
                <th class="highlight-green">AI Tickets</th>
                <th>Planilla + transferencias</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Funciones múltiples</td>
                <td class="check">✓ Sí</td>
                <td class="cross">✗ Caos</td>
              </tr>
              <tr>
                <td>Entradas QR y check-in</td>
                <td class="check">✓ Sí</td>
