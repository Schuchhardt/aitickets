      <!-- SLIDE 16: CTA Final -->
      <div class="slide" data-slide="16">
        <h1 class="highlight-green">¿Listo para llenar más funciones?</h1>
        <p style="text-align: center; font-size: 1.3rem; margin: 1rem 0;">
          Crea tu cuenta gratis y publica tu primera función
        </p>
        <ul style="margin: 1.5rem 0;">
          <li data-icon="→">Te ayudamos a armar tu evento</li>
          <li data-icon="→">Respondemos todas tus dudas</li>
          <li data-icon="→">Sin compromiso</li>
        </ul>
        <a href="/organizadores/registro" class="cta-button">Crear mi cuenta gratis</a>
        <p style="margin-top: 1.5rem; text-align: center;">
          <a href="https://calendar.app.google/CMt97vedNjzBaoEX7" target="_blank" rel="noopener noreferrer" style="color: #9AE600;">o agenda una demo de 15 minutos</a>
