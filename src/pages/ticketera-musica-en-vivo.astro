---
// Landing especializada para música en vivo (docs/specs/rediseno/SPEC_landing_musica_aitickets.md, fases 1 a 3): bandas,
// solistas, productoras de conciertos y salas. Misma URL que la landing SEO anterior (src/data/landings.ts la marca
// dedicated: [landing].astro ya no la genera, y la tarjeta, el sitemap, las relacionadas y "Según lo que produces" de
// /organizadores siguen leyendo de ahí; el footer ya la enlaza en "Para quién"). Tema propio "afiche de gira"
// ([data-theme="musica"], src/styles/landing-musica.css) sin tocar los tokens globales ni repetir el lenguaje de
// stand-up o academias: Anton condensada, mono del sistema, rojo de sala, papel de afiche, duotono y grano.
// Reutiliza la fórmula de precios (priceQuote → fees.mjs), el FAQ, la barra CTA mobile, el movimiento (LandingMotion),
// la barra de lectura de stand-up (en rojo) y la lógica de la demo de anuncios (useAdsDemo). Montos y plazos: fees.mjs,
// legal.mjs y producerFaq.ts; cadencia de redes: DEFAULT_CADENCE (también en Facebook y TikTok, y el reel con el video
// del evento); los anuncios segmentan por intereses de Meta. Lo que no existe en el producto va con "Pronto".
// Fase 4 (contenido real) queda fuera del código: fotos reales con autorización (§8), testimonio (MUSIC_TESTIMONIAL,
// hoy null: la sección no se muestra), afiche real en el cartel y revisión de los nombres de ejemplo.
export const prerender = true;
import AppFooter from "../components/AppFooter.vue";
import LandingFaq from "../components/landing/LandingFaq.vue";
import LandingMobileBar from "../components/landing/LandingMobileBar.vue";
import CtaTracking from "../components/landing/CtaTracking.astro";
import LandingMotion from "../components/landing/LandingMotion.astro";
import MusicHeader from "../components/landing/musica/MusicHeader.vue";
import MusicHero from "../components/landing/musica/MusicHero.astro";
import MusicForWho from "../components/landing/musica/MusicForWho.astro";
import MusicCurveSection from "../components/landing/musica/MusicCurveSection.astro";
import MusicPresale from "../components/landing/musica/MusicPresale.astro";
import MusicLineup from "../components/landing/musica/MusicLineup.astro";
import TourDates from "../components/landing/musica/TourDates.astro";
import MusicDoor from "../components/landing/musica/MusicDoor.astro";
import MusicDiffusion from "../components/landing/musica/MusicDiffusion.astro";
import MusicPrice from "../components/landing/musica/MusicPrice.astro";
import PressQuote from "../components/landing/musica/PressQuote.astro";
import MusicClosing from "../components/landing/musica/MusicClosing.astro";
import MusicTracking from "../components/landing/musica/MusicTracking.astro";
import Layout from "../layouts/Layout.astro";
import { publishUrl } from "../components/landing/links.js";
import { getLanding } from "../data/landings";
import { MUSICA_FAQ } from "../data/musicaFaq";
import { IVA_PERCENT_LABEL, SERVICE_FEE_PERCENT_LABEL } from "../../netlify/lib/fees.mjs";
import antonWoff2 from "@fontsource/anton/files/anton-latin-400-normal.woff2?url";
import "../styles/global.css";
import "../styles/landing.css";
import "../styles/landing-musica.css";

const landing = getLanding("ticketera-musica-en-vivo");
if (!landing) throw new Error("Falta la landing ticketera-musica-en-vivo en src/data/landings.ts");
const demoHref = landing.demo?.url ?? "/eventos";
const demoLabel = landing.demo?.label ?? "Ver eventos";

const SITE_URL = (import.meta.env.SITE_URL || "https://aitickets.cl").replace(/\/$/, "");
const url = `${SITE_URL}/${landing.slug}`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "AI Tickets", item: SITE_URL },
      { "@type": "ListItem", position: 2, name: "Para organizadores", item: `${SITE_URL}/organizadores` },
      { "@type": "ListItem", position: 3, name: landing.card.title, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "AI Tickets para música en vivo",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url,
    description: landing.description,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "CLP",
      description: `Sin mensualidad y 0% de comisión para bandas, productoras y salas. El comprador paga un cargo por servicio de ${SERVICE_FEE_PERCENT_LABEL} + IVA (${IVA_PERCENT_LABEL}) sobre ese cargo, o lo absorbe quien organiza.`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: MUSICA_FAQ.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout title={landing.title} description={landing.description} canonical={`/${landing.slug}`}>
  <link slot="head-extra" rel="preload" as="font" type="font/woff2" href={antonWoff2} crossorigin />
  <LandingMotion />
  <div class="mu" data-theme="musica">
    <MusicHeader client:idle publishHref={publishUrl("musica_header")} />
    <main>
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      <MusicHero ctaLabel={landing.cta.label} demoHref={demoHref} demoLabel={demoLabel} />
      <MusicForWho />
      <MusicCurveSection />
      <MusicPresale />
      <MusicLineup />
      <TourDates />
      <MusicDoor />
      <MusicDiffusion />
      <MusicPrice />
      <PressQuote />

      <section class="mu-section faq" aria-labelledby="mu-faq-title" data-mu-section="faq">
        <div class="mu-wrap faq-inner" data-lp-reveal>
          <h2 id="mu-faq-title" class="mu-h2 faq-title" data-lp-step>Preguntas frecuentes</h2>
          <div class="faq-list" data-lp-step><LandingFaq client:visible items={MUSICA_FAQ} idPrefix="mu-faq" /></div>
        </div>
      </section>

      <MusicClosing ctaLabel={landing.cta.label} />
    </main>
    <AppFooter client:idle tone="dark" />
    <LandingMobileBar
      client:idle
      variant="pill"
      title="Gratis para publicar"
      subtitle="0% de comisión para ti"
      ctaLabel="Publicar fecha"
      publishHref={publishUrl("musica_mobile_bar")}
    />
  </div>
  <CtaTracking />
  <MusicTracking />
</Layout>

<script>
  // Loops decorativos (ecualizador M5, barra de la historia M13): corren solo mientras se ven ([data-mu-play] →
  // .is-playing). Con "reducir movimiento" no hay html.lp-motion y el CSS no los anima.
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.classList.toggle("is-playing", entry.isIntersecting);
    });
    document.querySelectorAll("[data-mu-play]").forEach((el) => io.observe(el));
  }
</script>

<style>
  .faq-inner {
    max-width: 960px;
  }
  .faq-title {
    margin-bottom: 20px;
  }
  /* §4.11: pregunta en Prompt 600 y signo "+" en rojo que rota 45° al abrir (el giro ya lo hace LandingFaq) */
  .faq-list :global(.lf-q) {
    font-weight: 600;
  }
  .faq-list :global(.lf-icon) {
    color: var(--mu-red);
  }
  @media (min-width: 1024px) {
    .faq-title {
      margin-bottom: 32px;
    }
  }
</style>
