---
// Página de una entrada individual (event_attendees.id, uuid). Muestra la dirección secreta solo si la
// entrada está vigente (active/validated/NULL) y su orden (si tiene) está pagada.
import { getSupabaseAdmin } from "../../lib/auth-helpers";
import { descriptionToHtml } from "../../lib/sanitize";
import Layout from "../../layouts/Layout.astro";
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import EventHeader from "../../components/EventHeader.vue";
import EventTabs from "../../components/EventTabs.vue";
import TicketInfo from "../../components/TicketInfo.vue";

import "../../styles/global.css";

export const prerender = false;

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const { id } = Astro.params;
const supabase = getSupabaseAdmin();

let ticket: Record<string, any> | undefined = undefined;
let event: Record<string, any> | undefined = undefined;
let errorMessage: string | null = null;
let voidMessage: string | null = null;

const toChileTime = (value: string | null) =>
  value
    ? new Date(value).toLocaleTimeString("es-CL", { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false, timeZone: "America/Santiago" })
    : null;

if (!id || !UUID_RE.test(id)) {
  errorMessage = "Entrada no encontrada";
} else {
  const { data: ticketData } = await supabase
    .from("event_attendees")
    .select("id, event_id, attendee_id, qr_code, status, event_order_id, event_tickets ( ticket_name, event_date_id )")
    .eq("id", id)
    .maybeSingle();

  if (!ticketData) {
    errorMessage = "Entrada no encontrada";
  } else {
    const { data: eventData } = await supabase
      .from("events")
      .select("id, name, title, slug, description, image_url, location, start_date, end_date")
      .eq("id", ticketData.event_id)
      .maybeSingle();

    const ticketType: any = Array.isArray(ticketData.event_tickets) ? ticketData.event_tickets[0] : ticketData.event_tickets;
    const { data: order } = ticketData.event_order_id
      ? await supabase
          .from("event_orders")
          .select("status, buyer_first_name, buyer_last_name, buyer_email")
          .eq("id", ticketData.event_order_id)
          .maybeSingle()
      : { data: null };

    if (eventData) {
      event = { ...eventData, description: descriptionToHtml(eventData.description) };
      const [{ data: eventDates }, { data: faqs }, { data: categories }] = await Promise.all([
        supabase
          .from("event_dates")
          .select("id, date, start_time, end_time, event_location_id, event_locations ( name, display_name, address_line1_override, city_override, venues ( name, address_line1, city ) )")
          .eq("event_id", eventData.id)
          .order("date", { ascending: true })
          .order("start_time", { ascending: true }),
        supabase.from("event_faqs").select("question, answer").eq("event_id", eventData.id),
        supabase.from("event_tags").select("category_tags(name)").eq("event_id", eventData.id),
      ]);
      const defaultDate = { date: eventData.start_date, start_time: toChileTime(eventData.start_date), end_time: toChileTime(eventData.end_date) };
      event.dates = eventDates?.length ? eventDates : eventData.start_date ? [defaultDate] : [];

      const liveTicket = ticketData.status == null || ticketData.status === "active" || ticketData.status === "validated";
      const paidOrder = !ticketData.event_order_id || order?.status === "paid";
      if (liveTicket && paidOrder) {
        const { data: secretRow } = await supabase.from("events").select("secret_location").eq("id", eventData.id).maybeSingle();
        if (secretRow?.secret_location) event.secret_location = secretRow.secret_location;
      }
      event.faqs = faqs || [];
      event.tags = (categories || []).map((c: any) => c.category_tags?.name).filter(Boolean);
      const loc: any = eventDates?.[0]?.event_locations;
      const venue = loc?.venues || {};
      event.address = [loc?.display_name || venue.name || (loc?.name && loc.name !== "Main" ? loc.name : null), loc?.address_line1_override || venue.address_line1, loc?.city_override || venue.city]
        .filter(Boolean)
        .join(", ") || eventData.location || "";
    }

    // R2: comprador de la orden; fallback al registro attendees (entradas antiguas)
    let attendee: any = order?.buyer_email
      ? { first_name: order.buyer_first_name, last_name: order.buyer_last_name, email: order.buyer_email }
      : null;
    if (!attendee) {
      const { data } = await supabase
        .from("attendees")
        .select("first_name, last_name, email")
        .eq("id", ticketData.attendee_id)
        .maybeSingle();
      attendee = data;
    }

    // R1: entrada de una función específica -> solo esa función
    const fnId = ticketType?.event_date_id;
    const fnDates = fnId != null ? (event?.dates || []).filter((d: any) => String(d.id) === String(fnId)) : [];
    ticket = {
      id: ticketData.id,
      event_name: event?.name || "Evento",
      event_dates: fnDates.length ? fnDates : event?.dates || [],
      ticket_name: ticketType?.ticket_name || "Entrada General",
      attendee_name: `${attendee?.first_name || ""} ${attendee?.last_name || ""}`.trim(),
      attendee_email: attendee?.email || "",
      // Entrada anulada (p. ej. orden reembolsada): no se muestra el QR
      qr_code: ticketData.status === "cancelled" ? null : ticketData.qr_code || null,
      status: ticketData.status,
    };
    if (ticketData.status === "cancelled") {
      voidMessage = order?.status === "refunded"
        ? "Esta entrada fue anulada porque la orden se reembolsó. Ya no sirve para ingresar al evento."
        : "Esta entrada fue anulada y ya no sirve para ingresar al evento.";
    } else if (order && order.status !== "paid" && order.status !== "processing") {
      voidMessage = "Esta entrada todavía no está confirmada: su orden no figura como pagada.";
    }
  }
}
---

<Layout title={event?.name ? `Tu entrada: ${event.name} | AI Tickets` : "Tu entrada | AI Tickets"} noindex>
  <AppHeader client:idle />
  <main class="flex flex-col items-center min-h-screen bg-gray-100">
    <div class="max-w-6xl mx-auto w-full">
      {errorMessage ? (
        <div class="mt-12 mx-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg">
          <h2 class="text-xl font-semibold font-[Unbounded] mb-2">Error</h2>
          <p>{errorMessage}</p>
        </div>
      ) : (
        <>
          {voidMessage && (
            <div class="mt-12 mx-4 lg:mx-0 bg-amber-50 border border-amber-300 text-amber-800 px-4 py-3 rounded-lg font-[Prompt]">
              {voidMessage}
            </div>
          )}
          <div class="mt-0 pt-8 lg:pt-12 px-4 lg:px-0">
            <TicketInfo ticket={ticket} event={event} client:only />
          </div>

          <div class="w-full mt-6 px-4 lg:px-0 mb-8">
            <details class="bg-white p-4 rounded-lg shadow-lg">
              <summary class="text-lg font-semibold cursor-pointer font-[Unbounded]">Detalles del Evento</summary>
              <div class="mt-4">
                <EventHeader event={event} client:idle />
                <EventTabs event={event} client:only />
              </div>
            </details>
          </div>
        </>
      )}
    </div>
  </main>
  <AppFooter client:idle />
</Layout>
