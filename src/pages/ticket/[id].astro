---
// Página de una entrada individual (event_attendees.id, uuid): el link "Ver QR" de cada entrada del correo, para
// pasársela a un acompañante. Muestra la dirección secreta solo si la entrada está vigente (active/validated/NULL)
// y su orden (si tiene) está pagada. El muro de asistentes se ve en modo lectura (publica quien tiene la orden).
// Titular: el asistente que se escribió al comprar (event_attendees.holder_name) o, si no, quien compró.
import { getSupabaseAdmin } from "../../lib/auth-helpers";
import { cdnImage } from "../../lib/imageCdn.js";
import { loadAttendeeEvent, functionsForTickets, upcomingFirst, calendarUrl, mapsUrl, secretLocationFor } from "../../lib/attendeePage";
import { orderKind, orderCopy } from "../../../netlify/lib/order-kind.mjs";
import { loadFeed } from "../../../netlify/lib/attendee-community.mjs";
import Layout from "../../layouts/Layout.astro";
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import TicketInfo from "../../components/TicketInfo.vue";
import AttendeeFeed from "../../components/buyer/AttendeeFeed.vue";

import "../../styles/global.css";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const { id } = Astro.params;
const supabase = getSupabaseAdmin();

let ticket: Record<string, any> | null = null;
let event: any = null;
let order: any = null;
let errorMessage: string | null = null;
let voidMessage: string | null = null;
let secretLocation = "";
let feed: any = null;
let functionId: number | null = null;

if (!id || !UUID_RE.test(id)) {
  errorMessage = "No encontramos esta entrada. Revisa que el link esté completo.";
} else {
  const selectTicket = (extra: string) =>
    supabase.from("event_attendees").select(`id, event_id, attendee_id, qr_code, status, event_order_id,${extra} event_tickets ( ticket_name, event_date_id )`).eq("id", id).maybeSingle();
  // holder_name / seat_number son opcionales (base sin migrar)
  let { data: ticketData, error: ticketError }: { data: any; error: any } = await selectTicket(" holder_name, seat_number,");
  if (ticketError) ({ data: ticketData } = await selectTicket(""));

  if (!ticketData) {
    errorMessage = "No encontramos esta entrada. Revisa que el link esté completo.";
  } else {
    const ticketType: any = Array.isArray(ticketData.event_tickets) ? ticketData.event_tickets[0] : ticketData.event_tickets;
    functionId = ticketType?.event_date_id ?? null;
    const [loadedEvent, orderResult] = await Promise.all([
      loadAttendeeEvent(supabase, ticketData.event_id),
      ticketData.event_order_id
        ? supabase
            .from("event_orders")
            .select("status, buyer_first_name, buyer_last_name, buyer_email, payment_provider, ticket_details, total_payment, amount")
            .eq("id", ticketData.event_order_id)
            .maybeSingle()
        : Promise.resolve({ data: null }),
    ]);
    event = loadedEvent;
    order = orderResult.data;

    const liveTicket = ticketData.status == null || ticketData.status === "active" || ticketData.status === "validated";
    const paidOrder = !ticketData.event_order_id || order?.status === "paid";
    if (event && liveTicket && paidOrder) {
      // Dirección privada: desde que se revela (si se revela horas antes, la página de la orden dice cuándo)
      secretLocation = (await secretLocationFor(supabase, event, [functionId])).address;
      try {
        feed = await loadFeed(supabase, event.id);
      } catch (err: any) {
        console.warn("ticket: muro no disponible:", err?.message || err);
      }
    }

    // R2: comprador de la orden; fallback al registro attendees (entradas antiguas)
    let attendee: any = order?.buyer_email ? { first_name: order.buyer_first_name, last_name: order.buyer_last_name } : null;
    if (!attendee) {
      const { data } = await supabase.from("attendees").select("first_name, last_name").eq("id", ticketData.attendee_id).maybeSingle();
      attendee = data;
    }

    ticket = {
      id: ticketData.id,
      ticket_name: `${ticketType?.ticket_name || "Entrada General"}${ticketData.seat_number ? ` · invitado ${ticketData.seat_number}` : ""}`,
      attendee_name: ticketData.holder_name || `${attendee?.first_name || ""} ${attendee?.last_name || ""}`.trim(),
      // Entrada anulada (p. ej. orden reembolsada): no se muestra el QR
      qr_code: ticketData.status === "cancelled" ? null : ticketData.qr_code || null,
      status: ticketData.status,
    };
    if (ticketData.status === "cancelled") {
      voidMessage = order?.status === "refunded"
        ? "Esta entrada fue anulada porque la orden se reembolsó. Ya no sirve para ingresar al evento."
        : "Esta entrada fue anulada y ya no sirve para ingresar al evento.";
    } else if (order && order.status !== "paid" && order.status !== "processing") {
      voidMessage = "Esta entrada todavía no está confirmada: su orden no figura como pagada.";
    }
  }
}

// Una entrada suelta puede ser de un acompañante: "Entrada válida" en vez de "Compra confirmada"
const kind = order ? orderKind(order) : "purchase";
const badge = kind === "rsvp" || kind === "courtesy" ? orderCopy(kind, 1).badge : "Entrada válida";
const functions = event ? upcomingFirst(functionsForTickets(event, [functionId])) : [];
const fn = functions[0];
const place = secretLocation || fn?.place || event?.location || "";
const now = Date.now();
const ended = functions.length > 0 && functions.every((f) => f.startIso && new Date(f.endIso || f.startIso).getTime() + (f.endIso ? 0 : 3 * 3600 * 1000) < now);
const valid = Boolean(ticket?.qr_code) && !voidMessage;
const calendarHref = event && valid && !ended ? calendarUrl(event.name, fn, place, `${Astro.url.origin}/ticket/${id}`) : null;
const mapsHref = valid ? mapsUrl(place) : null;
---

<Layout title={event?.name ? `Tu entrada: ${event.name} | AI Tickets` : "Tu entrada | AI Tickets"} noindex>
  <AppHeader client:idle />
  <main class="min-h-screen bg-gray-50 pt-20 pb-16 px-4 font-[Prompt]">
    <div class="max-w-md mx-auto space-y-4">
      {errorMessage || !event || !ticket ? (
        <div class="mt-8 rounded-2xl border border-gray-200 bg-white p-6 text-center">
          <p class="text-gray-800">{errorMessage || "Evento no encontrado"}</p>
          <a href="/mis-entradas" class="mt-4 inline-block text-sm font-semibold underline">Buscar mis entradas</a>
        </div>
      ) : (
        <>
          {voidMessage && (
            <div class="rounded-2xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">{voidMessage}</div>
          )}

          <section class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-4">
            {event.image_url && <img src={cdnImage(event.image_url, 480)} alt="" width="64" height="64" class="h-16 w-16 shrink-0 rounded-xl object-cover bg-gray-100" />}
            <div class="min-w-0">
              {valid && <span class="inline-block rounded-full bg-lime-300 px-2 py-0.5 text-[11px] font-semibold text-black">{badge}</span>}
              <h1 class="mt-1 font-bold font-[Unbounded] text-gray-900 leading-snug break-words">{event.name}</h1>
              {event.organizerName && <p class="text-xs text-gray-500">Organiza {event.organizerName}</p>}
            </div>
          </section>

          <div>
            <TicketInfo ticket={ticket} event={{ name: event.name, slug: event.slug }} functionLabel={fn?.label || ""} place={place} client:only="vue" />
          </div>

          {(calendarHref || mapsHref) && (
            <div class="flex flex-wrap justify-center gap-2">
              {calendarHref && <a href={calendarHref} target="_blank" rel="noopener" class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-800 hover:border-gray-900 transition">+ Calendario</a>}
              {mapsHref && <a href={mapsHref} target="_blank" rel="noopener" class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-800 hover:border-gray-900 transition">Cómo llegar</a>}
            </div>
          )}

          {feed && feed.total > 0 && <AttendeeFeed initialFeed={feed} ended={ended} client:visible />}

          {event.slug && (
            <p class="text-center">
              <a href={`/eventos/${encodeURIComponent(event.slug)}`} class="text-sm text-gray-500 underline hover:text-gray-900">Ver la página del evento</a>
            </p>
          )}
        </>
      )}
    </div>
  </main>
  <AppFooter client:idle />
</Layout>
