---
// Landing especializada para talleres y cursos cortos (docs/specs/rediseno/SPEC_landing_talleres_aitickets.md, fases 1
// a 3): talleristas independientes y espacios que programan talleres. Misma URL que la landing SEO anterior
// (src/data/landings.ts la marca dedicated: [landing].astro ya no la genera, y la tarjeta, el sitemap, las relacionadas
// y "Según lo que produces" de /organizadores siguen leyendo de ahí; el footer ya la enlaza en "Para quién"). Tema propio
// "cuaderno de taller" ([data-theme="talleres"], src/styles/landing-talleres.css) sin tocar los tokens globales ni
// repetir el lenguaje de stand-up, academias, música o teatro: papel con cuadrícula azul, fichas, destacador amarillo,
// notas en lápiz pasta (Caveat), fotos impresas con clip, botones de cartón y una pizarra para el día del taller.
// La página se ordena como separadores de un cuaderno: Pendientes → Tu taller → Antes → El día → Difusión → Después →
// Precio → Espacios → (testimonio) → Preguntas → Cierre.
// Reutiliza la fórmula de precios (priceQuote → fees.mjs), los rótulos de la página del evento (cardLabel / cardState /
// checkoutFunctions de eventView.js), el FAQ, la barra CTA mobile, el movimiento (LandingMotion) y la barra de lectura
// (en azul). Montos y plazos: fees.mjs, legal.mjs y producerFaq.ts; el de un curso vendido con una sola entrada sigue a
// ledger.ts (se libera con la última sesión). Lo que no existe en el producto (preguntas al inscribirse, pasar lista por
// sesión, ver la lista de espera, repetir fechas en un paso, reseñas mientras quedan fechas, Facebook/TikTok/reels) va
// con "Pronto".
// Fase 4 (contenido real) queda fuera del código: fotos reales con autorización (§8), testimonio (WORKSHOP_TESTIMONIAL,
// hoy null: la sección no se muestra), un taller de ejemplo real (Preguntas abiertas 9) y revisión de los nombres.
export const prerender = true;
import AppFooter from "../components/AppFooter.vue";
import LandingFaq from "../components/landing/LandingFaq.vue";
import LandingMobileBar from "../components/landing/LandingMobileBar.vue";
import CtaTracking from "../components/landing/CtaTracking.astro";
import LandingMotion from "../components/landing/LandingMotion.astro";
import WorkshopHeader from "../components/landing/talleres/WorkshopHeader.vue";
import WorkshopHero from "../components/landing/talleres/WorkshopHero.astro";
import PendingList from "../components/landing/talleres/PendingList.astro";
import WorkshopBuild from "../components/landing/talleres/WorkshopBuild.astro";
import BeforeWorkshop from "../components/landing/talleres/BeforeWorkshop.astro";
import WorkshopDay from "../components/landing/talleres/WorkshopDay.astro";
import WorkshopDiffusion from "../components/landing/talleres/WorkshopDiffusion.astro";
import WorkshopAfter from "../components/landing/talleres/WorkshopAfter.astro";
import WorkshopPrice from "../components/landing/talleres/WorkshopPrice.astro";
import SpaceSchedule from "../components/landing/talleres/SpaceSchedule.astro";
import WorkshopQuote from "../components/landing/talleres/WorkshopQuote.astro";
import WorkshopClosing from "../components/landing/talleres/WorkshopClosing.astro";
import WorkshopTracking from "../components/landing/talleres/WorkshopTracking.astro";
import SectionTab from "../components/landing/talleres/SectionTab.astro";
import Layout from "../layouts/Layout.astro";
import { publishUrl } from "../components/landing/links.js";
import { getLanding } from "../data/landings";
import { TALLERES_FAQ } from "../data/talleresFaq";
import { IVA_PERCENT_LABEL, SERVICE_FEE_PERCENT_LABEL } from "../../netlify/lib/fees.mjs";
import bricolageWoff2 from "@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-800-normal.woff2?url";
import caveatWoff2 from "@fontsource/caveat/files/caveat-latin-600-normal.woff2?url";
import "../styles/global.css";
import "../styles/landing.css";
import "../styles/landing-talleres.css";

const landing = getLanding("ticketera-talleres");
if (!landing) throw new Error("Falta la landing ticketera-talleres en src/data/landings.ts");
const demoHref = landing.demo?.url ?? "/eventos";
const demoLabel = landing.demo?.label ?? "Ver eventos";

// Caveat (notas al margen): sin precarga y con font-display: optional (§7). Si no llega a tiempo, las notas quedan en
// Prompt sin mover el layout (tienen ancho fijo). Se declara aquí y no con la hoja de fontsource, que usa swap.
const caveatFace = `@font-face{font-family:"Caveat";font-style:normal;font-weight:600;font-display:optional;src:url(${caveatWoff2}) format("woff2");}`;

const SITE_URL = (import.meta.env.SITE_URL || "https://aitickets.cl").replace(/\/$/, "");
const url = `${SITE_URL}/${landing.slug}`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "AI Tickets", item: SITE_URL },
      { "@type": "ListItem", position: 2, name: "Para organizadores", item: `${SITE_URL}/organizadores` },
      { "@type": "ListItem", position: 3, name: landing.card.title, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "AI Tickets para talleres",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url,
    description: landing.description,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "CLP",
      description: `Gratis para talleres gratuitos. Si cobras, 0% de comisión para quien dicta el taller: quien se inscribe paga un cargo por servicio de ${SERVICE_FEE_PERCENT_LABEL} + IVA (${IVA_PERCENT_LABEL}) sobre ese cargo, o lo absorbe el taller.`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: TALLERES_FAQ.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout title={landing.title} description={landing.description} canonical={`/${landing.slug}`}>
  <link slot="head-extra" rel="preload" as="font" type="font/woff2" href={bricolageWoff2} crossorigin />
  <style slot="head-extra" is:inline set:html={caveatFace} />
  <LandingMotion />
  <div class="tl" data-theme="talleres">
    <WorkshopHeader client:idle publishHref={publishUrl("talleres_header")} ctaLabel={landing.cta.label} />
    <main>
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      <WorkshopHero lead={landing.intro} ctaLabel={landing.cta.label} demoHref={demoHref} demoLabel={demoLabel} />
      <PendingList />
      <WorkshopBuild />
      <BeforeWorkshop />
      <WorkshopDay />
      <WorkshopDiffusion />
      <WorkshopAfter />
      <WorkshopPrice />
      <SpaceSchedule />
      <WorkshopQuote />

      <section class="tl-section tl-faq" aria-labelledby="tl-faq-title" data-tl-section="faq">
        <SectionTab text="Preguntas" />
        <div class="tl-wrap faq-inner" data-lp-reveal>
          <p class="tl-eyebrow" data-lp-step>Preguntas</p>
          <h2 id="tl-faq-title" class="tl-h2 faq-title" data-lp-step>Preguntas frecuentes</h2>
          <div class="faq-list" data-lp-step><LandingFaq client:visible items={TALLERES_FAQ} idPrefix="tl-faq" /></div>
        </div>
      </section>

      <WorkshopClosing ctaLabel={landing.cta.label} />
    </main>
    <AppFooter client:idle tone="paper" />
    <LandingMobileBar
      client:idle
      variant="pill"
      title="Gratis si tu taller es gratis"
      subtitle="0% de comisión si cobras"
      ctaLabel={landing.cta.label}
      publishHref={publishUrl("talleres_mobile_bar")}
    />
  </div>
  <CtaTracking />
  <WorkshopTracking />
</Layout>

<script>
  // Loops decorativos (barra de la historia TL14): corren solo mientras se ven ([data-tl-play] → .is-playing). Con
  // "reducir movimiento" no hay html.lp-motion y el CSS no los anima.
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.classList.toggle("is-playing", entry.isIntersecting);
    });
    document.querySelectorAll("[data-tl-play]").forEach((el) => io.observe(el));
  }
</script>

<style>
  .faq-inner {
    max-width: 880px;
  }
  .faq-title {
    margin: 14px 0 24px;
  }
  /* §4.11: pregunta en Bricolage 700 de 20 px, cada ítem como renglón de cuaderno y el "+" en azul (el giro de 45° ya
     lo hace LandingFaq) */
  .faq-list :global(.lf-q) {
    font-family: var(--tl-display);
    font-size: 20px;
    line-height: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .faq-list :global(.lf-icon) {
    color: var(--tl-tinta);
  }
  .faq-list :global(.lf-item) {
    border-color: var(--tl-line);
  }
  @media (min-width: 1024px) {
    .faq-title {
      margin-bottom: 40px;
    }
  }
</style>
