---
// Landing para productores (docs/specs/rediseno/SPEC_landing_productores_aitickets.md, fases A, B y C). Diez secciones con
// solo dos fondos oscuros; el precio, la calculadora y los demás montos salen de fees.mjs/legal.mjs y las respuestas de
// dinero de PRODUCER_FAQ. Lo que enlazaba el hub anterior sigue enlazado: las cuatro guías desde los links de las
// secciones (Cómo funciona: vender online; Quién vende tus entradas: medir por promotor y preventa; La puerta: check-in
// con QR), las landings por tipo de evento desde la fila de "Todo lo demás" y el footer, y las de funcionalidad, la
// web gratis y la comparativa desde el footer.
// La portada (/) sigue con su diseño y su H1 por ahora (pendiente anotado en el PR). Sin ProducerSessionBanner: con
// sesión, el header ya cambia a "Ir a mi panel" y el aviso flotante tapaba la barra CTA mobile (§6).
// Movimiento (§8): LandingMotion va primero en el <body> para marcar html.lp-motion antes de pintar; las secciones
// marcan con data-lp-reveal / data-lp-step lo que entra al hacer scroll. ev-motion reduce a 1 ms cualquier transición
// o animación con "reducir movimiento".
export const prerender = true;
import AppFooter from "../../components/AppFooter.vue";
import LandingHeader from "../../components/landing/LandingHeader.vue";
import LandingMobileBar from "../../components/landing/LandingMobileBar.vue";
import LandingFaq from "../../components/landing/LandingFaq.vue";
import VideoModal from "../../components/landing/VideoModal.vue";
import CtaTracking from "../../components/landing/CtaTracking.astro";
import ProducerTracking from "../../components/landing/organizadores/ProducerTracking.astro";
import LandingMotion from "../../components/landing/LandingMotion.astro";
import HeroSection from "../../components/landing/organizadores/HeroSection.astro";
import HowSection from "../../components/landing/organizadores/HowSection.astro";
import PricingSection from "../../components/landing/organizadores/PricingSection.astro";
import PromotersSection from "../../components/landing/organizadores/PromotersSection.astro";
import MarketingSection from "../../components/landing/organizadores/MarketingSection.astro";
import DoorSection from "../../components/landing/organizadores/DoorSection.astro";
import CommunitySection from "../../components/landing/organizadores/CommunitySection.astro";
import ExtrasSection from "../../components/landing/organizadores/ExtrasSection.astro";
import AiSection from "../../components/landing/organizadores/AiSection.astro";
import ClosingSection from "../../components/landing/organizadores/ClosingSection.astro";
import Layout from "../../layouts/Layout.astro";
import { publishUrl } from "../../components/landing/links.js";
import { LANDING_MEDIA } from "../../components/landing/producerLanding.js";
import { ORGANIZADORES_FAQ } from "../../data/organizadoresFaq";
import { LEGAL } from "../../lib/legal";
import { IVA_PERCENT_LABEL, SERVICE_FEE_PERCENT_LABEL } from "../../../netlify/lib/fees.mjs";
import "../../styles/global.css";
import "../../styles/landing.css";

const SITE_URL = (import.meta.env.SITE_URL || "https://aitickets.cl").replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: LEGAL.brand,
    url: SITE_URL,
    logo: `${SITE_URL}/apple-touch-icon.png`,
    email: LEGAL.supportEmail,
    areaServed: "CL",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "AI Tickets para productores",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: `${SITE_URL}/organizadores`,
    description:
      "Ticketera online para productores de eventos en Chile: varias funciones por evento, links de venta por promotor, difusión automática en Instagram, check-in con QR y pago por función.",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "CLP",
      description: `Sin mensualidad y 0% de comisión para el productor. El comprador paga un cargo por servicio de ${SERVICE_FEE_PERCENT_LABEL} + IVA (${IVA_PERCENT_LABEL}) sobre ese cargo, o lo absorbe el productor.`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: ORGANIZADORES_FAQ.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout
  title="AI Tickets para productores: vende entradas con 0% de comisión | Chile"
  description={`Ticketera para productores de eventos en Chile: publica tus funciones, vende entradas con 0% de comisión para ti, mide qué promotor vende y valida con QR. Sin mensualidad.`}
  canonical="/organizadores"
>
  <LandingMotion />
  <LandingHeader client:idle publishHref={publishUrl("organizadores_header")} />
  <main class="lp ev-motion">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <HeroSection />
    <HowSection />
    <PricingSection />
    <PromotersSection />
    <MarketingSection />
    <DoorSection />
    <CommunitySection />
    <ExtrasSection />
    <AiSection />
    <section class="lp-section faq" aria-labelledby="faq-title" data-lp-section="faq">
      <div class="lp-wrap faq-wrap" data-lp-reveal>
        <h2 id="faq-title" class="lp-h2 faq-title" data-lp-step>Preguntas frecuentes</h2>
        <div data-lp-step><LandingFaq client:visible items={ORGANIZADORES_FAQ} idPrefix="org-faq" /></div>
      </div>
    </section>
    <ClosingSection />
  </main>
  <AppFooter client:idle />
  <VideoModal
    client:load
    src={LANDING_MEDIA.demoVideo}
    webmSrc={LANDING_MEDIA.demoVideoWebm}
    poster={LANDING_MEDIA.demoPoster}
    captions={LANDING_MEDIA.demoCaptions}
    title="Video: así vendes tu próxima función"
    progressEvent="lp_video_progress"
  />
  <LandingMobileBar client:idle publishHref={publishUrl("organizadores_mobile_bar")} />
  <CtaTracking />
  <ProducerTracking />
</Layout>

<style>
  .faq {
    padding-top: 0;
  }
  .faq-wrap {
    max-width: 760px;
  }
  .faq-title {
    margin-bottom: 16px;
  }
  @media (min-width: 1024px) {
    .faq-title {
      margin-bottom: 24px;
    }
  }
</style>
