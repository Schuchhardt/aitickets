---
export const prerender = true;
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import ProducersHeroSection from "../../components/ProducersHeroSection.vue";
import ProducersFeaturesSection from "../../components/ProducersFeaturesSection.vue";
import BenefitsSection from "../../components/BenefitsSection.vue";
import ContactSection from "../../components/ContactSection.vue";
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import "animate.css";
---

<Layout
  title="Para organizadores – Vende entradas con 0% de comisión | AI Tickets"
  description="Publica tu evento en minutos y vende entradas online en Chile. 0% de comisión para el productor, pagos con Webpay y tarjetas, web de eventos gratis, QR y check-in desde el celular."
  canonical="/organizadores"
>
  <AppHeader client:idle />

  <main>
    <ProducersHeroSection client:idle />
    <ProducersFeaturesSection />
    <BenefitsSection />
    <ContactSection />
  </main>
  <AppFooter client:idle />
</Layout>
