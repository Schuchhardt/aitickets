---
import Layout from "../../layouts/Layout.astro";
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import ProducerRegisterForm from "../../components/auth/ProducerRegisterForm.vue";
import GradientBackground from "../../components/Hero/GradientBackground.vue";
import { isGoogleAuthEnabled } from "../../lib/google-auth";
import { getSessionContext } from "../../lib/supabaseServer";
import { safeNextPath } from "../../lib/onboarding";
import "../../styles/global.css";

export const prerender = false;

// Ya tiene cuenta y sesión: al panel en vez de registrarse de nuevo
if (await getSessionContext(Astro)) {
	const queryNext = safeNextPath(Astro.url.searchParams.get("next"));
	if (queryNext) return Astro.redirect(queryNext);
	// Los enlaces internos mandan ?next en el fragmento (#next=…, signupUrl en src/components/landing/links.js) y el
	// servidor no lo ve: lo resuelve el navegador con la misma regla que safeNextPath (src/lib/onboarding.ts).
	return new Response(
		`<!doctype html><html lang="es-CL"><head><meta charset="utf-8"><meta name="robots" content="noindex"><title>AI Tickets</title>` +
			`<noscript><meta http-equiv="refresh" content="0;url=/dashboard"></noscript>` +
			`<script>(function(){var n="";try{n=new URLSearchParams(location.hash.slice(1)).get("next")||""}catch(e){}` +
			`var ok=n.length<=2000&&/^\\/(dashboard(\\/|\\?|$)|validador(\\/|\\?|$)|oauth\\/)/.test(n)&&n.indexOf("//")!==0&&n.indexOf("\\\\")<0&&!/[\\r\\n]/.test(n);` +
			`location.replace(ok?n:"/dashboard")})()</script></head><body><a href="/dashboard">Ir a mi panel</a></body></html>`,
		{ headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "private, no-store", "X-Robots-Tag": "noindex" } }
	);
}

const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY;
const googleEnabled = isGoogleAuthEnabled();

// Registro desde un enlace de lead (?lead=<token>): el token no debe filtrarse por Referer a terceros
// (Turnstile, analítica) ni indexarse.
const hasLead = Astro.url.searchParams.has("lead");
if (hasLead) {
  Astro.response.headers.set("Referrer-Policy", "same-origin");
  Astro.response.headers.set("Cache-Control", "private, no-store");
}
---

<Layout
  title="Crea tu cuenta de productor | AI Tickets"
  description="Registra tu productora gratis y vende entradas para tus eventos en Chile con 0% de comisión para el productor. Incluye tu web de eventos gratis, pagos, QR y check-in."
  canonical="/organizadores/registro"
  noindex={hasLead}
>
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
  <AppHeader client:idle />

  <main
    class="relative min-h-screen flex items-center justify-center py-20 px-4 overflow-hidden"
  >
    <GradientBackground variant="soft" client:idle />
    <div class="relative z-10 w-full">
      <ProducerRegisterForm client:load turnstileSiteKey={turnstileSiteKey} googleEnabled={googleEnabled} />
    </div>
  </main>

  <AppFooter client:idle />
</Layout>
