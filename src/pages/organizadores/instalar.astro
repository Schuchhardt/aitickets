---
import Layout from "../../layouts/Layout.astro";
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import "../../styles/global.css";

export const prerender = false;
---

<Layout
  title="Instala AI Tickets en tu teléfono"
  description="Instala la app de AI Tickets para gestionar tus eventos, entradas y pagos desde tu teléfono."
  canonical="/organizadores/instalar"
  noindex={true}
>
  <Fragment slot="head-extra">
    <link rel="manifest" href="/producer.webmanifest" />
  </Fragment>

  <AppHeader client:idle />

  <main class="min-h-screen bg-gray-950 text-white font-[Prompt]">
    <div class="max-w-lg mx-auto px-4 py-20 flex flex-col items-center text-center">
      <img src="/android-chrome-192x192.png" alt="AI Tickets" class="w-20 h-20 rounded-2xl shadow-lg mb-8" />

      <h1 class="text-3xl font-bold tracking-tight mb-3">Instala AI Tickets en tu teléfono</h1>
      <p class="text-gray-400 text-lg mb-10">Gestiona tus eventos desde cualquier lugar</p>

      <!-- Already installed -->
      <div id="already-installed" class="hidden w-full">
        <div class="rounded-xl bg-lime-500/10 border border-lime-500/20 p-5 mb-6">
          <p class="text-lime-400 font-semibold mb-2">Ya tienes la app instalada</p>
          <a href="/dashboard" class="inline-flex items-center gap-2 text-lime-400 hover:text-lime-300 text-sm underline underline-offset-2">
            Ir a mi panel &rarr;
          </a>
        </div>
      </div>

      <!-- Install prompt (non-iOS) -->
      <div id="install-section" class="hidden w-full">
        <ul class="text-left space-y-3 mb-8 text-gray-300 text-sm">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 w-6 h-6 rounded-full bg-lime-500/20 text-lime-400 flex items-center justify-center text-xs font-bold shrink-0">1</span>
            <span>Acceso rápido desde tu pantalla de inicio</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 w-6 h-6 rounded-full bg-lime-500/20 text-lime-400 flex items-center justify-center text-xs font-bold shrink-0">2</span>
            <span>Notificaciones de ventas y mensajes al instante</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 w-6 h-6 rounded-full bg-lime-500/20 text-lime-400 flex items-center justify-center text-xs font-bold shrink-0">3</span>
            <span>Gestiona eventos, entradas y pagos desde cualquier lugar</span>
          </li>
        </ul>

        <button
          id="install-btn"
          class="w-full bg-lime-500 text-gray-900 font-bold text-lg py-3 px-6 rounded-xl hover:bg-lime-400 transition-colors"
        >
          Instalar AI Tickets
        </button>
      </div>

      <!-- iOS instructions -->
      <div id="ios-section" class="hidden w-full">
        <p class="text-gray-400 text-sm mb-6">En iOS, instala la app desde Safari:</p>
        <ol class="text-left space-y-4 mb-8 text-gray-300 text-sm">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 w-6 h-6 rounded-full bg-lime-500/20 text-lime-400 flex items-center justify-center text-xs font-bold shrink-0">1</span>
            <span>Toca el ícono de <strong class="text-white">compartir</strong>
              <svg class="inline w-4 h-4 text-lime-400 mx-0.5 -mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
              en la barra de Safari
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 w-6 h-6 rounded-full bg-lime-500/20 text-lime-400 flex items-center justify-center text-xs font-bold shrink-0">2</span>
            <span>Desplázate y toca <strong class="text-white">"Agregar a pantalla de inicio"</strong></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 w-6 h-6 rounded-full bg-lime-500/20 text-lime-400 flex items-center justify-center text-xs font-bold shrink-0">3</span>
            <span>Confirma tocando <strong class="text-white">"Agregar"</strong></span>
          </li>
        </ol>
      </div>

      <!-- Fallback: not installable -->
      <div id="fallback-section" class="hidden w-full">
        <p class="text-gray-400 text-sm mb-4">
          Abre esta página desde Chrome (Android) o Safari (iOS) para instalar la app.
        </p>
        <a
          href="/dashboard"
          class="inline-flex items-center gap-2 text-lime-400 hover:text-lime-300 text-sm underline underline-offset-2"
        >
          Ir al panel web &rarr;
        </a>
      </div>
    </div>
  </main>

  <AppFooter client:idle />
</Layout>

<script is:inline>
(function () {
  var isStandalone = window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true
  if (isStandalone) {
    window.location.replace('/dashboard')
    return
  }

  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/producer-sw.js', { scope: '/' }).catch(function () {})
  }

  var isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream
  var alreadyEl = document.getElementById('already-installed')
  var installEl = document.getElementById('install-section')
  var iosEl = document.getElementById('ios-section')
  var fallbackEl = document.getElementById('fallback-section')
  var installBtn = document.getElementById('install-btn')
  var deferredPrompt = null

  if (isStandalone) {
    alreadyEl.classList.remove('hidden')
    return
  }

  if (isIos) {
    iosEl.classList.remove('hidden')
    return
  }

  window.addEventListener('beforeinstallprompt', function (e) {
    e.preventDefault()
    deferredPrompt = e
    installEl.classList.remove('hidden')
    if (fallbackEl) fallbackEl.classList.add('hidden')
  })

  installBtn.addEventListener('click', function () {
    if (!deferredPrompt) return
    deferredPrompt.prompt()
    deferredPrompt.userChoice.then(function (result) {
      if (result.outcome === 'accepted') {
        installBtn.textContent = 'Instalada'
        installBtn.disabled = true
      }
      deferredPrompt = null
    })
  })

  setTimeout(function () {
    if (!deferredPrompt && !isIos) {
      fallbackEl.classList.remove('hidden')
    }
  }, 3000)
})()
</script>
