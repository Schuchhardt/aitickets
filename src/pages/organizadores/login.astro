---
import Layout from "../../layouts/Layout.astro";
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import ProducerLoginForm from "../../components/auth/ProducerLoginForm.vue";
import GradientBackground from "../../components/Hero/GradientBackground.vue";
import { isGoogleAuthEnabled } from "../../lib/google-auth";
import { getSessionContext } from "../../lib/supabaseServer";
import { safeNextPath } from "../../lib/onboarding";
import "../../styles/global.css";

export const prerender = false;

// Con la sesión iniciada no se pide la contraseña de nuevo: directo al panel (o al ?next= interno)
if (await getSessionContext(Astro)) return Astro.redirect(safeNextPath(Astro.url.searchParams.get("next")) || "/dashboard");
---

<Layout
  title="Iniciar sesión | AI Tickets para productores"
  description="Ingresa a tu panel de AI Tickets para gestionar tus eventos, entradas, check-in y pagos."
  noindex={true}
>
  <AppHeader client:idle />

  <main
    class="relative min-h-screen flex items-center justify-center py-20 px-4 overflow-hidden"
  >
    <GradientBackground variant="soft" client:idle />
    <div class="relative z-10 w-full">
      <ProducerLoginForm client:load googleEnabled={isGoogleAuthEnabled()} />
    </div>
  </main>

  <AppFooter client:idle />
</Layout>
