---
// Aceptar una invitación al equipo de una productora (link del correo de invite_member). El token es de un
// solo uso y vence en 7 días; aquí solo se muestra a qué organización y con qué rol. El formulario llama a
// POST /api/team/accept-invitation, que crea o reactiva la cuenta y deja la sesión iniciada.
import Layout from "../../layouts/Layout.astro";
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import GradientBackground from "../../components/Hero/GradientBackground.vue";
import { getSupabaseAdmin } from "../../lib/auth-helpers";
import { loadInvitationByToken, invitationStatus, roleLabel, roleDescription } from "../../lib/team-invitations";
import "../../styles/global.css";

export const prerender = false;

const token = String(Astro.params.token || "");
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const supabase = getSupabaseAdmin();
const invitation = await loadInvitationByToken(supabase, token);
const status = invitation ? invitationStatus(invitation) : "not_found";

let orgName = "";
let hasAccount = false;
if (invitation && status === "pending") {
    const { data: org } = await supabase.from("organizations").select("public_name").eq("id", invitation.organization_id).maybeSingle();
    orgName = org?.public_name || "";
    const { data: user } = await supabase
        .from("users")
        .select("id, auth_user_id")
        .ilike("email", String(invitation.email).replace(/[\\%_]/g, (c: string) => `\\${c}`))
        .maybeSingle();
    hasAccount = Boolean(user?.auth_user_id);
}

const STATUS_MESSAGES: Record<string, string> = {
    not_found: "Este link de invitación no es válido. Revisa que esté completo o pide uno nuevo.",
    accepted: "Esta invitación ya fue usada. Ingresa con tu cuenta.",
    revoked: "Esta invitación fue anulada. Pide una nueva a quien te invitó.",
    expired: "Esta invitación venció. Pide una nueva a quien te invitó.",
};
---

<Layout title="Invitación al equipo | AI Tickets" description="Únete al equipo de una productora en AI Tickets." noindex={true}>
    <AppHeader client:idle />
    <main class="relative min-h-screen flex items-center justify-center py-20 px-4 overflow-hidden">
        <GradientBackground variant="soft" client:idle />
        <div class="relative z-10 w-full">
            <div class="w-full max-w-md mx-auto bg-white/10 backdrop-blur-xl p-8 rounded-xl shadow-2xl border border-white/20 text-white">
                {status !== "pending" ? (
                    <>
                        <h1 class="text-2xl font-bold mb-4 text-center font-[Unbounded]">Invitación</h1>
                        <p class="text-white/80 text-center mb-6" data-testid="invitation-status">{STATUS_MESSAGES[status]}</p>
                        <a href="/organizadores/login" class="block w-full text-center bg-white text-gray-900 font-medium py-3 rounded-lg hover:bg-white/90 transition">Ir a iniciar sesión</a>
                    </>
                ) : (
                    <>
                        <h1 class="text-2xl font-bold mb-2 text-center font-[Unbounded]">Únete a {orgName || "el equipo"}</h1>
                        <p class="text-white/70 text-center text-sm mb-6">
                            Te invitaron con el rol <strong class="text-white">{roleLabel(invitation.role)}</strong>.
                        </p>
                        <p class="text-xs text-white/60 mb-6 text-center">{roleDescription(invitation.role)}</p>
                        <form id="accept-form" class="space-y-4" data-token={token}>
                            <div>
                                <label class="block text-sm font-medium text-white/80 mb-1">Email</label>
                                <input type="email" value={invitation.email} disabled class="w-full px-4 py-2 border border-white/20 bg-white/5 text-white/70 rounded-lg" />
                            </div>
                            {!hasAccount && (
                                <div>
                                    <label for="name" class="block text-sm font-medium text-white/80 mb-1">Tu nombre</label>
                                    <input id="name" name="name" type="text" maxlength="150" required value={invitation.name || ""} class="w-full px-4 py-2 border border-white/20 bg-white/10 text-white placeholder-white/40 rounded-lg focus:ring-2 focus:ring-white/50 focus:border-transparent outline-none transition" />
                                </div>
                            )}
                            <div>
                                <label for="password" class="block text-sm font-medium text-white/80 mb-1">{hasAccount ? "Tu contraseña de AI Tickets" : "Crea una contraseña"}</label>
                                <input id="password" name="password" type="password" minlength={hasAccount ? 1 : 8} maxlength="72" required autocomplete={hasAccount ? "current-password" : "new-password"} class="w-full px-4 py-2 border border-white/20 bg-white/10 text-white placeholder-white/40 rounded-lg focus:ring-2 focus:ring-white/50 focus:border-transparent outline-none transition" />
                                <p class="text-[11px] text-white/50 mt-1">
                                    {hasAccount
                                        ? <>Ya tienes una cuenta con este correo. ¿La olvidaste? <a href="/organizadores/recuperar" class="underline">Recupérala</a>.</>
                                        : "Mínimo 8 caracteres. Si este correo ya tiene una cuenta en AI Tickets, usa esa contraseña."}
                                </p>
                            </div>
                            <div id="accept-error" class="hidden p-3 bg-red-500/20 text-red-200 text-sm rounded-lg border border-red-400/30"></div>
                            <button type="submit" id="accept-submit" class="w-full bg-white text-gray-900 font-medium py-3 rounded-lg hover:bg-white/90 transition active:scale-[0.98] disabled:opacity-70">
                                Aceptar invitación
                            </button>
                            <p class="text-[11px] text-white/50 text-center">Al continuar aceptas los <a href="/terminos-productores" target="_blank" rel="noopener" class="underline">Términos para productores</a>.</p>
                        </form>
                    </>
                )}
            </div>
        </div>
    </main>
    <AppFooter client:idle />
</Layout>

<script>
    const form = document.getElementById("accept-form") as HTMLFormElement | null;
    const errorBox = document.getElementById("accept-error");
    const submit = document.getElementById("accept-submit") as HTMLButtonElement | null;
    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!submit || !errorBox) return;
        submit.disabled = true;
        errorBox.classList.add("hidden");
        const data = new FormData(form);
        try {
            const res = await fetch("/api/team/accept-invitation", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ token: form.dataset.token, name: data.get("name") || undefined, password: data.get("password") }),
            });
            const body = await res.json().catch(() => ({}));
            if (res.ok && body.redirectTo) {
                window.location.href = body.redirectTo;
                return;
            }
            errorBox.textContent = body.message || "No pudimos completar la invitación.";
        } catch {
            errorBox.textContent = "Sin conexión. Intenta de nuevo.";
        }
        errorBox.classList.remove("hidden");
        submit.disabled = false;
    });
</script>
