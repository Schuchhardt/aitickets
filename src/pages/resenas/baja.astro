---
// Confirmación de baja de los recordatorios para calificar un evento. El GET nunca da de baja (los escáneres de
// enlaces hacen GET): muestra un botón que hace POST a /api/resenas/baja.
import Layout from "../../layouts/Layout.astro";
import { LEGAL } from "../../lib/legal";
import { getSupabaseAdmin } from "../../lib/auth-helpers";
import { verifyReviewReminderOptoutToken } from "../../../netlify/lib/review-token.mjs";
import "../../styles/global.css";

export const prerender = false;

const t = Astro.url.searchParams.get("t") || "";
const done = Astro.url.searchParams.get("listo") === "1";
const failed = Astro.url.searchParams.get("error") === "1";
Astro.response.headers.set("Cache-Control", "no-store");

const payload = t ? verifyReviewReminderOptoutToken(t) : null;
let eventName = "este evento";
if (payload) {
  const { data } = await getSupabaseAdmin().from("events").select("name").eq("id", payload.eventId).maybeSingle();
  if (data?.name) eventName = data.name;
}
---

<Layout title="Dejar de recibir recordatorios | AI Tickets" description="Deja de recibir recordatorios para calificar un evento." noindex>
  <main class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-16">
    <div class="w-full max-w-md bg-white border border-gray-200 rounded-2xl p-8 text-center shadow-sm">
      <a href="/" class="inline-block mb-6 text-lg font-bold text-gray-900">AI Tickets</a>
      {done ? (
        <>
          <h1 class="text-2xl font-bold text-gray-900 mb-3">Listo, no te escribiremos más</h1>
          <p class="text-gray-600">No recibirás más recordatorios para calificar este evento. Si cambias de opinión, puedes calificarlo y subir tus fotos desde su página.</p>
        </>
      ) : failed || (t && !payload) ? (
        <>
          <h1 class="text-2xl font-bold text-gray-900 mb-3">No pudimos procesar la baja</h1>
          <p class="text-gray-600">El enlace no es válido. Responde al correo que recibiste, o escríbenos a <a class="underline" href={`mailto:${LEGAL.supportEmail}`}>{LEGAL.supportEmail}</a>, y dejaremos de escribirte de inmediato.</p>
        </>
      ) : t ? (
        <>
          <h1 class="text-2xl font-bold text-gray-900 mb-3">¿Dejar de recibir recordatorios de {eventName}?</h1>
          <p class="text-gray-600 mb-6">No te escribiremos más para pedirte que califiques este evento o subas tus fotos. Tus entradas y los avisos de otros eventos no cambian.</p>
          <form method="post" action="/api/resenas/baja">
            <input type="hidden" name="t" value={t} />
            <input type="hidden" name="from" value="page" />
            <button type="submit" data-testid="resenas-baja-confirm" class="w-full rounded-xl bg-gray-900 px-6 py-3 font-semibold text-white hover:bg-gray-700">
              Sí, no quiero más recordatorios
            </button>
          </form>
        </>
      ) : (
        <>
          <h1 class="text-2xl font-bold text-gray-900 mb-3">Enlace incompleto</h1>
          <p class="text-gray-600">Usa el enlace "No quiero más recordatorios de este evento" que viene al final del correo.</p>
        </>
      )}
    </div>
  </main>
</Layout>
