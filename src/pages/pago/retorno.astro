---
// Página de retorno de pago, común a todos los proveedores: /pago/retorno?order=<uuid>[&provider=stripe&session_id=...|&cancelled=1]
// Solo MUESTRA el estado: quien marca la orden como pagada es el webhook del proveedor
// (/api/webhooks/stripe o /api/payment-confirmation). Redes de seguridad:
//  - Stripe: si la sesión (consultada en el servidor, con client_reference_id === order) está pagada y el
//    webhook todavía no llegó, se llama confirmPaidOrder (idempotente, mismo camino que el webhook).
//  - Si el comprador canceló en Stripe, se expira la sesión abierta y la orden pasa a 'cancelled' (libera stock).
//  - Orden pagada sin correo enviado -> /api/send-tickets-email (idempotente).
// Flow sigue volviendo por POST a /payment-confirmation (urlReturn).
import AppHeader from "../../components/AppHeader.vue";
import AppFooter from "../../components/AppFooter.vue";
import EventDetails from "../../components/EventDetails.vue";
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { getSupabaseAdmin } from "../../lib/auth-helpers";
import { sendTicketsEmail } from "../api/_lib/server-utils";
import { LEGAL } from "../../lib/legal";
import { confirmPaidOrder, markOrderFailed, UUID_RE } from "../../../netlify/lib/orders.mjs";
import { orderFeeBreakdown } from "../../../netlify/lib/fees.mjs";
import { retrieveStripeSession, expireStripeSession } from "../../../netlify/lib/payments/stripe.mjs";

export const prerender = false;

type ViewState = "paid" | "processing" | "pending" | "review" | "failed" | "cancelled" | "refunded" | "error";

const supabase = getSupabaseAdmin();
const params = Astro.url.searchParams;
const orderId = String(params.get("order") || "");
const provider = params.get("provider") || "";
const sessionId = params.get("session_id") || "";
const cancelled = params.get("cancelled") === "1";

let state: ViewState = "error";
let message = "No encontramos la información de tu pago. Revisa tu correo o escríbenos a " + LEGAL.supportEmail + ".";
let order: any = null;
let eventData: any = null;
let totalPaid = 0;
let purchase: any = null;
let purchaseData: any = null;

const ORDER_COLS_NEW = "id, status, event_id, amount, ticket_fee, total_payment, ticket_qty, ticket_details, created_at, email_sent_at, payment_provider, provider_session_id";
const ORDER_COLS_OLD = "id, status, event_id, amount, ticket_fee, total_payment, ticket_qty, ticket_details, created_at, email_sent_at";

async function loadOrder(id: string) {
  let data: any = null;
  let error: any = null;
  // service_fee_tax (IVA del cargo) llega con 202609290100; sin migrar se cae a las columnas anteriores
  for (const cols of [`${ORDER_COLS_NEW}, service_fee_tax`, ORDER_COLS_NEW, ORDER_COLS_OLD]) {
    ({ data, error } = await supabase.from("event_orders").select(cols).eq("id", id).maybeSingle());
    if (!error) break;
  }
  return error ? null : data;
}

if (UUID_RE.test(orderId)) {
  try {
    order = await loadOrder(orderId);

    // Stripe: validar la sesión en el servidor y aplicar las redes de seguridad
    if (order && provider === "stripe" && process.env.STRIPE_SECRET_KEY) {
      const storedSession = (order as any).provider_session_id as string | null | undefined;
      if (sessionId && (!storedSession || storedSession === sessionId) && /^cs_[A-Za-z0-9_]+$/.test(sessionId)) {
        try {
          const session: any = await retrieveStripeSession(sessionId);
          if (session?.client_reference_id === order.id && (session.payment_status === "paid") && !["paid", "review", "refunded"].includes(order.status)) {
            const pi = typeof session.payment_intent === "string" ? session.payment_intent : session.payment_intent?.id;
            const result = await confirmPaidOrder(supabase, order.id, {
              provider: "stripe",
              amount: Number(session.amount_total),
              currency: session.currency || "clp",
              externalId: session.id,
              method: "stripe_card",
              paymentIntentId: pi || null,
              livemode: typeof session.livemode === "boolean" ? session.livemode : null,
            });
            console.log(`pago/retorno: red de seguridad Stripe para ${order.id} -> ${result.status}`);
            order = (await loadOrder(order.id)) || order;
          }
        } catch (err: any) {
          console.error(`pago/retorno: no se pudo verificar la sesión de Stripe de ${order.id}:`, err?.message);
        }
      } else if (cancelled && order.status === "pending" && storedSession) {
        // El comprador volvió desde Stripe sin pagar: cerrar la sesión y liberar el stock
        const closed = await expireStripeSession(storedSession);
        if (closed === "expired" && (await markOrderFailed(supabase, order.id, "cancelled"))) {
          order = { ...order, status: "cancelled" };
        }
      }
    }

    if (order) {
      // Total cobrado = subtotal + cargo por servicio + IVA del cargo (total_payment es lo que confirmó el proveedor)
      totalPaid = Number(order.total_payment ?? orderFeeBreakdown(order).total) || 0;
      const { data: eventInfo } = await supabase
        .from("events")
        .select("id, name, title, slug, image_url, location, start_date, end_date")
        .eq("id", order.event_id)
        .maybeSingle();
      eventData = eventInfo ? { ...eventInfo, address: eventInfo.location } : null;

      switch (order.status) {
        case "paid":
          state = "paid";
          message = "¡Gracias por tu compra! Tu pago fue confirmado.";
          if (!order.email_sent_at) {
            const mail = await sendTicketsEmail(new URL(Astro.request.url), order.id);
            if (!mail.ok) console.error(`pago/retorno: no se pudo enviar el correo de la orden ${order.id} (${mail.status})`);
          }
          break;
        case "processing":
          state = "processing";
          message = "¡Pago recibido! Estamos emitiendo tus entradas; llegarán a tu correo en unos minutos.";
          break;
        case "review":
          state = "review";
          message = `Recibimos tu pago, pero tu orden requiere una revisión manual. Te contactaremos por correo; si tienes dudas escríbenos a ${LEGAL.supportEmail} indicando tu número de orden.`;
          break;
        case "refunded":
          state = "refunded";
          message = "Esta orden fue reembolsada y sus entradas fueron anuladas.";
          break;
        case "failed":
        case "rejected":
          state = "failed";
          message = "Tu pago no se completó. Puedes intentarlo nuevamente o usar otro medio de pago.";
          break;
        case "cancelled":
        case "expired":
          state = "cancelled";
          message = "El pago fue cancelado o expiró. No se realizó ningún cobro; puedes intentarlo nuevamente.";
          break;
        case "pending":
        default:
          if (cancelled) {
            state = "cancelled";
            message = "Cancelaste el pago. No se realizó ningún cobro; puedes intentarlo nuevamente.";
          } else {
            state = "pending";
            message = "Estamos confirmando tu pago. Te enviaremos las entradas por correo apenas se confirme (puedes recargar esta página en unos minutos).";
          }
      }

      if (state === "paid" && eventData) {
        const lines = Array.isArray(order.ticket_details) ? order.ticket_details : [];
        purchase = {
          transaction_id: order.id,
          value: totalPaid,
          tax: orderFeeBreakdown(order).feeIva,
          currency: "CLP",
          items: lines.map((l: any) => ({
            item_id: `${eventData.id}-${l.id}`,
            item_name: `${eventData.name} - ${l.name}`,
            item_category: "event_ticket",
            price: Number(l.price) || 0,
            quantity: Number(l.quantity) || 1,
          })),
        };
        purchaseData = {
          orderId: order.id,
          eventId: eventData.id,
          eventSlug: eventData.slug,
          eventName: eventData.name,
          eventStartDate: eventData.start_date,
          amount: totalPaid,
          ticketsCount: Number(order.ticket_qty) || lines.reduce((s: number, l: any) => s + (Number(l.quantity) || 0), 0),
          tickets: [],
        };
      }
    }
  } catch (err: any) {
    console.error("pago/retorno: error:", err?.message);
    state = "error";
    message = `No pudimos verificar el estado de tu pago en este momento. Revisa tu correo o escríbenos a ${LEGAL.supportEmail}.`;
  }
}

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Cache-Control", "no-store");

const orderUrl = order ? `/order/${order.id}` : null;
const retryUrl = eventData?.slug ? `/eventos/${eventData.slug}` : "/eventos";
const headingColor =
  state === "paid" || state === "processing" ? "text-green-600" : state === "pending" || state === "review" ? "text-amber-600" : "text-red-600";
---
<Layout title="Estado de tu pago | AI Tickets" noindex>
  <AppHeader client:idle />

  <main class="flex flex-col items-center min-h-screen bg-gray-100 py-10">
    <div class="max-w-3xl w-full bg-white shadow-lg rounded-2xl p-6 lg:p-10 mx-4" data-testid="payment-return" data-state={state}>
      <h1 class={`text-2xl font-semibold ${headingColor} pt-4 mb-4 font-[Unbounded] text-center`}>{message}</h1>

      {order && eventData && <EventDetails event={eventData} client:load />}

      {order && (
        <div class="space-y-2 text-gray-700 font-[Prompt] mt-4 break-words">
          <p><span class="font-semibold">Orden:</span> {order.id}</p>
          <p><span class="font-semibold">Total:</span> {totalPaid > 0 ? `$${totalPaid.toLocaleString("es-CL")} CLP` : "Gratis"}</p>
        </div>
      )}

      {(state === "paid" || state === "processing" || state === "pending" || state === "review") && orderUrl && (
        <div class="mt-8 text-center">
          <a href={orderUrl} class="inline-block px-6 py-3 bg-black hover:bg-gray-800 text-white font-semibold rounded-xl transition">
            {state === "paid" ? "Ver mis entradas" : "Ver mi orden"}
          </a>
          {state === "paid" && <p class="text-sm text-gray-500 mt-2 font-[Prompt]">También te enviamos las entradas por correo.</p>}
        </div>
      )}

      {(state === "failed" || state === "cancelled" || state === "refunded" || state === "error") && (
        <div class="mt-10 text-center">
          <a href={retryUrl} class="inline-block px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl transition">
            Volver al evento
          </a>
        </div>
      )}
    </div>
  </main>

  <AppFooter />

  {purchase && (
    <script define:vars={{ purchase, purchaseData }}>
      // GA4 purchase: una sola vez por orden (recargar la página no duplica la conversión)
      try {
        const gaKey = 'ga_purchase_' + purchase.transaction_id;
        if (!sessionStorage.getItem(gaKey)) {
          window.gtag?.('event', 'purchase', purchase);
          sessionStorage.setItem(gaKey, '1');
        }
      } catch (e) { /* storage o gtag no disponibles */ }

      // Guardar la compra para "Mis entradas" en la página del evento y limpiar el flujo de reserva
      try {
        const key = 'purchase_event_' + purchaseData.eventId;
        const orders = JSON.parse(localStorage.getItem(key) || '[]');
        if (!orders.some((o) => o.orderId === purchaseData.orderId)) {
          orders.push({ ...purchaseData, purchaseDate: new Date().toISOString() });
          localStorage.setItem(key, JSON.stringify(orders));
        }
        localStorage.removeItem('selectedTickets_event_' + purchaseData.eventId);
        localStorage.removeItem('buyerInfo_event_' + purchaseData.eventId);
        localStorage.removeItem('currentStep_event_' + purchaseData.eventId);
      } catch (e) { /* storage no disponible */ }
    </script>
  )}
</Layout>
