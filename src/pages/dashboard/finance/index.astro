---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { getSupabaseAdmin } from "../../../lib/auth-helpers";
import { ORG_ADMIN_ROLES } from "../../../lib/supabaseServer";
import { requireDashboardSession } from "../_lib/guard";
import { SERVICE_FEE_PERCENT_LABEL, IVA_PERCENT_LABEL } from "../../../../netlify/lib/fees.mjs";
import { getStaffEventIds } from "../../../../netlify/lib/event-staff.mjs";
import { computeOrgLedger, RELEASE_HOURS, CHECKIN_RELEASE_THRESHOLD, RESERVE_HOLD_DAYS, type OrgLedger, type HoldReason } from "../../../lib/producer-api/ledger";
import { RISK_LEVEL_LABELS } from "../../../lib/eventRisk";
import { roleAllows } from "../../../lib/producer-api/permissions";
import { getTool } from "../../../lib/producer-api/tools";
import { runTool } from "../../../lib/producer-api/registry";
import { dashboardToolContext } from "../../../lib/producer-api/session";
import { PAYOUT_SCHEDULE_TEXT } from "../../../../netlify/lib/legal.mjs";
import PayoutRequestButton from "../../../components/dashboard/PayoutRequestButton.vue";

const guard = await requireDashboardSession(Astro, [...ORG_ADMIN_ROLES, "finance"]);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const supabaseAdmin = getSupabaseAdmin();

// Antes de cualquier uso: providerLabel() se llama al armar las transacciones (TDZ si va después)
const PROVIDER_LABELS: Record<string, string> = { flow: "Webpay", free: "Gratis", courtesy: "Cortesía", demo: "Demo" };
function providerLabel(p: string | null | undefined): string {
    return p ? PROVIDER_LABELS[p] || p : "Webpay";
}

type Tx = {
    event: string;
    amount: number;
    ticketFee: number;
    feeTax: number;
    paymentFee: number;
    discount: number;
    discountCode: string;
    total: number;
    qty: number;
    date: string;
    provider: string;
};

let totalRevenue = 0; // ventas de entradas (lo que recibe el productor)
let totalServiceFees = 0; // cargo por servicio NETO pagado por los compradores (ticket_fee)
let totalServiceFeeTax = 0; // IVA del cargo por servicio (service_fee_tax)
let totalDiscounts = 0; // descuentos por códigos (discount_amount); amount ya viene descontado
let discountedOrders = 0;
let totalAbsorbedFees = 0; // cargo + IVA absorbidos por el productor (ya descontados de amount)
let absorbedOrders = 0;
let transactions: Tx[] = [];
let refundedCount = 0; // órdenes reembolsadas (no suman al saldo)
let reviewCount = 0; // pagos en revisión manual (monto no coincide o sin stock)

// Equipo asignado a ciertos eventos (aitickets_event_staff): solo ve las finanzas de esos eventos
const staffEventIds = await getStaffEventIds(supabaseAdmin, dbUser.id);
let orgEventsQuery = supabaseAdmin
    .from("events")
    .select("id, name, end_date, start_date")
    .eq("organization_id", dbUser.organization_id);
if (staffEventIds) orgEventsQuery = orgEventsQuery.in("id", staffEventIds);
const { data: allOrgEvents } = await orgEventsQuery.order("start_date", { ascending: false });
// ?event=<id> (desde la tarjeta "Ingresos" del evento): ventas, saldo y órdenes de ese evento. Retiros y
// solicitudes son de la cuenta completa: no se muestran filtrados.
const eventParam = Number(Astro.url.searchParams.get("event"));
const filterEvent = (allOrgEvents || []).find((e) => Number(e.id) === eventParam) || null;
const orgEvents = filterEvent ? [filterEvent] : allOrgEvents;

if (orgEvents && orgEvents.length > 0) {
    const eventIds = orgEvents.map((e) => e.id);
    const eventNameMap = Object.fromEntries(orgEvents.map((e) => [e.id, e.name]));

    // Solo órdenes pagadas. Paginado con .range(): PostgREST corta en 1000 filas y los totales quedarían incompletos.
    // payment_provider existe desde la migración 202609270100 y service_fee_tax desde 202609290100;
    // sin ellas (deploy preview contra una base sin migrar) se omiten.
    const orders: any[] = [];
    const PAGE_SIZE = 1000;
    const BASE_COLUMNS = "id, event_id, amount, ticket_fee, payment_fee, total_payment, ticket_qty, created_at";
    // discount_amount/discount_code existen desde 202609300200.
    // fee_absorbed existe desde 202610090200.
    const columnSets = [
        `${BASE_COLUMNS}, payment_provider, service_fee_tax, discount_amount, discount_code, fee_absorbed`,
        `${BASE_COLUMNS}, payment_provider, service_fee_tax, discount_amount, discount_code`,
        `${BASE_COLUMNS}, payment_provider, service_fee_tax`,
        `${BASE_COLUMNS}, payment_provider`,
        BASE_COLUMNS,
    ];
    let columnIndex = 0;
    for (let from = 0; ; from += PAGE_SIZE) {
        const fetchPage = () => supabaseAdmin
            .from("event_orders")
            .select(columnSets[columnIndex])
            .in("event_id", eventIds)
            .eq("status", "paid")
            .order("created_at", { ascending: false })
            .order("id", { ascending: true })
            .range(from, from + PAGE_SIZE - 1);
        let { data: page, error: pageError }: { data: any[] | null; error: any } = await fetchPage();
        while (pageError && from === 0 && columnIndex < columnSets.length - 1) {
            columnIndex += 1;
            ({ data: page, error: pageError } = await fetchPage());
        }
        if (pageError) {
            console.error("Error cargando órdenes para finanzas:", pageError.message);
            break;
        }
        orders.push(...(page || []));
        if (!page || page.length < PAGE_SIZE) break;
    }

    for (const o of orders || []) {
        const amount = Number(o.amount) || 0;
        const ticketFee = Number(o.ticket_fee) || 0;
        totalRevenue += amount;
        totalServiceFees += ticketFee;
        totalServiceFeeTax += Number(o.service_fee_tax) || 0;
        if (o.fee_absorbed === true) {
            totalAbsorbedFees += ticketFee + (Number(o.service_fee_tax) || 0);
            absorbedOrders += 1;
        }
        const discount = Number(o.discount_amount) || 0;
        if (discount > 0) {
            totalDiscounts += discount;
            discountedOrders += 1;
        }
    }

    transactions = (orders || []).slice(0, 300).map((o) => ({
        event: eventNameMap[o.event_id] || "—",
        amount: Number(o.amount) || 0,
        ticketFee: Number(o.ticket_fee) || 0,
        feeTax: Number(o.service_fee_tax) || 0,
        paymentFee: Number(o.payment_fee) || 0,
        discount: Number(o.discount_amount) || 0,
        discountCode: Number(o.discount_amount) > 0 ? o.discount_code || "" : "",
        total: Number(o.total_payment) || 0,
        qty: o.ticket_qty || 0,
        date: new Date(o.created_at).toLocaleDateString("es-CL", { timeZone: "America/Santiago" }),
        provider: providerLabel(o.payment_provider),
    }));

    // Órdenes fuera del saldo que conviene mostrar: reembolsadas y en revisión
    const [{ count: refunded }, { count: review }] = await Promise.all([
        supabaseAdmin.from("event_orders").select("id", { count: "exact", head: true }).in("event_id", eventIds).eq("status", "refunded"),
        supabaseAdmin.from("event_orders").select("id", { count: "exact", head: true }).in("event_id", eventIds).eq("status", "review"),
    ]);
    refundedCount = refunded || 0;
    reviewCount = review || 0;

}

// Saldo: misma fuente que get_balance/request_payout (ledger.ts). Cada función se libera 48 h después de terminar.
let ledger: OrgLedger = {
    events: [],
    totals: { available: 0, pending: 0, retained: 0, withdrawn: 0, paid_out: 0, negative_balance: 0, sales_net: 0, partial_refunds: 0, held: 0, reserve: 0 },
    hold_reasons: [],
};
try {
    ledger = await computeOrgLedger(supabaseAdmin, Number(dbUser.organization_id), { eventIds: filterEvent ? [Number(filterEvent.id)] : staffEventIds });
} catch (err: any) {
    console.error("Error calculando el saldo:", err?.message || err);
}
const ledgerEvents = ledger.events
    .filter((l) => l.sales_net > 0 || l.withdrawn > 0 || l.retained > 0)
    .sort((a, b) => String(b.last_function_end || "").localeCompare(String(a.last_function_end || "")));
const nextRelease = ledgerEvents
    .map((l) => l.next_release_at)
    .filter(Boolean)
    .sort()[0] || null;

// Retiros: estado de verificación y últimas solicitudes (mismas herramientas que la API)
const canManagePayouts = roleAllows(dbUser.role, "finance.manage") && !staffEventIds;
let verification: any = null;
let payouts: any[] = [];
const toolAuth = await dashboardToolContext(Astro);
if (toolAuth.ok) {
    const [v, p] = await Promise.all([
        runTool(getTool("get_verification_status")!, {}, toolAuth.ctx),
        runTool(getTool("list_payouts")!, { limit: 10 }, toolAuth.ctx),
    ]);
    if (v.ok) verification = v.result;
    if (p.ok) payouts = (p.result as any).payouts || [];
}
const PAYOUT_STATUS: Record<string, string> = { requested: "Solicitado", processing: "En proceso", paid: "Transferido", cancelled: "Anulado", failed: "Falló" };

// Datos bancarios (tabla organization_payout_accounts, migración 20260926_C_dashboard)
const { data: payout } = await supabaseAdmin
    .from("organization_payout_accounts")
    .select("bank_name, bank_account_number, bank_account_holder, bank_account_rut")
    .eq("organization_id", dbUser.organization_id)
    .maybeSingle();
const hasBankData = !!(payout?.bank_name && payout?.bank_account_number && payout?.bank_account_holder && payout?.bank_account_rut);

/** Motivos de retención propios de una función/evento (los de la cuenta se muestran una sola vez arriba). */
const ACCOUNT_CODES = new Set(["identity_pending", "bank_unverified", "holder_unchecked", "holder_mismatch"]);
const ownReasons = (reasons: HoldReason[] = []) => reasons.filter((r) => !ACCOUNT_CODES.has(r.code));
const pct = (r: number | null) => (r == null ? "—" : `${Math.round(r * 100)}%`);

const formatCLP = (amount: number) => `$${Math.round(Number(amount) || 0).toLocaleString("es-CL")}`;
const formatDate = (d: string | null) =>
    d ? new Date(d).toLocaleDateString("es-CL", { timeZone: "America/Santiago" }) : "—";
const formatDateTime = (d: string | null) =>
    d ? new Date(d).toLocaleString("es-CL", { timeZone: "America/Santiago", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }) : "—";
---

<DashboardLayout title="Ingresos">
    <div class="space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h1 class="text-2xl font-bold text-gray-900">
                Ingresos y Finanzas
            </h1>
        </div>

        {filterEvent && (
            <div class="flex flex-wrap items-center justify-between gap-2 bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm" data-testid="finance-event-filter">
                <p class="text-gray-700">Mostrando solo <a href={`/dashboard/events/${filterEvent.id}`} class="font-semibold text-gray-900 underline">{filterEvent.name}</a></p>
                <a href="/dashboard/finance" class="font-medium text-gray-700 underline hover:text-black">Ver todos los eventos</a>
            </div>
        )}

        <!-- Cómo se paga -->
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 md:p-5 text-sm text-blue-900">
            <p class="font-semibold mb-1">¿Cómo recibo mi dinero?</p>
            <p>
                Recibes el <strong>100% del valor de tus entradas</strong>: el cargo por servicio y su IVA los paga el comprador.
                {PAYOUT_SCHEDULE_TEXT} La transferencia va a la cuenta que registres en <a href="/dashboard/settings" class="underline font-medium">Configuración</a>.
            </p>
            {!hasBankData && (
                <p class="mt-2 text-red-700 font-medium">
                    ⚠️ Aún no registras tus datos bancarios. Complétalos en Configuración para poder recibir tus pagos.
                </p>
            )}
        </div>

        {ledger.hold_reasons.length > 0 && (ledger.totals.held > 0 || ledger.totals.pending > 0) && (
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 md:p-5 text-sm text-amber-900" data-testid="finance-account-holds">
                <p class="font-semibold mb-1">Para liberar tus ventas falta:</p>
                <ul class="list-disc pl-5 space-y-0.5">
                    {ledger.hold_reasons.map((r) => <li>{r.label}</li>)}
                </ul>
                <p class="mt-2">
                    Complétalo en <a href="/dashboard/settings" class="underline font-medium">Configuración</a>.{" "}
                    <a href="/terminos-productores#recaudacion" class="underline">*Se aplican términos y condiciones</a>
                </p>
            </div>
        )}

        <!-- Quick Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
            <div class="bg-white p-4 md:p-6 rounded-xl border border-gray-100 shadow-sm">
                <h3 class="text-gray-500 text-sm font-medium">Ventas de entradas</h3>
                <p class="text-2xl md:text-3xl font-bold mt-2">{formatCLP(totalRevenue)}</p>
                <p class="text-xs text-gray-400 mt-1">Órdenes pagadas. No incluye el cargo por servicio ({formatCLP(totalServiceFees)}) ni su IVA ({formatCLP(totalServiceFeeTax)}).</p>
                {totalAbsorbedFees > 0 && (
                    <p class="text-xs text-gray-400 mt-1" data-testid="finance-absorbed-fees">
                        Neto de {formatCLP(totalAbsorbedFees)} en cargo por servicio que absorbiste ({absorbedOrders} orden{absorbedOrders === 1 ? "" : "es"} con cargo incluido en el precio).
                    </p>
                )}
                {totalDiscounts > 0 && (
                    <p class="text-xs text-gray-400 mt-1" data-testid="finance-discounts">
                        Ya descontados {formatCLP(totalDiscounts)} en códigos de descuento ({discountedOrders} orden{discountedOrders === 1 ? "" : "es"}). <a href="/dashboard/descuentos" class="underline">Ver códigos</a>
                    </p>
                )}
            </div>
            <div class="bg-white p-4 md:p-6 rounded-xl border border-gray-100 shadow-sm" data-testid="finance-available">
                <h3 class="text-gray-500 text-sm font-medium">Disponible para retirar</h3>
                <p class="text-2xl md:text-3xl font-bold mt-2 text-green-600">{formatCLP(ledger.totals.available)}</p>
                <p class="text-xs text-gray-400 mt-1">Ventas de funciones que terminaron hace {RELEASE_HOURS} h o más y cumplen las condiciones de liberación.</p>
                {canManagePayouts && !filterEvent && (
                    <div class="mt-3">
                        <PayoutRequestButton
                            client:load
                            available={ledger.totals.available}
                            canRequest={Boolean(verification?.can_request_payout)}
                            missing={(verification?.missing || []).filter((m: any) => m.blocks_payouts).map((m: any) => m.label)}
                        />
                    </div>
                )}
            </div>
            <div class="bg-white p-4 md:p-6 rounded-xl border border-gray-100 shadow-sm" data-testid="finance-pending">
                <h3 class="text-gray-500 text-sm font-medium">Por liberar</h3>
                <p class="text-2xl md:text-3xl font-bold mt-2">{formatCLP(ledger.totals.pending)}</p>
                <p class="text-xs text-gray-400 mt-1">
                    {nextRelease ? `Próxima liberación: ${formatDateTime(nextRelease)}.` : "Funciones por realizarse."}
                    {ledger.totals.retained > 0 && ` Retenido: ${formatCLP(ledger.totals.retained)} (pagos en revisión, eventos cancelados o condiciones pendientes; detalle por evento abajo).`}
                    {ledger.totals.reserve > 0 && ` Incluye ${formatCLP(ledger.totals.reserve)} de reserva por riesgo.`}
                </p>
                <p class="text-xs text-gray-400 mt-1">Transferido a la fecha: {formatCLP(ledger.totals.paid_out)}</p>
            </div>
        </div>

        {payouts.length > 0 && !filterEvent && (
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden" data-testid="finance-payouts">
                <div class="p-4 md:p-6 border-b border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900">Retiros</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-gray-600">
                        <thead class="bg-gray-50 text-gray-900 font-semibold border-b border-gray-100">
                            <tr>
                                <th class="px-4 md:px-6 py-3 whitespace-nowrap">Solicitado</th>
                                <th class="px-4 md:px-6 py-3 whitespace-nowrap">Monto</th>
                                <th class="px-4 md:px-6 py-3 whitespace-nowrap">Cuenta</th>
                                <th class="px-4 md:px-6 py-3 whitespace-nowrap">Estado</th>
                                <th class="px-4 md:px-6 py-3 whitespace-nowrap">Depósito estimado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {payouts.map((p) => (
                                <tr class="border-b border-gray-50">
                                    <td class="px-4 md:px-6 py-3 whitespace-nowrap">{formatDate(p.requested_at)}</td>
                                    <td class="px-4 md:px-6 py-3 whitespace-nowrap font-medium text-gray-900">{formatCLP(p.amount)}</td>
                                    <td class="px-4 md:px-6 py-3 whitespace-nowrap">{p.bank} ****{p.account_last4}</td>
                                    <td class="px-4 md:px-6 py-3 whitespace-nowrap">{PAYOUT_STATUS[p.status] || p.status}</td>
                                    <td class="px-4 md:px-6 py-3 whitespace-nowrap">{p.paid_at ? formatDate(p.paid_at) : p.estimated_payment_date || "—"}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        )}

        <!-- Resumen por evento -->
        {ledgerEvents.length > 0 && (
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="p-4 md:p-6 border-b border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900">Resumen por evento</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-gray-600">
                        <thead class="bg-gray-50 text-gray-900 font-semibold border-b border-gray-100">
                            <tr>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Evento</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Funciones</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Entradas</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Ventas de entradas</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Retirado</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Disponible</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Por liberar</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {ledgerEvents.map((s) => (
                                <tr class="border-b border-gray-50 hover:bg-gray-50 transition align-top">
                                    <td class="px-4 md:px-6 py-3 md:py-4 font-medium text-gray-900 min-w-[10rem]">
                                        {s.name}
                                        {s.cancelled && <span class="block text-xs text-red-600">Cancelado: saldo retenido</span>}
                                        {s.risk_level && s.risk_level !== "low" && (
                                            <span class="block text-xs text-amber-700">
                                                Riesgo {RISK_LEVEL_LABELS[s.risk_level as keyof typeof RISK_LEVEL_LABELS]?.toLowerCase() || s.risk_level} · reserva {s.reserve_pct}%
                                            </span>
                                        )}
                                        {s.reserve_amount > 0 && (
                                            <span class="block text-xs text-gray-500">Reserva {formatCLP(s.reserve_amount)} hasta {formatDate(s.reserve_release_at)}</span>
                                        )}
                                        {ownReasons(s.hold_reasons).filter((r) => r.code !== "risk_reserve" && r.code !== "event_cancelled").map((r) => (
                                            <span class="block text-xs text-amber-700">Retenido: {r.label}</span>
                                        ))}
                                    </td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 text-xs min-w-[12rem]">
                                        {s.functions.filter((f) => f.sales_net > 0).length > 0 ? (
                                            <ul class="space-y-1">
                                                {s.functions.filter((f) => f.sales_net > 0).map((f) => (
                                                    <li data-testid="finance-function" data-release-status={f.release_status}>
                                                        {formatDate(f.ends_at)}{f.start_time ? ` ${f.start_time}` : ""} · {formatCLP(f.sales_net)} ·{" "}
                                                        {f.release_status === "released" ? (
                                                            <span class="text-green-700">liberado</span>
                                                        ) : f.release_status === "held" ? (
                                                            <span class="text-amber-700">retenido</span>
                                                        ) : f.release_status === "cancelled" ? (
                                                            <span class="text-red-600">cancelado</span>
                                                        ) : (
                                                            <span class="text-gray-500">desde {formatDateTime(f.releases_at)}</span>
                                                        )}
                                                        {f.checkin_ratio != null && f.release_status !== "pending" && (
                                                            <span class="text-gray-400"> · check-ins {pct(f.checkin_ratio)}{f.attested_at ? " · acreditada" : ""}</span>
                                                        )}
                                                        {ownReasons(f.hold_reasons).map((r) => (
                                                            <span class="block text-amber-700">
                                                                {r.code === "risk_reserve" ? `Reserva ${formatCLP(f.reserve_amount)} hasta ${formatDate(f.reserve_release_at)}` : r.label}
                                                            </span>
                                                        ))}
                                                        {canManagePayouts && f.hold_reasons.some((r) => r.code === "low_checkins") && !f.attested_at && (
                                                            <details class="mt-1">
                                                                <summary class="cursor-pointer text-blue-600 hover:underline">Acreditar que la función se realizó</summary>
                                                                <form class="mt-1 space-y-1" data-attest-form data-event-id={s.event_id} data-event-date-id={f.event_date_id}>
                                                                    <textarea name="note" required minlength="3" maxlength="1000" rows="2" class="w-full border rounded p-1 text-xs" placeholder="Cómo se realizó y qué evidencia tienes (asistentes aprox., link a fotos)"></textarea>
                                                                    <button type="submit" class="px-2 py-1 rounded bg-black text-white text-xs">Acreditar</button>
                                                                    <p class="text-red-600" data-attest-error></p>
                                                                </form>
                                                            </details>
                                                        )}
                                                    </li>
                                                ))}
                                            </ul>
                                        ) : (
                                            <span class="text-gray-500">Última: {formatDate(s.last_function_end)}</span>
                                        )}
                                    </td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{s.tickets}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{formatCLP(s.sales_net - s.partial_refunds)}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{formatCLP(s.withdrawn)}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap font-semibold text-green-700">{formatCLP(s.available)}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{formatCLP(s.pending + s.retained)}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">
                                        <a href={`/api/events/orders-csv?event_id=${s.event_id}`} class="text-blue-600 hover:underline whitespace-nowrap">Exportar CSV</a>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        )}

        {(refundedCount > 0 || reviewCount > 0) && (
            <div class="bg-amber-50 border border-amber-100 rounded-xl p-4 text-sm text-amber-900">
                {refundedCount > 0 && <p>{refundedCount} orden(es) reembolsada(s): sus entradas fueron anuladas y no suman a tu saldo.</p>}
                {reviewCount > 0 && <p>{reviewCount} pago(s) en revisión manual por nuestro equipo: se sumarán a tu saldo cuando se emitan las entradas.</p>}
            </div>
        )}

        <!-- Transactions Table -->
        {transactions.length > 0 ? (
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="p-4 md:p-6 border-b border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900">Órdenes pagadas</h3>
                    <p class="text-xs text-gray-500 mt-1">
                        El cargo por servicio ({SERVICE_FEE_PERCENT_LABEL}) y su IVA ({IVA_PERCENT_LABEL} del cargo) los paga el comprador y la comisión de la pasarela de pago la cubre AI Tickets: ninguno se descuenta de tu saldo.
                    </p>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-gray-600">
                        <thead class="bg-gray-50 text-gray-900 font-semibold border-b border-gray-100">
                            <tr>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Evento</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Entradas</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Monto entradas</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Descuento</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Cargo por servicio</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">IVA cargo</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Total pagado</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Comisión pasarela</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Medio de pago</th>
                                <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            {transactions.map((t) => (
                                <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                                    <td class="px-4 md:px-6 py-3 md:py-4 font-medium text-gray-900 min-w-[10rem]">{t.event}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{t.qty}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap font-medium text-gray-900">{formatCLP(t.amount)}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">
                                        {t.discount > 0 ? (
                                            <span>-{formatCLP(t.discount)}{t.discountCode && <span class="block text-xs text-gray-400 font-mono">{t.discountCode}</span>}</span>
                                        ) : "—"}
                                    </td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{formatCLP(t.ticketFee)}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{formatCLP(t.feeTax)}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{formatCLP(t.total)}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap text-gray-400">{formatCLP(t.paymentFee)}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{t.provider}</td>
                                    <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{t.date}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        ) : (
            <div class="bg-white rounded-xl border border-gray-100 p-6 md:p-8 text-center shadow-sm mt-6">
                <div class="max-w-md mx-auto">
                    <h3 class="text-lg font-medium text-gray-900 mb-2">Órdenes pagadas</h3>
                    <p class="text-gray-500">
                        Aún no hay ventas registradas. Cuando vendas entradas, aquí verás el desglose.
                    </p>
                </div>
            </div>
        )}
        <p class="text-xs text-gray-400">
            Lo de cada función se libera {RELEASE_HOURS} h después de que termina si tu identidad y tu cuenta bancaria están verificadas, la función registró
            check-ins de al menos {Math.round(CHECKIN_RELEASE_THRESHOLD * 100)}% de las entradas (o acreditas que se realizó) y no hay reclamos abiertos. En eventos con
            riesgo podemos retener una reserva hasta {RESERVE_HOLD_DAYS} días después de la función.{" "}
            <a href="/terminos-productores#recaudacion" class="underline">*Se aplican términos y condiciones</a>
        </p>
    </div>
</DashboardLayout>

<script>
    document.querySelectorAll<HTMLFormElement>("form[data-attest-form]").forEach((form) => {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const button = form.querySelector("button");
            const errorEl = form.querySelector("[data-attest-error]");
            if (button) button.disabled = true;
            if (errorEl) errorEl.textContent = "";
            try {
                const res = await fetch("/api/events/attest", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        event_id: Number(form.dataset.eventId),
                        event_date_id: Number(form.dataset.eventDateId),
                        note: String(new FormData(form).get("note") || ""),
                    }),
                });
                const out = await res.json().catch(() => ({}));
                if (!res.ok || !out.ok) throw new Error(out?.error?.message || "No se pudo acreditar la función.");
                window.location.reload();
            } catch (err: any) {
                if (errorEl) errorEl.textContent = err?.message || "No se pudo acreditar la función.";
                if (button) button.disabled = false;
            }
        });
    });
</script>
