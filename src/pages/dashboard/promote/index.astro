---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { EVENT_MANAGER_ROLES, ORG_ADMIN_ROLES, hasRole } from "../../../lib/supabaseServer";
import { requireDashboardSession } from "../_lib/guard";
import { getSupabaseAdmin } from "../../../lib/auth-helpers";
import PromoteOverview from "../../../components/dashboard/promote/PromoteOverview.vue";
import { loadAdConnections, loadAdsView } from "../../../lib/ads";
import { adsEnabled } from "../../../../netlify/lib/zernio-ads.mjs";
import { getStaffEventIds } from "../../../../netlify/lib/event-staff.mjs";
import { SERIES_TABLE, LIVE_STATUSES } from "../../../lib/socialSeries";

const guard = await requireDashboardSession(Astro, EVENT_MANAGER_ROLES);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const supabaseAdmin = getSupabaseAdmin();

// Fetch connected social accounts
const { data: socialAccounts } = await supabaseAdmin
  .from("social_accounts")
  .select("id, platform, account_name, avatar_url, status, created_at")
  .eq("organization_id", dbUser.organization_id)
  .order("created_at", { ascending: false });

// Fetch recent social posts with event info
const { data: socialPosts } = await supabaseAdmin
  .from("social_posts")
  .select("*, events(id, name, title, image_url)")
  .eq("organization_id", dbUser.organization_id)
  .order("created_at", { ascending: false })
  .limit(20);

// Eventos a la venta que todavía no terminan, para "Promociona un evento" (con acceso por evento del miembro)
const nowIso = new Date().toISOString();
const { data: rawEvents } = await supabaseAdmin
  .from("events")
  .select("id, name, title, image_url, status, start_date, end_date")
  .eq("organization_id", dbUser.organization_id)
  .eq("status", "published")
  .or(`end_date.gte.${nowIso},end_date.is.null`)
  .order("start_date", { ascending: true, nullsFirst: false });
const allowedEventIds = await getStaffEventIds(supabaseAdmin, dbUser.id);
const events = (rawEvents || []).filter((e: any) => !allowedEventIds || allowedEventIds.includes(Number(e.id)));

// Difusión automática en Instagram por evento (docs/specs/historias-automaticas.md). Sin la tabla: sin estado.
const seriesByEvent: Record<number, string> = {};
if (events.length) {
  const { data: series } = await supabaseAdmin
    .from(SERIES_TABLE)
    .select("event_id, status")
    .in("event_id", events.map((e: any) => e.id))
    .in("status", [...LIVE_STATUSES]);
  for (const s of series || []) seriesByEvent[Number(s.event_id)] ??= s.status;
}

// Anuncios en Meta vía Zernio (src/lib/ads.ts). Sin sincronizar aquí: la pestaña lo hace al abrirse.
const enabledAds = adsEnabled();
let ads = { enabled: enabledAds, connections: [] as any[], campaigns: [] as any[] };
if (enabledAds) {
  try {
    const [connections, campaigns] = await Promise.all([
      loadAdConnections(supabaseAdmin, Number(dbUser.organization_id)),
      loadAdsView(supabaseAdmin, { organizationId: Number(dbUser.organization_id), userId: Number(dbUser.id) }),
    ]);
    ads = { enabled: true, connections, campaigns };
  } catch (err: any) {
    console.error("promote: anuncios", err?.message);
  }
}

// Total de posts de la organización (la lista solo trae los 20 más recientes)
const { count: totalCount } = await supabaseAdmin
  .from("social_posts")
  .select("id", { count: "exact", head: true })
  .eq("organization_id", dbUser.organization_id);
const totalPosts = totalCount || 0;
const activeCampaigns = ads.campaigns.filter((c) => c.status === "active").length;
const totalAdSpend = ads.campaigns.filter((c) => !c.currency || c.currency === "CLP").reduce((s, c) => s + (Number(c.spend) || 0), 0);
const hasMetaAds = ads.connections.some((c) => c.status === "active");
const activeAdsByEvent: Record<number, number> = {};
for (const c of ads.campaigns) if (c.status === "active") activeAdsByEvent[Number(c.event_id)] = (activeAdsByEvent[Number(c.event_id)] || 0) + 1;
const promoteEvents = events.map((e: any) => ({
  id: e.id,
  name: e.title || e.name,
  image_url: e.image_url,
  start_date: e.start_date,
  series: seriesByEvent[Number(e.id)] || null,
  activeAds: activeAdsByEvent[Number(e.id)] || 0,
}));

const connected = Astro.url.searchParams.get("connected");
const error = Astro.url.searchParams.get("error");
const rawTab = Astro.url.searchParams.get("tab");
const tab = rawTab === "ads" && !enabledAds ? "" : rawTab;
---

<DashboardLayout title="Promocionar">
  <PromoteOverview
    client:only="vue"
    accountsJson={JSON.stringify(socialAccounts || [])}
    postsJson={JSON.stringify(socialPosts || [])}
    eventsJson={JSON.stringify(promoteEvents)}
    statsJson={JSON.stringify({ totalPosts, activeCampaigns, totalAdSpend, hasMetaAds })}
    connectedPlatform={connected || ""}
    errorType={error || ""}
    initialTab={tab || ""}
    adsJson={JSON.stringify(ads)}
    canManageAds={hasRole(dbUser, ORG_ADMIN_ROLES)}
  />
</DashboardLayout>
