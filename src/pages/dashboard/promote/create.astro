---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { EVENT_MANAGER_ROLES } from "../../../lib/supabaseServer";
import { requireDashboardSession } from "../_lib/guard";
import { getSupabaseAdmin } from "../../../lib/auth-helpers";
import CreateSocialPost from "../../../components/dashboard/promote/CreateSocialPost.vue";

const guard = await requireDashboardSession(Astro, EVENT_MANAGER_ROLES);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const supabaseAdmin = getSupabaseAdmin();

// Fetch published events
const { data: events } = await supabaseAdmin
  .from("events")
  .select(`
    id, name, title, description, image_url, status, start_date,
    event_tickets(ticket_name, price),
    event_dates(date, start_time, end_time),
    event_locations(*, venues(name, city, address_line1))
  `)
  .eq("organization_id", dbUser.organization_id)
  .eq("status", "published")
  .order("created_at", { ascending: false });

// Fetch connected accounts
const { data: socialAccounts } = await supabaseAdmin
  .from("social_accounts")
  .select("*")
  .eq("organization_id", dbUser.organization_id)
  .eq("status", "active");

// Pre-selected event from query param
const preSelectedEventId = Astro.url.searchParams.get("event") || "";
---

<DashboardLayout title="Crear Post">
  <CreateSocialPost
    client:only="vue"
    eventsJson={JSON.stringify(events || [])}
    accountsJson={JSON.stringify(socialAccounts || [])}
    preSelectedEventId={preSelectedEventId}
  />
</DashboardLayout>
