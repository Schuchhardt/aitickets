---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Download, Users } from "lucide-vue-next";
import { getSupabaseAdmin } from "../../lib/auth-helpers";
import { EVENT_MANAGER_ROLES } from "../../lib/supabaseServer";
import { requireDashboardSession } from "./_lib/guard";
import { getStaffEventIds } from "../../../netlify/lib/event-staff.mjs";
import { fetchAll } from "../../lib/producer-api/tools/common";

const guard = await requireDashboardSession(Astro, EVENT_MANAGER_ROLES);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const supabaseAdmin = getSupabaseAdmin();

// Tope de filas en pantalla (y en el CSV, que se arma desde la tabla). Paginado: PostgREST corta en 1000 filas.
const MAX_ROWS = 5000;
const dateFmt = new Intl.DateTimeFormat("es-CL", { timeZone: "America/Santiago", day: "2-digit", month: "2-digit", year: "numeric" });

let attendees: Array<{name: string; email: string; event: string; ticket: string; date: string}> = [];
let truncated = false;

if (dbUser?.organization_id) {
  // Equipo asignado a ciertos eventos (aitickets_event_staff): solo ve a los asistentes de esos eventos
  const staffEventIds = await getStaffEventIds(supabaseAdmin, dbUser.id);
  const orgEvents = await fetchAll<{ id: number; name: string }>(() => {
    let q = supabaseAdmin.from("events").select("id, name").eq("organization_id", dbUser.organization_id);
    if (staffEventIds) q = q.in("id", staffEventIds);
    return q.order("id", { ascending: true });
  });

  if (orgEvents.length > 0) {
    const eventIds = orgEvents.map((e) => e.id);
    const eventNameMap = Object.fromEntries(orgEvents.map((e) => [e.id, e.name]));

    // Asistentes de esos eventos, los más recientes primero (sin las entradas anuladas por reembolso)
    const eventAttendees = await fetchAll<any>(() => supabaseAdmin
      .from("event_attendees")
      .select(`
        id,
        event_id,
        created_at,
        event_ticket_id,
        status,
        attendees (first_name, last_name, email),
        event_tickets (ticket_name)
      `)
      .in("event_id", eventIds)
      .order("created_at", { ascending: false })
      .order("id", { ascending: true }), { max: MAX_ROWS });
    truncated = eventAttendees.length >= MAX_ROWS;

    attendees = eventAttendees.filter((ea: any) => ea.status !== "cancelled").map((ea: any) => ({
      name: [ea.attendees?.first_name, ea.attendees?.last_name].filter(Boolean).join(" ") || "—",
      email: ea.attendees?.email || "—",
      event: eventNameMap[ea.event_id] || "—",
      ticket: ea.event_tickets?.ticket_name || "—",
      date: dateFmt.format(new Date(ea.created_at)),
    }));
  }
}
---

<DashboardLayout title="Comunidad">
  <div
    class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 md:mb-8"
  >
    <div>
      <h1 class="text-2xl md:text-3xl font-bold font-[Unbounded] mb-2">Comunidad</h1>
      <p class="text-gray-600">
        Visualiza a los asistentes de todos tus eventos.
      </p>
    </div>

    {attendees.length > 0 && (
      <button
        id="exportCsvBtn"
        class="self-start md:self-auto inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 transition font-medium"
      >
        <Download size={18} />
        Exportar CSV
      </button>
    )}
  </div>

  {truncated && (
    <p class="mb-4 text-sm text-gray-500">
      Se muestran los {MAX_ROWS.toLocaleString("es-CL")} asistentes más recientes. Para la lista completa descarga el CSV de órdenes de cada evento en <a href="/dashboard/tickets" class="underline">Entradas</a>.
    </p>
  )}

  <div
    class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden"
  >
    <div class="overflow-x-auto">
      <table id="attendeesTable" class="w-full text-left text-sm text-gray-600">
        <thead
          class="bg-gray-50 text-gray-900 font-semibold border-b border-gray-100"
        >
          <tr>
            <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Nombre</th>
            <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Email</th>
            <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Evento</th>
            <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Ticket</th>
            <th class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">Fecha Compra</th>
          </tr>
        </thead>
        <tbody>
          {attendees.length > 0 ? (
            attendees.map((a) => (
              <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                <td class="px-4 md:px-6 py-3 md:py-4 font-medium text-gray-900 whitespace-nowrap">{a.name}</td>
                <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{a.email}</td>
                <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{a.event}</td>
                <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{a.ticket}</td>
                <td class="px-4 md:px-6 py-3 md:py-4 whitespace-nowrap">{a.date}</td>
              </tr>
            ))
          ) : (
            <tr>
              <td colspan="5" class="px-4 md:px-6 py-12 text-center text-gray-400">
                <div class="flex flex-col items-center gap-2">
                  <Users size={24} />
                  <span>No se encontraron asistentes aún.</span>
                </div>
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>

<script>
  const exportBtn = document.getElementById('exportCsvBtn');
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      const table = document.getElementById('attendeesTable');
      if (!table) return;
      const rows = table.querySelectorAll('tr');
      const csvLines: string[] = [];
      rows.forEach((row) => {
        const cells = row.querySelectorAll('th, td');
        const line = Array.from(cells).map((cell) => {
          const text = cell.textContent?.trim().replace(/"/g, '""') || '';
          return `"${text}"`;
        }).join(',');
        csvLines.push(line);
      });
      const csv = csvLines.join('\n');
      const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `asistentes_${new Date().toISOString().split('T')[0]}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });
  }
</script>
