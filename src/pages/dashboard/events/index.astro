---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { Plus, Calendar, MapPin, Eye, Edit, ListFilter, Globe, FileText, QrCode } from "lucide-vue-next";
import { getSupabaseAdmin } from "../../../lib/auth-helpers";
import { hasRole, EVENT_MANAGER_ROLES } from "../../../lib/supabaseServer";
import { requireDashboardSession } from "../_lib/guard";
import { getStaffEventIds } from "../../../../netlify/lib/event-staff.mjs";

// Todos los roles pueden ver la lista (los validadores solo acceden al check-in)
const guard = await requireDashboardSession(Astro);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const canManage = hasRole(dbUser, EVENT_MANAGER_ROLES);

const events: any[] = [];
{
  // archived_at (202610090200): los archivados se ocultan de "Todos" y se ven en "Archivados".
  // Sin la columna (deploy preview sin migrar) se lista sin ella.
  const load = (cols: string) =>
    getSupabaseAdmin()
      .from("events")
      .select(cols)
      .eq("organization_id", dbUser.organization_id)
      .order("created_at", { ascending: false });
  let { data, error } = await load("id, name, slug, status, image_url, start_date, location, created_at, archived_at");
  if (error) ({ data } = await load("id, name, slug, status, image_url, start_date, location, created_at"));
  if (data) events.push(...data);
}
// Acceso por evento (aitickets_event_staff): un miembro con eventos asignados solo ve esos
const staffEventIds = await getStaffEventIds(getSupabaseAdmin(), dbUser.id);
if (staffEventIds) events.splice(0, events.length, ...events.filter((e) => staffEventIds.includes(Number(e.id))));
const hasArchived = events.some((e) => e.archived_at);
const cardStatus = (e: any) => (e.archived_at ? "archived" : e.status === "published" ? "published" : "draft");
---

<DashboardLayout title="Mis Eventos">
  <div
    class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8"
  >
    <div>
      <h1 class="text-3xl font-bold font-[Unbounded] mb-2">Mis Eventos</h1>
      <p class="text-gray-600">Gestiona y monitorea todos tus eventos.</p>
    </div>

    {canManage && (
      <a
        href="/dashboard/events/create"
        class="inline-flex items-center gap-2 bg-black text-white px-5 py-2.5 rounded-lg hover:bg-gray-800 transition font-medium"
      >
        <Plus size={20} />
        Crear Evento
      </a>
    )}
  </div>

  {
    !events || events.length === 0 ? (
      <div
        id="empty-state"
        class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center"
      >
        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-400">
          <Calendar size={32} />
        </div>
        <h3 class="text-xl font-bold mb-2">No tienes eventos activos</h3>
        <p class="text-gray-500 mb-6">
          Crea tu primer evento para comenzar a vender entradas.
        </p>
        {canManage && (
          <a
            href="/dashboard/events/create"
            class="inline-flex bg-black text-white px-6 py-3 rounded-lg hover:bg-gray-800 transition font-medium"
          >
            Crear Evento
          </a>
        )}
      </div>
    ) : (
      <>
        <!-- Status Filter Buttons -->
        <div class="flex flex-wrap gap-3 mb-6">
          <button
            type="button"
            data-status-filter="all"
            class="status-filter-btn flex items-center gap-2 px-3 py-1.5 bg-gray-900 text-white rounded-full border border-gray-900 cursor-pointer transition-all hover:opacity-90"
          >
            <ListFilter size={14} />
            <span class="text-xs font-medium">Todos</span>
          </button>
          <button
            type="button"
            data-status-filter="published"
            class="status-filter-btn flex items-center gap-2 px-3 py-1.5 bg-green-50 rounded-full border border-green-100 cursor-pointer transition-all hover:bg-green-100"
          >
            <Globe size={14} class="text-green-600" />
            <span class="text-xs font-medium text-green-700">Publicados</span>
          </button>
          <button
            type="button"
            data-status-filter="draft"
            class="status-filter-btn flex items-center gap-2 px-3 py-1.5 bg-gray-50 rounded-full border border-gray-200 cursor-pointer transition-all hover:bg-gray-100"
          >
            <FileText size={14} class="text-gray-500" />
            <span class="text-xs font-medium text-gray-600">Borradores</span>
          </button>
          {hasArchived && (
            <button
              type="button"
              data-status-filter="archived"
              class="status-filter-btn flex items-center gap-2 px-3 py-1.5 bg-gray-50 rounded-full border border-gray-200 cursor-pointer transition-all hover:bg-gray-100"
            >
              <span class="text-xs font-medium text-gray-600">Archivados</span>
            </button>
          )}
        </div>

        <div
          id="events-grid"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
        >
          {events.map((event) => (
            <div class="event-card bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group" data-status={cardStatus(event)} style={event.archived_at ? "display:none" : undefined}>
            <div class="aspect-video bg-gray-200 relative overflow-hidden">
              {event.image_url ? (
                <img src={event.image_url} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400">
                  <Calendar size={32} />
                </div>
              )}
            </div>

            <div class="p-5">
              <div class="flex justify-between items-start mb-2">
                <span
                  class={`px-2 py-1 text-xs font-medium rounded-full ${event.status === "published" ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600"}`}
                >
                  {event.status === "published" ? "Publicado" : "Borrador"}
                </span>
                <span class="text-xs text-gray-500">
                  {event.start_date
                    ? new Date(event.start_date).toLocaleDateString("es-CL", { timeZone: "America/Santiago" })
                    : "Sin fecha"}
                </span>
              </div>

              <h3 class="font-bold text-lg mb-2 font-[Unbounded] line-clamp-1">
                {event.name}
              </h3>

              <div class="flex items-center gap-2 text-sm text-gray-600 mb-4">
                <MapPin size={16} />
                <span class="truncate">
                  {event.location || "Ubicación por definir"}
                </span>
              </div>

              <div class="flex gap-2 mt-4 pt-4 border-t border-gray-50">
                {canManage ? (
                  <>
                    <a
                      href={`/dashboard/events/${event.id}`}
                      class="flex-1 flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium text-gray-700 bg-gray-50 rounded-lg hover:bg-gray-100 transition"
                    >
                      <Eye size={16} /> Gestionar
                    </a>
                    <a
                      href={`/dashboard/events/${event.id}/edit`}
                      class="flex-1 flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium text-white bg-black rounded-lg hover:bg-gray-800 transition"
                    >
                      <Edit size={16} /> Editar
                    </a>
                  </>
                ) : (
                  <a
                    href={`/dashboard/events/${event.id}/checkin`}
                    class="flex-1 flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium text-white bg-black rounded-lg hover:bg-gray-800 transition"
                  >
                    <QrCode size={16} /> Check-in
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </>
    )
  }
</DashboardLayout>

<script>
  const statusFilterBtns = document.querySelectorAll('.status-filter-btn');
  const eventCards = document.querySelectorAll('.event-card');

  function setActiveFilter(activeBtn: HTMLElement) {
    statusFilterBtns.forEach(btn => {
      const status = (btn as HTMLElement).dataset.statusFilter;
      btn.classList.remove('bg-gray-900', 'text-white', 'border-gray-900');

      if (status === 'all') {
        btn.classList.add('bg-gray-100', 'text-gray-700', 'border-gray-200');
      } else if (status === 'published') {
        btn.classList.add('bg-green-50', 'text-green-700', 'border-green-100');
      } else if (status === 'draft' || status === 'archived') {
        btn.classList.add('bg-gray-50', 'text-gray-600', 'border-gray-200');
      }
    });

    activeBtn.classList.remove(
      'bg-gray-100', 'text-gray-700', 'border-gray-200',
      'bg-green-50', 'text-green-700', 'border-green-100',
      'bg-gray-50', 'text-gray-600'
    );
    activeBtn.classList.add('bg-gray-900', 'text-white', 'border-gray-900');
  }

  function filterByStatus(status: string) {
    eventCards.forEach(card => {
      const cardStatus = (card as HTMLElement).dataset.status;
      // "Todos" no incluye los archivados
      if ((status === 'all' && cardStatus !== 'archived') || cardStatus === status) {
        (card as HTMLElement).style.display = '';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  statusFilterBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const status = target.dataset.statusFilter || 'all';
      setActiveFilter(target);
      filterByStatus(status);
    });
  });
</script>
