---
import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import EditEventForm from "../../../../components/events/EditEventForm.vue";
import { getSupabaseAdmin } from "../../../../lib/auth-helpers";
import { listOrgVenues, type OrgVenue } from "../../../../lib/orgVenues";
import { EVENT_MANAGER_ROLES } from "../../../../lib/supabaseServer";
import { requireDashboardSession } from "../../_lib/guard";
import { decodeBasicEntities } from "../../../../lib/sanitize";

const { id } = Astro.params;
const guard = await requireDashboardSession(Astro, EVENT_MANAGER_ROLES);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const supabaseAdmin = getSupabaseAdmin();

// Fetch Full Event Data
const { data: event, error } = await supabaseAdmin
    .from("events")
    .select(
        `
        id, name, description, image_url, accessibility, status,
        event_tags ( category_tags ( name ) ),
        event_tickets (
          id,
          ticket_name,
          price,
          total_quantity,
          status,
          event_date_id
        ),
        event_locations (
           id,
           venue_id,
           name,
           dates:event_dates (
             id,
             date,
             start_time,
             end_time
           ),
           venue:venues (
             id,
             name,
             city
           )
        )
    `,
    )
    .eq("id", id)
    .eq("organization_id", dbUser.organization_id)
    .single();

if (error || !event) {
    console.error("Edit fetch error", error);
    return Astro.redirect("/dashboard/events");
}

// Transform Data to Form State
const initialFormState = {
    general: {
        name: event.name,
        // Descripción guardada como texto plano sanitizado: mostrar sin entidades HTML en el textarea
        description: /<\/?[a-z][^>]*>/i.test(event.description || "") ? event.description : decodeBasicEntities(event.description || ""),
        imageUrl: event.image_url || "",
        category: (event as any).event_tags?.[0]?.category_tags?.name || "",
        isPrivate: event.accessibility === "private",
    },
    locations:
        event.event_locations?.map((loc: any) => ({
            id: loc.id,
            venueId: loc.venue_id,
            isNewVenue: false,
            newVenueName: "",
            newVenueAddress: "",
            newVenueCity: "",
            // Ubicación sin funciones (p. ej. evento duplicado): se ofrece una fecha vacía para completar
            dates: loc.dates?.length
                ? loc.dates.map((d: any) => ({
                      id: d.id,
                      date: d.date,
                      startTime: d.start_time?.slice(0, 5) || "21:00",
                      endTime: d.end_time?.slice(0, 5) || "",
                  }))
                : [{ id: Date.now(), date: "", startTime: "21:00", endTime: "" }],
        })) || [],
    tickets:
        event.event_tickets?.filter((t: any) => t.status !== "unavailable").map((t: any) => ({
            id: t.id,
            name: t.ticket_name,
            price: Number(t.price),
            quantity: t.total_quantity,
            description: "",
            // R1: "" = todas las funciones
            eventDateId: t.event_date_id ?? "",
        })) || [],
};

// Lugares para el selector: solo los de mi organización o los que ya usan mis eventos
let venues: OrgVenue[] = [];
try {
    ({ venues } = await listOrgVenues(supabaseAdmin, dbUser.organization_id));
} catch (err) {
    console.error("Venues fetch error", err);
}
---

<DashboardLayout title={`Editar ${event.name}`}>
    <div class="max-w-4xl mx-auto">
        <div class="mb-8">
            <a
                href={`/dashboard/events/${id}`}
                class="text-gray-500 hover:text-black mb-2 inline-block text-sm"
                >&larr; Volver al Dashboard</a
            >
            <h1 class="text-3xl font-bold font-[Unbounded]">Editar Evento</h1>
        </div>

        <EditEventForm
            client:load
            eventId={id!}
            initialFormState={initialFormState}
            initialVenues={venues}
            eventStatus={(event as any).status || "draft"}
        />
    </div>
</DashboardLayout>
