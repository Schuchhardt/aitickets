---
import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import EditEventForm from "../../../../components/events/EditEventForm.vue";
import { getSupabaseAdmin } from "../../../../lib/auth-helpers";
import { listOrgVenues, type OrgVenue } from "../../../../lib/orgVenues";
import { EVENT_MANAGER_ROLES } from "../../../../lib/supabaseServer";
import { requireDashboardSession } from "../../_lib/guard";
import { canAccessEventByStaff } from "../../../../../netlify/lib/event-staff.mjs";
import { decodeBasicEntities } from "../../../../lib/sanitize";
import { normalizePageSettings } from "../../../../lib/eventPageSettings";
import { isDemoEventSlug } from "../../../../lib/demoEvent.mjs";
import { normalizeReviewSettings } from "../../../../../netlify/lib/reviews.mjs";
import { siteUrl as siteUrlFromEnv } from "../../../api/_lib/server-utils";
import { loadTicketChain, loadPeoplePerTicket } from "../../../../../netlify/lib/tickets.mjs";
import { normalizeCheckoutFields } from "../../../../lib/checkoutFields.mjs";
import { loadEntryDeadlines } from "../../../../../netlify/lib/checkin.mjs";
import { loadSecretLocation } from "../../../../../netlify/lib/secret-location.mjs";

const { id } = Astro.params;
const guard = await requireDashboardSession(Astro, EVENT_MANAGER_ROLES);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
// Acceso por evento (aitickets_event_staff): un miembro con eventos asignados solo opera esos
if (!(await canAccessEventByStaff(getSupabaseAdmin(), dbUser.id, Astro.params.id))) return Astro.redirect("/dashboard/events");
const supabaseAdmin = getSupabaseAdmin();

// Fetch Full Event Data
const loadEvent = (coverColumn: string) => supabaseAdmin
    .from("events")
    .select(
        `
        id, name, slug, description, image_url, accessibility, status,${coverColumn}
        event_tags ( category_tags ( name ) ),
        event_tickets (
          id,
          ticket_name,
          price,
          total_quantity,
          status,
          event_date_id
        ),
        event_locations (
           id,
           venue_id,
           name,
           dates:event_dates (
             id,
             date,
             start_time,
             end_time
           ),
           venue:venues (
             id,
             name,
             city
           )
        )
    `,
    )
    .eq("id", id)
    .eq("organization_id", dbUser.organization_id)
    .single();
let { data: event, error }: { data: any; error: any } = await loadEvent(" cover_settings, page_settings, review_settings,");
// Deploy previews: las migraciones de review_settings/page_settings/cover_settings pueden no estar aplicadas todavía
if (error?.code === "42703") ({ data: event, error } = await loadEvent(" cover_settings, page_settings,"));
if (error?.code === "42703") ({ data: event, error } = await loadEvent(" cover_settings,"));
if (error?.code === "42703") ({ data: event, error } = await loadEvent(""));

if (error || !event) {
    console.error("Edit fetch error", error);
    return Astro.redirect("/dashboard/events");
}

// Tandas encadenadas (vacío si la migración 202610290100 aún no está aplicada)
const ticketChain = await loadTicketChain(supabaseAdmin, event.id);
// Mesas para N y qué pedir al comprar (vacíos si las migraciones 202610300100/110 aún no están aplicadas)
const [peoplePerTicket, checkoutFieldsRes] = await Promise.all([
    loadPeoplePerTicket(supabaseAdmin, event.id),
    supabaseAdmin.from("events").select("checkout_fields").eq("id", event.id).maybeSingle(),
]);
const checkoutFields = normalizeCheckoutFields(checkoutFieldsRes.error ? null : (checkoutFieldsRes.data as any)?.checkout_fields);
// Hora límite de ingreso por entrada (vacío si la migración 202610300300 aún no está aplicada)
const entryDeadlines = await loadEntryDeadlines(supabaseAdmin, event.id);
// Dirección que solo ven quienes compran (secret_location) y cuándo se revela
const secretLocation = await loadSecretLocation(supabaseAdmin, event.id).catch(() => ({ address: null, revealHours: null }));
// Solo cuenta si la anterior sigue en el formulario (las retiradas de la venta no se muestran)
const visibleTicketIds = new Set((event.event_tickets || []).filter((t: any) => t.status !== "unavailable").map((t: any) => Number(t.id)));

// Transform Data to Form State
const initialFormState = {
    general: {
        name: event.name,
        // Link público /eventos/<slug> (editable; src/lib/eventSlug.ts crea el redirect si ya circula)
        slug: event.slug || "",
        // Descripción guardada como texto plano sanitizado: mostrar sin entidades HTML en el textarea
        description: /<\/?[a-z][^>]*>/i.test(event.description || "") ? event.description : decodeBasicEntities(event.description || ""),
        imageUrl: event.image_url || "",
        coverSettings: event.cover_settings || null,
        pageSettings: normalizePageSettings(event.page_settings),
        category: (event as any).event_tags?.[0]?.category_tags?.name || "",
        isPrivate: event.accessibility === "private",
        checkoutFields,
        secretLocation: secretLocation.address || "",
        secretLocationRevealHours: secretLocation.revealHours ?? "",
    },
    // Toggle al final del formulario: correo "¿Cómo estuvo?" 24 h después de cada función
    reviews: { enabled: normalizeReviewSettings(event.review_settings).enabled },
    locations:
        event.event_locations?.map((loc: any) => ({
            id: loc.id,
            venueId: loc.venue_id,
            isNewVenue: false,
            newVenueName: "",
            newVenueAddress: "",
            newVenueCity: "",
            // Ubicación sin funciones (p. ej. evento duplicado): se ofrece una fecha vacía para completar
            dates: loc.dates?.length
                ? loc.dates.map((d: any) => ({
                      id: d.id,
                      date: d.date,
                      startTime: d.start_time?.slice(0, 5) || "21:00",
                      endTime: d.end_time?.slice(0, 5) || "",
                  }))
                : [{ id: Date.now(), date: "", startTime: "21:00", endTime: "" }],
        })) || [],
    tickets:
        event.event_tickets?.filter((t: any) => t.status !== "unavailable").map((t: any) => ({
            id: t.id,
            name: t.ticket_name,
            price: Number(t.price),
            quantity: t.total_quantity,
            description: "",
            // R1: "" = todas las funciones
            eventDateId: t.event_date_id ?? "",
            peoplePerTicket: peoplePerTicket.get(Number(t.id)) || 1,
            opensAfterId: visibleTicketIds.has(Number(ticketChain.get(Number(t.id)))) ? ticketChain.get(Number(t.id)) : "",
            entryUntil: entryDeadlines.get(Number(t.id)) || "",
        })) || [],
};

// Asistentes confirmados (entradas no anuladas): el aviso por correo solo se ofrece si hay
const { count: attendeeCount } = await supabaseAdmin
    .from("event_attendees")
    .select("id", { count: "exact", head: true })
    .eq("event_id", event.id)
    .or("status.is.null,status.neq.cancelled");

const siteUrl = (siteUrlFromEnv() || Astro.url.origin).replace(/\/+$/, "");

// Lugares para el selector: solo los de mi organización o los que ya usan mis eventos
let venues: OrgVenue[] = [];
try {
    ({ venues } = await listOrgVenues(supabaseAdmin, dbUser.organization_id));
} catch (err) {
    console.error("Venues fetch error", err);
}
---

<DashboardLayout title={`Editar ${event.name}`}>
    <div class="max-w-4xl mx-auto">
        <div class="mb-6 md:mb-8">
            <a
                href={`/dashboard/events/${id}`}
                class="text-gray-500 hover:text-black mb-2 inline-block text-sm"
                >&larr; Volver al Dashboard</a
            >
            <h1 class="text-2xl md:text-3xl font-bold font-[Unbounded]">Editar Evento</h1>
        </div>

        <EditEventForm
            client:load
            eventId={id!}
            initialFormState={initialFormState}
            initialVenues={venues}
            eventStatus={(event as any).status || "draft"}
            attendeeCount={attendeeCount || 0}
            publicBaseUrl={`${siteUrl}/eventos/`}
            slugLocked={isDemoEventSlug(event.slug)}
        />
    </div>
</DashboardLayout>
