---
import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import { getSupabaseAdmin } from "../../../../lib/auth-helpers";
import ValidateQR from "../../../../components/ValidateQR.vue";
import { requireDashboardSession } from "../../_lib/guard";
import { canAccessEventByStaff } from "../../../../../netlify/lib/event-staff.mjs";
import { CHECKIN_ROLES, loadCheckinEvent, validatorEventPath } from "../../../../lib/validatorApp";

// Check-in dentro del panel (dueños, administradores y marketing). El rol Puerta usa la app de puerta
// (/validador/<slug>, sin el menú del panel): se lo redirige allá.
const { id } = Astro.params;
const guard = await requireDashboardSession(Astro, CHECKIN_ROLES);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const supabaseAdmin = getSupabaseAdmin();
// Acceso por evento (aitickets_event_staff): un miembro con eventos asignados solo opera esos
if (!(await canAccessEventByStaff(supabaseAdmin, dbUser.id, id))) return Astro.redirect(dbUser.role === "validator" ? "/validador" : "/dashboard/events");

const { data: eventRow, error } = await supabaseAdmin
    .from("events")
    .select("id, name, slug, start_date")
    .eq("id", id)
    .eq("organization_id", dbUser.organization_id)
    .single();

if (error || !eventRow) {
    return Astro.redirect(dbUser.role === "validator" ? "/validador" : "/dashboard/events");
}
if (dbUser.role === "validator") return Astro.redirect(validatorEventPath(eventRow.slug));

// Entradas (paginadas), funciones, ingresos por función y hora límite (src/lib/validatorApp.ts)
const event = await loadCheckinEvent(supabaseAdmin, eventRow);
const validatorHref = validatorEventPath(event.slug);
---

<DashboardLayout title={`Check-in · ${event.name}`}>
    <div class="mb-6">
        <div class="flex items-center gap-2 sm:gap-3 mb-2 min-w-0 text-sm sm:text-base">
            <a
                href="/dashboard/events"
                class="text-gray-500 hover:text-black transition">Eventos</a
            >
            <span class="text-gray-300">/</span>
            <a
                href={`/dashboard/events/${event.id}`}
                class="text-gray-500 hover:text-black transition truncate min-w-0 max-w-[200px]"
                >{event.name}</a
            >
            <span class="text-gray-300">/</span>
            <span class="text-gray-900 font-medium">Check-in</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-bold font-[Unbounded]">Check-in</h1>
        <p class="text-sm sm:text-base text-gray-500 mt-1">Escanea los códigos QR, busca asistentes por nombre o email para validarlos manualmente, o reenvía sus entradas.</p>
        <div class="mt-3 flex flex-col sm:flex-row sm:items-center gap-2 text-sm bg-gray-50 border border-gray-200 rounded-lg p-3">
            <p class="text-gray-600 flex-1">
                Para la puerta usa el <strong>validador</strong> en el teléfono: pantalla completa y sigue funcionando sin conexión.
                Tu equipo de puerta entra con el rol <strong>Puerta</strong> en <span class="font-mono">aitickets.cl/validador</span> (créalo en <a href="/dashboard/team" class="underline">Equipo</a>).
            </p>
            <a href={validatorHref} class="shrink-0 inline-flex items-center justify-center px-3 py-2 rounded-lg bg-black text-white font-medium hover:bg-gray-800" data-testid="open-validator">
                Abrir validador
            </a>
        </div>
    </div>

    <ValidateQR event={event} client:load />
</DashboardLayout>
