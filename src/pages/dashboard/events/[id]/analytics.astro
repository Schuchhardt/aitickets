---
import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import { getSupabaseAdmin } from "../../../../lib/auth-helpers";
import LineChart from "../../../../components/dashboard/analytics/LineChart.vue";
import BarChart from "../../../../components/dashboard/analytics/BarChart.vue";
import GeoTable from "../../../../components/dashboard/analytics/GeoTable.vue";
import { Eye, Users, Ticket, BarChart3, TrendingUp, Gauge } from "lucide-vue-next";
import { EVENT_MANAGER_ROLES } from "../../../../lib/supabaseServer";
import { requireDashboardSession } from "../../_lib/guard";
import { canAccessEventByStaff } from "../../../../../netlify/lib/event-staff.mjs";
import { getEventAnalytics } from "../../../../lib/eventAnalytics";

const { id } = Astro.params;
const guard = await requireDashboardSession(Astro, EVENT_MANAGER_ROLES);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
// Acceso por evento (aitickets_event_staff): un miembro con eventos asignados solo opera esos
if (!(await canAccessEventByStaff(getSupabaseAdmin(), dbUser.id, Astro.params.id))) return Astro.redirect("/dashboard/events");
const supabaseAdmin = getSupabaseAdmin();

const { data: event, error } = await supabaseAdmin
    .from("events")
    .select("id, name, slug, status")
    .eq("id", id)
    .eq("organization_id", dbUser.organization_id)
    .single();

if (error || !event) {
    return Astro.redirect("/dashboard/events");
}

// Toda la analítica sale de src/lib/eventAnalytics.ts (la misma que usan get_event_performance y el resumen del
// evento): paginada, en hora de Chile y con las definiciones canónicas (ventas sin cortesías ni transferencias;
// conversión = órdenes ÷ visitantes únicos; ocupación = emitidas ÷ capacidad).
const analytics = await getEventAnalytics(supabaseAdmin, { id: Number(event.id), status: event.status });
const { kpis } = analytics;
const fmtPct = (v: number | null) => (v == null ? "—" : `${v.toLocaleString("es-CL")}%`);

const visitDates = analytics.daily.map((d) => d.date);
const visitCounts = analytics.daily.map((d) => d.visits);
const salesDates = visitDates;
const salesCounts = analytics.daily.map((d) => d.tickets);

const hourCounts = analytics.peak_hours;
const hourLabels = hourCounts.map((_: number, i: number) => `${i.toString().padStart(2, "0")}:00`);

const sourceLabels = analytics.sources.map((s) => s.source);
const sourceValues = analytics.sources.map((s) => s.visits);

const ticketLabels = analytics.ticket_types.map((t) => t.name);
const ticketValues = analytics.ticket_types.map((t) => t.tickets);

const geoData = analytics.locations.map(({ location, visits, percentage }) => ({ location, visits, percentage }));

const channelRows = analytics.channels.map((c) => ({ ...c, channel: c.channel.startsWith("ref:") ? `ref: ${c.channel.slice(4)}` : c.channel }));
const providerRows = analytics.providers;
const refundedOrders = analytics.refunded_orders;

// --- Chart Data Serialization ---
const visitsDatasets = JSON.stringify([
    {
        label: "Visitas",
        data: visitCounts,
        borderColor: "#2563eb",
        backgroundColor: "rgba(37, 99, 235, 0.1)",
        fill: true,
        tension: 0.3,
        pointRadius: 2,
    },
]);

const salesDatasets = JSON.stringify([
    {
        label: "Entradas vendidas",
        data: salesCounts,
        borderColor: "#16a34a",
        backgroundColor: "rgba(22, 163, 74, 0.1)",
        fill: true,
        tension: 0.3,
        pointRadius: 2,
    },
]);

const sourceDatasets = JSON.stringify([
    {
        data: sourceValues,
        backgroundColor: ["#111827", "#2563eb", "#7c3aed", "#db2777", "#ea580c", "#ca8a04", "#059669", "#6b7280"],
        borderRadius: 4,
    },
]);

const ticketDatasets = JSON.stringify([
    {
        data: ticketValues,
        backgroundColor: ["#2563eb", "#7c3aed", "#db2777", "#ea580c", "#ca8a04", "#059669"],
        borderRadius: 4,
    },
]);

const peakDatasets = JSON.stringify([
    {
        data: hourCounts,
        backgroundColor: "#e5e7eb",
        hoverBackgroundColor: "#111827",
        borderRadius: 4,
    },
]);
---

<DashboardLayout title={`Analytics · ${event.name}`}>
    <div class="mb-6">
        <div class="flex items-center gap-2 sm:gap-3 mb-2 min-w-0 text-sm sm:text-base">
            <a href="/dashboard/events" class="text-gray-500 hover:text-black transition">Eventos</a>
            <span class="text-gray-300">/</span>
            <a
                href={`/dashboard/events/${event.id}`}
                class="text-gray-500 hover:text-black transition truncate min-w-0 max-w-[200px]"
            >{event.name}</a>
            <span class="text-gray-300">/</span>
            <span class="text-gray-900 font-medium">Analytics</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-bold font-[Unbounded]">Analytics</h1>
        <p class="text-gray-500 mt-1">Resumen de rendimiento de tu evento.</p>
    </div>

    <!-- Summary Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3 sm:gap-4 mb-8">
        <div class="bg-white p-4 sm:p-5 rounded-xl border border-gray-200 shadow-sm min-w-0">
            <div class="p-2 bg-blue-50 text-blue-600 rounded-lg w-fit mb-3">
                <Eye size={18} />
            </div>
            <p class="text-gray-500 text-xs mb-1">Visitas</p>
            <h3 class="text-lg sm:text-xl font-bold break-words">{kpis.visits.toLocaleString("es-CL")}</h3>
        </div>
        <div class="bg-white p-4 sm:p-5 rounded-xl border border-gray-200 shadow-sm min-w-0">
            <div class="p-2 bg-purple-50 text-purple-600 rounded-lg w-fit mb-3">
                <Users size={18} />
            </div>
            <p class="text-gray-500 text-xs mb-1">Visitantes únicos</p>
            <h3 class="text-lg sm:text-xl font-bold break-words">{kpis.unique_visitors.toLocaleString("es-CL")}</h3>
        </div>
        <div class="bg-white p-4 sm:p-5 rounded-xl border border-gray-200 shadow-sm min-w-0">
            <div class="p-2 bg-green-50 text-green-600 rounded-lg w-fit mb-3">
                <Ticket size={18} />
            </div>
            <p class="text-gray-500 text-xs mb-1">Entradas vendidas</p>
            <h3 class="text-lg sm:text-xl font-bold break-words">{kpis.tickets_sold.toLocaleString("es-CL")}</h3>
            {kpis.courtesy_tickets > 0 && <p class="text-xs text-gray-400 mt-1">+ {kpis.courtesy_tickets.toLocaleString("es-CL")} cortesías</p>}
        </div>
        <div class="bg-white p-4 sm:p-5 rounded-xl border border-gray-200 shadow-sm min-w-0">
            <div class="p-2 bg-orange-50 text-orange-600 rounded-lg w-fit mb-3">
                <BarChart3 size={18} />
            </div>
            <p class="text-gray-500 text-xs mb-1">Ingresos</p>
            <h3 class="text-lg sm:text-xl font-bold break-words">${kpis.revenue_clp.toLocaleString("es-CL")}</h3>
            <p class="text-xs text-gray-400 mt-1">{kpis.paid_orders.toLocaleString("es-CL")} órdenes</p>
        </div>
        <div class="bg-white p-4 sm:p-5 rounded-xl border border-gray-200 shadow-sm min-w-0">
            <div class="p-2 bg-pink-50 text-pink-600 rounded-lg w-fit mb-3">
                <TrendingUp size={18} />
            </div>
            <p class="text-gray-500 text-xs mb-1">Conversión</p>
            <h3 class="text-lg sm:text-xl font-bold break-words">{fmtPct(kpis.conversion_pct)}</h3>
            <p class="text-xs text-gray-400 mt-1">órdenes ÷ visitantes únicos</p>
        </div>
        <div class="bg-white p-4 sm:p-5 rounded-xl border border-gray-200 shadow-sm min-w-0">
            <div class="p-2 bg-gray-100 text-gray-700 rounded-lg w-fit mb-3">
                <Gauge size={18} />
            </div>
            <p class="text-gray-500 text-xs mb-1">Ocupación</p>
            <h3 class="text-lg sm:text-xl font-bold break-words">{fmtPct(kpis.sell_through_pct)}</h3>
            <p class="text-xs text-gray-400 mt-1">{kpis.capacity == null ? `${kpis.issued_tickets.toLocaleString("es-CL")} emitidas · sin límite` : `${kpis.issued_tickets.toLocaleString("es-CL")} emitidas de ${kpis.capacity.toLocaleString("es-CL")}`}</p>
        </div>
    </div>
    {analytics.visits_truncated && (
        <p class="text-xs text-gray-500 -mt-5 mb-6">Mostrando las primeras 50.000 visitas en los gráficos de tráfico.</p>
    )}

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
        <LineChart
            client:visible
            title={analytics.series_truncated ? "Visitas por día (último año)" : "Visitas por día"}
            labelsJson={JSON.stringify(visitDates)}
            datasetsJson={visitsDatasets}
        />
        <LineChart
            client:visible
            title={analytics.series_truncated ? "Entradas vendidas por día (último año)" : "Entradas vendidas por día"}
            labelsJson={JSON.stringify(salesDates)}
            datasetsJson={salesDatasets}
        />
        <BarChart
            client:visible
            title="Fuentes de tráfico"
            horizontal
            labelsJson={JSON.stringify(sourceLabels)}
            datasetsJson={sourceDatasets}
        />
        <BarChart
            client:visible
            horizontal={false}
            title="Entradas vigentes por tipo"
            labelsJson={JSON.stringify(ticketLabels)}
            datasetsJson={ticketDatasets}
        />
        <BarChart
            client:visible
            horizontal={false}
            title="Horas pico de visitas (hora de Chile)"
            labelsJson={JSON.stringify(hourLabels)}
            datasetsJson={peakDatasets}
        />
        <GeoTable
            client:visible
            title="Ubicación de visitantes"
            dataJson={JSON.stringify(geoData)}
        />
    </div>

    <!-- Ventas y conversión por canal (UTM / ref) -->
    <div class="bg-white p-4 sm:p-6 rounded-xl border border-gray-200 shadow-sm mt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
            <h3 class="font-bold text-lg">Ventas por canal</h3>
            <a href={`/dashboard/events/${event.id}#trackingBuilder`} class="text-sm text-blue-600 hover:underline">Crear link con seguimiento</a>
        </div>
        {channelRows.length === 0 ? (
            <p class="text-sm text-gray-500">Aún no hay visitas ni ventas. Comparte links con <code>utm_source</code> o <code>ref</code> para saber qué canal vende más.</p>
        ) : (
            <div class="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-gray-500 border-b border-gray-100">
                            <th class="py-2 pr-4 font-medium">Canal</th>
                            <th class="py-2 pr-4 font-medium text-right whitespace-nowrap">Visitantes</th>
                            <th class="py-2 pr-4 font-medium text-right whitespace-nowrap">Órdenes</th>
                            <th class="py-2 pr-4 font-medium text-right whitespace-nowrap">Conversión</th>
                            <th class="py-2 pr-4 font-medium text-right whitespace-nowrap">Entradas</th>
                            <th class="py-2 font-medium text-right whitespace-nowrap">Ingresos</th>
                        </tr>
                    </thead>
                    <tbody>
                        {channelRows.map((row) => (
                            <tr class="border-b border-gray-50">
                                <td class="py-2 pr-4 text-gray-900 break-all min-w-[8rem]">{row.channel}</td>
                                <td class="py-2 pr-4 text-right whitespace-nowrap">{row.unique_visitors == null ? "—" : row.unique_visitors.toLocaleString("es-CL")}</td>
                                <td class="py-2 pr-4 text-right whitespace-nowrap">{row.orders}</td>
                                <td class="py-2 pr-4 text-right whitespace-nowrap">{fmtPct(row.conversion_pct)}</td>
                                <td class="py-2 pr-4 text-right whitespace-nowrap">{row.tickets}</td>
                                <td class="py-2 text-right whitespace-nowrap">${row.revenue_clp.toLocaleString("es-CL")}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        )}
        <p class="text-xs text-gray-400 mt-3">
            Visitantes según el link con que llegaron; órdenes según la atribución guardada en la compra. Las visitas empezaron a registrar <code>ref</code> con esta versión de la analítica: en ventas por <code>ref</code> anteriores la conversión puede no mostrarse.
            Ventas sin cortesías ni transferencias. Fechas y horas en horario de Chile continental.
        </p>
    </div>

    {providerRows.length > 0 && (
        <div class="bg-white p-4 sm:p-6 rounded-xl border border-gray-200 shadow-sm mt-6">
            <h3 class="font-bold text-lg mb-4">Ventas por medio de pago</h3>
            <div class="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-gray-500 border-b border-gray-100">
                            <th class="py-2 pr-4 font-medium">Medio de pago</th>
                            <th class="py-2 pr-4 font-medium text-right whitespace-nowrap">Órdenes</th>
                            <th class="py-2 pr-4 font-medium text-right whitespace-nowrap">Entradas</th>
                            <th class="py-2 font-medium text-right whitespace-nowrap">Ingresos</th>
                        </tr>
                    </thead>
                    <tbody>
                        {providerRows.map((row) => (
                            <tr class="border-b border-gray-50">
                                <td class="py-2 pr-4 text-gray-900">{row.label}</td>
                                <td class="py-2 pr-4 text-right whitespace-nowrap">{row.orders}</td>
                                <td class="py-2 pr-4 text-right whitespace-nowrap">{row.tickets}</td>
                                <td class="py-2 text-right whitespace-nowrap">${row.revenue_clp.toLocaleString("es-CL")}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            {(refundedOrders || 0) > 0 && (
                <p class="text-xs text-gray-500 mt-3">{refundedOrders} orden(es) reembolsada(s) no se incluyen en las ventas. Las cortesías y transferencias tampoco.</p>
            )}
        </div>
    )}
</DashboardLayout>
