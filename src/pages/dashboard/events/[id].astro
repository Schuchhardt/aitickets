---
import { siteUrl as siteUrlFromEnv } from "../../api/_lib/server-utils";
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import EventFAQManager from "../../../components/dashboard/EventFAQManager.vue";
import CourtesyTicketsForm from "../../../components/dashboard/CourtesyTicketsForm.vue";
import DiscountCodesManager from "../../../components/dashboard/DiscountCodesManager.vue";
import { getSupabaseAdmin } from "../../../lib/auth-helpers";
import { EVENT_MANAGER_ROLES } from "../../../lib/supabaseServer";
import { requireDashboardSession } from "../_lib/guard";
import {
    Calendar,
    MapPin,
    Ticket,
    CheckCircle,
    AlertCircle,
    Eye,
    Edit,
    Share2,
    BarChart3,
    Users,
    Copy,
    Download,
} from "lucide-vue-next";

const { id } = Astro.params;
const guard = await requireDashboardSession(Astro, EVENT_MANAGER_ROLES);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const supabaseAdmin = getSupabaseAdmin();

// Detalle del evento (solo si pertenece a la organización)
const { data: event, error } = await supabaseAdmin
    .from("events")
    .select(
        `
    id, name, slug, status, start_date, end_date, location, accessibility,
    event_tickets (
      id,
      ticket_name,
      price,
      total_quantity,
      status
    ),
    event_dates ( id ),
    event_locations (
      id,
      venues (
        name,
        city
      )
    )
  `,
    )
    .eq("id", id)
    .eq("organization_id", dbUser.organization_id)
    .single();

if (error || !event) {
    return Astro.redirect("/dashboard/events");
}

// Calculate Stats
const totalTickets =
    event.event_tickets?.reduce(
        (acc: number, t: any) => acc + (t.total_quantity || t.quantity || 0),
        0,
    ) || 0;

// Real ticket sales from event_attendees
const { count: ticketsSold } = await supabaseAdmin
    .from("event_attendees")
    .select("id", { count: "exact", head: true })
    .eq("event_id", event.id)
    .or("status.is.null,status.neq.cancelled"); // anuladas (reembolsos) no cuentan

// Real revenue from paid orders
const { data: ordersData } = await supabaseAdmin
    .from("event_orders")
    .select("amount")
    .eq("event_id", event.id)
    .eq("status", "paid");
const totalRevenue = ordersData?.reduce((sum, o) => sum + (o.amount || 0), 0) || 0;

// Per-ticket sales counts
const { data: ticketSalesData } = await supabaseAdmin
    .from("event_attendees")
    .select("event_ticket_id")
    .eq("event_id", event.id)
    .or("status.is.null,status.neq.cancelled");
const ticketSalesMap: Record<string, number> = {};
ticketSalesData?.forEach((ea: any) => {
    ticketSalesMap[ea.event_ticket_id] = (ticketSalesMap[ea.event_ticket_id] || 0) + 1;
});

// Total event page visits
const { count: totalVisits } = await supabaseAdmin
    .from("event_visits")
    .select("id", { count: "exact", head: true })
    .eq("event_id", event.id);

// Unique visitors (by ip_hash) — fetch distinct hashes
const { data: uniqueVisitorsData } = await supabaseAdmin
    .from("event_visits")
    .select("ip_hash")
    .eq("event_id", event.id);
const uniqueVisitors = new Set(uniqueVisitorsData?.map((v: any) => v.ip_hash)).size;

const conversion = totalTickets > 0 ? Math.round(((ticketsSold || 0) / totalTickets) * 100) : 0;

const publicLink = `/eventos/${event.slug}`;
const siteUrl = (siteUrlFromEnv() || Astro.url.origin).replace(/\/+$/, "");
const activeTickets = (event.event_tickets || []).filter((t: any) => t.status !== "unavailable");
const courtesyTickets = activeTickets.map((t: any) => ({ id: t.id, ticket_name: t.ticket_name }));
const hasDates = (event.event_dates?.length || 0) > 0 || !!event.start_date;
const publishBlockers = [
    !hasDates ? "Agrega al menos una función (fecha y hora)." : null,
    activeTickets.length === 0 ? "Agrega al menos un tipo de entrada." : null,
].filter(Boolean);
---

<DashboardLayout title={event.name}>
    <!-- Header -->
    <div
        class="flex flex-col md:flex-row md:items-start justify-between gap-6 mb-8"
    >
        <div>
            <div class="flex items-center gap-3 mb-2">
                <a
                    href="/dashboard/events"
                    class="text-gray-500 hover:text-black transition">Eventos</a
                >
                <span class="text-gray-300">/</span>
                <span class="text-gray-900 font-medium truncate max-w-[200px]"
                    >{event.name}</span
                >
            </div>
            <h1 class="text-3xl font-bold font-[Unbounded] mb-2">
                {event.name}
            </h1>
            <div class="flex items-center gap-4 text-sm text-gray-600">
                <span
                    class={`px-3 py-1 rounded-full text-xs font-bold ${event.status === "published" ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700"}`}
                >
                    {event.status === "published" ? "Publicado" : "Borrador"}
                </span>
                <span class="flex items-center gap-1">
                    <Calendar size={16} />
                    {
                        event.start_date
                            ? new Date(event.start_date).toLocaleString("es-CL", { timeZone: "America/Santiago", dateStyle: "medium", timeStyle: "short" })
                            : "Fecha por definir"
                    }
                </span>
            </div>
        </div>

        <div class="flex flex-wrap gap-3">
            <a
                href={publicLink}
                target="_blank"
                class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium"
            >
                <Eye size={18} /> Ver Página
            </a>
            <a
                href={`/dashboard/events/${event.id}/checkin`}
                class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium"
            >
                <CheckCircle size={18} /> Check-in
            </a>
            <a
                href={`/dashboard/events/${event.id}/analytics`}
                class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium"
            >
                <BarChart3 size={18} /> Analytics
            </a>
            <button
                id="duplicateEventBtn"
                type="button"
                data-event-id={event.id}
                class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium"
                title="Crea una copia en borrador con las mismas entradas y lugar, sin fechas"
            >
                <Copy size={18} /> Duplicar
            </button>
            <a
                href={`/dashboard/events/${event.id}/edit`}
                class="flex items-center gap-2 px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-900 transition font-medium"
            >
                <Edit size={18} /> Editar
            </a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <div class="flex justify-between items-start mb-4">
                <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
                    <Eye size={20} />
                </div>
            </div>
            <p class="text-gray-500 text-sm mb-1">Visitas Totales</p>
            <h3 class="text-2xl font-bold">{totalVisits || 0}</h3>
            <p class="text-xs text-gray-400 mt-1">{uniqueVisitors} visitantes únicos</p>
        </div>

        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <div class="flex justify-between items-start mb-4">
                <div class="p-2 bg-purple-50 text-purple-600 rounded-lg">
                    <Ticket size={20} />
                </div>
            </div>
            <p class="text-gray-500 text-sm mb-1">Entradas Vendidas</p>
            <h3 class="text-2xl font-bold">{ticketsSold || 0} / {totalTickets}</h3>
        </div>

        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <div class="flex justify-between items-start mb-4">
                <div class="p-2 bg-green-50 text-green-600 rounded-lg">
                    <BarChart3 size={20} />
                </div>
            </div>
            <p class="text-gray-500 text-sm mb-1">Ingresos Totales</p>
            <h3 class="text-2xl font-bold">${totalRevenue.toLocaleString()}</h3>
        </div>
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <div class="flex justify-between items-start mb-4">
                <div class="p-2 bg-orange-50 text-orange-600 rounded-lg">
                    <Share2 size={20} />
                </div>
            </div>
            <p class="text-gray-500 text-sm mb-1">Conversión</p>
            <h3 class="text-2xl font-bold">{conversion}%</h3>
        </div>
    </div>

    <!-- Main Content Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column: Details -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Tickets Section -->
            <section
                class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden"
            >
                <div
                    class="p-6 border-b border-gray-100 flex justify-between items-center"
                >
                    <h3 class="font-bold text-lg">Tipos de Entrada</h3>
                    <a
                        href={`/dashboard/events/${event.id}/edit`}
                        class="text-sm text-black font-medium hover:underline"
                        >Gestionar</a
                    >
                </div>
                <div class="divide-y divide-gray-100">
                    {
                        event.event_tickets?.map((ticket: any) => (
                            <div class="p-4 flex justify-between items-center hover:bg-gray-50 transition">
                                <div>
                                    <p class="font-bold text-gray-900">
                                        {ticket.ticket_name}
                                    </p>
                                    <p class="text-sm text-gray-500">
                                        ${Number(ticket.price).toLocaleString()}{" "}
                                        • {ticketSalesMap[ticket.id] || 0} emitidas / {ticket.total_quantity ?? "sin límite"}
                                    </p>
                                </div>
                                <div>
                                    <span class={`px-2 py-1 rounded text-xs font-medium ${ticket.status === "unavailable" ? "bg-red-50 text-red-600" : "bg-gray-100 text-gray-600"}`}>
                                        {ticket.status === "unavailable" ? "Retirada" : "Activo"}
                                    </span>
                                </div>
                            </div>
                        ))
                    }
                    {
                        (!event.event_tickets ||
                            event.event_tickets.length === 0) && (
                            <div class="p-8 text-center text-gray-500">
                                No hay entradas configuradas.
                            </div>
                        )
                    }
                </div>
            </section>

            <!-- Cortesías -->
            <CourtesyTicketsForm client:visible eventId={Number(event.id)} tickets={courtesyTickets} />

            <!-- Códigos de descuento (del evento + los de toda la organización) -->
            <DiscountCodesManager client:visible eventId={Number(event.id)} />

            <!-- FAQ Section -->
            <EventFAQManager client:load eventId={Number(event.id)} />
        </div>

        <!-- Right Column: Quick Actions & Public Link -->
        <div class="space-y-6">
            <div
                class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm"
            >
                <h3 class="font-bold text-lg mb-4">Link Público</h3>
                <p class="text-sm text-gray-500 mb-2">
                    Comparte este enlace para vender entradas.
                </p>

                <div class="flex gap-2">
                    <input
                        type="text"
                        readonly
                        value={`${siteUrl}${publicLink}`}
                        class="bg-gray-50 border border-gray-200 text-gray-600 text-sm rounded-lg px-3 py-2 w-full outline-none"
                    />
                    <button
                        id="copyLinkBtn"
                        type="button"
                        data-link={`${siteUrl}${publicLink}`}
                        title="Copiar link"
                        class="p-2 bg-gray-100 hover:bg-gray-200 rounded-lg transition text-gray-700"
                    >
                        <Share2 size={18} />
                    </button>
                </div>
            </div>

            <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm" id="trackingBuilder" data-base={`${siteUrl}${publicLink}`}>
                <h3 class="font-bold text-lg mb-2">Link con seguimiento</h3>
                <p class="text-sm text-gray-500 mb-4">
                    Crea un link por canal (Instagram, un promotor, un afiche) y mira sus visitas y ventas en Analíticas &rarr; "Ventas por canal".
                </p>
                <div class="space-y-2">
                    <input data-param="utm_source" type="text" maxlength="64" placeholder="Fuente (ej: instagram)" class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-black" />
                    <input data-param="utm_medium" type="text" maxlength="64" placeholder="Medio (ej: historia, bio, afiche)" class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-black" />
                    <input data-param="utm_campaign" type="text" maxlength="64" placeholder="Campaña (ej: preventa)" class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-black" />
                    <input data-param="ref" type="text" maxlength="64" placeholder="Código de promotor / ref (opcional)" class="w-full bg-gray-50 border border-gray-200 text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-black" />
                </div>
                <div class="flex gap-2 mt-3">
                    <input id="trackingLinkOutput" type="text" readonly value={`${siteUrl}${publicLink}`} class="bg-gray-50 border border-gray-200 text-gray-600 text-xs rounded-lg px-3 py-2 w-full outline-none" />
                    <button id="copyTrackingLinkBtn" type="button" title="Copiar link con seguimiento" class="p-2 bg-gray-100 hover:bg-gray-200 rounded-lg transition text-gray-700">
                        <Share2 size={18} />
                    </button>
                </div>
            </div>

            <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
                <h3 class="font-bold text-lg mb-2">Órdenes</h3>
                <p class="text-sm text-gray-500 mb-4">Descarga las órdenes pagadas del evento (CSV compatible con Excel).</p>
                <a
                    href={`/api/events/orders-csv?event_id=${event.id}`}
                    class="flex items-center justify-center gap-2 w-full py-2 bg-gray-100 hover:bg-gray-200 rounded-lg transition text-gray-800 font-medium text-sm"
                >
                    <Download size={16} /> Exportar CSV
                </a>
            </div>

            <div
                class="bg-gradient-to-br from-gray-900 to-black p-6 rounded-xl text-white shadow-lg"
            >
                <h3 class="font-bold text-lg mb-2">Estado del Evento</h3>
                <p class="text-gray-400 text-sm mb-6">
                    Tu evento está actualmente en modo <strong
                        >{
                            event.status === "published"
                                ? "Público"
                                : "Borrador"
                        }</strong
                    >.
                </p>

                {event.status !== "published" && publishBlockers.length > 0 && (
                    <ul class="text-sm text-yellow-300 mb-4 list-disc pl-5">
                        {publishBlockers.map((b) => <li>{b}</li>)}
                    </ul>
                )}

                <button
                    id="toggleStatusBtn"
                    data-event-id={event.id}
                    data-current-status={event.status}
                    class="w-full py-2 bg-white text-black font-bold rounded-lg hover:bg-gray-100 transition"
                >
                    {
                        event.status === "published"
                            ? "Pausar Ventas"
                            : "Publicar Evento"
                    }
                </button>
            </div>
        </div>
    </div>
</DashboardLayout>

<script>
  const copyBtn = document.getElementById('copyLinkBtn');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.link || '');
      copyBtn.setAttribute('title', '¡Copiado!');
      alert('Link copiado');
    } catch {
      prompt('Copia el link:', copyBtn.dataset.link || '');
    }
  });

  // Constructor de link con seguimiento (utm_* / ref)
  const builder = document.getElementById('trackingBuilder');
  const trackingOutput = document.getElementById('trackingLinkOutput') as HTMLInputElement | null;
  const buildTrackingLink = () => {
    if (!builder || !trackingOutput) return;
    const url = new URL(builder.dataset.base || window.location.origin);
    builder.querySelectorAll<HTMLInputElement>('input[data-param]').forEach((input) => {
      const value = input.value.trim().toLowerCase().replace(/\s+/g, '-');
      if (value) url.searchParams.set(input.dataset.param!, value);
    });
    trackingOutput.value = url.toString();
  };
  builder?.querySelectorAll('input[data-param]').forEach((input) => input.addEventListener('input', buildTrackingLink));
  document.getElementById('copyTrackingLinkBtn')?.addEventListener('click', async () => {
    const link = trackingOutput?.value || '';
    try {
      await navigator.clipboard.writeText(link);
      alert('Link copiado');
    } catch {
      prompt('Copia el link:', link);
    }
  });

  const dupBtn = document.getElementById('duplicateEventBtn') as HTMLButtonElement | null;
  dupBtn?.addEventListener('click', async () => {
    if (!confirm('Se creará una copia en borrador con las mismas entradas y lugar, sin fechas. ¿Continuar?')) return;
    dupBtn.disabled = true;
    try {
      const res = await fetch('/api/events/duplicate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ eventId: Number(dupBtn.dataset.eventId) })
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.id) {
        window.location.href = `/dashboard/events/${data.id}/edit`;
      } else {
        alert(data.message || 'No se pudo duplicar el evento');
        dupBtn.disabled = false;
      }
    } catch {
      alert('Error de conexión');
      dupBtn.disabled = false;
    }
  });

  const btn = document.getElementById('toggleStatusBtn');
  if (btn) {
    btn.addEventListener('click', async () => {
      const eventId = btn.dataset.eventId;
      const currentStatus = btn.dataset.currentStatus;
      const newStatus = currentStatus === 'published' ? 'draft' : 'published';
      
      (btn as HTMLButtonElement).disabled = true;
      btn.textContent = 'Actualizando...';

      try {
        const res = await fetch('/api/events/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            eventId: Number(eventId),
            general: null,
            locations: [],
            tickets: [],
            statusOnly: true,
            status: newStatus
          })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert(data.message || 'Error al actualizar estado');
          (btn as HTMLButtonElement).disabled = false;
          btn.textContent = currentStatus === 'published' ? 'Pausar Ventas' : 'Publicar Evento';
        }
      } catch (e) {
        alert('Error de conexión');
        (btn as HTMLButtonElement).disabled = false;
        btn.textContent = currentStatus === 'published' ? 'Pausar Ventas' : 'Publicar Evento';
      }
    });
  }
</script>
