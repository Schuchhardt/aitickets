---
import { siteUrl as siteUrlFromEnv } from "../../api/_lib/server-utils";
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import EventFAQManager from "../../../components/dashboard/EventFAQManager.vue";
import CourtesyTicketsForm from "../../../components/dashboard/CourtesyTicketsForm.vue";
import DiscountCodesManager from "../../../components/dashboard/DiscountCodesManager.vue";
import PreviewLinksManager from "../../../components/dashboard/PreviewLinksManager.vue";
import EventDocumentsManager from "../../../components/dashboard/EventDocumentsManager.vue";
import EventCoverManager from "../../../components/dashboard/EventCoverManager.vue";
import EventGalleryManager from "../../../components/dashboard/EventGalleryManager.vue";
import EventReviewsManager from "../../../components/dashboard/EventReviewsManager.vue";
import EventCommunityManager from "../../../components/dashboard/EventCommunityManager.vue";
import TrackingLinkBuilder from "../../../components/dashboard/TrackingLinkBuilder.vue";
import PromoterLinksManager from "../../../components/dashboard/PromoterLinksManager.vue";
import SocialSeriesCard from "../../../components/dashboard/SocialSeriesCard.vue";
import EventWaitlistManager from "../../../components/dashboard/EventWaitlistManager.vue";
import { getSupabaseAdmin } from "../../../lib/auth-helpers";
import { EVENT_MANAGER_ROLES, ORG_ADMIN_ROLES, hasRole } from "../../../lib/supabaseServer";
import { adsEnabled } from "../../../../netlify/lib/zernio-ads.mjs";
import { WAITLIST_TABLE } from "../../../../netlify/lib/waitlist.mjs";
import { requireDashboardSession } from "../_lib/guard";
import { identityApproved, loadOrgIdentity, ticketsRequireIdentity, IDENTITY_FREE_PAID_CAPACITY } from "../../../lib/producerIdentity";
import { canAccessEventByStaff } from "../../../../netlify/lib/event-staff.mjs";
import { getEventSummary } from "../../../lib/eventAnalytics";
import { PROFILE_LABELS, eventProfile, eventPhase, normalizeAddedModules, resolveModules, panelTabs, defaultTab } from "../../../lib/eventModules";
import {
    Calendar,
    MapPin,
    Ticket,
    CheckCircle,
    AlertCircle,
    Eye,
    Edit,
    Share2,
    BarChart3,
    Pause,
    Rocket,
    Send,
    Target,
} from "lucide-vue-next";

const { id } = Astro.params;
const guard = await requireDashboardSession(Astro, EVENT_MANAGER_ROLES);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
// Acceso por evento (aitickets_event_staff): un miembro con eventos asignados solo opera esos
if (!(await canAccessEventByStaff(getSupabaseAdmin(), dbUser.id, Astro.params.id))) return Astro.redirect("/dashboard/events");
const supabaseAdmin = getSupabaseAdmin();

// Detalle del evento (solo si pertenece a la organización)
const loadEvent = (coverColumn: string) => supabaseAdmin
    .from("events")
    .select(
        `
    id, name, slug, status, start_date, end_date, location, accessibility, image_url,${coverColumn}
    event_tickets (
      id,
      ticket_name,
      price,
      total_quantity,
      is_gift,
      status
    ),
    event_dates ( id ),
    event_tags ( category_tags ( name ) ),
    event_locations (
      id,
      venues (
        name,
        city
      )
    )
  `,
    )
    .eq("id", id)
    .eq("organization_id", dbUser.organization_id)
    .single();
// Deploy previews y local comparten la BD de producción: las columnas más nuevas pueden no existir todavía, así que
// se van soltando de a una (de la más nueva a la más antigua) en vez de perderlas todas
const optionalColumns = ["panel_modules", "cover_settings", "is_massive, requires_documents"];
let { data: event, error }: { data: any; error: any } = await loadEvent(` ${optionalColumns.join(", ")},`);
for (let i = 1; error?.code === "42703" && i <= optionalColumns.length; i++) {
    const rest = optionalColumns.slice(i);
    ({ data: event, error } = await loadEvent(rest.length ? ` ${rest.join(", ")},` : ""));
}

if (error || !event) {
    return Astro.redirect("/dashboard/events");
}

// Tarjetas: src/lib/eventAnalytics.ts (paginado y con las mismas definiciones que la analítica y la API).
// Entradas vendidas sin cortesías ni transferencias (las cortesías se muestran aparte); conversión = órdenes ÷
// visitantes únicos; ocupación = emitidas ÷ capacidad a la venta.
const summary = await getEventSummary(supabaseAdmin, { id: Number(event.id), status: event.status });
const fmtPct = (v: number | null) => (v == null ? "—" : `${v.toLocaleString("es-CL")}%`);
const ticketSalesMap = summary.issued_by_ticket_type_id;

const publicLink = `/eventos/${event.slug}`;
const siteUrl = (siteUrlFromEnv() || Astro.url.origin).replace(/\/+$/, "");
const activeTickets = (event.event_tickets || []).filter((t: any) => t.status !== "unavailable");
const courtesyTickets = activeTickets.map((t: any) => ({ id: t.id, ticket_name: t.ticket_name }));
const hasDates = (event.event_dates?.length || 0) > 0 || !!event.start_date;
// Más de 10 cupos pagados => identidad verificada (Términos para productores §2 bis; mismo control que setEventStatus)
const needsIdentity = ticketsRequireIdentity(event.event_tickets || []);
const identityOk = !needsIdentity || identityApproved(await loadOrgIdentity(supabaseAdmin, Number(dbUser.organization_id)).catch(() => null));
const publishBlockers = [
    !hasDates ? "Agrega al menos una función (fecha y hora)." : null,
    activeTickets.length === 0 ? "Agrega al menos un tipo de entrada." : null,
    !identityOk ? `Verifica tu identidad en Configuración > Verificación de identidad: es obligatorio para vender más de ${IDENTITY_FREE_PAID_CAPACITY} entradas pagadas.` : null,
].filter(Boolean);

// Lista de espera (sin la tabla, 0)
const { count: waitlistCount } = await supabaseAdmin.from(WAITLIST_TABLE).select("id", { count: "exact", head: true }).eq("event_id", event.id);

// Módulos del panel por perfil (categoría), condiciones del evento y los que el productor agregó: src/lib/eventModules.ts
const categoryTag = event.event_tags?.[0]?.category_tags;
const moduleCtx = {
    profile: eventProfile(Array.isArray(categoryTag) ? categoryTag[0]?.name : categoryTag?.name),
    status: event.status,
    functionCount: event.event_dates?.length || 0,
    ticketTypeCount: activeTickets.length,
    phase: eventPhase(event.start_date, event.end_date),
    waitlistCount: waitlistCount || 0,
    hasAttendees: Object.values(ticketSalesMap).some((n) => Number(n) > 0),
    isMassive: event.is_massive === true || event.requires_documents === true,
};
const modules = resolveModules(moduleCtx, normalizeAddedModules(event.panel_modules));
const tabs = panelTabs(modules);
const activeTab = defaultTab(moduleCtx, tabs);
const canCreateAds = adsEnabled() && hasRole(dbUser, ORG_ADMIN_ROLES);
---

<DashboardLayout title={event.name}>
    <!-- Header -->
    <div
        class="flex flex-col md:flex-row md:items-start justify-between gap-4 md:gap-6 mb-4"
    >
        <div class="min-w-0">
            <div class="flex items-center gap-3 mb-2 min-w-0">
                <a
                    href="/dashboard/events"
                    class="text-gray-500 hover:text-black transition">Eventos</a
                >
                <span class="text-gray-300">/</span>
                <span class="text-gray-900 font-medium truncate min-w-0 max-w-[200px]"
                    >{event.name}</span
                >
            </div>
            <h1 class="text-2xl md:text-3xl font-bold font-[Unbounded] mb-2 break-words">
                {event.name}
            </h1>
            <div class="flex items-center gap-4 text-sm text-gray-600">
                <span class="flex items-center gap-1">
                    <Calendar size={16} />
                    {
                        event.start_date
                            ? new Date(event.start_date).toLocaleString("es-CL", { timeZone: "America/Santiago", dateStyle: "medium", timeStyle: "short" })
                            : "Fecha por definir"
                    }
                </span>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-3">
            <a
                href={publicLink}
                target="_blank"
                class="flex items-center justify-center gap-2 px-4 py-2.5 sm:py-2 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium text-sm sm:text-base"
            >
                <Eye size={18} /> {event.status === "published" ? "Ver Página" : "Vista previa"}
            </a>
            <a
                href={`/dashboard/events/${event.id}/checkin`}
                class="flex items-center justify-center gap-2 px-4 py-2.5 sm:py-2 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium text-sm sm:text-base"
            >
                <CheckCircle size={18} /> Check-in
            </a>
            <a
                href={`/dashboard/events/${event.id}/analytics`}
                class="flex items-center justify-center gap-2 px-4 py-2.5 sm:py-2 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium text-sm sm:text-base"
            >
                <BarChart3 size={18} /> Analytics
            </a>
            <a
                href={`/dashboard/events/${event.id}/edit`}
                class="flex items-center justify-center gap-2 px-4 py-2.5 sm:py-2 bg-black text-white rounded-lg hover:bg-gray-900 transition font-medium text-sm sm:text-base"
            >
                <Edit size={18} /> Editar
            </a>
        </div>
    </div>

    <!-- Estado del evento (publicar / pausar) -->
    <div
        class={`mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-xl border p-4 ${event.status === "published" ? "bg-green-50 border-green-200" : "bg-yellow-50 border-yellow-200"}`}
        data-testid="event-status"
    >
        <div class="flex items-start gap-3">
            <span class={`mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full ${event.status === "published" ? "bg-green-500" : "bg-yellow-500"}`}></span>
            <div>
                <p class="font-semibold text-gray-900">
                    {event.status === "published" ? "Publicado: las entradas están a la venta" : "Borrador: el evento no está a la venta"}
                </p>
                {event.status !== "published" && publishBlockers.length > 0 ? (
                    <ul class="mt-1 text-sm text-yellow-800 list-disc pl-5">
                        {publishBlockers.map((b) => <li>{b}</li>)}
                    </ul>
                ) : (
                    <p class="text-sm text-gray-600">
                        {event.status === "published"
                            ? "Si pausas las ventas, el evento vuelve a borrador y deja de aparecer en la cartelera."
                            : "Cuando esté listo, publícalo para empezar a vender."}
                    </p>
                )}
            </div>
        </div>
        <button
            id="toggleStatusBtn"
            data-event-id={event.id}
            data-current-status={event.status}
            class={`shrink-0 flex items-center justify-center gap-2 px-5 py-2 rounded-lg font-bold transition ${event.status === "published" ? "bg-white border border-gray-300 text-gray-800 hover:bg-gray-50" : "bg-black text-white hover:bg-gray-900"}`}
        >
            {event.status === "published" ? <Pause size={16} /> : <Rocket size={16} />}
            <span>{event.status === "published" ? "Pausar Ventas" : "Publicar Evento"}</span>
        </button>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 mb-8">
        <div class="bg-white p-4 sm:p-6 rounded-xl border border-gray-200 shadow-sm min-w-0">
            <div class="flex justify-between items-start mb-3 sm:mb-4">
                <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
                    <Eye size={20} />
                </div>
            </div>
            <p class="text-gray-500 text-sm mb-1">Visitas Totales</p>
            <h3 class="text-xl sm:text-2xl font-bold break-words">{summary.visits.toLocaleString("es-CL")}</h3>
            <p class="text-xs text-gray-400 mt-1">{summary.unique_visitors.toLocaleString("es-CL")} visitantes únicos</p>
        </div>

        <div class="bg-white p-4 sm:p-6 rounded-xl border border-gray-200 shadow-sm min-w-0">
            <div class="flex justify-between items-start mb-3 sm:mb-4">
                <div class="p-2 bg-purple-50 text-purple-600 rounded-lg">
                    <Ticket size={20} />
                </div>
            </div>
            <p class="text-gray-500 text-sm mb-1">Entradas Vendidas</p>
            <h3 class="text-xl sm:text-2xl font-bold break-words">{summary.tickets_sold.toLocaleString("es-CL")}</h3>
            <p class="text-xs text-gray-400 mt-1">
                {summary.capacity == null ? "Capacidad sin límite" : `Capacidad: ${summary.capacity.toLocaleString("es-CL")}`}
                {summary.courtesy_tickets > 0 && ` · + ${summary.courtesy_tickets.toLocaleString("es-CL")} cortesías`}
            </p>
        </div>

        <div class="bg-white p-4 sm:p-6 rounded-xl border border-gray-200 shadow-sm min-w-0">
            <div class="flex justify-between items-start mb-3 sm:mb-4">
                <div class="p-2 bg-green-50 text-green-600 rounded-lg">
                    <BarChart3 size={20} />
                </div>
            </div>
            <p class="text-gray-500 text-sm mb-1">Ingresos Totales</p>
            <h3 class="text-xl sm:text-2xl font-bold break-words">${summary.revenue_clp.toLocaleString("es-CL")}</h3>
            <p class="text-xs text-gray-400 mt-1">{summary.paid_orders.toLocaleString("es-CL")} órdenes pagadas</p>
        </div>
        <div class="bg-white p-4 sm:p-6 rounded-xl border border-gray-200 shadow-sm min-w-0">
            <div class="flex justify-between items-start mb-3 sm:mb-4">
                <div class="p-2 bg-orange-50 text-orange-600 rounded-lg">
                    <Share2 size={20} />
                </div>
            </div>
            <p class="text-gray-500 text-sm mb-1">Conversión</p>
            <h3 class="text-xl sm:text-2xl font-bold break-words">{fmtPct(summary.conversion_pct)}</h3>
            <p class="text-xs text-gray-400 mt-1">órdenes ÷ visitantes únicos · Ocupación {fmtPct(summary.sell_through_pct)}</p>
        </div>
    </div>

    <!-- Pestañas: cada módulo vive en una (src/lib/eventModules.ts); las vacías no se muestran -->
    <div class="border-b border-gray-200 mb-6 -mx-4 px-4 sm:mx-0 sm:px-0 overflow-x-auto scroll-mt-4" role="tablist" data-testid="event-tabs">
        <div class="flex gap-1 min-w-max">
            {tabs.map((t) => (
                <button
                    type="button"
                    role="tab"
                    data-tab={t.id}
                    aria-selected={t.id === activeTab ? "true" : "false"}
                    class="px-4 py-2.5 text-sm font-medium border-b-2 -mb-px transition border-transparent text-gray-500 hover:text-black aria-selected:border-black aria-selected:text-black"
                >
                    {t.label}
                </button>
            ))}
        </div>
    </div>

    {tabs.map((t) => (
        <div role="tabpanel" data-tab-panel={t.id} hidden={t.id !== activeTab} class="max-w-4xl space-y-6 md:space-y-8 mb-8">
            {t.modules.map((m) => (
                <div data-module={m.id} hidden={!m.enabled} class="rounded-xl transition-shadow">
                    {m.id === "tickets" && (
                        <section class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                            <div class="p-4 sm:p-6 border-b border-gray-100 flex justify-between items-center gap-3">
                                <h3 class="font-bold text-lg">Tipos de Entrada</h3>
                                <a href={`/dashboard/events/${event.id}/edit`} class="text-sm text-black font-medium hover:underline">Gestionar</a>
                            </div>
                            <div class="divide-y divide-gray-100">
                                {event.event_tickets?.map((ticket: any) => (
                                    <div class="p-4 flex justify-between items-center gap-3 hover:bg-gray-50 transition">
                                        <div class="min-w-0">
                                            <p class="font-bold text-gray-900 break-words">{ticket.ticket_name}</p>
                                            <p class="text-sm text-gray-500">
                                                ${Number(ticket.price).toLocaleString()}{" "}
                                                • {ticketSalesMap[ticket.id] || 0} emitidas / {ticket.total_quantity ?? "sin límite"}
                                            </p>
                                        </div>
                                        <div class="shrink-0">
                                            <span class={`px-2 py-1 rounded text-xs font-medium ${ticket.status === "unavailable" ? "bg-red-50 text-red-600" : "bg-gray-100 text-gray-600"}`}>
                                                {ticket.status === "unavailable" ? "Retirada" : "Activo"}
                                            </span>
                                        </div>
                                    </div>
                                ))}
                                {(!event.event_tickets || event.event_tickets.length === 0) && (
                                    <div class="p-8 text-center text-gray-500">No hay entradas configuradas.</div>
                                )}
                            </div>
                        </section>
                    )}
                    {m.id === "waitlist" && <EventWaitlistManager client:visible eventId={Number(event.id)} />}
                    {m.id === "courtesy" && <CourtesyTicketsForm client:visible eventId={Number(event.id)} tickets={courtesyTickets} />}
                    {/* Códigos de descuento (del evento + los de toda la organización) */}
                    {m.id === "discounts" && <DiscountCodesManager client:visible eventId={Number(event.id)} />}
                    {m.id === "public-link" && (
                        <div class="bg-white p-4 sm:p-6 rounded-xl border border-gray-200 shadow-sm">
                            <div class="flex items-center justify-between gap-3 mb-4">
                                <h3 class="font-bold text-lg">Link Público</h3>
                                <a href={`/dashboard/events/${event.id}/edit#link-publico`} class="text-sm text-black font-medium hover:underline">Cambiar</a>
                            </div>
                            <p class="text-sm text-gray-500 mb-2">Comparte este enlace para vender entradas.</p>
                            <div class="flex gap-2">
                                <input
                                    type="text"
                                    readonly
                                    value={`${siteUrl}${publicLink}`}
                                    class="bg-gray-50 border border-gray-200 text-gray-600 text-sm rounded-lg px-3 py-2 w-full min-w-0 outline-none"
                                />
                                <button
                                    id="copyLinkBtn"
                                    type="button"
                                    data-link={`${siteUrl}${publicLink}`}
                                    title="Copiar link"
                                    class="shrink-0 p-2.5 sm:p-2 bg-gray-100 hover:bg-gray-200 rounded-lg transition text-gray-700"
                                >
                                    <Share2 size={18} />
                                </button>
                            </div>
                        </div>
                    )}
                    {/* Difusión automática: historias y posts en Instagram hasta el evento (docs/specs/historias-automaticas.md) */}
                    {m.id === "social-series" && <SocialSeriesCard client:visible eventId={Number(event.id)} eventName={event.name} />}
                    {/* Atajos a Promocionar con el evento elegido (?event=<id>) */}
                    {m.id === "promote" && (
                        <div class="bg-white p-4 sm:p-6 rounded-xl border border-gray-200 shadow-sm" data-testid="event-promote">
                            <div class="flex items-center justify-between gap-3 mb-1">
                                <h3 class="font-bold text-lg">Posts y anuncios</h3>
                                <a href="/dashboard/promote" class="text-sm text-black font-medium hover:underline">Ver en Promocionar</a>
                            </div>
                            <p class="text-sm text-gray-500 mb-4">
                                {canCreateAds
                                    ? "Publica un post en tus redes conectadas o crea un anuncio pagado en Instagram y Facebook."
                                    : "Publica un post en tus redes conectadas."}
                            </p>
                            <div class="flex flex-wrap gap-2">
                                <a
                                    href={`/dashboard/promote/create?event=${event.id}`}
                                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black text-white text-sm font-medium hover:bg-gray-900 transition"
                                >
                                    <Send size={16} /> Crear post
                                </a>
                                {canCreateAds && (
                                    <a
                                        href={`/dashboard/promote/ads/create?event=${event.id}`}
                                        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 bg-white text-sm font-medium hover:bg-gray-50 transition"
                                    >
                                        <Target size={16} /> Crear anuncio
                                    </a>
                                )}
                            </div>
                        </div>
                    )}
                    {m.id === "tracking-links" && (
                        <TrackingLinkBuilder client:visible baseUrl={`${siteUrl}${publicLink}`} analyticsUrl={`/dashboard/events/${event.id}/analytics`} />
                    )}
                    {m.id === "promoter-links" && <PromoterLinksManager client:visible eventId={Number(event.id)} />}
                    {m.id === "preview-links" && <PreviewLinksManager client:visible eventId={Number(event.id)} status={event.status} />}
                    {/* Portada (vista Desktop / Mobile, ajuste y generación con IA) */}
                    {m.id === "cover" && (
                        <EventCoverManager
                            client:visible
                            eventId={Number(event.id)}
                            eventName={event.name}
                            imageUrl={event.image_url || ""}
                            coverSettings={event.cover_settings || null}
                        />
                    )}
                    {m.id === "faq" && <EventFAQManager client:visible eventId={Number(event.id)} />}
                    {m.id === "documents" && <EventDocumentsManager client:visible eventId={Number(event.id)} />}
                    {/* Mensajes de asistentes y muro (reacciones) */}
                    {m.id === "community" && <EventCommunityManager client:visible eventId={Number(event.id)} eventName={event.name} />}
                    {/* Reseñas, fotos de asistentes e invitación al próximo evento */}
                    {m.id === "reviews" && <EventReviewsManager client:visible eventId={Number(event.id)} publicUrl={publicLink} />}
                    {/* Galería (al final de la página pública del evento) */}
                    {m.id === "gallery" && <EventGalleryManager client:visible eventId={Number(event.id)} publicUrl={publicLink} />}
                </div>
            ))}

            {/* Más herramientas de esta pestaña: las que no vienen para este tipo de evento; al agregar una aparece su tarjeta */}
            <details data-more-tools={t.id} hidden={!t.modules.some((m) => !m.core && !m.enabled)} class="group rounded-xl border border-dashed border-gray-300 bg-white/60">
                <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer list-none">
                    <span class="font-medium text-gray-700">Más herramientas</span>
                    <span class="text-sm text-gray-500 group-open:hidden">Ver</span>
                    <span class="text-sm text-gray-500 hidden group-open:inline">Cerrar</span>
                </summary>
                <p class="px-4 -mt-2 pb-2 text-xs text-gray-500">No vienen activas para este evento ({PROFILE_LABELS[moduleCtx.profile]}). Al agregar una, queda en esta pestaña.</p>
                <ul class="divide-y divide-gray-100 border-t border-gray-100">
                    {t.modules.filter((m) => !m.core).map((m) => (
                        <li data-add-item={m.id} hidden={m.enabled} class="flex items-center justify-between gap-4 p-4">
                            <div class="min-w-0">
                                <p class="font-medium text-gray-900">{m.title}</p>
                                <p class="text-sm text-gray-500">{m.description}</p>
                            </div>
                            <button
                                type="button"
                                data-add-module={m.id}
                                class="shrink-0 px-3 py-1.5 rounded-lg border border-gray-300 bg-white text-sm font-medium hover:bg-gray-50"
                            >
                                Agregar
                            </button>
                        </li>
                    ))}
                </ul>
            </details>
        </div>
    ))}

    <p id="modulesToast" hidden role="alert" class="fixed bottom-4 left-4 right-4 sm:left-auto sm:max-w-sm z-50 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 shadow-lg"></p>
</DashboardLayout>

<script>
  // Pestañas: la elegida queda en el hash (#ventas, #difusion…) para volver a ella al recargar
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
  const showTab = (id: string) => {
    if (!tabButtons.some((b) => b.dataset.tab === id)) return false;
    tabButtons.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === id)));
    document.querySelectorAll<HTMLElement>('[data-tab-panel]').forEach((p) => (p.hidden = p.dataset.tabPanel !== id));
    return true;
  };
  tabButtons.forEach((b) =>
    b.addEventListener('click', () => {
      showTab(b.dataset.tab!);
      history.replaceState(null, '', `#${b.dataset.tab}`);
    }),
  );
  // Llegando con #pestaña (p. ej. desde Promocionar): el id no existe como ancla, así que se baja a las pestañas a mano
  const openFromHash = () => {
    if (location.hash && showTab(location.hash.slice(1))) {
      requestAnimationFrame(() => document.querySelector('[role="tablist"]')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    }
  };
  openFromHash();
  // Un link a #pestaña dentro de la misma página no recarga: solo cambia el hash
  window.addEventListener('hashchange', openFromHash);

  // Agregar una herramienta (events.panel_modules vía /api/events/modules): su tarjeta aparece al instante, se baja a
  // ella para configurarla y se guarda en segundo plano (si falla, vuelve a "Más herramientas").
  const panelEventId = Number(document.getElementById('toggleStatusBtn')?.dataset.eventId);
  const toast = document.getElementById('modulesToast');
  const showModule = (id: string, shown: boolean) => {
    const slot = document.querySelector<HTMLElement>(`[data-module="${id}"]`);
    if (slot) slot.hidden = !shown;
    const item = document.querySelector<HTMLElement>(`[data-add-item="${id}"]`);
    if (item) item.hidden = shown;
    const more = item?.closest<HTMLDetailsElement>('[data-more-tools]');
    if (more) more.hidden = !more.querySelector('[data-add-item]:not([hidden])');
    return slot;
  };
  const addModule = async (id: string) => {
    const slot = showModule(id, true);
    if (slot) {
      slot.scrollIntoView({ behavior: 'smooth', block: 'start' });
      slot.classList.add('ring-2', 'ring-black', 'ring-offset-4');
      setTimeout(() => slot.classList.remove('ring-2', 'ring-black', 'ring-offset-4'), 1600);
    }
    try {
      const res = await fetch('/api/events/modules', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ eventId: panelEventId, moduleId: id }),
      });
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).message || 'No se pudo guardar');
    } catch (e: any) {
      showModule(id, false);
      if (toast) {
        toast.textContent = e?.message || 'Error de conexión';
        toast.hidden = false;
        setTimeout(() => (toast.hidden = true), 5000);
      }
    }
  };
  document.querySelectorAll<HTMLButtonElement>('[data-add-module]').forEach((b) => b.addEventListener('click', () => addModule(b.dataset.addModule!)));

  const copyBtn = document.getElementById('copyLinkBtn');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.link || '');
      copyBtn.setAttribute('title', '¡Copiado!');
      alert('Link copiado');
    } catch {
      prompt('Copia el link:', copyBtn.dataset.link || '');
    }
  });

  const btn = document.getElementById('toggleStatusBtn') as HTMLButtonElement | null;
  if (btn) {
    const label = btn.querySelector('span');
    btn.addEventListener('click', async () => {
      const eventId = btn.dataset.eventId;
      const currentStatus = btn.dataset.currentStatus;
      const newStatus = currentStatus === 'published' ? 'draft' : 'published';
      const idleText = currentStatus === 'published' ? 'Pausar Ventas' : 'Publicar Evento';

      btn.disabled = true;
      if (label) label.textContent = 'Actualizando...';

      try {
        const res = await fetch('/api/events/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            eventId: Number(eventId),
            general: null,
            locations: [],
            tickets: [],
            statusOnly: true,
            status: newStatus
          })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert(data.message || 'Error al actualizar estado');
          btn.disabled = false;
          if (label) label.textContent = idleText;
        }
      } catch (e) {
        alert('Error de conexión');
        btn.disabled = false;
        if (label) label.textContent = idleText;
      }
    });
  }
</script>
