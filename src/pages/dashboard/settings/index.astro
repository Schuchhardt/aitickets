---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { getSupabaseAdmin } from "../../../lib/auth-helpers";
import { ORG_ADMIN_ROLES, hasRole } from "../../../lib/supabaseServer";
import { requireDashboardSession } from "../_lib/guard";
import { IDENTITY_STATUS_LABELS, loadOrgIdentity, syncIdentityFromDidit } from "../../../lib/producerIdentity";
import { BIOMETRIC_CONSENT_TEXT, IDENTITY_WHY_TEXT } from "../../../../netlify/lib/identity.mjs";

// Finanzas entra solo para los datos de pago (el perfil de la organización lo editan dueño y administradores)
const guard = await requireDashboardSession(Astro, [...ORG_ADMIN_ROLES, "finance"]);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const canEditOrg = hasRole(dbUser, ORG_ADMIN_ROLES);
const BANK_CHANGE_HOLD_HOURS = 72;
const supabaseAdmin = getSupabaseAdmin();

type OrgSettings = {
    public_name: string | null;
    email: string | null;
    phone: string | null;
};

type PayoutAccount = {
    verified_at?: string | null;
    bank_changed_at?: string | null;
    legal_name: string | null;
    legal_rut: string | null;
    bank_name: string | null;
    bank_account_type: string | null;
    bank_account_number: string | null;
    bank_account_holder: string | null;
    bank_account_rut: string | null;
};

const { data: orgData } = await supabaseAdmin
    .from("organizations")
    .select("public_name, email, phone")
    .eq("id", dbUser.organization_id)
    .single();
const org = orgData as OrgSettings | null;

// Datos bancarios: tabla aparte (organization_payout_accounts, migración 20260926_C_dashboard)
let payout: PayoutAccount | null = null;
{
    const BASE = "legal_name, legal_rut, bank_name, bank_account_type, bank_account_number, bank_account_holder, bank_account_rut";
    const load = (cols: string) => supabaseAdmin.from("organization_payout_accounts").select(cols).eq("organization_id", dbUser.organization_id).maybeSingle();
    // verified_at/bank_changed_at existen desde la migración 202610090200
    let { data, error } = await load(`${BASE}, verified_at, bank_changed_at, holder_match_status`);
    if (error) ({ data, error } = await load(`${BASE}, verified_at, bank_changed_at`));
    if (error) ({ data, error } = await load(BASE));
    if (error) console.error("Error cargando datos de pago:", error.message);
    payout = (data as PayoutAccount | null) || null;
}
const bankComplete = Boolean(payout?.bank_name && payout?.bank_account_number && payout?.bank_account_holder && payout?.bank_account_rut);
const holdUntil = payout?.bank_changed_at ? new Date(new Date(payout.bank_changed_at).getTime() + BANK_CHANGE_HOLD_HOURS * 3600000) : null;
const holdActive = Boolean(holdUntil && holdUntil.getTime() > Date.now());

// Verificación de identidad (Didit). Al volver del flujo (?identidad=volver) se consulta la decisión por si el
// webhook aún no llega.
let identity = await loadOrgIdentity(supabaseAdmin, Number(dbUser.organization_id)).catch(() => null);
if (Astro.url.searchParams.get("identidad") === "volver" && identity?.identity_session_id && identity.identity_status !== "approved") {
    try {
        await syncIdentityFromDidit(supabaseAdmin, Number(dbUser.organization_id));
        identity = await loadOrgIdentity(supabaseAdmin, Number(dbUser.organization_id));
    } catch (err: any) {
        console.error("Didit sync:", err?.message || err);
    }
}
const identityStatus = identity?.identity_status ?? null;
const identityLabel = identityStatus ? IDENTITY_STATUS_LABELS[identityStatus] : "Sin verificar";
const canStartIdentity = canEditOrg && identityStatus !== "approved" && identityStatus !== "in_review";
const holderMismatch = (payout as any)?.holder_match_status === "mismatch";

const BANKS = [
    "BancoEstado", "Banco de Chile / Edwards", "Santander", "BCI / MACH", "Scotiabank", "Itaú", "Banco Security",
    "Banco BICE", "Banco Falabella", "Banco Ripley", "Banco Consorcio", "Banco Internacional", "Coopeuch",
    "Tenpo", "Mercado Pago", "Otro",
];
const ACCOUNT_TYPES = ["Cuenta Corriente", "Cuenta Vista / CuentaRUT", "Cuenta de Ahorro"];
---

<DashboardLayout title="Configuración">
    <div class="max-w-4xl mx-auto space-y-8">
        {canEditOrg && (
        <!-- Profile Section -->
        <!-- Mobile: el botón Guardar y su mensaje van bajo el formulario; desde sm, el botón vuelve arriba a la derecha -->
        <section class="relative flex flex-col gap-6">
            <div class="border-b border-gray-100 pb-4 sm:pr-44">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">
                        Perfil de la Organización
                    </h2>
                    <p class="text-gray-500 text-sm">
                        Actualiza la información visible para el público.
                    </p>
                </div>
            </div>

            <div id="orgMsg" class="hidden order-1 sm:order-none rounded-lg px-4 py-3 text-sm font-medium"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700"
                        >Nombre de la Organización</label
                    >
                    <input
                        id="orgName"
                        type="text"
                        class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5"
                        placeholder="Tu organización"
                        value={org?.public_name || ""}
                    />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700"
                        >Email de Contacto</label
                    >
                    <input
                        id="orgEmail"
                        type="email"
                        class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5"
                        placeholder="contacto@ejemplo.com"
                        value={org?.email || ""}
                    />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700"
                        >Teléfono</label
                    >
                    <input
                        id="orgPhone"
                        type="tel"
                        class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5"
                        placeholder="+56 9 ..."
                        value={org?.phone || ""}
                    />
                </div>
            </div>

            <button
                id="saveOrgBtn"
                class="order-2 sm:order-none w-full sm:w-auto sm:absolute sm:top-0 sm:right-0 px-4 py-2 text-sm bg-black text-white rounded-lg hover:bg-gray-800"
            >
                Guardar Cambios
            </button>
        </section>
        )}

        <!-- Verificación de identidad (Didit) -->
        <section id="identidad" class="space-y-4 pt-6 scroll-mt-24" data-testid="identity-section">
            <div class="border-b border-gray-100 pb-4">
                <h2 class="text-xl font-bold text-gray-900">Verificación de identidad</h2>
                <p class="text-gray-500 text-sm">{IDENTITY_WHY_TEXT} Es obligatoria para publicar eventos con entradas pagadas y para recibir transferencias.</p>
            </div>

            <div class={`rounded-lg border px-4 py-3 text-sm ${identityStatus === "approved" ? "border-green-100 bg-green-50 text-green-900" : identityStatus === "declined" ? "border-red-100 bg-red-50 text-red-800" : "border-gray-200 bg-gray-50 text-gray-800"}`}>
                <p class="font-medium" data-testid="identity-status">
                    {identityStatus === "approved" ? "✓ " : ""}{identityLabel}{identityStatus === "approved" && identity?.identity_name ? `: ${identity.identity_name}` : ""}
                </p>
                {identityStatus === "pending" && <p class="mt-1">Si ya completaste los pasos, el resultado puede tardar unos minutos. Puedes retomar la verificación si la dejaste a medias.</p>}
                {identityStatus === "in_review" && <p class="mt-1">El equipo de AI Tickets está revisando tu verificación (normalmente 1 día hábil).</p>}
                {identityStatus === "declined" && <p class="mt-1">No pudimos verificar tu identidad. Puedes intentarlo de nuevo con tu cédula vigente y buena luz, o escribirnos a soporte.</p>}
                {!identityStatus && <p class="mt-1">Si operas como empresa, verifica la identidad del representante legal y registra abajo la razón social y el RUT de la empresa.</p>}
            </div>

            {canStartIdentity && (
                <div class="space-y-3">
                    <label class="flex items-start gap-2 text-sm text-gray-700">
                        <input id="identityConsent" type="checkbox" class="mt-1 h-4 w-4 rounded border-gray-300" />
                        <span>{BIOMETRIC_CONSENT_TEXT.replace("Aviso de privacidad.", "")}<a href="/privacy" target="_blank" rel="noopener" class="underline">Aviso de privacidad</a>.</span>
                    </label>
                    <button id="startIdentityBtn" class="w-full sm:w-auto px-4 py-2 text-sm bg-black text-white rounded-lg hover:bg-gray-800 disabled:opacity-50">
                        {identityStatus ? "Retomar verificación" : "Verificar mi identidad"}
                    </button>
                    <div id="identityMsg" class="hidden rounded-lg px-4 py-3 text-sm font-medium"></div>
                </div>
            )}
            {!canEditOrg && identityStatus !== "approved" && (
                <p class="text-sm text-gray-500">La verificación la hace el dueño o un administrador de la organización.</p>
            )}
        </section>

        <!-- Bank / Payout Section -->
        <section id="datos-bancarios" class="relative flex flex-col gap-6 pt-6 scroll-mt-24">
            <div class="border-b border-gray-100 pb-4 sm:pr-44">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Datos para pagos</h2>
                    <p class="text-gray-500 text-sm">
                        Lo que vendes para cada función queda disponible 48 horas después de que termina; cuando solicitas un retiro desde Ingresos, lo transferimos a esta cuenta en hasta 2 días hábiles.
                    </p>
                </div>
            </div>

            <div id="bankMsg" class="hidden order-1 sm:order-none rounded-lg px-4 py-3 text-sm font-medium"></div>

            <div class="rounded-lg border border-amber-100 bg-amber-50 px-4 py-3 text-sm text-amber-900" data-testid="bank-verification-note">
                {bankComplete && payout?.verified_at && !holdActive && <p class="font-medium">✓ Cuenta verificada: puedes solicitar retiros.</p>}
                {bankComplete && !payout?.verified_at && <p class="font-medium">Cuenta en verificación por AI Tickets (normalmente 1 día hábil).</p>}
                {holdActive && holdUntil && (
                    <p class="font-medium">Por seguridad, los retiros quedan habilitados desde el {holdUntil.toLocaleString("es-CL", { timeZone: "America/Santiago", dateStyle: "medium", timeStyle: "short" })}.</p>
                )}
                {holderMismatch && (
                    <p class="font-medium text-red-700" data-testid="holder-mismatch">La cuenta no está a nombre de la persona o empresa verificada: los retiros quedan bloqueados hasta que AI Tickets la revise.</p>
                )}
                <p class="mt-1">
                    La cuenta debe estar a nombre de la persona verificada o de la empresa que representa: no transferimos a cuentas de terceros.
                    Cambiar los datos bancarios requiere una nueva verificación de AI Tickets y bloquea los retiros durante {BANK_CHANGE_HOLD_HOURS} horas.
                    Nunca compartas tu número de cuenta por chat: ingrésalo solo aquí.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700">Razón social (opcional)</label>
                    <input id="legalName" type="text" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5" placeholder="Mi Productora SpA" value={payout?.legal_name || ""} />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700">RUT empresa (opcional)</label>
                    <input id="legalRut" type="text" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5" placeholder="76.123.456-7" value={payout?.legal_rut || ""} />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700">Banco</label>
                    <select id="bankName" class="w-full px-4 py-2 rounded-lg border border-gray-200 bg-white focus:outline-none focus:ring-2 focus:ring-black/5">
                        <option value="">Selecciona tu banco...</option>
                        {BANKS.map((b) => <option value={b} selected={payout?.bank_name === b}>{b}</option>)}
                        {payout?.bank_name && !BANKS.includes(payout.bank_name) && <option value={payout.bank_name} selected>{payout.bank_name}</option>}
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700">Tipo de cuenta</label>
                    <select id="bankAccountType" class="w-full px-4 py-2 rounded-lg border border-gray-200 bg-white focus:outline-none focus:ring-2 focus:ring-black/5">
                        <option value="">Selecciona...</option>
                        {ACCOUNT_TYPES.map((t) => <option value={t} selected={payout?.bank_account_type === t}>{t}</option>)}
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700">Número de cuenta</label>
                    <input id="bankAccountNumber" type="text" inputmode="numeric" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5" value={payout?.bank_account_number || ""} />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700">Titular de la cuenta</label>
                    <input id="bankAccountHolder" type="text" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5" value={payout?.bank_account_holder || ""} />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700">RUT del titular</label>
                    <input id="bankAccountRut" type="text" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5" placeholder="12.345.678-9" value={payout?.bank_account_rut || ""} />
                </div>
            </div>

            <button id="saveBankBtn" class="order-2 sm:order-none w-full sm:w-auto sm:absolute sm:top-6 sm:right-0 px-4 py-2 text-sm bg-black text-white rounded-lg hover:bg-gray-800">
                Guardar Datos
            </button>
        </section>

        <!-- La contraseña se cambia desde Mi Perfil (disponible para todos los roles) -->
        <section class="pt-6">
            <p class="text-sm text-gray-500">
                ¿Quieres cambiar tu contraseña? Hazlo desde <a href="/dashboard/profile" class="font-medium text-gray-900 underline">Mi Perfil</a>.
            </p>
        </section>
    </div>
</DashboardLayout>

<script>
  // Organization save
  const saveOrgBtn = document.getElementById('saveOrgBtn');
  const orgMsg = document.getElementById('orgMsg');

  function showMsg(el: HTMLElement | null, text: string, isError: boolean) {
    if (!el) return;
    el.textContent = text;
    el.className = `order-1 sm:order-none rounded-lg px-4 py-3 text-sm font-medium ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 4000);
  }

  saveOrgBtn?.addEventListener('click', async () => {
    (saveOrgBtn as HTMLButtonElement).disabled = true;
    saveOrgBtn.textContent = 'Guardando...';
    try {
      const res = await fetch('/api/organizations/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          public_name: (document.getElementById('orgName') as HTMLInputElement)?.value,
          email: (document.getElementById('orgEmail') as HTMLInputElement)?.value,
          phone: (document.getElementById('orgPhone') as HTMLInputElement)?.value,
        }),
      });
      const data = await res.json();
      if (res.ok) {
        showMsg(orgMsg, 'Organización actualizada correctamente', false);
      } else {
        showMsg(orgMsg, data.message || 'Error al guardar', true);
      }
    } catch {
      showMsg(orgMsg, 'Error de conexión', true);
    } finally {
      (saveOrgBtn as HTMLButtonElement).disabled = false;
      saveOrgBtn.textContent = 'Guardar Cambios';
    }
  });

  // Identity verification (Didit)
  const startIdentityBtn = document.getElementById('startIdentityBtn') as HTMLButtonElement | null;
  const identityMsg = document.getElementById('identityMsg');
  startIdentityBtn?.addEventListener('click', async () => {
    const consent = (document.getElementById('identityConsent') as HTMLInputElement | null)?.checked === true;
    if (!consent) {
      showMsg(identityMsg, 'Para continuar debes autorizar el tratamiento de tus datos biométricos.', true);
      return;
    }
    const idleText = startIdentityBtn.textContent;
    startIdentityBtn.disabled = true;
    startIdentityBtn.textContent = 'Abriendo verificación...';
    try {
      const res = await fetch('/api/identity/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ consent: true }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      showMsg(identityMsg, data.message || 'No pudimos iniciar la verificación', true);
    } catch {
      showMsg(identityMsg, 'Error de conexión', true);
    }
    startIdentityBtn.disabled = false;
    startIdentityBtn.textContent = idleText;
  });

  // Bank data save
  const saveBankBtn = document.getElementById('saveBankBtn');
  const bankMsg = document.getElementById('bankMsg');
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';

  saveBankBtn?.addEventListener('click', async () => {
    (saveBankBtn as HTMLButtonElement).disabled = true;
    saveBankBtn.textContent = 'Guardando...';
    try {
      const res = await fetch('/api/organizations/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          legal_name: val('legalName'),
          legal_rut: val('legalRut'),
          bank_name: val('bankName'),
          bank_account_type: val('bankAccountType'),
          bank_account_number: val('bankAccountNumber'),
          bank_account_holder: val('bankAccountHolder'),
          bank_account_rut: val('bankAccountRut'),
        }),
      });
      const data = await res.json();
      showMsg(bankMsg, res.ok ? 'Datos bancarios guardados' : (data.message || 'Error al guardar'), !res.ok);
    } catch {
      showMsg(bankMsg, 'Error de conexión', true);
    } finally {
      (saveBankBtn as HTMLButtonElement).disabled = false;
      saveBankBtn.textContent = 'Guardar Datos';
    }
  });
</script>
