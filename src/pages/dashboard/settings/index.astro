---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { getSupabaseAdmin } from "../../../lib/auth-helpers";
import { ORG_ADMIN_ROLES, hasRole } from "../../../lib/supabaseServer";
import { requireDashboardSession } from "../_lib/guard";
import { roleAllows } from "../../../lib/producer-api/permissions";
import { IDENTITY_STATUS_LABELS, loadOrgIdentity, syncIdentityFromDidit } from "../../../lib/producerIdentity";
import { BIOMETRIC_CONSENT_TEXT, IDENTITY_WHY_TEXT } from "../../../../netlify/lib/identity.mjs";

// Finanzas entra solo para los datos de pago (el perfil de la organización lo editan dueño y administradores)
const guard = await requireDashboardSession(Astro, [...ORG_ADMIN_ROLES, "finance"]);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const canEditOrg = hasRole(dbUser, ORG_ADMIN_ROLES);
// Datos para pagos: solo el dueño y finanzas (finance.manage); un administrador los ve pero no los cambia
const canEditPayout = roleAllows(dbUser.role, "finance.manage");
const BANK_CHANGE_HOLD_HOURS = 72;
const supabaseAdmin = getSupabaseAdmin();

type OrgSettings = {
    public_name: string | null;
    logo_url?: string | null;
    email: string | null;
    phone: string | null;
};

type PayoutAccount = {
    verified_at?: string | null;
    verification_rejected_at?: string | null;
    verification_notes?: string | null;
    bank_changed_at?: string | null;
    legal_name: string | null;
    legal_rut: string | null;
    bank_name: string | null;
    bank_account_type: string | null;
    bank_account_number: string | null;
    bank_account_holder: string | null;
    bank_account_rut: string | null;
};

// logo_url existe desde 202611180100 (deploy preview sin migrar: sin logo)
const loadOrg = (cols: string) => supabaseAdmin.from("organizations").select(cols).eq("id", dbUser.organization_id).single();
let { data: orgData, error: orgError } = await loadOrg("public_name, email, phone, logo_url");
if (orgError) ({ data: orgData } = await loadOrg("public_name, email, phone"));
const org = orgData as OrgSettings | null;
const orgInitials = (org?.public_name || "?").trim().split(/\s+/).slice(0, 2).map((w) => w[0]?.toUpperCase() || "").join("") || "?";

// Datos bancarios: tabla aparte (organization_payout_accounts, migración 20260926_C_dashboard)
let payout: PayoutAccount | null = null;
{
    const BASE = "legal_name, legal_rut, bank_name, bank_account_type, bank_account_number, bank_account_holder, bank_account_rut";
    const load = (cols: string) => supabaseAdmin.from("organization_payout_accounts").select(cols).eq("organization_id", dbUser.organization_id).maybeSingle();
    // verified_at/bank_changed_at existen desde 202610090200; holder_match_status, desde la verificación de identidad
    // (Didit); el rechazo de la cuenta, desde payout_ops
    let { data, error } = await load(`${BASE}, verified_at, bank_changed_at, holder_match_status, verification_rejected_at, verification_notes`);
    if (error) ({ data, error } = await load(`${BASE}, verified_at, bank_changed_at, holder_match_status`));
    if (error) ({ data, error } = await load(`${BASE}, verified_at, bank_changed_at`));
    if (error) ({ data, error } = await load(BASE));
    if (error) console.error("Error cargando datos de pago:", error.message);
    payout = (data as PayoutAccount | null) || null;
}
// Persona natural o empresa: sin pestaña guardada, se deduce de si registró razón social/RUT de empresa
const holderKind: "person" | "company" = payout?.legal_name || payout?.legal_rut ? "company" : "person";
const bankComplete = Boolean(payout?.bank_name && payout?.bank_account_number && payout?.bank_account_holder && payout?.bank_account_rut);
const holdUntil = payout?.bank_changed_at ? new Date(new Date(payout.bank_changed_at).getTime() + BANK_CHANGE_HOLD_HOURS * 3600000) : null;
const holdActive = Boolean(holdUntil && holdUntil.getTime() > Date.now());
// AI Tickets rechazó la cuenta y el productor aún no corrige los datos (guardarlos de nuevo borra el rechazo)

// Verificación de identidad (Didit). Al volver del flujo (?identidad=volver) se consulta la decisión por si el
// webhook aún no llega.
let identity = await loadOrgIdentity(supabaseAdmin, Number(dbUser.organization_id)).catch(() => null);
if (Astro.url.searchParams.get("identidad") === "volver" && identity?.identity_session_id && identity.identity_status !== "approved") {
    try {
        await syncIdentityFromDidit(supabaseAdmin, Number(dbUser.organization_id));
        identity = await loadOrgIdentity(supabaseAdmin, Number(dbUser.organization_id));
    } catch (err: any) {
        console.error("Didit sync:", err?.message || err);
    }
}
const identityStatus = identity?.identity_status ?? null;
const identityLabel = identityStatus ? IDENTITY_STATUS_LABELS[identityStatus] : "Sin verificar";
const canStartIdentity = canEditOrg && identityStatus !== "approved" && identityStatus !== "in_review";

const BANKS = [
    "BancoEstado", "Banco de Chile / Edwards", "Santander", "BCI / MACH", "Scotiabank", "Itaú", "Banco Security",
    "Banco BICE", "Banco Falabella", "Banco Ripley", "Banco Consorcio", "Banco Internacional", "Coopeuch",
    "Tenpo", "Mercado Pago", "Otro",
];
const ACCOUNT_TYPES = ["Cuenta Corriente", "Cuenta Vista / CuentaRUT", "Cuenta de Ahorro"];
---

<DashboardLayout title="Configuración">
    <div class="max-w-4xl mx-auto space-y-8">
        {canEditOrg && (
        <!-- Profile Section -->
        <!-- Mobile: el botón Guardar y su mensaje van bajo el formulario; desde sm, el botón vuelve arriba a la derecha -->
        <section class="relative flex flex-col gap-6">
            <div class="border-b border-gray-100 pb-4 sm:pr-44">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">
                        Perfil de la Organización
                    </h2>
                    <p class="text-gray-500 text-sm">
                        Actualiza la información visible para el público.
                    </p>
                </div>
            </div>

            <div id="orgMsg" class="hidden order-1 sm:order-none rounded-lg px-4 py-3 text-sm font-medium"></div>

            <!-- Logo: se ve junto a "Organiza …" en la página de cada evento -->
            <div class="flex items-center gap-4" data-testid="org-logo">
                <div class="h-16 w-16 shrink-0 overflow-hidden rounded-full border border-gray-200 bg-gray-100 flex items-center justify-center text-lg font-semibold text-gray-600">
                    <img id="orgLogoImg" src={org?.logo_url || undefined} alt="Logo de la organización" class={`h-full w-full object-cover ${org?.logo_url ? "" : "hidden"}`} />
                    <span id="orgLogoInitials" class={org?.logo_url ? "hidden" : ""}>{orgInitials}</span>
                </div>
                <div class="space-y-1">
                    <p class="text-sm font-medium text-gray-700">Logo</p>
                    <div class="flex flex-wrap gap-2">
                        <label class="cursor-pointer px-3 py-1.5 text-sm rounded-lg border border-gray-200 hover:bg-gray-50">
                            <span id="orgLogoBtnText">{org?.logo_url ? "Cambiar logo" : "Subir logo"}</span>
                            <input id="orgLogoInput" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />
                        </label>
                        <button id="orgLogoRemove" type="button" class={`px-3 py-1.5 text-sm rounded-lg text-gray-600 hover:bg-gray-50 ${org?.logo_url ? "" : "hidden"}`}>Quitar</button>
                    </div>
                    <p class="text-xs text-gray-500">Cuadrado, JPG, PNG o WEBP, hasta 5 MB.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                <div class="space-y-2">
                    <label for="orgName" class="text-sm font-medium text-gray-700"
                        >Nombre público</label
                    >
                    <input
                        id="orgName"
                        type="text"
                        class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5"
                        placeholder="Ej: Dance Studio"
                        value={org?.public_name || ""}
                    />
                    <p class="text-xs text-gray-500">
                        Tu productora, academia o marca. En tus eventos dice <strong>“Organiza {org?.public_name || "Dance Studio"}”</strong>.
                        Puede ser distinto de tu nombre o de la razón social con la que cobras.
                    </p>
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700"
                        >Email de Contacto</label
                    >
                    <input
                        id="orgEmail"
                        type="email"
                        class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5"
                        placeholder="contacto@ejemplo.com"
                        value={org?.email || ""}
                    />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700"
                        >Teléfono</label
                    >
                    <input
                        id="orgPhone"
                        type="tel"
                        class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5"
                        placeholder="+56 9 ..."
                        value={org?.phone || ""}
                    />
                </div>
            </div>

            <button
                id="saveOrgBtn"
                class="order-2 sm:order-none w-full sm:w-auto sm:absolute sm:top-0 sm:right-0 px-4 py-2 text-sm bg-black text-white rounded-lg hover:bg-gray-800"
            >
                Guardar Cambios
            </button>
        </section>
        )}

        <!-- Verificación de identidad (Didit) -->
        <section id="identidad" class="space-y-4 pt-6 scroll-mt-24" data-testid="identity-section">
            <div class="border-b border-gray-100 pb-4">
                <h2 class="text-xl font-bold text-gray-900">Verificación de identidad</h2>
                <p class="text-gray-500 text-sm">{IDENTITY_WHY_TEXT} Es obligatoria para publicar eventos pagados para más de 10 personas y para recibir transferencias.</p>
            </div>

            <div class={`rounded-lg border px-4 py-3 text-sm ${identityStatus === "approved" ? "border-green-100 bg-green-50 text-green-900" : identityStatus === "declined" ? "border-red-100 bg-red-50 text-red-800" : "border-gray-200 bg-gray-50 text-gray-800"}`}>
                <p class="font-medium" data-testid="identity-status">
                    {identityStatus === "approved" ? "✓ " : ""}{identityLabel}{identityStatus === "approved" && identity?.identity_name ? `: ${identity.identity_name}` : ""}
                </p>
                {identityStatus === "pending" && <p class="mt-1">Si ya completaste los pasos, el resultado puede tardar unos minutos. Puedes retomar la verificación si la dejaste a medias.</p>}
                {identityStatus === "in_review" && <p class="mt-1">El equipo de AI Tickets está revisando tu verificación (normalmente 1 día hábil).</p>}
                {identityStatus === "declined" && <p class="mt-1">No pudimos verificar tu identidad. Puedes intentarlo de nuevo con tu cédula vigente y buena luz, o escribirnos a soporte.</p>}
                {!identityStatus && <p class="mt-1">Si cobras como persona natural, verifica tu identidad. Si cobras como empresa, verifica la del representante legal y elige “Empresa” en Datos para pagos.</p>}
            </div>

            {canStartIdentity && (
                <div class="space-y-3">
                    <label class="flex items-start gap-2 text-sm text-gray-700">
                        <input id="identityConsent" type="checkbox" class="mt-1 h-4 w-4 rounded border-gray-300" />
                        <span>{BIOMETRIC_CONSENT_TEXT.replace("Aviso de privacidad.", "")}<a href="/privacy" target="_blank" rel="noopener" class="underline">Aviso de privacidad</a>.</span>
                    </label>
                    <button id="startIdentityBtn" class="w-full sm:w-auto px-4 py-2 text-sm bg-black text-white rounded-lg hover:bg-gray-800 disabled:opacity-50">
                        {identityStatus ? "Retomar verificación" : "Verificar mi identidad"}
                    </button>
                    <div id="identityMsg" class="hidden rounded-lg px-4 py-3 text-sm font-medium"></div>
                </div>
            )}
            {!canEditOrg && identityStatus !== "approved" && (
                <p class="text-sm text-gray-500">La verificación la hace el dueño o un administrador de la organización.</p>
            )}
        </section>

        <!-- Bank / Payout Section -->
        <section id="datos-bancarios" data-holder-kind={holderKind} class="relative flex flex-col gap-6 pt-6 scroll-mt-24">
            <div class="border-b border-gray-100 pb-4 sm:pr-44">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Datos para pagos</h2>
                    <p class="text-gray-500 text-sm">
                        Lo que vendes para cada función queda disponible 48 horas después de que termina; cuando solicitas un retiro desde Ingresos, lo transferimos a esta cuenta en hasta 2 días hábiles.
                    </p>
                </div>
            </div>

            <div id="bankMsg" class="hidden order-1 sm:order-none rounded-lg px-4 py-3 text-sm font-medium"></div>

            <div class="rounded-lg border border-amber-100 bg-amber-50 px-4 py-3 text-sm text-amber-900" data-testid="bank-verification-note">
                {bankComplete && !holdActive && <p class="font-medium">✓ Cuenta registrada: puedes solicitar retiros.</p>}
                {holdActive && holdUntil && (
                    <p class="font-medium">Por seguridad, los retiros quedan habilitados desde el {holdUntil.toLocaleString("es-CL", { timeZone: "America/Santiago", dateStyle: "medium", timeStyle: "short" })}.</p>
                )}
                <p class="mt-1">
                    Por seguridad, cambiar los datos bancarios bloquea los retiros durante {BANK_CHANGE_HOLD_HOURS} horas.
                    Nunca compartas tu número de cuenta por chat: ingrésalo solo aquí.
                </p>
            </div>

            <!-- ¿A nombre de quién cobra? Persona natural (su propio RUT) o empresa (razón social y RUT de la empresa) -->
            <div class="space-y-3">
                <p class="text-sm font-medium text-gray-700">¿Cómo recibes los pagos?</p>
                <div role="tablist" aria-label="Tipo de titular" class="inline-flex w-full sm:w-auto rounded-lg bg-gray-100 p-1">
                    <button type="button" role="tab" data-kind="person" id="tabPerson" aria-selected={holderKind === "person" ? "true" : "false"} class="holder-tab flex-1 sm:flex-none px-4 py-1.5 text-sm font-medium rounded-md text-gray-500" data-testid="holder-tab-person">Persona natural</button>
                    <button type="button" role="tab" data-kind="company" id="tabCompany" aria-selected={holderKind === "company" ? "true" : "false"} class="holder-tab flex-1 sm:flex-none px-4 py-1.5 text-sm font-medium rounded-md text-gray-500" data-testid="holder-tab-company">Empresa</button>
                </div>
                <p class="text-sm text-gray-500" data-for="person">
                    Cobras a tu nombre, con tu RUT personal. No necesitas empresa ni razón social: la cuenta debe estar a tu nombre
                    (el de tu cédula verificada). Tus eventos igual dicen “Organiza {org?.public_name || "tu productora"}”.
                </p>
                <p class="text-sm text-gray-500" data-for="company">
                    Cobras como empresa (SpA, EIRL, Ltda.). La razón social y el RUT de la empresa se muestran en la página de tus
                    eventos; la cuenta debe estar a nombre de la empresa (o del representante legal verificado).
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                <div class="space-y-2" data-for="company">
                    <label for="legalName" class="text-sm font-medium text-gray-700">Razón social</label>
                    <input id="legalName" type="text" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5" placeholder="Mi Productora SpA" value={payout?.legal_name || ""} />
                </div>
                <div class="space-y-2" data-for="company">
                    <label for="legalRut" class="text-sm font-medium text-gray-700">RUT de la empresa</label>
                    <input id="legalRut" type="text" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5" placeholder="76.123.456-7" value={payout?.legal_rut || ""} />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700">Banco</label>
                    <select id="bankName" class="w-full px-4 py-2 rounded-lg border border-gray-200 bg-white focus:outline-none focus:ring-2 focus:ring-black/5">
                        <option value="">Selecciona tu banco...</option>
                        {BANKS.map((b) => <option value={b} selected={payout?.bank_name === b}>{b}</option>)}
                        {payout?.bank_name && !BANKS.includes(payout.bank_name) && <option value={payout.bank_name} selected>{payout.bank_name}</option>}
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700">Tipo de cuenta</label>
                    <select id="bankAccountType" class="w-full px-4 py-2 rounded-lg border border-gray-200 bg-white focus:outline-none focus:ring-2 focus:ring-black/5">
                        <option value="">Selecciona...</option>
                        {ACCOUNT_TYPES.map((t) => <option value={t} selected={payout?.bank_account_type === t}>{t}</option>)}
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-700">Número de cuenta</label>
                    <input id="bankAccountNumber" type="text" inputmode="numeric" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5" value={payout?.bank_account_number || ""} />
                </div>
                <div class="space-y-2">
                    <label for="bankAccountHolder" class="text-sm font-medium text-gray-700"><span data-for="person">Tu nombre completo (titular)</span><span data-for="company">Titular de la cuenta (la empresa)</span></label>
                    <input id="bankAccountHolder" type="text" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5" placeholder={holderKind === "company" ? "Mi Productora SpA" : "María Pérez Soto"} value={payout?.bank_account_holder || ""} />
                </div>
                <div class="space-y-2">
                    <label for="bankAccountRut" class="text-sm font-medium text-gray-700"><span data-for="person">Tu RUT</span><span data-for="company">RUT del titular</span></label>
                    <input id="bankAccountRut" type="text" class="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black/5" placeholder={holderKind === "company" ? "76.123.456-7" : "12.345.678-9"} value={payout?.bank_account_rut || ""} />
                </div>
            </div>

            {canEditPayout ? (
                <button id="saveBankBtn" class="order-2 sm:order-none w-full sm:w-auto sm:absolute sm:top-6 sm:right-0 px-4 py-2 text-sm bg-black text-white rounded-lg hover:bg-gray-800">
                    Guardar Datos
                </button>
            ) : (
                <p class="order-2 sm:order-none text-sm text-gray-500" data-testid="bank-readonly-note">
                    Solo el dueño de la cuenta o una persona de finanzas pueden cambiar los datos para pagos.
                </p>
            )}
        </section>

        <!-- La contraseña se cambia desde Mi Perfil (disponible para todos los roles) -->
        <section class="pt-6">
            <p class="text-sm text-gray-500">
                ¿Quieres cambiar tu contraseña? Hazlo desde <a href="/dashboard/profile" class="font-medium text-gray-900 underline">Mi Perfil</a>.
            </p>
        </section>
    </div>
</DashboardLayout>

<style>
  #datos-bancarios[data-holder-kind="person"] [data-for="company"],
  #datos-bancarios[data-holder-kind="company"] [data-for="person"] {
    display: none;
  }
  .holder-tab[aria-selected="true"] {
    background: #fff;
    color: rgb(17 24 39);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .holder-tab:disabled {
    cursor: not-allowed;
  }
</style>

<script>
  // Organization save
  const saveOrgBtn = document.getElementById('saveOrgBtn');
  const orgMsg = document.getElementById('orgMsg');

  function showMsg(el: HTMLElement | null, text: string, isError: boolean) {
    if (!el) return;
    el.textContent = text;
    el.className = `order-1 sm:order-none rounded-lg px-4 py-3 text-sm font-medium ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 4000);
  }

  saveOrgBtn?.addEventListener('click', async () => {
    (saveOrgBtn as HTMLButtonElement).disabled = true;
    saveOrgBtn.textContent = 'Guardando...';
    try {
      const res = await fetch('/api/organizations/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          public_name: (document.getElementById('orgName') as HTMLInputElement)?.value,
          email: (document.getElementById('orgEmail') as HTMLInputElement)?.value,
          phone: (document.getElementById('orgPhone') as HTMLInputElement)?.value,
        }),
      });
      const data = await res.json();
      if (res.ok) {
        showMsg(orgMsg, 'Organización actualizada correctamente', false);
      } else {
        showMsg(orgMsg, data.message || 'Error al guardar', true);
      }
    } catch {
      showMsg(orgMsg, 'Error de conexión', true);
    } finally {
      (saveOrgBtn as HTMLButtonElement).disabled = false;
      saveOrgBtn.textContent = 'Guardar Cambios';
    }
  });

  // Identity verification (Didit)
  const startIdentityBtn = document.getElementById('startIdentityBtn') as HTMLButtonElement | null;
  const identityMsg = document.getElementById('identityMsg');
  startIdentityBtn?.addEventListener('click', async () => {
    const consent = (document.getElementById('identityConsent') as HTMLInputElement | null)?.checked === true;
    if (!consent) {
      showMsg(identityMsg, 'Para continuar debes autorizar el tratamiento de tus datos biométricos.', true);
      return;
    }
    const idleText = startIdentityBtn.textContent;
    startIdentityBtn.disabled = true;
    startIdentityBtn.textContent = 'Abriendo verificación...';
    try {
      const res = await fetch('/api/identity/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ consent: true }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      showMsg(identityMsg, data.message || 'No pudimos iniciar la verificación', true);
    } catch {
      showMsg(identityMsg, 'Error de conexión', true);
    }
    startIdentityBtn.disabled = false;
    startIdentityBtn.textContent = idleText;
  });

  // Logo de la organización
  const logoInput = document.getElementById('orgLogoInput') as HTMLInputElement | null;
  const logoImg = document.getElementById('orgLogoImg') as HTMLImageElement | null;
  const logoInitials = document.getElementById('orgLogoInitials');
  const logoRemove = document.getElementById('orgLogoRemove') as HTMLButtonElement | null;
  const logoBtnText = document.getElementById('orgLogoBtnText');
  function showLogo(url: string | null) {
    if (logoImg) { if (url) logoImg.src = url; logoImg.classList.toggle('hidden', !url); }
    logoInitials?.classList.toggle('hidden', Boolean(url));
    logoRemove?.classList.toggle('hidden', !url);
    if (logoBtnText) logoBtnText.textContent = url ? 'Cambiar logo' : 'Subir logo';
  }
  logoInput?.addEventListener('change', async () => {
    const file = logoInput.files?.[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) { showMsg(orgMsg, 'La imagen no debe superar los 5MB', true); logoInput.value = ''; return; }
    if (logoBtnText) logoBtnText.textContent = 'Subiendo...';
    const form = new FormData();
    form.append('file', file);
    try {
      const res = await fetch('/api/organizations/logo', { method: 'POST', body: form });
      const data = await res.json().catch(() => ({}));
      if (res.ok) { showLogo(data.url); showMsg(orgMsg, 'Logo actualizado', false); }
      else { showLogo(logoImg && !logoImg.classList.contains('hidden') ? logoImg.src : null); showMsg(orgMsg, data.message || 'No pudimos subir el logo', true); }
    } catch {
      showMsg(orgMsg, 'Error de conexión', true);
      showLogo(logoImg && !logoImg.classList.contains('hidden') ? logoImg.src : null);
    }
    logoInput.value = '';
  });
  logoRemove?.addEventListener('click', async () => {
    logoRemove.disabled = true;
    try {
      const res = await fetch('/api/organizations/logo', { method: 'DELETE' });
      const data = await res.json().catch(() => ({}));
      if (res.ok) { showLogo(null); showMsg(orgMsg, 'Logo eliminado', false); }
      else showMsg(orgMsg, data.message || 'No pudimos quitar el logo', true);
    } catch {
      showMsg(orgMsg, 'Error de conexión', true);
    }
    logoRemove.disabled = false;
  });

  // Persona natural / Empresa: muestra los campos de cada caso
  // Qué campos se ven lo decide el CSS con data-holder-kind de la sección (sin parpadeo antes del JS)
  const bankSection = document.getElementById('datos-bancarios');
  let holderKind = (bankSection?.dataset.holderKind === 'company' ? 'company' : 'person') as 'person' | 'company';
  function setHolderKind(kind: 'person' | 'company') {
    holderKind = kind;
    if (bankSection) bankSection.dataset.holderKind = kind;
    document.querySelectorAll<HTMLButtonElement>('#datos-bancarios .holder-tab').forEach((tab) => {
      tab.setAttribute('aria-selected', tab.dataset.kind === kind ? 'true' : 'false');
    });
    const holder = document.getElementById('bankAccountHolder') as HTMLInputElement | null;
    const holderRut = document.getElementById('bankAccountRut') as HTMLInputElement | null;
    if (holder) holder.placeholder = kind === 'company' ? 'Mi Productora SpA' : 'María Pérez Soto';
    if (holderRut) holderRut.placeholder = kind === 'company' ? '76.123.456-7' : '12.345.678-9';
  }
  document.querySelectorAll<HTMLButtonElement>('#datos-bancarios .holder-tab').forEach((tab) => {
    tab.addEventListener('click', () => { if (!tab.disabled) setHolderKind(tab.dataset.kind === 'company' ? 'company' : 'person'); });
  });
  setHolderKind(holderKind);

  // Bank data save
  const saveBankBtn = document.getElementById('saveBankBtn');
  // Sin permiso para cambiarlos (administrador): los datos para pagos quedan de solo lectura
  if (!saveBankBtn) {
    document.querySelectorAll('#datos-bancarios input, #datos-bancarios select, #datos-bancarios .holder-tab').forEach((el) => { (el as HTMLInputElement).disabled = true; });
  }
  const bankMsg = document.getElementById('bankMsg');
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';

  saveBankBtn?.addEventListener('click', async () => {
    const isCompany = holderKind === 'company';
    if (isCompany && (!val('legalName').trim() || !val('legalRut').trim())) {
      showMsg(bankMsg, 'Para cobrar como empresa completa la razón social y el RUT de la empresa', true);
      return;
    }
    (saveBankBtn as HTMLButtonElement).disabled = true;
    saveBankBtn.textContent = 'Guardando...';
    try {
      const res = await fetch('/api/organizations/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          // Persona natural: sin razón social ni RUT de empresa (se borran si quedaron de antes)
          legal_name: isCompany ? val('legalName') : '',
          legal_rut: isCompany ? val('legalRut') : '',
          bank_name: val('bankName'),
          bank_account_type: val('bankAccountType'),
          bank_account_number: val('bankAccountNumber'),
          bank_account_holder: val('bankAccountHolder'),
          bank_account_rut: val('bankAccountRut'),
        }),
      });
      const data = await res.json();
      showMsg(bankMsg, res.ok ? 'Datos bancarios guardados' : (data.message || 'Error al guardar'), !res.ok);
    } catch {
      showMsg(bankMsg, 'Error de conexión', true);
    } finally {
      (saveBankBtn as HTMLButtonElement).disabled = false;
      saveBankBtn.textContent = 'Guardar Datos';
    }
  });
</script>
