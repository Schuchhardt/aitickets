---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getSupabaseAdmin } from "../../lib/auth-helpers";
import { requireDashboardSession } from "./_lib/guard";
import { googlePhotoUrl } from "../../lib/userAvatar";

// Perfil propio: cualquier rol
const guard = await requireDashboardSession(Astro);
if (!guard.ok) return guard.response;
const { authUser: user } = guard.session;

const { data: dbUser } = await getSupabaseAdmin()
    .from("users")
    .select("id, name, email, phone, role, organization_id")
    .eq("id", guard.session.dbUser.id)
    .single();

const avatarUrl = guard.session.dbUser.avatar_url || null;
const hasGooglePhoto = Boolean(googlePhotoUrl(user));
const initial =
    (dbUser?.name || user.user_metadata?.full_name)?.[0]?.toUpperCase() || user.email?.[0]?.toUpperCase() || "U";
---

<DashboardLayout title="Mi Perfil">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-2xl font-bold font-[Unbounded] mb-6">Mi Perfil</h1>

        <div class="bg-white p-4 md:p-6 rounded-xl border border-gray-200 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-6 md:mb-8">
                <div class="relative w-20 h-20 shrink-0">
                    <img
                        id="avatarImg"
                        src={avatarUrl || undefined}
                        alt="Tu foto de perfil"
                        class:list={["w-20 h-20 rounded-full object-cover bg-gray-200", { hidden: !avatarUrl }]}
                    />
                    <div
                        id="avatarInitial"
                        class:list={["w-20 h-20 rounded-full bg-black text-white flex items-center justify-center text-3xl font-bold", { hidden: !!avatarUrl }]}
                    >
                        {initial}
                    </div>
                    <div id="avatarSpinner" class="hidden absolute inset-0 rounded-full bg-white/70 flex items-center justify-center">
                        <div class="animate-spin h-6 w-6 border-2 border-black border-t-transparent rounded-full"></div>
                    </div>
                </div>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold break-words">
                        {dbUser?.name || user.user_metadata?.full_name || "Usuario"}
                    </h2>
                    <p class="text-gray-500 break-all">{user.email}</p>
                    <div class="flex flex-wrap gap-2 mt-3">
                        <label
                            class="cursor-pointer px-3 py-1.5 text-sm rounded-lg border border-gray-300 hover:bg-gray-50 font-medium"
                            data-testid="profile-avatar-upload"
                        >
                            <span id="avatarUploadLabel">{avatarUrl ? "Cambiar foto" : "Subir foto"}</span>
                            <input id="avatarInput" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="sr-only" />
                        </label>
                        {
                            hasGooglePhoto && (
                                <button
                                    type="button"
                                    id="avatarGoogleBtn"
                                    class="px-3 py-1.5 text-sm rounded-lg border border-gray-300 hover:bg-gray-50 font-medium"
                                    data-testid="profile-avatar-google"
                                >
                                    Usar mi foto de Google
                                </button>
                            )
                        }
                        <button
                            type="button"
                            id="avatarRemoveBtn"
                            class:list={["px-3 py-1.5 text-sm rounded-lg text-red-600 hover:bg-red-50 font-medium", { hidden: !avatarUrl }]}
                        >
                            Quitar
                        </button>
                    </div>
                    <p class="text-xs text-gray-400 mt-2">JPG, PNG, WEBP o GIF, hasta 5 MB.</p>
                    <p id="avatarMsg" class="hidden text-sm mt-2" aria-live="polite"></p>
                </div>
            </div>

            <form id="profileForm" class="space-y-4">
                <div id="messageContainer" class="hidden p-4 rounded-lg mb-4">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                        >Nombre Completo</label
                    >
                    <input
                        type="text"
                        name="full_name"
                        value={dbUser?.name ||
                            user.user_metadata?.full_name ||
                            ""}
                        class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-black focus:border-black outline-none transition-all"
                        required
                    />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                        >Teléfono</label
                    >
                    <input
                        type="tel"
                        name="phone"
                        value={dbUser?.phone || user.user_metadata?.phone || ""}
                        placeholder="+56 9 1234 5678"
                        class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-black focus:border-black outline-none transition-all"
                    />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                        >Correo Electrónico</label
                    >
                    <input
                        type="email"
                        value={user.email}
                        disabled
                        class="w-full px-4 py-2 rounded-lg border border-gray-300 bg-gray-50 text-gray-500 cursor-not-allowed"
                    />
                </div>

                <div class="pt-4">
                    <button
                        type="submit"
                        id="submitBtn"
                        class="w-full sm:w-auto justify-center px-6 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
                    >
                        <span>Guardar Cambios</span>
                        <div
                            id="spinner"
                            class="hidden animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"
                        >
                        </div>
                    </button>
                </div>
            </form>
        </div>

        <!-- Seguridad: cambio de contraseña (cualquier rol). Sin contraseña actual: se envía un enlace al
             correo que abre el panel con el modal para crear la nueva (/api/auth/magic-link → /auth/link). -->
        <div id="password" class="bg-white p-4 md:p-6 rounded-xl border border-gray-200 shadow-sm mt-6">
            <h2 class="text-lg font-bold mb-1">Contraseña</h2>
            <p class="text-gray-500 text-sm mb-4">
                Te enviaremos un enlace a <span class="font-medium text-gray-700 break-all">{user.email}</span>. Al abrirlo
                entrarás directo a tu panel y podrás crear tu nueva contraseña, sin necesidad de la actual.
            </p>
            <div id="pwMsg" class="hidden p-4 rounded-lg mb-4" aria-live="polite"></div>
            <button type="button" id="sendPwLinkBtn"
                class="w-full sm:w-auto px-6 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed"
                data-testid="profile-change-password">
                Cambiar contraseña
            </button>
        </div>
    </div>

    <script>
        const form = document.getElementById("profileForm") as HTMLFormElement;
        const messageContainer = document.getElementById("messageContainer") as HTMLElement;
        const submitBtn = document.getElementById(
            "submitBtn",
        ) as HTMLButtonElement;
        const spinner = document.getElementById("spinner") as HTMLElement;

        if (form) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();

                // Reset state
                messageContainer.classList.add("hidden");
                messageContainer.className = "hidden p-4 rounded-lg mb-4";
                submitBtn.disabled = true;
                spinner.classList.remove("hidden");

                const formData = new FormData(form);
                const data = {
                    full_name: formData.get("full_name"),
                    phone: formData.get("phone"),
                };

                try {
                    const response = await fetch("/api/users/update", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(data),
                    });

                    const result = await response.json();

                    messageContainer.classList.remove("hidden");

                    if (response.ok) {
                        messageContainer.classList.add(
                            "bg-green-50",
                            "text-green-800",
                            "border",
                            "border-green-200",
                        );
                        messageContainer.textContent =
                            "Perfil actualizado correctamente.";
                        // Optional: Reload to reflect changes in Sidebar/UI
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        throw new Error(
                            result.error || "Error al actualizar el perfil",
                        );
                    }
                } catch (error) {
                    messageContainer.classList.add(
                        "bg-red-50",
                        "text-red-800",
                        "border",
                        "border-red-200",
                    );
                    messageContainer.textContent = error instanceof Error ? error.message : String(error);
                } finally {
                    submitBtn.disabled = false;
                    spinner.classList.add("hidden");
                }
            });
        }

        // Foto de perfil: subir, copiar la de Google o quitar
        const avatarImg = document.getElementById("avatarImg") as HTMLImageElement | null;
        const avatarInitial = document.getElementById("avatarInitial") as HTMLElement | null;
        const avatarSpinner = document.getElementById("avatarSpinner") as HTMLElement | null;
        const avatarInput = document.getElementById("avatarInput") as HTMLInputElement | null;
        const avatarUploadLabel = document.getElementById("avatarUploadLabel") as HTMLElement | null;
        const avatarGoogleBtn = document.getElementById("avatarGoogleBtn") as HTMLButtonElement | null;
        const avatarRemoveBtn = document.getElementById("avatarRemoveBtn") as HTMLButtonElement | null;
        const avatarMsg = document.getElementById("avatarMsg") as HTMLElement | null;

        const showAvatarMsg = (text: string, isError: boolean) => {
            if (!avatarMsg) return;
            avatarMsg.textContent = text;
            avatarMsg.className = `text-sm mt-2 ${isError ? "text-red-600" : "text-green-700"}`;
        };

        const renderAvatar = (url: string | null) => {
            if (url && avatarImg) avatarImg.src = url;
            avatarImg?.classList.toggle("hidden", !url);
            avatarInitial?.classList.toggle("hidden", !!url);
            avatarRemoveBtn?.classList.toggle("hidden", !url);
            if (avatarUploadLabel) avatarUploadLabel.textContent = url ? "Cambiar foto" : "Subir foto";
            // La barra lateral también muestra la foto
            setTimeout(() => window.location.reload(), 1200);
        };

        const avatarRequest = async (init: RequestInit, okText: string) => {
            avatarSpinner?.classList.remove("hidden");
            avatarMsg?.classList.add("hidden");
            for (const b of [avatarGoogleBtn, avatarRemoveBtn]) if (b) b.disabled = true;
            if (avatarInput) avatarInput.disabled = true;
            try {
                const res = await fetch("/api/users/avatar", init);
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.message || "No pudimos guardar tu foto");
                showAvatarMsg(okText, false);
                renderAvatar(data.url || null);
            } catch (err) {
                showAvatarMsg(err instanceof Error ? err.message : "Error de conexión", true);
            } finally {
                avatarSpinner?.classList.add("hidden");
                for (const b of [avatarGoogleBtn, avatarRemoveBtn]) if (b) b.disabled = false;
                if (avatarInput) {
                    avatarInput.disabled = false;
                    avatarInput.value = "";
                }
            }
        };

        avatarInput?.addEventListener("change", () => {
            const file = avatarInput.files?.[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) {
                showAvatarMsg("La imagen no debe superar los 5MB", true);
                avatarInput.value = "";
                return;
            }
            const fd = new FormData();
            fd.append("file", file);
            avatarRequest({ method: "POST", body: fd }, "Foto actualizada.");
        });

        avatarGoogleBtn?.addEventListener("click", () =>
            avatarRequest(
                { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ source: "google" }) },
                "Ahora usas tu foto de Google.",
            ),
        );

        avatarRemoveBtn?.addEventListener("click", () => avatarRequest({ method: "DELETE" }, "Foto eliminada."));

        // Cambio de contraseña: enviar el enlace al correo
        const pwMsg = document.getElementById("pwMsg") as HTMLElement | null;
        const sendPwLinkBtn = document.getElementById("sendPwLinkBtn") as HTMLButtonElement | null;

        const showPwMsg = (text: string, isError: boolean) => {
            if (!pwMsg) return;
            pwMsg.textContent = text;
            pwMsg.className = `p-4 rounded-lg border mb-4 ${isError ? "bg-red-50 text-red-800 border-red-200" : "bg-green-50 text-green-800 border-green-200"}`;
        };

        sendPwLinkBtn?.addEventListener("click", async () => {
            sendPwLinkBtn.disabled = true;
            sendPwLinkBtn.textContent = "Enviando...";
            try {
                const res = await fetch("/api/auth/magic-link", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ purpose: "change-password" }),
                });
                const data = await res.json().catch(() => ({}));
                if (res.ok) {
                    showPwMsg(data.message || "Te enviamos un enlace a tu correo.", false);
                    sendPwLinkBtn.textContent = "Reenviar enlace";
                } else {
                    showPwMsg(data.message || "No pudimos enviar el enlace. Intenta de nuevo.", true);
                    sendPwLinkBtn.textContent = "Cambiar contraseña";
                }
            } catch {
                showPwMsg("Error de conexión", true);
                sendPwLinkBtn.textContent = "Cambiar contraseña";
            } finally {
                sendPwLinkBtn.disabled = false;
            }
        });
    </script>
</DashboardLayout>
