---
// "Conecta tu IA": paso a paso para Claude y ChatGPT (OAuth), otros clientes MCP y llaves de API para
// integraciones (REST /api/v1). Destino final del funnel de registro (?bienvenida=1 muestra la bienvenida).
// Los datos los carga ApiKeysManager vía /api/api-keys.
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ApiKeysManager from "../../components/dashboard/ApiKeysManager.vue";
import { EVENT_MANAGER_ROLES } from "../../lib/supabaseServer";
import { siteUrl } from "../api/_lib/server-utils";
import { requireDashboardSession } from "./_lib/guard";

const guard = await requireDashboardSession(Astro, EVENT_MANAGER_ROLES);
if (!guard.ok) return guard.response;

const origin = siteUrl() || Astro.url.origin;
---

<DashboardLayout title="Conecta tu IA">
    <div class="space-y-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Conecta tu IA</h1>
            <p class="text-sm text-gray-500 mt-1 max-w-3xl">
                Gestiona tus eventos conversando con Claude o ChatGPT: crea eventos y entradas, lanza códigos de descuento,
                pregunta cómo van las ventas y genera imágenes y posts. Sigue los pasos de tu asistente; no necesitas copiar ninguna llave.
            </p>
        </div>
        <ApiKeysManager client:load origin={origin} />
    </div>
</DashboardLayout>
