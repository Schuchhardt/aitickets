</DashboardLayout>

<script>
    // Tab switching
    document.querySelectorAll(".tab-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const tabId = btn.getAttribute("data-tab");

            // Update tab buttons
            document.querySelectorAll(".tab-btn").forEach((b) => {
                b.classList.remove("active", "border-black", "text-black");
                b.classList.add("border-transparent", "text-gray-500");
            });
            btn.classList.add("active", "border-black", "text-black");
            btn.classList.remove("border-transparent", "text-gray-500");

            // Update tab content
            document.querySelectorAll(".tab-content").forEach((content) => {
                content.classList.add("hidden");
            });
            document.getElementById(`tab-${tabId}`)?.classList.remove("hidden");
        });
    });

    // Accordion functionality
    document.querySelectorAll(".accordion-trigger").forEach((trigger) => {
        trigger.addEventListener("click", () => {
            const accordion = trigger.closest(".event-accordion");
            const content = accordion?.querySelector(".accordion-content");
            const icon = trigger.querySelector(".accordion-icon");

            if (content?.classList.contains("hidden")) {
                content.classList.remove("hidden");
                icon?.classList.add("rotate-180");
            } else {
                content?.classList.add("hidden");
                icon?.classList.remove("rotate-180");
            }
        });
    });

    // Búsqueda y filtro por función (las entradas válidas para cualquier función aparecen en todas). El CSV
    // descarga solo la función elegida (/api/events/orders-csv?event_date_id=).
    function applyFilters(eventId: string | null) {
        if (!eventId) return;
        const search = document.querySelector<HTMLInputElement>(`.search-input[data-event-id="${eventId}"]`);
        const fnSelect = document.querySelector<HTMLSelectElement>(`.function-filter[data-event-id="${eventId}"]`);
        const searchTerm = (search?.value || "").toLowerCase();
        const fn = fnSelect?.value || "";
        const tbody = document.querySelector(`.attendees-tbody[data-event-id="${eventId}"]`);
        tbody?.querySelectorAll<HTMLElement>(".attendee-row").forEach((row) => {
            const text = [".attendee-name", ".attendee-email", ".attendee-ticket"]
                .map((sel) => row.querySelector(sel)?.textContent?.toLowerCase() || "")
                .join(" ");
            const rowFn = row.dataset.function || "all";
            const matches = text.includes(searchTerm) && (!fn || rowFn === fn || rowFn === "all");
            row.style.display = matches ? "" : "none";
        });
        const csv = document.querySelector<HTMLAnchorElement>(`[data-csv-event-id="${eventId}"]`);
        if (csv) csv.href = `/api/events/orders-csv?event_id=${eventId}${fn ? `&event_date_id=${fn}` : ""}`;
    }

    document.querySelectorAll(".search-input").forEach((input) => {
        input.addEventListener("input", () => applyFilters(input.getAttribute("data-event-id")));
    });
    document.querySelectorAll(".function-filter").forEach((select) => {
        select.addEventListener("change", () => applyFilters(select.getAttribute("data-event-id")));
    });

    // ?event=<id> (desde la tarjeta "Entradas vendidas" del evento): abre su pestaña y su acordeón
    const preselected = new URLSearchParams(window.location.search).get("event");
    const target = preselected ? document.querySelector<HTMLElement>(`.event-accordion[data-event-id="${CSS.escape(preselected)}"]`) : null;
    if (target) {
        const tabId = target.closest(".tab-content")?.id.replace("tab-", "");
        document.querySelector<HTMLButtonElement>(`.tab-btn[data-tab="${tabId}"]`)?.click();
        if (target.querySelector(".accordion-content")?.classList.contains("hidden")) {
            target.querySelector<HTMLButtonElement>(".accordion-trigger")?.click();
        }
        target.scrollIntoView({ block: "start" });
    }
</script>

<style>
    .tab-btn.active {
        border-color: #000;
        color: #000;
    }
</style>
