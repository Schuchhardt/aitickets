---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { getSupabaseAdmin } from "../../../lib/auth-helpers";
import { EVENT_MANAGER_ROLES } from "../../../lib/supabaseServer";
import { requireDashboardSession } from "../_lib/guard";
import { getStaffEventIds } from "../../../../netlify/lib/event-staff.mjs";
import { fetchAll } from "../../../lib/producer-api/tools/common";
import { formatFunctionLabel } from "../../../../netlify/lib/dates.mjs";
import { formatRut, answersText, missingAttendeeData } from "../../../lib/checkoutFields.mjs";
import {
    Ticket,
    Calendar,
    ChevronDown,
    Users,
    DollarSign,
    Gift,
    Clock,
    CheckCircle,
    XCircle,
    Search,
    Download,
} from "lucide-vue-next";

const guard = await requireDashboardSession(Astro, EVENT_MANAGER_ROLES);
if (!guard.ok) return guard.response;
const { dbUser } = guard.session;
const supabaseAdmin = getSupabaseAdmin();

const now = new Date().toISOString();
// Equipo asignado a ciertos eventos (aitickets_event_staff): solo ve las entradas de esos eventos
const staffEventIds = await getStaffEventIds(supabaseAdmin, dbUser.id);
const onlyStaffEvents = <Q,>(query: Q): Q => (staffEventIds ? (query as any).in("id", staffEventIds) : query);

// Fetch current events (end_date >= now or start_date >= now)
const { data: currentEvents } = await onlyStaffEvents(supabaseAdmin
    .from("events")
    .select(
        `
    id,
    name,
    title,
    slug,
    start_date,
    end_date,
    status,
    image_url,
    event_tickets (
      id,
      ticket_name,
      price,
      total_quantity,
      status,
      is_gift,
      event_date_id
    ),
    event_dates (
      id,
      date,
      start_time
    )
  `,
    )
    .eq("organization_id", dbUser.organization_id))
    .or(`end_date.gte.${now},end_date.is.null`)
    .order("start_date", { ascending: true });

// Fetch past events (end_date < now)
const { data: pastEvents } = await onlyStaffEvents(supabaseAdmin
    .from("events")
    .select(
        `
    id,
    name,
    title,
    slug,
    start_date,
    end_date,
    status,
    image_url,
    event_tickets (
      id,
      ticket_name,
      price,
      total_quantity,
      status,
      is_gift,
      event_date_id
    ),
    event_dates (
      id,
      date,
      start_time
    )
  `,
    )
    .eq("organization_id", dbUser.organization_id))
    .lt("end_date", now)
    .order("end_date", { ascending: false });

type AttendeeRow = {
    id: string;
    name: string;
    email: string;
    ticketType: string;
    price: number;
    isFree: boolean;
    isComplimentary: boolean;
    purchaseDate: string;
    status: string | null;
    validated: boolean;
    /** Función del tipo de entrada (event_date_id); null = válida para cualquier función. */
    functionId: number | null;
    functionLabel: string | null;
    /** Quien compró, si el asistente de este QR es otra persona (event_attendees.holder_name). */
    boughtBy: string | null;
    /** Respuestas a las preguntas del evento ("Talla: M · Alergias: no"): las de esta persona y las de la orden. */
    answers: string;
    /** Lo que le falta a esta persona (invitado que aún no completa sus datos): 'Nombre' o el texto de cada pregunta. */
    pending: string[];
    /** Empresa de la orden ("Acme SpA · 76.123.456-7"). */
    company: string;
};
type TicketStats = {
    /** Entradas vendidas: vigentes, de órdenes pagadas (o gratis sin orden), sin cortesías. */
    totalSold: number;
    /** Cortesías vigentes (se muestran aparte; no son ventas). */
    courtesy: number;
    /** Emitidas vigentes por tipo de entrada (incluye cortesías: es el stock usado). */
    byTicketType: Record<number, number>;
    /** Ocupación de los tipos a la venta con cupo: emitidas ÷ cupo (sin el tipo "Cortesía" del sistema). */
    occupancyPct: number;
};

/**
 * Entradas de un evento con su listado. Paginado (fetchAll): antes las órdenes pagadas se cortaban en 1000 y las
 * entradas de órdenes posteriores dejaban de contarse.
 */
/** Funciones del evento en orden, con su etiqueta (solo importan si hay más de una). */
function eventFunctionList(event: any): { id: number; label: string }[] {
    return [...(event.event_dates || [])]
        .sort((a: any, b: any) => `${a.date} ${a.start_time || ""}`.localeCompare(`${b.date} ${b.start_time || ""}`))
        .map((d: any) => ({ id: Number(d.id), label: formatFunctionLabel(d, { withPlace: false }) }));
}

// Asistente de cada QR (holder_*, 202610300100), mesa (unit_id, 202610300110) y respuestas por persona
// (registration_answers, 202610310100): columnas opcionales (base sin migrar)
const ATTENDEE_EXTRA_COLUMNS = ["holder_name, holder_email, unit_id, registration_answers,", "holder_name, holder_email, unit_id,", "holder_name, holder_email,", ""];
const ORDER_EXTRA_COLUMNS = ["buyer_first_name, buyer_last_name, buyer_email, registration_answers, company_rut, company_name", "buyer_first_name, buyer_last_name, buyer_email"];

async function fetchWithFallback<T>(variants: string[], build: (cols: string) => any): Promise<T[]> {
    let lastError: any = null;
    for (const cols of variants) {
        try {
            return await fetchAll<T>(() => build(cols));
        } catch (err: any) {
            lastError = err;
            if (!["42703", "PGRST204"].includes(String(err?.code || ""))) throw err;
        }
    }
    throw lastError;
}

async function loadEventTickets(event: any): Promise<{ stats: TicketStats; attendees: AttendeeRow[] }> {
    const functionLabels = new Map(eventFunctionList(event).map((f) => [f.id, f.label]));
    const [eventAttendeesRows, paidOrders, fieldsRes] = await Promise.all([
        fetchWithFallback<any>(ATTENDEE_EXTRA_COLUMNS, (extra) => supabaseAdmin
            .from("event_attendees")
            .select(
                `
      ${extra}
      id,
      created_at,
      event_order_id,
      event_ticket_id,
      status,
      validated_at,
      is_complimentary,
      event_tickets (
        id,
        ticket_name,
        price,
        event_date_id
      ),
      attendees (
        id,
        first_name,
        last_name,
        email
      )
    `,
            )
            .eq("event_id", event.id)
            .order("created_at", { ascending: false })
            .order("id", { ascending: true })),
        fetchWithFallback<any>(ORDER_EXTRA_COLUMNS, (cols) => supabaseAdmin
            .from("event_orders")
            .select(`id, ${cols}`)
            .eq("event_id", event.id)
            .eq("status", "paid")
            .order("id", { ascending: true })),
        supabaseAdmin.from("events").select("checkout_fields").eq("id", event.id).maybeSingle(),
    ]);
    const checkoutFields = fieldsRes.error ? null : (fieldsRes.data as any)?.checkout_fields;
    const paidOrderIds = new Set(paidOrders.map((o) => o.id));
    const ordersById = new Map<string, any>(paidOrders.map((o) => [o.id, o]));

    // Entradas de órdenes pagadas o sin orden (gratis antiguas)
    const valid = eventAttendeesRows.filter((a: any) => a.event_order_id === null || paidOrderIds.has(a.event_order_id));
    const active = valid.filter((a: any) => a.status !== "cancelled"); // anuladas (reembolsos) no cuentan
    const byTicketType: Record<number, number> = {};
    let courtesy = 0;
    // Stock usado: una mesa para N cuenta una vez (sus QR comparten unit_id)
    const seenUnits = new Set<string>();
    for (const a of active) {
        if (a.is_complimentary === true) courtesy += 1;
        if (a.unit_id && seenUnits.has(a.unit_id)) continue;
        if (a.unit_id) seenUnits.add(a.unit_id);
        byTicketType[a.event_ticket_id] = (byTicketType[a.event_ticket_id] || 0) + 1;
    }
    const limited = (event.event_tickets || []).filter((t: any) => !t.is_gift && t.total_quantity != null);
    const capacity = limited.reduce((sum: number, t: any) => sum + (Number(t.total_quantity) || 0), 0);
    const issued = limited.reduce((sum: number, t: any) => sum + (byTicketType[t.id] || 0), 0);

    return {
        stats: {
            totalSold: active.length - courtesy,
            courtesy,
            byTicketType,
            occupancyPct: capacity > 0 ? Math.min(100, Math.round((issued / capacity) * 100)) : 0,
        },
        attendees: valid.map((a: any) => {
            const order = a.event_order_id ? ordersById.get(a.event_order_id) : null;
            const buyerName = order?.buyer_email
                ? `${order.buyer_first_name || ""} ${order.buyer_last_name || ""}`.trim()
                : `${a.attendees?.first_name || ""} ${a.attendees?.last_name || ""}`.trim();
            const buyerEmail = order?.buyer_email || a.attendees?.email || "";
            const holderIsOther = Boolean(a.holder_name || a.holder_email) && (a.holder_name || "") !== buyerName;
            // Invitado por correo que aún no escribe su nombre
            const unnamedGuest = !a.holder_name && Boolean(a.holder_email) && String(a.holder_email).toLowerCase() !== String(buyerEmail).toLowerCase();
            return {
            id: a.id,
            name: a.holder_name || (unnamedGuest ? "Invitado (sin nombre)" : buyerName) || "Sin nombre",
            email: a.holder_email || (a.holder_name ? "" : buyerEmail) || "Sin email",
            boughtBy: holderIsOther ? buyerName || buyerEmail : null,
            answers: [answersText(a.registration_answers), answersText(order?.registration_answers)].filter(Boolean).join(" · "),
            pending: a.status === "cancelled" ? [] : missingAttendeeData(checkoutFields, a, { buyerEmail, orderAnswers: order?.registration_answers }),
            company: order?.company_name ? `${order.company_name} · ${formatRut(order.company_rut)}` : "",
            ticketType: a.event_tickets?.ticket_name || "N/A",
            price: a.event_tickets?.price || 0,
            isFree: a.event_order_id === null,
            isComplimentary: a.is_complimentary,
            purchaseDate: a.created_at,
            status: a.status,
            validated: !!a.validated_at,
            functionId: a.event_tickets?.event_date_id == null ? null : Number(a.event_tickets.event_date_id),
            functionLabel:
                functionLabels.size > 1
                    ? a.event_tickets?.event_date_id == null
                        ? "Todas las funciones"
                        : functionLabels.get(Number(a.event_tickets.event_date_id)) || null
                    : null,
            };
        }),
    };
}

// Pre-compute stats for all events (en paralelo, de a 6 eventos)
const eventStats: Record<number, TicketStats> = {};
const eventAttendees: Record<number, AttendeeRow[]> = {};

const allEvents = [...(currentEvents || []), ...(pastEvents || [])];
for (let i = 0; i < allEvents.length; i += 6) {
    const batch = allEvents.slice(i, i + 6);
    const loaded = await Promise.all(batch.map((event) => loadEventTickets(event)));
    batch.forEach((event, j) => {
        eventStats[event.id] = loaded[j].stats;
        eventAttendees[event.id] = loaded[j].attendees;
    });
}

// Format price
function formatPrice(price: number): string {
    return new Intl.NumberFormat("es-CL", {
        style: "currency",
        currency: "CLP",
        minimumFractionDigits: 0,
    }).format(price);
}

// Format date
function formatDate(dateString: string | null): string {
    if (!dateString) return "Sin fecha";
    return new Date(dateString).toLocaleDateString("es-CL", {
        timeZone: "America/Santiago",
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    });
}
---

<DashboardLayout title="Entradas">
    <div class="space-y-6">
        <!-- Header -->
        <div
            class="flex flex-col md:flex-row md:items-center justify-between gap-4"
        >
            <div>
                <h1 class="text-2xl md:text-3xl font-bold font-[Unbounded] mb-2">
                    Entradas
                </h1>
                <p class="text-gray-600">
                    Gestiona las entradas vendidas de todos tus eventos.
                </p>
            </div>
        </div>

        <!-- Tabs -->
        <div
            class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden"
        >
            <div class="border-b border-gray-100">
                <nav class="flex overflow-x-auto" id="tabs-nav">
                    <button
                        type="button"
                        class="tab-btn active shrink-0 whitespace-nowrap px-4 md:px-6 py-4 text-sm font-medium border-b-2 border-black text-black transition-colors"
                        data-tab="current"
                    >
                        <span class="flex items-center gap-2">
                            <Calendar class="w-4 h-4" />
                            Eventos Actuales
                            <span
                                class="bg-black text-white text-xs px-2 py-0.5 rounded-full"
                            >
                                {currentEvents?.length || 0}
                            </span>
                        </span>
                    </button>
                    <button
                        type="button"
                        class="tab-btn shrink-0 whitespace-nowrap px-4 md:px-6 py-4 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors"
                        data-tab="past"
                    >
                        <span class="flex items-center gap-2">
                            <Clock class="w-4 h-4" />
                            Eventos Pasados
                            <span
                                class="bg-gray-100 text-gray-600 text-xs px-2 py-0.5 rounded-full"
                            >
                                {pastEvents?.length || 0}
                            </span>
                        </span>
                    </button>
                </nav>
            </div>

            <!-- Current Events Tab -->
            <div id="tab-current" class="tab-content">
                {
                    !currentEvents || currentEvents.length === 0 ? (
                        <div class="p-8 md:p-12 text-center">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-400">
                                <Ticket size={32} />
                            </div>
                            <h3 class="text-xl font-bold mb-2">
                                No hay eventos actuales
                            </h3>
                            <p class="text-gray-500 mb-6">
                                Crea un evento para comenzar a vender entradas.
                            </p>
                            <a
                                href="/dashboard/events/create"
                                class="inline-flex bg-black text-white px-6 py-3 rounded-lg hover:bg-gray-800 transition font-medium"
                            >
                                Crear Evento
                            </a>
                        </div>
                    ) : (
                        <div class="divide-y divide-gray-100">
                            {currentEvents.map((event) => {
                                const stats = eventStats[event.id];
                                const attendees = eventAttendees[event.id];
                                const soldPercentage = stats.occupancyPct;

                                return (
                                    <div
                                        class="event-accordion"
                                        data-event-id={event.id}
                                    >
                                        {/* Event Header - Clickable */}
                                        <button
                                            type="button"
                                            class="accordion-trigger w-full p-4 md:p-6 flex items-center gap-3 md:gap-4 hover:bg-gray-50 transition text-left"
                                        >
                                            <div class="w-12 h-12 md:w-16 md:h-16 bg-gray-100 rounded-lg overflow-hidden flex-shrink-0">
                                                {event.image_url ? (
                                                    <img
                                                        src={event.image_url}
                                                        alt={event.name}
                                                        class="w-full h-full object-cover"
                                                    />
                                                ) : (
                                                    <div class="w-full h-full flex items-center justify-center text-gray-400">
                                                        <Calendar size={24} />
                                                    </div>
                                                )}
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <h3 class="font-bold text-lg truncate">
                                                        {event.title ||
                                                            event.name}
                                                    </h3>
                                                    <span
                                                        class={`shrink-0 px-2 py-0.5 text-xs font-medium rounded-full ${
                                                            event.status ===
                                                            "published"
                                                                ? "bg-green-100 text-green-700"
                                                                : "bg-yellow-100 text-yellow-700"
                                                        }`}
                                                    >
                                                        {event.status ===
                                                        "published"
                                                            ? "Publicado"
                                                            : "Borrador"}
                                                    </span>
                                                </div>
                                                <p class="text-sm text-gray-500">
                                                    {event.start_date
                                                        ? formatDate(
                                                              event.start_date,
                                                          )
                                                        : "Fecha por definir"}
                                                </p>
                                            </div>
                                            <div class="flex items-center gap-3 md:gap-6 shrink-0">
                                                <div class="text-right">
                                                    <p class="text-xl md:text-2xl font-bold">
                                                        {stats.totalSold}
                                                    </p>
                                                    <p class="text-xs text-gray-500">
                                                        vendidas
                                                    </p>
                                                    {stats.courtesy > 0 && (
                                                        <p class="text-xs text-gray-400">
                                                            + {stats.courtesy} cortesías
                                                        </p>
                                                    )}
                                                </div>
                                                <div class="w-12 sm:w-24">
                                                    <div class="flex justify-end sm:justify-between text-xs mb-1">
                                                        <span class="text-gray-500 hidden sm:inline">
                                                            Ocupación
                                                        </span>
                                                        <span class="font-medium">
                                                            {soldPercentage}%
                                                        </span>
                                                    </div>
                                                    <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                                                        <div
                                                            class="h-full bg-gradient-to-r from-purple-500 to-pink-500 rounded-full transition-all duration-500"
                                                            style={`width: ${soldPercentage}%`}
                                                        />
                                                    </div>
                                                </div>
                                                <ChevronDown class="w-5 h-5 text-gray-400 accordion-icon transition-transform duration-200" />
                                            </div>
                                        </button>

                                        {/* Accordion Content */}
                                        <div class="accordion-content hidden border-t border-gray-100 bg-gray-50/50">
                                            {/* Ticket Types Summary */}
                                            <div class="p-4 md:p-6 border-b border-gray-100">
                                                <h4 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
                                                    <Ticket class="w-4 h-4" />
                                                    Resumen por Tipo de Entrada
                                                </h4>
                                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                                    {event.event_tickets?.map(
                                                        (ticket) => {
                                                            const sold =
                                                                stats
                                                                    .byTicketType[
                                                                    ticket.id
                                                                ] || 0;
                                                            const available =
                                                                ticket.total_quantity == null
                                                                    ? "Sin límite"
                                                                    : Math.max(0, ticket.total_quantity - sold);
                                                            const ticketPercentage =
                                                                ticket.total_quantity
                                                                    ? Math.round(
                                                                          (sold /
                                                                              ticket.total_quantity) *
                                                                              100,
                                                                      )
                                                                    : 0;
                                                            const isFree =
                                                                ticket.price ===
                                                                0;

                                                            return (
                                                                <div class="bg-white rounded-lg border border-gray-200 p-4">
                                                                    <div class="flex items-start justify-between mb-3">
                                                                        <div class="flex items-center gap-2">
                                                                            {isFree ? (
                                                                                <Gift class="w-4 h-4 text-green-500" />
                                                                            ) : (
                                                                                <Ticket class="w-4 h-4 text-purple-500" />
                                                                            )}
                                                                            <span class="font-medium text-gray-900">
                                                                                {
                                                                                    ticket.ticket_name
                                                                                }
                                                                            </span>
                                                                        </div>
                                                                        <span
                                                                            class={`text-xs px-2 py-0.5 rounded-full ${
                                                                                isFree
                                                                                    ? "bg-green-100 text-green-700"
                                                                                    : "bg-purple-100 text-purple-700"
                                                                            }`}
                                                                        >
                                                                            {isFree
                                                                                ? "Gratis"
                                                                                : formatPrice(
                                                                                      ticket.price,
                                                                                  )}
                                                                        </span>
                                                                    </div>
                                                                    <div class="space-y-2">
                                                                        <div class="flex justify-between text-sm">
                                                                            <span class="text-gray-500">
                                                                                {ticket.is_gift ? "Emitidas" : "Vendidas"}
                                                                            </span>
                                                                            <span class="font-semibold text-green-600">
                                                                                {
                                                                                    sold
                                                                                }
                                                                            </span>
                                                                        </div>
                                                                        <div class="flex justify-between text-sm">
                                                                            <span class="text-gray-500">
                                                                                Disponibles
                                                                            </span>
                                                                            <span class="font-semibold text-blue-600">
                                                                                {
                                                                                    available
                                                                                }
                                                                            </span>
                                                                        </div>
                                                                        <div class="h-1.5 bg-gray-200 rounded-full overflow-hidden mt-2">
                                                                            <div
                                                                                class="h-full bg-gradient-to-r from-green-400 to-emerald-500 rounded-full"
                                                                                style={`width: ${ticketPercentage}%`}
                                                                            />
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            );
                                                        },
                                                    )}
                                                    {(!event.event_tickets ||
                                                        event.event_tickets
                                                            .length === 0) && (
                                                        <div class="col-span-full text-center py-4 text-gray-500">
                                                            No hay tipos de
                                                            entrada configurados
                                                        </div>
                                                    )}
                                                </div>
                                            </div>

                                            {/* Attendees Table */}
                                            <div class="p-4 md:p-6">
                                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                                                    <h4 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                                                        <Users class="w-4 h-4" />
                                                        Listado de Entradas (
                                                        {attendees.length})
                                                    </h4>
                                                    <div class="flex items-center gap-2 w-full sm:w-auto">
                                                    {eventFunctionList(event).length > 1 && (
                                                        <select
                                                            class="function-filter py-2 px-2 text-sm border border-gray-200 rounded-lg bg-white max-w-[12rem]"
                                                            data-event-id={event.id}
                                                            aria-label="Filtrar por función"
                                                        >
                                                            <option value="">Todas las funciones</option>
                                                            {eventFunctionList(event).map((f) => (
                                                                <option value={f.id}>{f.label}</option>
                                                            ))}
                                                        </select>
                                                    )}
                                                    <a
                                                        href={`/api/events/orders-csv?event_id=${event.id}`}
                                                        data-csv-event-id={event.id}
                                                        title="Descarga las órdenes pagadas del evento (CSV compatible con Excel)"
                                                        class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition whitespace-nowrap"
                                                    >
                                                        <Download class="w-4 h-4" /> Exportar CSV
                                                    </a>
                                                    <div class="relative flex-1 sm:flex-none min-w-0">
                                                        <input
                                                            type="text"
                                                            placeholder="Buscar..."
                                                            class="search-input w-full sm:w-auto pl-9 pr-4 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black/5 focus:border-gray-300"
                                                            data-event-id={
                                                                event.id
                                                            }
                                                        />
                                                        <Search class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" />
                                                    </div>
                                                    </div>
                                                </div>

                                                {attendees.length > 0 ? (
                                                    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                                                        <div class="overflow-x-auto">
                                                            <table class="w-full text-sm">
