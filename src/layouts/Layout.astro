---
import ToastContainer from '../components/ui/ToastContainer.vue';
import ChunkReload from '../components/ChunkReload.astro';
import { OG_HEIGHT, OG_WIDTH } from '../lib/imageOptimize';
import { DEFAULT_OG_CARD, ogCardForPath, ogCardImagePath, ogPageKey, type OgCard } from '../lib/ogPages';

interface Props {
	title?: string;
	description?: string;
	/** Ruta ("/eventos") o URL absoluta. Por defecto: la ruta actual sin query string. */
	canonical?: string;
	/**
	 * Ruta o URL absoluta de la imagen para compartir. Por defecto, la tarjeta 1200×630 de la ruta canónica
	 * (src/lib/ogPages.ts) o, si la página no tiene una, la de la portada.
	 */
	image?: string;
	/** Texto alternativo de `image`. */
	imageAlt?: string;
	/** Tarjeta de una página que no está en el registro de ogPages.ts (p. ej. una guía); también se genera en el build. */
	ogCard?: OgCard;
	noindex?: boolean;
	ogType?: string;
	/**
	 * false = no carga Google Analytics. Usar en páginas cuya URL lleva tokens de acceso o datos
	 * personales (/auth/link?t=, /organizadores/verificar?t=, /organizadores/recuperar?email=).
	 */
	analytics?: boolean;
}

const SITE_URL = (import.meta.env.SITE_URL || 'https://aitickets.cl').replace(/\/$/, '');
const DEFAULT_TITLE = 'AI Tickets – Venta de entradas para eventos en Chile';
const DEFAULT_DESCRIPTION = 'Vende entradas para tus eventos en Chile con 0% de comisión para el productor. Página del evento, pagos, QR y check-in en un solo lugar.';

const absolute = (pathOrUrl: string) =>
	/^https?:\/\//i.test(pathOrUrl) ? pathOrUrl : `${SITE_URL}${pathOrUrl.startsWith('/') ? '' : '/'}${pathOrUrl}`;

const {
	title = DEFAULT_TITLE,
	description = DEFAULT_DESCRIPTION,
	canonical,
	image,
	imageAlt,
	ogCard,
	noindex = false,
	ogType = 'website',
	analytics = true,
} = Astro.props;

const canonicalUrl = absolute(canonical ?? Astro.url.pathname);
// Imagen para compartir: la tarjeta de la página (generada en el build, 1200×630 JPEG < 300 KB) o la de la portada
const canonicalPath = new URL(canonicalUrl).pathname;
const pageCard = image ? null : ogCard ?? ogCardForPath(canonicalPath);
const shareCard = image ? null : pageCard ?? DEFAULT_OG_CARD;
const imageUrl = absolute(image ?? ogCardImagePath(pageCard ? ogPageKey(canonicalPath) : 'inicio', shareCard!));
const imageAltText = imageAlt ?? shareCard?.alt ?? title;
const hasCustomHead = Astro.slots.has('head');
---
<!doctype html>
<html lang="es-CL">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Título, descripción y Open Graph primero: los bots de vista previa (WhatsApp, Facebook) leen solo el
		     comienzo del HTML. -->
		{hasCustomHead ? (
			<slot name="head" />
		) : (
			<>
				<title>{title}</title>
				<meta name="description" content={description}>
				<link rel="canonical" href={canonicalUrl}>
				{noindex && <meta name="robots" content="noindex, nofollow">}
				<!-- Open Graph / Facebook -->
				<meta property="og:type" content={ogType}>
				<meta property="og:title" content={title}>
				<meta property="og:description" content={description}>
				<meta property="og:url" content={canonicalUrl}>
				<meta property="og:site_name" content="AI Tickets">
				<meta property="og:locale" content="es_CL">
				<meta property="og:image" content={imageUrl}>
				<meta property="og:image:secure_url" content={imageUrl}>
				{shareCard && <>
					<meta property="og:image:type" content="image/jpeg">
					<meta property="og:image:width" content={String(OG_WIDTH)}>
					<meta property="og:image:height" content={String(OG_HEIGHT)}>
				</>}
				<meta property="og:image:alt" content={imageAltText}>
				<!-- Twitter -->
				<meta name="twitter:card" content="summary_large_image">
				<meta name="twitter:title" content={title}>
				<meta name="twitter:description" content={description}>
				<meta name="twitter:url" content={canonicalUrl}>
				<meta name="twitter:site" content="@aitickets">
				<meta name="twitter:creator" content="@aitickets">
				<meta name="twitter:image" content={imageUrl}>
				<meta name="twitter:image:alt" content={imageAltText}>
			</>
		)}
		{/* Extras de una página puntual (p. ej. precargar su fuente de acento) sin reemplazar el head por defecto */}
		<slot name="head-extra" />
		<ChunkReload />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<meta name="theme-color" content="#a3e635">
		<meta name="generator" content={Astro.generator} />

		<!-- Google Analytics: stub en el hilo principal para que window.gtag / window.dataLayer
		     funcionen desde el código de la app (Partytown reenvía 'gtag' y 'dataLayer.push' al worker). -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
		</script>
		<!-- Sin analytics={false} el stub queda (las llamadas a gtag no fallan) pero no se carga GA. -->
		{analytics && (<>
		<!-- Google Analytics (optimized with Partytown) -->
		<script is:inline type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-ZKTCNLYSQT"></script>
		<script is:inline type="text/partytown">
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-ZKTCNLYSQT', {
				page_title: document.title,
				page_location: (function () {
					// Nunca enviar tokens ni correos de la URL a terceros
					try {
						var u = new URL(window.location.href);
						['t', 'token', 'email', 'code', 'access_token', 'refresh_token'].forEach(function (k) { u.searchParams.delete(k); });
						u.hash = '';
						return u.toString();
					} catch (e) {
						return window.location.origin + window.location.pathname;
					}
				})()
			});
		</script>
		</>)}

	</head>
	<body>
		<slot />
		<!-- Toast Container para notificaciones -->
		<ToastContainer client:only="vue" />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		/* clip (no hidden): con hidden en html y body, body pasa a ser el contenedor de scroll y window.scrollY queda en 0 */
		overflow-x: clip;
	}
</style>
