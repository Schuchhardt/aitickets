---
import DashboardSidebar from "../components/dashboard/DashboardSidebar.vue";
import DashboardSkeletons from "../components/dashboard/DashboardSkeletons.astro";
import ChunkReload from "../components/ChunkReload.astro";
import logoLight from "../images/logo.png";
import "../styles/global.css";
import { getSessionContext, type SessionContext } from "../lib/supabaseServer";
import SetPasswordModal from "../components/auth/SetPasswordModal.vue";
import { PW_RESET_COOKIE, verifyPwResetCookie } from "../lib/magic-link";
import { getSupabaseAdmin } from "../lib/auth-helpers";
import { needsIdentityNotice } from "../lib/producerIdentity";
import { recordDashboardPageView } from "../lib/producerActivity";

const { title = "Dashboard" } = Astro.props;

// La página ya validó la sesión con requireDashboardSession (queda en Astro.locals);
// si no, se consulta aquí.
const session: SessionContext | null =
  (Astro.locals as any).sessionContext || (await getSessionContext(Astro));

const userData = session
  ? {
      email: session.authUser.email,
      user_metadata: session.authUser.user_metadata,
      id: session.authUser.id,
      dbName: session.dbUser.name || null, // Nombre desde public.users
      role: session.dbUser.role || null,
    }
  : null;

// Después de un enlace de acceso (recuperar / cambiar contraseña): modal para crear la contraseña nueva
const showSetPassword = !!session && Astro.url.searchParams.get("set_password") === "1";
const canSetPassword =
  showSetPassword && verifyPwResetCookie(Astro.cookies.get(PW_RESET_COOKIE)?.value, session!.authUser.id);

// Recién verificó su correo (verificar.astro redirige con ?bienvenida=1 ya con sesión iniciada)
const showWelcome = !!session && Astro.url.searchParams.get("bienvenida") === "1";

// Las dos consultas del layout van en paralelo (cada cambio de sección pasa por aquí).
const [showIdentityNotice, activityPage] = await Promise.all([
  // Productores con eventos pagados ya publicados y sin identidad verificada: sus eventos siguen a la venta,
  // pero se les pide verificar (Términos para productores §2 bis) porque sin eso no pueden retirar.
  !!session && !Astro.url.pathname.startsWith("/dashboard/settings")
    ? needsIdentityNotice(getSupabaseAdmin(), Number(session.dbUser.organization_id)).catch(() => false)
    : false,
  // Bitácora de uso del panel (MCP de admin: get_producer_activity): registra esta página y le pasa su id al
  // rastreador del navegador (src/lib/producerActivityClient.js). Sin sesión o con la bitácora apagada no hay id.
  recordDashboardPageView(Astro, session).catch(() => null),
]);

// Sidebar renderizado en el servidor (antes client:only: aparecía tarde en cada página). El estado contraído
// vive en una cookie para que el primer render ya sea el definitivo (DashboardSidebar.vue).
const sidebarCollapsed = Astro.cookies.get("dashboard_sidebar_collapsed")?.value === "1";
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <ChunkReload />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Producer Dashboard</title>
    <!-- Las fuentes (Unbounded y Prompt) vienen de @fontsource en global.css: sin hoja externa que bloquee el render -->
    <style is:global>
      /* Cambio de sección sin parpadeo (Chrome, Edge, Safari 18.2+): el menú lateral y la barra superior quedan
         fijos y solo el contenido hace un fundido corto. */
      @view-transition {
        navigation: auto;
      }
      #dashboard-sidebar {
        view-transition-name: dashboard-sidebar;
      }
      #dashboard-topbar {
        view-transition-name: dashboard-topbar;
      }
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 120ms;
      }
      @media (prefers-reduced-motion: reduce) {
        @view-transition {
          navigation: none;
        }
      }

      /* Navegación en curso (src/lib/dashboardNav.js): el skeleton reemplaza al contenido */
      #dashboard-nav-skeleton,
      .ait-nav-progress {
        display: none;
      }
      .ait-navigating #dashboard-content {
        display: none;
      }
      .ait-navigating #dashboard-nav-skeleton {
        display: block;
      }
      /* Arriba del contenido (main es relative y vuelve al inicio al navegar) */
      .ait-navigating .ait-nav-progress {
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        overflow: hidden;
        z-index: 30;
      }
      .ait-nav-progress::after {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 40%;
        background: #84cc16;
        animation: ait-progress 1s ease-in-out infinite;
      }
      @keyframes ait-progress {
        from { transform: translateX(-100%); }
        to { transform: translateX(250%); }
      }
      @media (prefers-reduced-motion: reduce) {
        .ait-nav-progress::after {
          animation: none;
        }
      }
    </style>
  </head>
  <body
    class="bg-gray-50 min-h-screen font-[Prompt]"
    data-ait-pv={activityPage?.id}
    data-ait-route={activityPage?.route}
    data-ait-pv-deferred={activityPage?.deferred ? "1" : undefined}
  >
    <script>
      import { startProducerActivity } from "../lib/producerActivityClient.js";
      import { startDashboardNav } from "../lib/dashboardNav.js";
      startDashboardNav();
      startProducerActivity();
    </script>
    <div class="flex flex-col md:flex-row h-dvh overflow-hidden">
      <!-- Barra superior (mobile): abre el menú lateral como cajón -->
      <header id="dashboard-topbar" class="md:hidden flex items-center gap-3 h-14 px-3 bg-white border-b border-gray-200 shrink-0 pt-[env(safe-area-inset-top)] box-content">
        <button
          type="button"
          data-sidebar-open
          aria-label="Abrir menú"
          aria-controls="dashboard-sidebar"
          class="flex items-center justify-center w-10 h-10 rounded-lg text-gray-700 hover:bg-gray-100"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
        </button>
        <a href="/dashboard" class="flex items-center">
          <img src={logoLight.src} alt="AI Tickets" class="h-7" />
        </a>
      </header>

      <!-- Sidebar -->
      <DashboardSidebar
        client:load
        userJson={JSON.stringify(userData)}
        currentPath={Astro.url.pathname}
        initialCollapsed={sidebarCollapsed}
      />

      <!-- Main Content -->
      <main id="dashboard-main" class="flex-1 min-w-0 overflow-y-auto overflow-x-hidden p-4 md:p-8 relative">
        <!-- Al hacer clic en un enlace del panel: barra de progreso + skeleton de la sección de destino (src/lib/dashboardNav.js) -->
        <div class="ait-nav-progress" aria-hidden="true"></div>
        <div id="dashboard-nav-skeleton" class="max-w-7xl mx-auto" role="status" aria-live="polite" aria-label="Cargando"></div>
        <div id="dashboard-content" class="max-w-7xl mx-auto">
          {
            showWelcome && (
              <div
                id="welcome-banner"
                role="status"
                class="mb-6 flex items-start gap-3 rounded-xl border border-lime-300 bg-lime-50 px-4 py-3 text-sm text-gray-900"
              >
                <div class="flex-1">
                  <p class="font-semibold">¡Correo confirmado! Bienvenido/a a AI Tickets.</p>
                  <p class="text-gray-700">Ya iniciaste sesión. Crea tu primer evento cuando quieras.</p>
                </div>
                <button
                  type="button"
                  aria-label="Cerrar"
                  class="text-gray-500 hover:text-gray-900"
                  onclick="document.getElementById('welcome-banner')?.remove()"
                >
                  ✕
                </button>
              </div>
            )
          }
          {
            showIdentityNotice && (
              <div id="identity-banner" role="status" class="mb-6 flex flex-col sm:flex-row sm:items-center gap-3 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 pr-10 text-sm text-gray-900 relative">
                <button
                  type="button"
                  id="identity-banner-close"
                  aria-label="Cerrar"
                  class="absolute top-2 right-2 p-1 text-gray-500 hover:text-gray-900"
                >
                  ✕
                </button>
                <div class="flex-1">
                  <p class="font-semibold">Verifica tu identidad para poder retirar lo recaudado</p>
                  <p class="text-gray-700">Tus eventos siguen a la venta. Toma un par de minutos.</p>
                </div>
                <a href="/dashboard/settings#identidad" class="shrink-0 rounded-lg bg-gray-900 px-4 py-2 text-center font-semibold text-white hover:bg-gray-700">
                  Verificar identidad
                </a>
              </div>
            )
          }
          {
            showIdentityNotice && (
              // Cerrado, no vuelve en 7 días (en este navegador). Inline y justo después del aviso para que no parpadee.
              <script is:inline>
                (function () {
                  var KEY = "aitickets:identity-banner-closed";
                  var WEEK = 7 * 24 * 3600 * 1000;
                  var banner = document.getElementById("identity-banner");
                  try {
                    if (Date.now() - Number(localStorage.getItem(KEY) || 0) < WEEK) banner && banner.remove();
                  } catch (e) {}
                  var close = document.getElementById("identity-banner-close");
                  close && close.addEventListener("click", function () {
                    try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
                    banner && banner.remove();
                  });
                })();
              </script>
            )
          }
          <slot />
        </div>
      </main>
    </div>
    {showSetPassword && <SetPasswordModal client:only="vue" canSet={canSetPassword} />}
    <DashboardSkeletons />
  </body>
</html>
