---
// Skeletons de navegación del panel: src/lib/dashboardNav.js clona el que corresponde a la sección de destino
// (data-skeleton) dentro de #dashboard-nav-skeleton al hacer clic en un enlace, mientras llega la página.
// Imitan el encabezado y la estructura de cada tipo de página para que el cambio no salte.
const bar = "ait-skeleton rounded-md";
const card = "bg-white rounded-xl shadow-sm border border-gray-100";
---

<template data-skeleton="overview">
  <div aria-hidden="true">
    <div class="mb-6 md:mb-8">
      <div class:list={[bar, "h-8 md:h-9 w-2/3 max-w-sm mb-3"]}></div>
      <div class:list={[bar, "h-4 w-1/2 max-w-xs"]}></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6 mb-8 md:mb-10">
      {[0, 1, 2].map(() => (
        <div class:list={[card, "p-4 md:p-6"]}>
          <div class:list={[bar, "h-3 w-24 mb-3"]}></div>
          <div class:list={[bar, "h-8 w-32"]}></div>
        </div>
      ))}
    </div>
    <div class:list={[bar, "h-6 w-48 mb-4 md:mb-6"]}></div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
      {[0, 1, 2].map(() => (
        <div class:list={[card, "overflow-hidden"]}>
          <div class="ait-skeleton h-40"></div>
          <div class="p-4 space-y-2">
            <div class:list={[bar, "h-5 w-3/4"]}></div>
            <div class:list={[bar, "h-3 w-1/2"]}></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</template>

<template data-skeleton="cards">
  <div aria-hidden="true">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <div class:list={[bar, "h-8 md:h-9 w-56 mb-3"]}></div>
        <div class:list={[bar, "h-4 w-72 max-w-full"]}></div>
      </div>
      <div class:list={[bar, "h-11 w-40 rounded-lg"]}></div>
    </div>
    <div class="flex gap-2 mb-6">
      {[0, 1, 2, 3].map(() => <div class:list={[bar, "h-9 w-24 rounded-full"]}></div>)}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {[0, 1, 2, 3, 4, 5].map(() => (
        <div class:list={[card, "overflow-hidden"]}>
          <div class="ait-skeleton h-44"></div>
          <div class="p-4 space-y-2">
            <div class:list={[bar, "h-5 w-3/4"]}></div>
            <div class:list={[bar, "h-3 w-1/2"]}></div>
            <div class:list={[bar, "h-3 w-1/3"]}></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</template>

<template data-skeleton="table">
  <div aria-hidden="true">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <div class:list={[bar, "h-8 md:h-9 w-48 mb-3"]}></div>
        <div class:list={[bar, "h-4 w-80 max-w-full"]}></div>
      </div>
      <div class:list={[bar, "h-11 w-36 rounded-lg"]}></div>
    </div>
    <div class:list={[card, "overflow-hidden"]}>
      <div class="flex gap-4 p-4 border-b border-gray-100">
        <div class:list={[bar, "h-10 flex-1 rounded-lg"]}></div>
        <div class:list={[bar, "h-10 w-32 rounded-lg"]}></div>
      </div>
      {[0, 1, 2, 3, 4, 5, 6].map(() => (
        <div class="flex items-center gap-4 px-4 py-4 border-b border-gray-50 last:border-0">
          <div class="ait-skeleton h-9 w-9 rounded-full shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class:list={[bar, "h-4 w-1/3"]}></div>
            <div class:list={[bar, "h-3 w-1/4"]}></div>
          </div>
          <div class:list={[bar, "h-4 w-20 hidden sm:block"]}></div>
          <div class:list={[bar, "h-8 w-24 rounded-lg"]}></div>
        </div>
      ))}
    </div>
  </div>
</template>

<template data-skeleton="detail">
  <div aria-hidden="true">
    <div class:list={[bar, "h-4 w-32 mb-6"]}></div>
    <div class="flex flex-col md:flex-row gap-6 mb-8">
      <div class="ait-skeleton h-40 md:w-64 rounded-xl shrink-0"></div>
      <div class="flex-1">
        <div class:list={[bar, "h-6 w-24 rounded-full mb-3"]}></div>
        <div class:list={[bar, "h-8 md:h-9 w-3/4 mb-3"]}></div>
        <div class:list={[bar, "h-4 w-1/2 mb-2"]}></div>
        <div class:list={[bar, "h-4 w-1/3 mb-5"]}></div>
        <div class="flex flex-wrap gap-2">
          {[0, 1, 2].map(() => <div class:list={[bar, "h-10 w-32 rounded-lg"]}></div>)}
        </div>
      </div>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 mb-8">
      {[0, 1, 2, 3].map(() => (
        <div class:list={[card, "p-4 md:p-6"]}>
          <div class:list={[bar, "h-3 w-20 mb-3"]}></div>
          <div class:list={[bar, "h-7 w-24"]}></div>
        </div>
      ))}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
      {[0, 1, 2, 3].map(() => (
        <div class:list={[card, "p-5 space-y-3"]}>
          <div class:list={[bar, "h-5 w-40"]}></div>
          <div class:list={[bar, "h-3 w-full"]}></div>
          <div class:list={[bar, "h-3 w-2/3"]}></div>
        </div>
      ))}
    </div>
  </div>
</template>

<template data-skeleton="form">
  <div aria-hidden="true">
    <div class="mb-6 md:mb-8">
      <div class:list={[bar, "h-8 md:h-9 w-56 mb-3"]}></div>
      <div class:list={[bar, "h-4 w-80 max-w-full"]}></div>
    </div>
    <div class="space-y-6">
      {[0, 1].map(() => (
        <div class:list={[card, "p-4 md:p-6"]}>
          <div class:list={[bar, "h-6 w-48 mb-6"]}></div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            {[0, 1, 2, 3].map(() => (
              <div>
                <div class:list={[bar, "h-3 w-24 mb-2"]}></div>
                <div class:list={[bar, "h-11 w-full rounded-lg"]}></div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</template>
