---
/**
 * Meta tags + JSON-LD (schema.org/Event, src/lib/eventJsonLd.ts) de la página pública de un evento.
 * Recibe el evento ya preparado por src/pages/eventos/[slug].astro
 * (dates con start_iso/end_iso y venue, tickets a la venta, organization).
 * No debe recibir ni mostrar secret_location.
 */
interface Props {
  event: any;
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
}

import { LEGAL } from "../lib/legal";
import { eventOgImagePath } from "../lib/ogImage";
import { defaultOgImagePath, DEFAULT_OG_CARD } from "../lib/ogPages";
import { OG_HEIGHT, OG_WIDTH } from "../lib/imageOptimize";
import { cdnImage, cdnSrcset, EVENT_COVER_SIZES } from "../lib/imageCdn.js";
import { buildEventJsonLd, serializeJsonLd } from "../lib/eventJsonLd";

const { event, title, description, canonicalPath, noindex = false } = Astro.props;
const siteUrl = (import.meta.env.SITE_URL || "https://aitickets.cl").replace(/\/$/, "");
// Sin portada: la tarjeta genérica de AI Tickets (1200×630 JPEG, src/lib/ogPages.ts)
const fallbackImagePath = defaultOgImagePath();

const buildAbsoluteUrl = (path?: string | null) => {
  if (!path) return `${siteUrl}${fallbackImagePath}`;
  if (/^https?:\/\//i.test(path)) return path;
  return `${siteUrl}${path.startsWith("/") ? "" : "/"}${path}`;
};

const canonicalUrl = `${siteUrl}${canonicalPath}`;
// Portada original (JSON-LD: Google prefiere la imagen en alta) y la versión para compartir: 1200×630,
// JPEG < 300 KB (WhatsApp no muestra la vista previa con imágenes pesadas). Ver src/pages/og/eventos/[id].jpg.ts.
const imageUrl = buildAbsoluteUrl(event?.image_url);
const ogPath = event?.id ? eventOgImagePath(event.id, event.image_url) : null;
const shareImageUrl = ogPath ? `${siteUrl}${ogPath}` : `${siteUrl}${fallbackImagePath}`;
const shareImageType = "image/jpeg";
const shareImageAlt = ogPath && event?.name ? `Portada de ${event.name}` : DEFAULT_OG_CARD.alt;

// JSON-LD schema.org/Event: src/lib/eventJsonLd.ts (offers con validFrom, organizer con url, performer)
const eventJsonLd = serializeJsonLd(
  buildEventJsonLd(event, {
    siteUrl,
    canonicalUrl,
    images: ogPath ? [imageUrl, shareImageUrl] : [imageUrl],
    fallbackDescription: description,
    brand: LEGAL.brand,
    supportEmail: LEGAL.supportEmail,
  })
);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph (WhatsApp, Facebook, LinkedIn, Telegram, iMessage) -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="AI Tickets" />
<meta property="og:locale" content="es_CL" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={event?.name || title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={shareImageUrl} />
<meta property="og:image:secure_url" content={shareImageUrl} />
<meta property="og:image:type" content={shareImageType} />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:alt" content={shareImageAlt} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@aitickets" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={event?.name || title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={shareImageUrl} />
<meta name="twitter:image:alt" content={shareImageAlt} />

<!-- Precarga de la imagen principal (LCP). Con video de portada (AutoplayVideo.vue) la imagen no se ve arriba:
     se precarga el póster del video, que se pinta mientras el video carga -->
{event?.cover_video
  ? event.cover_video.poster_url && <link rel="preload" as="image" href={event.cover_video.poster_url} fetchpriority="high" />
  : event?.image_url && <link rel="preload" as="image" href={cdnImage(event.image_url, 1080)} imagesrcset={cdnSrcset(event.image_url)} imagesizes={cdnSrcset(event.image_url) ? EVENT_COVER_SIZES : undefined} fetchpriority="high" />}

<!-- JSON-LD Structured Data -->
{eventJsonLd && !noindex && (
  <script is:inline type="application/ld+json" set:html={eventJsonLd}></script>
)}
