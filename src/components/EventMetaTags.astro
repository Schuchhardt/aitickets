---
/**
 * Meta tags + JSON-LD (schema.org/Event) de la página pública de un evento.
 * Recibe el evento ya preparado por src/pages/eventos/[slug].astro
 * (dates con start_iso/end_iso y venue, tickets a la venta, organization).
 * No debe recibir ni mostrar secret_location.
 */
interface Props {
  event: any;
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
}

const { event, title, description, canonicalPath, noindex = false } = Astro.props;
const siteUrl = (import.meta.env.SITE_URL || "https://aitickets.cl").replace(/\/$/, "");
const fallbackImagePath = "/aitickets_preview.png";

const buildAbsoluteUrl = (path?: string | null) => {
  if (!path) return `${siteUrl}${fallbackImagePath}`;
  if (/^https?:\/\//i.test(path)) return path;
  return `${siteUrl}${path.startsWith("/") ? "" : "/"}${path}`;
};

const stripHtml = (html?: string | null) =>
  (html || "")
    .replace(/<br\s*\/?>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/\s+/g, " ")
    .trim();

const canonicalUrl = `${siteUrl}${canonicalPath}`;
const imageUrl = buildAbsoluteUrl(event?.image_url);

const buildPlace = (venue: any) => {
  if (!venue) {
    return {
      "@type": "Place",
      name: event.location || "Por confirmar",
      address: {
        "@type": "PostalAddress",
        streetAddress: event.location || undefined,
        addressCountry: "CL",
      },
    };
  }
  const place: any = {
    "@type": "Place",
    name: venue.name || event.location,
    address: {
      "@type": "PostalAddress",
      streetAddress: venue.address || undefined,
      addressLocality: venue.city || undefined,
      addressRegion: venue.region || undefined,
      postalCode: venue.postal_code || undefined,
      addressCountry: venue.country || "CL",
    },
  };
  if (Number.isFinite(venue.latitude) && Number.isFinite(venue.longitude)) {
    place.geo = { "@type": "GeoCoordinates", latitude: venue.latitude, longitude: venue.longitude };
  }
  return place;
};

const buildOffers = () => {
  // Solo publicar offers si hay entradas a la venta o agotadas (nunca inventar un precio)
  const tickets = Array.isArray(event.tickets) ? event.tickets : [];
  if (tickets.length > 0) {
    return tickets.map((t: any) => ({
      "@type": "Offer",
      name: t.ticket_name || "Entrada general",
      price: Number(t.price) || 0,
      priceCurrency: "CLP",
      availability: t.remaining === 0 ? "https://schema.org/SoldOut" : "https://schema.org/InStock",
      url: canonicalUrl,
      ...(t.init_date ? { validFrom: new Date(t.init_date).toISOString() } : {}),
    }));
  }
  if (event.sale_state === "sold_out") {
    return [{ "@type": "Offer", url: canonicalUrl, priceCurrency: "CLP", availability: "https://schema.org/SoldOut" }];
  }
  return null;
};

const generateEventJsonLd = () => {
  if (!event) return null;
  const organizer = event.organization?.name
    ? {
        "@type": "Organization",
        name: event.organization.name,
        ...(event.organization.website ? { url: event.organization.website } : {}),
      }
    : { "@type": "Organization", name: "AI Tickets", url: siteUrl };
  const offers = buildOffers();
  const baseDescription = stripHtml(event.description) || description;

  const functions = (Array.isArray(event.dates) ? event.dates : []).filter((d: any) => d.start_iso);
  const entries = (functions.length ? functions : [{ start_iso: null, end_iso: null, venue: event.venue }]).map(
    (fn: any) => {
      const item: any = {
        "@context": "https://schema.org",
        "@type": "Event",
        name: event.name,
        description: baseDescription.slice(0, 5000),
        url: canonicalUrl,
        image: [imageUrl],
        eventStatus: "https://schema.org/EventScheduled",
        eventAttendanceMode: fn.venue?.is_virtual
          ? "https://schema.org/OnlineEventAttendanceMode"
          : "https://schema.org/OfflineEventAttendanceMode",
        location: buildPlace(fn.venue || event.venue),
        organizer,
      };
      if (fn.start_iso) item.startDate = fn.start_iso;
      else if (event.start_date) item.startDate = event.start_date;
      if (fn.end_iso) item.endDate = fn.end_iso;
      else if (event.end_date) item.endDate = event.end_date;
      if (offers) item.offers = offers;
      return item;
    }
  );
  return JSON.stringify(entries.length === 1 ? entries[0] : entries).replace(/</g, "\\u003c");
};

const eventJsonLd = generateEventJsonLd();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="AI Tickets" />
<meta property="og:locale" content="es_CL" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={event?.name || title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@aitickets" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={event?.name || title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Precarga de la imagen principal (LCP) -->
{event?.image_url && <link rel="preload" as="image" href={event.image_url} fetchpriority="high" />}

<!-- JSON-LD Structured Data -->
{eventJsonLd && !noindex && (
  <script is:inline type="application/ld+json" set:html={eventJsonLd}></script>
)}
