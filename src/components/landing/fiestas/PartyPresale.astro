---
// 3 · La escalera (SPEC_landing_fiestas §4.3, cobalto, pulsera PREVENTA): la firma de la página. El H2, la bajada, la
// isla PresaleStairs (simulación de la preventa por etapas) y la lista bajo la escalera. Verificado en el código: cada
// etapa es un tipo de entrada con ventana de venta (isTicketOnSale en netlify/lib/tickets.mjs) que hoy se programa desde
// el asistente de IA (tools/tickets.ts: sales_start/sales_end), dicho como ABSORB_FEE_ACTIVATION; la cuenta regresiva y
// "Avisarme cuando abra" son de la card del evento (EventActionCard.vue) solo antes de la primera etapa (Preguntas
// abiertas 2); a quienes dejan el correo se les avisa solo cuando abre (netlify/lib/waitlist.mjs). Máximo
// por compra: DEFAULT_MAX_PER_PURCHASE (Reservation/pricing.js). Duplicar copia los tipos de entrada (eventDuplicate.ts).
import PresaleStairs from "./PresaleStairs.vue";
import StickerHeading from "./StickerHeading.astro";
import Wristband from "./Wristband.astro";
import { PARTY_START, openingLabel } from "./fiestasLanding.js";
import { DEFAULT_MAX_PER_PURCHASE } from "../../Reservation/pricing.js";

interface Props {
  schedule: { date: string; short: string; openings: string[] };
  soldOut: { big: string; message: string };
}
const { schedule, soldOut } = Astro.props;
const openingLabels = schedule.openings.map((_, i) => openingLabel(schedule, i));
const items = [
  { color: "amarillo", title: "Cada etapa con su fecha y hora", text: "La programas una vez. Hoy se programa desde tu asistente de IA conectado o escribiéndonos por WhatsApp." },
  { color: "naranja", title: "Antes de abrir, cuenta regresiva", text: "Las últimas 24 horas antes de la primera etapa, tu página muestra la cuenta regresiva y un botón para dejar el correo. Cuando abre, les avisamos solos." },
  { color: "crema", title: `Hasta ${DEFAULT_MAX_PER_PURCHASE} por compra`, text: "Si no lo cambias, para que la preventa alcance para más gente." },
  { color: "tinta", title: "Las etapas se copian", text: "Duplicas la fiesta y vuelves a tener tus etapas, solo cambias las fechas." },
];
---

<section
  id="preventa"
  class="fi-section fi-bg-cobalto fi-on-dark fp"
  aria-labelledby="fi-presale-title"
  data-fi-section="presale"
  data-fi-band-color="amarillo"
  data-fi-band-label="Preventa"
>
  <Wristband color="amarillo" label="Preventa" serial={2} divider />
  <div class="fi-wrap" data-lp-reveal>
    <div class="fp-head">
      <StickerHeading id="fi-presale-title" text="Sube el precio" sticker="por etapas." />
      <p class="fi-lead fp-lead" data-lp-step>
        Cada etapa es un tipo de entrada con su precio, su cupo y la fecha y hora en que abre. Tu público ve la que está a
        la venta, la agotada como agotada y las que vienen con su fecha. Arma la tuya y juega la preventa.
      </p>
    </div>

    <div class="fp-stairs" data-lp-step>
      <PresaleStairs
        client:visible
        openings={schedule.openings}
        openingLabels={openingLabels}
        dateLabel={`${schedule.short} · ${PARTY_START}`}
        soldOutBig={soldOut.big}
        soldOutMessage={soldOut.message}
      />
    </div>

    <ul class="fp-list">
      {
        items.map((item) => (
          <li class="fp-item" data-lp-step>
            <span class={`fi-band fi-band-mini fi-band--${item.color} fp-mini`} style="--tilt: -4deg" aria-hidden="true">
              <span class="fi-band-strip">
                <span class="fi-band-half fi-band-a" />
                <span class="fi-band-half fi-band-b" />
              </span>
            </span>
            <div>
              <p class="fp-item-title">{item.title}</p>
              <p class="fp-item-text">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="fi-links" data-lp-step>
      <a href="/guias/como-hacer-una-preventa" class="fi-link">Guía: cómo hacer una preventa <span class="fi-arrow" aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .fp :global(.fi-h2) {
    color: var(--fi-crema);
  }
  .fp-lead {
    max-width: 640px;
    margin-top: 18px;
  }
  .fp-stairs {
    margin-top: 44px;
  }
  .fp-list {
    display: grid;
    gap: 22px;
    margin-top: 44px;
  }
  .fp-item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .fp :global(.fp-mini) {
    --band-h: 8px;
    width: 36px;
    margin-top: 9px;
  }
  .fp-item-title {
    font-weight: 700;
    font-size: 17px;
    line-height: 24px;
  }
  .fp-item-text {
    margin-top: 4px;
    font-size: 15px;
    line-height: 23px;
    color: var(--text-2);
  }
  @media (min-width: 768px) {
    .fp-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 40px;
    }
  }
  @media (min-width: 1024px) {
    .fp-head {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 48px;
      align-items: end;
    }
    .fp-lead {
      margin-top: 0;
    }
    .fp-stairs {
      margin-top: 64px;
    }
  }
</style>
