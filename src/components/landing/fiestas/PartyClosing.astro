---
// 12 · Cierre (SPEC_landing_fiestas §4.12, naranja + confeti): sin foto; confeti estático que flota lento (F16), el H2
// "¿Cuándo abre tu preventa?" con sticker, la pulsera con el nombre de tu fiesta (isla BandNamer: decorativa, no se envía
// ni se guarda) y los CTAs con los mismos destinos que stand-up y clubs (registro, WhatsApp y demo de 15 min).
// data-final-cta: la barra flotante de mobile se esconde aquí. F18: el CTA principal da un único "golpe" de sombra.
import BandNamer from "./BandNamer.vue";
import Confetti from "./Confetti.astro";
import StickerHeading from "./StickerHeading.astro";
import { DEMO_CALL_URL, publishUrl, whatsappUrl } from "../links.js";

interface Props {
  ctaLabel: string;
}
const { ctaLabel } = Astro.props;
---

<section class="fi-section fi-bg-naranja fcl" aria-labelledby="fi-closing-title" data-final-cta data-fi-section="closing" data-fi-band-color="amarillo" data-fi-play>
  <Confetti set="closing" float />
  <div class="fi-wrap fcl-inner" data-lp-reveal>
    <StickerHeading id="fi-closing-title" text="¿Cuándo abre" sticker="tu preventa?" class="fcl-title" />
    <div class="fcl-band" data-lp-step>
      <BandNamer client:visible />
    </div>
    <p class="fi-lead fcl-lead" data-lp-step>Publícala hoy. Crear tu cuenta es gratis y no hay costos fijos. Si quieres, la armamos contigo.</p>
    <div class="fcl-ctas" data-lp-step>
      <a href={publishUrl("fiestas_closing")} class="fi-btn fi-btn-crema" data-cta="publish" data-section="closing" data-fi-thump>
        {ctaLabel} <span class="fi-arrow" aria-hidden="true">→</span>
      </a>
      <a
        href={whatsappUrl("Hola, quiero vender entradas para mi fiesta con AI Tickets")}
        class="fi-btn fi-btn-line"
        target="_blank"
        rel="noopener noreferrer"
        data-cta="whatsapp"
        data-section="closing"
      >
        Hablar por WhatsApp
      </a>
    </div>
    <p class="fcl-help" data-lp-step>
      <a href={DEMO_CALL_URL} class="fi-link" target="_blank" rel="noopener noreferrer" data-cta="demo_call" data-section="closing">Agenda una demo de 15 min</a>
      ·
      <a href="/organizadores" class="fi-link" data-cta="organizadores" data-section="closing">Todo lo que hace AI Tickets</a>
    </p>
    <p class="fcl-help" data-lp-step>
      También para <a href="/ticketera-discotecas" class="fi-link">clubs y discotecas</a>,
      <a href="/ticketera-musica-en-vivo" class="fi-link">música en vivo</a> y tu <a href="/web-gratis" class="fi-link">web gratis</a>. ¿Comparando? <a href="/ticketeras-en-chile" class="fi-link">Ticketeras en Chile</a>.
    </p>
  </div>
</section>

<style>
  .fcl {
    isolation: isolate;
  }
  .fcl :global(.fi-confetti) {
    z-index: -1;
  }
  .fcl-inner {
    text-align: left;
  }
  .fcl :global(.fcl-title) {
    font-size: 44px;
    line-height: 46px;
  }
  .fcl-band {
    margin-top: 36px;
  }
  .fcl-lead {
    max-width: 560px;
    margin-top: 32px;
  }
  .fcl-ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 24px;
  }
  .fcl-help {
    margin-top: 18px;
    font-size: 15px;
    line-height: 24px;
  }
  @media (min-width: 640px) {
    .fcl-ctas {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
  @media (min-width: 1024px) {
    .fcl :global(.fcl-title) {
      font-size: 96px;
      line-height: 0.95;
    }
    .fcl-band {
      margin-top: 48px;
    }
  }
</style>
