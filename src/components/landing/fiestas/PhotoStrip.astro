---
// Tira de photobooth (SPEC_landing_fiestas §1, se usa una vez en §4.2): tres cuadros verticales de una misma foto con
// encuadres distintos (cara, grupo, luces del fondo), marco blanco y al pie "FIESTA DISQUETE · EJEMPLO". Un solo archivo.
import { PARTY_NAME } from "./fiestasLanding.js";

interface Photo {
  src: string;
  width: number;
  height: number;
  sources: { type: string; srcset: string }[];
}
interface Props {
  photo: Photo;
  alt: string;
}
const { photo, alt } = Astro.props;
const frames = ["50% 32%", "50% 62%", "80% 8%"];
---

<figure class="fps">
  {
    frames.map((position, i) => (
      <span class="fps-frame">
        <picture>
          {photo.sources.map((source) => <source type={source.type} srcset={source.srcset} sizes="220px" />)}
          <img
            class="fi-photo-img"
            src={photo.src}
            alt={i === 0 ? alt : ""}
            width={photo.width}
            height={photo.height}
            style={`object-position: ${position}`}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </span>
    ))
  }
  <figcaption class="fps-caption" aria-hidden="true">{PARTY_NAME} · ejemplo</figcaption>
</figure>

<style>
  .fps {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 6px 6px 8px;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 14px 30px rgba(22, 17, 13, 0.2);
  }
  .fps-frame {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--fi-crema-2);
  }
  .fps-frame picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .fps-caption {
    font-size: 8px;
    line-height: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: var(--fi-text-3);
  }
  @media (min-width: 768px) {
    .fps {
      gap: 10px;
      padding: 10px 10px 12px;
    }
    .fps-caption {
      font-size: 10px;
    }
  }
</style>
