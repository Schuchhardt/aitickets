---
// 2 · Hecho para (SPEC_landing_fiestas §4.2, crema, pulsera LA IDEA): seis stickers con forma y giro distintos (tipos
// de fiesta), la tira de photobooth de la fiesta universitaria, la banda para centros de estudiantes y los enlaces a las
// landings vecinas (clubs y música en vivo). La gira usa MAX_EVENT_FUNCTIONS (producerFaq.ts).
// La banda de centros de estudiantes queda en la versión corta (sin el detalle de a nombre de quién se cobra) hasta
// confirmar con los términos de productores si una persona puede cobrar la fiesta de un centro de estudiantes
// (Preguntas abiertas 13); el rol Finanzas existe (permissions.ts).
import { GraduationCap, MapPin, PartyPopper, QrCode, Sparkles, Heart } from "lucide-vue-next";
import PhotoStrip from "./PhotoStrip.astro";
import Sticker from "./Sticker.astro";
import StickerHeading from "./StickerHeading.astro";
import Wristband from "./Wristband.astro";
import { PARTY_PHOTOS, PHOTO_ALT } from "./fiestasLanding.js";
import { MAX_EVENT_FUNCTIONS } from "../../../data/producerFaq";

const kinds = [
  { shape: "burst", tone: "amarillo", tilt: -4, icon: GraduationCap, title: "Fiestas universitarias", text: "Mechonas, aniversarios y fiestas de carrera, con entrada alumno y general." },
  { shape: "pill", tone: "naranja", tilt: 2, icon: PartyPopper, title: "Fiestas temáticas", text: "Los 2000, reggaetón antiguo, Halloween, disfraces. El flyer manda." },
  { shape: "ticket", tone: "crema", tilt: -1.5, icon: QrCode, title: "En galpón o casona", text: "Un lugar distinto cada vez y la puerta sin señal. Igual se escanea." },
  { shape: "circle", tone: "cobalto", tilt: 3, icon: Sparkles, title: "Año Nuevo y fechas grandes", text: "Preventas largas, con etapas que abren semanas antes." },
  { shape: "heart", tone: "naranja", tilt: -3, icon: Heart, title: "Aniversarios y fiestas de marca", text: "Invitados con cortesía y venta en el mismo evento." },
  {
    shape: "pill",
    tone: "crema",
    tilt: 1.5,
    icon: MapPin,
    title: "La fiesta que sale de gira",
    text: `Santiago, Viña y Concepción en un solo evento, una fecha por ciudad (hasta ${MAX_EVENT_FUNCTIONS}).`,
  },
] as const;
---

<section id="para-quien" class="fi-section fi-bg-crema fw" aria-labelledby="fi-forwho-title" data-fi-section="for_who" data-fi-band-color="cobalto" data-fi-band-label="La idea">
  <Wristband color="cobalto" label="La idea" serial={1} divider />
  <div class="fi-wrap" data-lp-reveal>
    <div class="fw-head">
      <div>
        <StickerHeading id="fi-forwho-title" text="Si la armas tú," sticker="se vende aquí." />
        <p class="fi-lead fw-lead" data-lp-step>Una fiesta que se arma, se difunde y pasa una vez. O que sale de gira.</p>
      </div>
      <div class="fw-strip" data-lp-step>
        <PhotoStrip photo={PARTY_PHOTOS.universitaria} alt={PHOTO_ALT.universitaria} />
      </div>
    </div>

    <ul class="fw-grid" aria-label="Hecho para">
      {
        kinds.map((k, i) => (
          <li class="fw-cell">
            <Sticker shape={k.shape} tone={k.tone} tilt={k.tilt} pop index={i} class={`fw-sticker fw-${k.shape}`}>
              <k.icon size={22} aria-hidden="true" class="fw-icon" />
              <span class="fw-title">{k.title}</span>
              <span class="fw-text">{k.text}</span>
            </Sticker>
          </li>
        ))
      }
    </ul>

    <div class="fw-band" data-lp-step>
      <p class="fi-h3 fw-band-title">¿Eres de un centro de estudiantes?</p>
      <p class="fw-band-text">
        Publicas gratis y cobras con Webpay; tu compañera de tesorería ve las ventas con el rol Finanzas. Entrada alumno y
        entrada general son dos tipos de entrada: en la puerta se ve cuál trae cada uno para pedir la credencial.
      </p>
    </div>

    <p class="fi-links fw-links" data-lp-step>
      <span>¿Tienes un local con noches todas las semanas? <a href="/ticketera-discotecas" class="fi-link">Clubs y discotecas <span class="fi-arrow" aria-hidden="true">→</span></a></span>
      <span>¿Tocan bandas en vivo? <a href="/ticketera-musica-en-vivo" class="fi-link">Música en vivo <span class="fi-arrow" aria-hidden="true">→</span></a></span>
    </p>
  </div>
</section>

<style>
  .fw-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px;
    gap: 16px;
    align-items: start;
  }
  .fw-lead {
    max-width: 560px;
    margin-top: 18px;
  }
  .fw-strip {
    transform: rotate(2deg);
  }
  .fw-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 16px;
    margin-top: 40px;
  }
  .fw-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }
  .fw-grid :global(.fw-sticker) {
    width: 100%;
    max-width: 260px;
  }
  .fw-grid :global(.fw-sticker .fi-sticker-body) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  .fw-grid :global(.fw-burst),
  .fw-grid :global(.fw-circle),
  .fw-grid :global(.fw-heart) {
    max-width: 230px;
  }
  .fw-grid :global(.fw-burst) {
    padding: 22%;
  }
  .fw-grid :global(.fw-circle) {
    padding: 14%;
  }
  .fw-grid :global(.fw-pill) {
    align-self: center;
    border-radius: 999px;
    padding: 18px 20px;
  }
  .fw-grid :global(.fw-ticket) {
    align-self: center;
    padding: 18px 26px;
  }
  .fw-title {
    font-size: 15px;
    line-height: 19px;
    font-weight: 700;
  }
  .fw-text {
    font-size: 12px;
    line-height: 16px;
  }
  .fw-band {
    margin-top: 44px;
    padding: 20px;
    border: 2px solid var(--fi-tinta);
    border-radius: 20px;
    background: var(--fi-crema-2);
  }
  .fw-band-text {
    margin-top: 8px;
    max-width: 820px;
    font-size: 15px;
    line-height: 23px;
    color: var(--fi-text-2);
  }
  @media (max-width: 767px) {
    /* Mobile: máximo ±2° de giro en piezas con texto */
    .fw-grid :global(.fw-sticker) {
      transform: rotate(clamp(-2deg, var(--tilt), 2deg));
    }
  }
  @media (min-width: 768px) {
    .fw-head {
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: 40px;
    }
    .fw-strip {
      transform: rotate(3deg);
    }
    .fw-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px 28px;
      margin-top: 56px;
    }
    .fw-title {
      font-size: 17px;
      line-height: 22px;
    }
    .fw-text {
      font-size: 14px;
      line-height: 19px;
    }
    .fw-band {
      padding: 26px 30px;
    }
  }
</style>
