---
// 4 · Quién vende tus entradas (SPEC_landing_productores §5.4, fondo oscuro). Ejemplo de la tabla "Ventas por canal"
// de las métricas del evento (dashboard/events/[id]/analytics), con datos ficticios rotulados como tales.
import { formatCLP } from "../producerLanding.js";

const TICKET_PRICE = 8000;
const channels = [
  { name: "Link de campaña", source: "Publicidad en Instagram", tickets: 37 },
  { name: "Link de Pedro", source: "Comediante del line-up", tickets: 23 },
  { name: "Link de Ana", source: "Promotora", tickets: 11 },
  { name: "Directo", source: "Sin link", tickets: 9 },
];
const max = Math.max(...channels.map((c) => c.tickets));
---

<section class="lp-section lp-dark" aria-labelledby="promoters-title">
  <div class="lp-wrap promo">
    <div class="promo-copy">
      <p class="lp-eyebrow">Links con seguimiento</p>
      <h2 id="promoters-title" class="lp-h2 promo-title">¿Quién está vendiendo tus entradas?</h2>
      <p class="lp-lead promo-lead">
        Crea un link para cada integrante del line-up, promotor o campaña. Cada compra queda asociada al link con que llegó
        el comprador, y en las métricas ves órdenes, entradas e ingresos por canal. Sin capturas de pantalla ni reportes a
        mano.
      </p>
      <ul class="promo-points">
        <li>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path></svg>
          <span>Compara canales y decide dónde poner tu próxima publicación o tu presupuesto.</span>
        </li>
        <li>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle></svg>
          <span>Súmale códigos de descuento con fecha límite y cupos para preventas o la última semana.</span>
        </li>
      </ul>
      <p class="promo-more">
        <a href="/guias/como-medir-ventas-por-promotor" class="lp-link" data-cta="learn_promoters" data-section="promoters">
          Cómo medir las ventas de cada promotor <span aria-hidden="true">→</span>
        </a>
        <a href="/guias/como-hacer-una-preventa" class="lp-link" data-cta="learn_presale" data-section="promoters">
          Cómo hacer una preventa <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    <figure class="promo-panel">
      <figcaption class="promo-panel-head">
        <span>Ventas por canal · Stand-up del jueves</span>
        <span class="lp-example">Datos de ejemplo</span>
      </figcaption>
      <ul class="promo-rows">
        {channels.map((c) => (
          <li>
            <p class="promo-row-head">
              <span><strong>{c.name}</strong> <span class="promo-source">· {c.source}</span></span>
              <span class="ev-tabular">{c.tickets} entradas</span>
            </p>
            <div class="lp-bar-track promo-track" aria-hidden="true">
              <div class="lp-bar" style={`transform: scaleX(${(c.tickets / max).toFixed(3)})`}></div>
            </div>
            <p class="promo-money ev-tabular">{formatCLP(c.tickets * TICKET_PRICE)} en ventas</p>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</section>

<style>
  .promo {
    display: grid;
    gap: 28px;
  }
  .promo-title {
    margin-top: 10px;
  }
  .promo-lead {
    margin-top: 12px;
  }
  .promo-points {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
    font-size: 15px;
    line-height: 23px;
    color: var(--lp-on-dark-2);
  }
  .promo-points li {
    display: flex;
    gap: 12px;
  }
  .promo-points svg {
    flex: 0 0 auto;
    margin-top: 2px;
    color: #fff;
  }
  .promo-more {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 24px;
  }
  .promo-panel {
    margin: 0;
    padding: 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background: var(--lp-dark-raised);
  }
  .promo-panel-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--lp-on-dark-3);
  }
  .promo-rows li {
    margin-top: 22px;
  }
  .promo-row-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
  }
  .promo-row-head strong {
    font-weight: 600;
  }
  .promo-source {
    display: none;
    color: var(--lp-on-dark-3);
  }
  .promo-track {
    margin-top: 10px;
  }
  .promo-money {
    margin-top: 6px;
    font-size: 13px;
    color: var(--lp-on-dark-3);
  }
  @media (min-width: 640px) {
    .promo-source {
      display: inline;
    }
  }
  @media (min-width: 1024px) {
    .promo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
      align-items: center;
    }
    .promo-title {
      margin-top: 14px;
    }
    .promo-lead {
      margin-top: 18px;
    }
    .promo-points {
      margin-top: 28px;
    }
    .promo-more {
      margin-top: 28px;
    }
    .promo-panel {
      padding: 28px;
    }
  }
</style>
