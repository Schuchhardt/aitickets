---
// Ticket de mesa de ejemplo (SPEC_landing_clubs §4.7, C14): card vertical con borde que brilla. "MESA VIP" en Doto 40,
// la noche, lo que incluye (sin marcas ni "botella de…": §0.10), el precio con SERVICE_FEE_NOTE (fees.mjs), la barra de
// mesas vendidas (crece al revelarse) y "6 QR, uno por invitado" (mesa para 6: people_per_ticket, buildAttendeeRows).
import { CLUB_TICKETS, LIVE_NIGHT, NIGHT_NAME, nightState, NIGHT_PEAK_STEP } from "./clubsLanding.js";
import { formatCLP } from "../producerLanding.js";
import { SERVICE_FEE_NOTE } from "../../../../netlify/lib/fees.mjs";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const mesa = CLUB_TICKETS.mesa;
// Las mesas vendidas son las de la noche en vivo a la 01:30 (9 de 10)
const { tablesSold, tablesTotal } = nightState(NIGHT_PEAK_STEP);
---

<article class:list={["tt cl-card cl-card-glow", className]} aria-label="Ticket de mesa, ejemplo" data-testid="club-table-ticket">
  <p class="cl-example">ejemplo</p>
  <p class="cl-led tt-title">{mesa.name}</p>
  <p class="tt-night">{NIGHT_NAME} · VIE {LIVE_NIGHT.start}</p>
  <p class="tt-detail">Hasta 6 personas · consumo incluido</p>
  <p class="tt-price">
    <span class="cl-tabular">{formatCLP(mesa.price)}</span>
    <span class="cl-note">{SERVICE_FEE_NOTE}</span>
  </p>
  <div class="tt-sold">
    <p class="tt-sold-label cl-tabular">{tablesSold} de {tablesTotal} mesas vendidas</p>
    <span class="tt-bar" aria-hidden="true"><span style={`transform: scaleX(${tablesSold / tablesTotal})`}></span></span>
  </div>
  <p class="tt-qr">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
      ><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect
        x="3"
        y="14"
        width="7"
        height="7"
        rx="1"></rect><path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h4v-3"></path></svg
    >
    6 QR, uno por invitado
  </p>
</article>

<style>
  .tt {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 340px;
    padding: 22px;
  }
  .tt-title {
    font-size: 40px;
    line-height: 44px;
    color: var(--cl-fluor);
  }
  .tt-night {
    font-weight: 600;
  }
  .tt-detail {
    font-size: 15px;
    color: var(--cl-text-2);
  }
  .tt-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--cl-line-strong);
    font-size: 24px;
    font-weight: 700;
  }
  .tt-sold-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--cl-text-2);
  }
  .tt-bar {
    display: block;
    height: 6px;
    margin-top: 6px;
    border-radius: 3px;
    background: var(--cl-led-off);
    overflow: hidden;
  }
  .tt-bar span {
    display: block;
    height: 100%;
    background: var(--cl-fluor);
    box-shadow: 0 0 8px rgba(255, 79, 184, 0.6);
    transform-origin: left center;
  }
  .tt-qr {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--cl-text-1);
  }
  /* C14: el ticket entra con translateY 24 px y la barra crece 800 ms al revelarse */
  :global(.lp-motion) :global([data-lp-reveal]:not(.is-in)) .tt {
    opacity: 0;
  }
  :global(.lp-motion) :global(.is-in) .tt {
    animation: cl-up-24 700ms var(--ease-out) 200ms both;
  }
  :global(.lp-motion) :global(.is-in) .tt-bar span {
    animation: cl-grow-x 800ms var(--ease-out) 600ms backwards;
  }
</style>
