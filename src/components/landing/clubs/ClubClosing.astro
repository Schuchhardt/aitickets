---
// 12 · Cierre (SPEC_landing_clubs §4.12): sin foto, fondo negro con dos halos que derivan lento (C7), el letrero LED
// grande como H2 ("¿Cuándo abres la próxima noche?", se enciende como el H1, C15) y la cuenta regresiva al próximo
// viernes a las 23:30 en hora de Chile (countdownToNight, EVENT_TIMEZONE): se actualiza cada minuto, sin segundos ni
// transición, y es decorativa (aria-hidden). Sin JS: "Este viernes · 23:30". data-final-cta: la barra flotante de
// mobile se esconde aquí. CTAs con los mismos destinos que stand-up (registro, WhatsApp y demo de 15 min) y los links
// internos a /organizadores y a las landings de fiestas, música y stand-up (SEO §9; fiestas se suma con
// SPEC_landing_fiestas: las landings de noche se enlazan entre sí).
import LedHeading from "./LedHeading.astro";
import { LIVE_NIGHT } from "./clubsLanding.js";
import { DEMO_CALL_URL, publishUrl, whatsappUrl } from "../links.js";

interface Props {
  ctaLabel: string;
}
const { ctaLabel } = Astro.props;
---

<section class="cl-section ccl" aria-labelledby="cl-closing-title" data-final-cta data-cl-section="closing" data-cl-play>
  <span class="cl-halo cl-halo-drift ccl-halo-1" aria-hidden="true"></span>
  <span class="cl-halo cl-halo-fluor cl-halo-drift cl-halo-drift-2 ccl-halo-2" aria-hidden="true"></span>
  <div class="cl-wrap ccl-inner" data-lp-reveal>
    <div class="ccl-sign" data-lp-step>
      <LedHeading id="cl-closing-title" text="¿Cuándo abres" lit="la próxima noche?" class="ccl-title" />
      <p class="cl-led ccl-countdown" aria-hidden="true" data-cl-countdown>Este viernes · {LIVE_NIGHT.start}</p>
    </div>
    <p class="cl-lead ccl-lead" data-lp-step>Publícala hoy. Crear tu cuenta es gratis y no hay costos fijos. Si quieres, la armamos contigo.</p>
    <div class="ccl-ctas" data-lp-step>
      <a href={publishUrl("clubs_closing")} class="cl-btn cl-btn-lime" data-cta="publish" data-section="closing">
        {ctaLabel} <span aria-hidden="true">→</span>
      </a>
      <a
        href={whatsappUrl("Hola, quiero vender entradas para las noches de mi club con AI Tickets")}
        class="cl-btn cl-btn-line"
        target="_blank"
        rel="noopener noreferrer"
        data-cta="whatsapp"
        data-section="closing"
      >
        Hablar por WhatsApp
      </a>
    </div>
    <p class="ccl-help" data-lp-step>
      <a href={DEMO_CALL_URL} class="cl-link" target="_blank" rel="noopener noreferrer" data-cta="demo_call" data-section="closing">Agenda una demo de 15 min</a>
      ·
      <a href="/organizadores" class="cl-link" data-cta="organizadores" data-section="closing">Todo lo que hace AI Tickets</a>
    </p>
    <p class="ccl-help ccl-also" data-lp-step>
      También para <a href="/ticketera-fiestas" class="cl-link">fiestas</a>, <a href="/ticketera-musica-en-vivo" class="cl-link">música en vivo</a> y <a href="/ticketera-stand-up" class="cl-link">stand-up</a>.
    </p>
  </div>
</section>

<script>
  import { countdownToNight } from "./clubsLanding.js";

  // Cuenta regresiva por minuto (es estado, no animación: también con "reducir movimiento")
  const el = document.querySelector<HTMLElement>("[data-cl-countdown]");
  if (el) {
    const paint = () => {
      el.textContent = countdownToNight(new Date()).label;
    };
    paint();
    // Se alinea al cambio de minuto y desde ahí actualiza cada 60 s
    window.setTimeout(() => {
      paint();
      window.setInterval(paint, 60_000);
    }, 60_000 - (Date.now() % 60_000));
  }
</script>

<script>
  // Deriva de los halos (C7) solo mientras se ven ([data-cl-play] → .is-playing); el CSS la apaga sin html.lp-motion
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.classList.toggle("is-playing", entry.isIntersecting);
    });
    document.querySelectorAll("[data-cl-play]").forEach((el) => io.observe(el));
  }
</script>

<style>
  .ccl {
    background: var(--cl-noche);
    text-align: center;
  }
  .ccl-halo-1 {
    --size: 760px;
    left: -280px;
    top: -260px;
  }
  .ccl-halo-2 {
    --size: 700px;
    right: -260px;
    bottom: -280px;
  }
  .ccl-inner {
    padding-block: 24px 48px;
  }
  .ccl-sign {
    position: relative;
    padding: 28px 16px;
    border: 1px solid var(--cl-line);
    border-radius: 20px;
    background-color: #000;
    background-image: radial-gradient(circle, var(--cl-led-off) 1.2px, transparent 1.6px);
    background-size: 8px 8px;
    box-shadow: 0 0 60px rgba(138, 92, 255, 0.18);
  }
  .ccl-sign :global(.ccl-title) {
    font-size: 44px;
    line-height: 48px;
  }
  .ccl-sign :global(.cl-led-grid) {
    display: none;
  }
  .ccl-countdown {
    margin-top: 20px;
    text-wrap: balance;
    font-size: 28px;
    line-height: 34px;
    color: var(--cl-fluor);
  }
  .ccl-lead {
    max-width: 560px;
    margin: 28px auto 0;
    color: var(--cl-text-1);
  }
  .ccl-ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 32px;
  }
  .ccl-help {
    margin-top: 24px;
    font-size: 14px;
    line-height: 22px;
    color: var(--cl-text-3);
  }
  .ccl-also {
    margin-top: 8px;
  }
  @media (min-width: 640px) {
    .ccl-ctas {
      flex-direction: row;
      justify-content: center;
    }
  }
  @media (min-width: 1024px) {
    .ccl-sign {
      padding: 56px 40px;
    }
    .ccl-sign :global(.ccl-title) {
      font-size: clamp(64px, 6.6vw, 96px);
      line-height: 1;
    }
    .ccl-sign :global(.ccl-title .cl-glow::after) {
      display: block;
    }
    .ccl-countdown {
      font-size: 40px;
      line-height: 46px;
    }
    .ccl-lead {
      margin-top: 36px;
    }
    .ccl-ctas {
      margin-top: 40px;
    }
  }
</style>
