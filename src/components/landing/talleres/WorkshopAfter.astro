---
// 7 · Después: del taller de prueba al nivel 2 (SPEC_landing_talleres §4.7, ancla #despues): tres pasos numerados a
// mano y la demo de invitación (InviteNextLevel). Verificado en el código:
//   reseñas → REVIEW_REQUEST_DELAY_HOURS / REVIEW_REQUEST_WINDOW_HOURS / MAX_PHOTOS_PER_PERSON (reviews.mjs), código para
//             quien califica (EventReviewsManager.vue, REWARD_CODE_PREFIX); en la página, mientras quedan fechas si
//             se activa en la configuración de reseñas (review_settings.show_while_on_sale, EventDetail.vue)
//   invitar → invitations.ts con INVITE_AUDIENCES (reviews.mjs), sin bajas ni quienes ya tienen entrada
//   duplicar → eventDuplicate.ts (copia datos, lugares, entradas y FAQ; no las fechas)
import SectionTab from "./SectionTab.astro";
import Highlight from "./Highlight.astro";
import InviteNextLevel from "./InviteNextLevel.vue";
import { INVITE_AUDIENCE_TEXT } from "../../../data/inviteAudience";
import {
  INVITE_AUDIENCES,
  MAX_PHOTOS_PER_PERSON,
  REVIEW_REQUEST_DELAY_HOURS,
  REVIEW_REQUEST_WINDOW_HOURS,
} from "../../../../netlify/lib/reviews.mjs";

const steps = [
  {
    title: "Te cuentan cómo les fue.",
    text: `Entre ${REVIEW_REQUEST_DELAY_HOURS} y ${REVIEW_REQUEST_WINDOW_HOURS} horas después, les llega un correo para calificar con estrellas, comentar y subir hasta ${MAX_PHOTOS_PER_PERSON} fotos de lo que hicieron. Si quieres, premias a quien califica con un código para tu próximo taller.`,
  },
  {
    title: "Los invitas al siguiente.",
    text: `Con un correo desde el panel, a ${INVITE_AUDIENCE_TEXT}. No llega a quienes se dieron de baja ni a quienes ya tienen entrada.`,
  },
  {
    title: "El próximo mes, en minutos.",
    text: "Duplicas el taller con su descripción, imagen, lugar, entradas y preguntas, y agregas las fechas nuevas.",
  },
];
const audiences = (["all", "checked_in", "promoters"] as const).map((value) => ({ value, label: INVITE_AUDIENCES[value] }));
---

<section id="despues" class="tl-section tl-on-papel-2" aria-labelledby="tl-after-title" data-tl-section="despues">
  <SectionTab text="Después" />
  <div class="tl-wrap">
    <div class="tl-after-head" data-lp-reveal>
      <p class="tl-eyebrow" data-lp-step>Después del taller</p>
      <h2 id="tl-after-title" class="tl-h2 tl-after-title" data-lp-step>
        Quien vino una vez <Highlight>vuelve al nivel 2.</Highlight>
      </h2>
    </div>
    <div class="tl-after-grid">
      <ol class="tl-after-steps" data-lp-reveal>
        {
          steps.map((step, i) => (
            <li data-lp-step>
              <span class="tl-hand tl-after-n" aria-hidden="true">{i + 1}</span>
              <div>
                <h3 class="tl-after-h3">{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div>
        <InviteNextLevel client:visible audiences={audiences} />
        <p class="tl-after-note">
          <strong>Las reseñas, en la página del taller.</strong> Mientras sigue con fechas, junto al botón para inscribirse.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .tl-after-title {
    margin-top: 14px;
  }
  .tl-after-grid {
    display: grid;
    gap: 40px;
    margin-top: 40px;
  }
  .tl-after-steps {
    display: grid;
    gap: 28px;
    list-style: none;
  }
  .tl-after-steps li {
    display: flex;
    gap: 16px;
  }
  .tl-after-n {
    flex: 0 0 32px;
    font-size: 40px;
    line-height: 36px;
  }
  .tl-after-h3 {
    font-size: 18px;
    line-height: 26px;
    font-weight: 600;
  }
  .tl-after-steps p {
    margin-top: 4px;
    font-size: 16px;
    line-height: 25px;
    color: var(--tl-grafito-2);
  }
  .tl-after-note {
    margin-top: 16px;
    font-size: 14px;
    line-height: 21px;
    color: var(--tl-grafito-3);
  }
  .tl-after-note strong {
    font-weight: 600;
    color: var(--tl-grafito);
  }
  @media (min-width: 1024px) {
    .tl-after-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 64px;
      margin-top: 56px;
      align-items: start;
    }
  }
</style>
