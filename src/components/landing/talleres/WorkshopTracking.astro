---
// Analítica de la landing de talleres (SPEC_landing_talleres §10), con prefijo tl_ como te_ en teatro y mu_ en música:
//   tl_view                     carga de la página
//   tl_cta_click {position}     clic en un CTA ([data-cta="publish"] y el de la web gratis de #espacios,
//                               position = data-section: hero, closing, header, mobile_bar, espacios)
//   tl_web_click                clic en "Arma la web de tu espacio" (#espacios → /web-gratis)
//   tl_demo_click {position}    clic en el ejemplo ([data-cta="demo"])
//   tl_whatsapp_click {position}
//   tl_faq_open {question}      abre una pregunta (el botón todavía dice aria-expanded="false" en la fase de captura)
//   tl_section_view {section}   cada [data-tl-section] entra en pantalla (una vez)
// Los propios (tl_builder_change, tl_builder_full, tl_roll_replay, tl_invite_audience, tl_calc_change) los mandan las
// islas. CtaTracking sigue midiendo producer_cta_clicked.
---

<script>
  import { trackEvent } from "../../../composables/useGoogleAnalytics.js";

  const CTA_EVENTS: Record<string, string> = {
    publish: "tl_cta_click",
    web: "tl_cta_click",
    demo: "tl_demo_click",
    whatsapp: "tl_whatsapp_click",
  };

  trackEvent("tl_view", { page: location.pathname });

  document.addEventListener(
    "click",
    (e) => {
      const target = e.target as Element | null;
      const cta = target?.closest?.("[data-cta]");
      const kind = cta?.getAttribute("data-cta") || "";
      const name = cta && CTA_EVENTS[kind];
      if (cta && name) trackEvent(name, { position: cta.getAttribute("data-section") || "" });
      if (kind === "web") trackEvent("tl_web_click");

      const question = target?.closest?.('[data-testid="landing-faq"] button[aria-expanded="false"]');
      if (question) trackEvent("tl_faq_open", { question: question.textContent?.trim().slice(0, 100) || "" });
    },
    { capture: true },
  );

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          trackEvent("tl_section_view", { section: (entry.target as HTMLElement).dataset.tlSection });
          io.unobserve(entry.target);
        }
      },
      // Con margen y no con umbral de área: una sección más alta que la pantalla nunca llegaría al 25%
      { rootMargin: "0px 0px -40% 0px", threshold: 0 },
    );
    document.querySelectorAll("[data-tl-section]").forEach((section) => io.observe(section));
  }
</script>
