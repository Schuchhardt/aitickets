---
// 7 · Programa · Precio (SPEC_landing_teatro §4.7, fondo marfil, ancla #precio): una hoja de programa de mano centrada
// con doble filete dorado. El texto se arma con las constantes como el priceLead de stand-up y música (fees.mjs y
// ABSORB_FEE_ACTIVATION de producerFaq.ts); las garantías llevan PAYOUT_SHORT_TEXT de legal.mjs con el asterisco de
// TERMS_NOTE. La ficha de la entrada usa la fórmula del checkout (ProgramCalculator → priceQuote → computeFeeSplit).
import ActEyebrow from "./ActEyebrow.astro";
import ProgramCalculator from "./ProgramCalculator.vue";
import { ABSORB_FEE_ACTIVATION, TERMS_NOTE } from "../../../data/producerFaq";
import { IVA_PERCENT_LABEL, SERVICE_FEE_PERCENT_LABEL } from "../../../../netlify/lib/fees.mjs";
import { PAYOUT_SHORT_TEXT } from "../../../../netlify/lib/legal.mjs";

const priceLead =
  `Para la compañía, 0% de comisión. Tu público paga un cargo por servicio de ${SERVICE_FEE_PERCENT_LABEL} más IVA ` +
  `(${IVA_PERCENT_LABEL}) sobre ese cargo. Si prefieres un precio final redondo, lo absorbes tú, por obra. ` +
  `${ABSORB_FEE_ACTIVATION} Las funciones gratis no pagan nada.`;
const guarantees = ["Sin mensualidad", "Sin permanencia", `${PAYOUT_SHORT_TEXT}*`];
---

<section id="precio" class="te-section te-on-programa pg" aria-labelledby="te-price-title" data-te-section="pricing">
  <div class="te-wrap">
    <div class="pg-sheet">
      <span class="pg-ornament" aria-hidden="true"><span class="te-diamond"></span><span class="te-diamond"></span><span class="te-diamond"></span></span>
      <div class="pg-head" data-lp-reveal>
        <ActEyebrow text="Programa" />
        <h2 id="te-price-title" class="te-h2 pg-title" data-lp-step>
          La compañía cobra <span class="te-gold pg-line">el 100% de cada entrada.</span>
        </h2>
        <p class="te-lead pg-lead" data-lp-step>{priceLead}</p>
      </div>
      <div class="pg-calc" data-lp-reveal>
        <div data-lp-step><ProgramCalculator client:visible /></div>
      </div>
      <p class="pg-guarantees" data-testid="theatre-guarantees">
        {
          guarantees.map((g, i) => (
            <>
              {i > 0 && <span class="te-diamond pg-sep" aria-hidden="true" />}
              <span>{g}</span>
            </>
          ))
        }
      </p>
      <p class="pg-terms"><a href={TERMS_NOTE.href} class="te-link">{TERMS_NOTE.text}</a></p>
    </div>
  </div>
</section>

<style>
  .pg-sheet {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 22px 36px;
    text-align: center;
  }
  /* Doble filete dorado en todo el borde de la hoja (10 px en mobile, 16 px en desktop) */
  .pg-sheet::before,
  .pg-sheet::after {
    content: "";
    position: absolute;
    pointer-events: none;
    border: 1px solid rgba(122, 90, 30, 0.55);
  }
  .pg-sheet::before {
    inset: 0;
  }
  .pg-sheet::after {
    inset: 5px;
    border-color: rgba(122, 90, 30, 0.35);
  }
  .pg-ornament {
    position: absolute;
    top: -6px;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    transform: translateX(-50%);
    background: var(--te-programa);
    color: var(--te-oro-ink);
  }
  .pg-ornament .te-diamond:nth-child(2) {
    width: 8px;
    height: 8px;
  }
  .pg-title {
    margin-top: 20px;
  }
  .pg-line {
    display: block;
  }
  .pg-lead {
    max-width: 600px;
    margin: 20px auto 0;
  }
  .pg-calc {
    max-width: 560px;
    margin: 36px auto 0;
    padding-top: 28px;
    border-top: 1px solid rgba(122, 90, 30, 0.35);
  }
  .pg-guarantees {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 14px;
    margin-top: 32px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--te-ink);
  }
  .pg-sep {
    width: 5px;
    height: 5px;
    background: var(--te-oro-ink);
  }
  .pg-terms {
    margin-top: 14px;
    font-size: 12px;
    color: var(--te-ink-3);
  }
  @media (min-width: 768px) {
    .pg-sheet {
      padding: 88px 72px 64px;
    }
    .pg-sheet::before {
      inset: 16px;
    }
    .pg-sheet::after {
      inset: 21px;
    }
    .pg-ornament {
      top: 10px;
    }
  }
  @media (min-width: 1024px) {
    /* La hoja mide 760 px: el H2 baja un poco para que "el 100% de cada entrada." quede en una línea */
    .pg-title {
      font-size: 56px;
      line-height: 60px;
    }
  }
</style>
