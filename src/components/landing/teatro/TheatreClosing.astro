---
// 11 · Telón (SPEC_landing_teatro §4.11): la foto de dos intérpretes bajo un foco en un arco de proscenio grande, con
// las piernas de terciopelo a los lados y la bambalina arriba (Curtain variant="closing", T18: el telón "baja" al
// revelarse). data-final-cta: la barra flotante de mobile se esconde aquí. CTAs con los mismos destinos que stand-up y
// música (registro, WhatsApp y demo de 15 min) y los links internos a /organizadores y a las otras landings (SEO §9).
// La foto de referencia es vertical y llega a 896 px: el arco de desktop (560 px) la muestra sin ampliar.
import Curtain from "./Curtain.astro";
import ProsceniumPhoto from "./ProsceniumPhoto.astro";
import { THEATRE_PHOTOS } from "./teatroLanding.js";
import { DEMO_CALL_URL, publishUrl, whatsappUrl } from "../links.js";

interface Props {
  ctaLabel: string;
}
const { ctaLabel } = Astro.props;
---

<section class="te-section tcl" aria-labelledby="te-closing-title" data-final-cta data-te-section="closing">
  <div class="tcl-stage" data-lp-reveal>
    <Curtain variant="closing" />
    <div class="te-wrap tcl-inner">
      <div class="tcl-photo-wrap" data-lp-step>
        <ProsceniumPhoto
          photo={THEATRE_PHOTOS.telon}
          alt="Dos intérpretes frente a frente bajo un foco cálido"
          sizes="(min-width: 1024px) 560px, 100vw"
          arch
          position="50% 40%"
          class="tcl-photo"
        />
      </div>
      <h2 id="te-closing-title" class="te-h2 tcl-title" data-lp-step>
        ¿Cuándo es <span class="te-gold tcl-line">el estreno?</span>
      </h2>
      <p class="te-lead tcl-lead" data-lp-step>Publica tu obra hoy. Crear tu cuenta es gratis y no hay costos fijos. Si quieres, la armamos contigo.</p>
      <div class="tcl-ctas" data-lp-step>
        <a href={publishUrl("teatro_closing")} class="te-btn te-btn-lime" data-cta="publish" data-section="closing">
          {ctaLabel} <span aria-hidden="true">→</span>
        </a>
        <a
          href={whatsappUrl("Hola, quiero vender entradas para mi obra con AI Tickets")}
          class="te-btn te-btn-line"
          target="_blank"
          rel="noopener noreferrer"
          data-cta="whatsapp"
          data-section="closing"
        >
          Hablar por WhatsApp
        </a>
      </div>
      <p class="tcl-help" data-lp-step>
        <a href={DEMO_CALL_URL} class="te-link" target="_blank" rel="noopener noreferrer" data-cta="demo_call" data-section="closing">Agenda una demo de 15 min</a>
        ·
        <a href="/organizadores" class="te-link" data-cta="organizadores" data-section="closing">Todo lo que hace AI Tickets</a>
      </p>
      <p class="tcl-help tcl-also" data-lp-step>
        También para <a href="/ticketera-stand-up" class="te-link">stand-up</a>, <a href="/ticketera-musica-en-vivo" class="te-link">música en vivo</a> y <a href="/academias" class="te-link">academias</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .tcl {
    position: relative;
    overflow: hidden;
    padding-top: 96px;
  }
  .tcl-stage {
    position: static;
  }
  .tcl-inner {
    position: relative;
    z-index: 4;
    text-align: center;
  }
  .tcl-photo-wrap {
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }
  .tcl-photo-wrap :global(.tcl-photo) {
    height: min(120vw, 620px);
  }
  .tcl-title {
    margin-top: 40px;
    font-size: 44px;
    line-height: 48px;
  }
  .tcl-line {
    display: block;
  }
  .tcl-lead {
    max-width: 560px;
    margin: 20px auto 0;
    color: var(--te-text-1);
  }
  .tcl-ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 32px;
  }
  .tcl-help {
    margin-top: 24px;
    font-size: 14px;
    line-height: 22px;
    color: var(--te-text-3);
  }
  .tcl-also {
    margin-top: 8px;
  }
  @media (min-width: 640px) {
    .tcl-ctas {
      flex-direction: row;
      justify-content: center;
    }
  }
  @media (min-width: 1024px) {
    .tcl {
      padding-top: 136px;
    }
    .tcl-photo-wrap {
      max-width: 560px;
    }
    .tcl-photo-wrap :global(.tcl-photo) {
      height: 700px;
    }
    .tcl-title {
      margin-top: 56px;
      font-size: clamp(64px, 6.2vw, 88px);
      line-height: 1;
    }
    .tcl-lead {
      margin-top: 28px;
    }
    .tcl-ctas {
      margin-top: 40px;
    }
  }
</style>
