---
// Pase de prensa de ejemplo (SPEC_landing_teatro §4.3, Escena 2): card marfil de 260 px colgada de un cordón (dos
// líneas finas desde arriba), rotada −2°, con los datos de una cortesía para una función. El cuadrito tipo QR es
// decorativo y NO es un QR válido (aria-hidden): un patrón fijo de celdas, sin codificar nada.
// T9: entra colgando (rotate −8° y −24 px → −2°, con rebote leve) cuando su bloque se revela. En mobile va sin
// rotación, abajo de la foto.
import { PLAY_DEMO, SEASON_FUNCTIONS } from "./teatroLanding.js";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
// Patrón 7 × 7 fijo (no codifica nada): esquinas tipo QR y relleno irregular
const CELLS = "1110101101010110101111000010111011101000101101110".split("").map((c) => c === "1");
---

<div class:list={["pp", className]} data-testid="theatre-press-pass">
  <span class="pp-cord" aria-hidden="true"></span>
  <div class="pp-card">
    <p class="pp-kicker">Pase de prensa · ejemplo</p>
    <p class="te-display pp-title">{PLAY_DEMO.title}</p>
    <p class="pp-when">{SEASON_FUNCTIONS[1].label} · 2 entradas</p>
    <p class="pp-note">Cortesía · no cuenta como venta</p>
    <span class="pp-qr" aria-hidden="true">
      {CELLS.map((on) => <span class:list={["pp-cell", { "is-on": on }]} />)}
    </span>
  </div>
</div>

<style>
  .pp {
    position: relative;
    width: min(260px, 100%);
    padding-top: 40px;
    transform-origin: 50% 0;
  }
  .pp-cord {
    position: absolute;
    top: 0;
    left: 50%;
    width: 46px;
    height: 48px;
    transform: translateX(-50%);
    border-left: 1px solid rgba(240, 232, 216, 0.55);
    border-right: 1px solid rgba(240, 232, 216, 0.55);
    border-radius: 0 0 4px 4px;
  }
  .pp-card {
    position: relative;
    padding: 18px 18px 16px;
    border-radius: 10px;
    background: var(--te-programa);
    color: var(--te-ink);
    box-shadow: 0 24px 48px rgba(7, 10, 18, 0.5);
  }
  /* Ojal del cordón */
  .pp-card::before {
    content: "";
    position: absolute;
    top: 8px;
    left: 50%;
    width: 30px;
    height: 6px;
    transform: translateX(-50%);
    border-radius: 3px;
    background: var(--te-programa-2);
    box-shadow: inset 0 1px 2px rgba(22, 26, 36, 0.25);
  }
  .pp-kicker {
    margin-top: 6px;
    font-size: 11px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--te-oro-ink);
  }
  .pp-title {
    margin-top: 6px;
    font-size: 26px;
    line-height: 30px;
  }
  .pp-when {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 500;
  }
  .pp-note {
    margin-top: 2px;
    font-size: 13px;
    color: var(--te-ink-3);
  }
  .pp-qr {
    display: grid;
    grid-template-columns: repeat(7, 8px);
    gap: 2px;
    width: max-content;
    margin-top: 12px;
    padding: 6px;
    border: 1px solid rgba(22, 26, 36, 0.2);
    border-radius: 4px;
    background: #fff;
  }
  .pp-cell {
    width: 8px;
    height: 8px;
  }
  .pp-cell.is-on {
    background: var(--te-ink);
  }
  @media (min-width: 1024px) {
    .pp {
      transform: rotate(-2deg);
    }
  }
  /* T9: entra colgando al 40 % de visibilidad, con rebote leve */
  @keyframes pp-hang {
    0% {
      opacity: 0;
      transform: rotate(-8deg) translateY(-24px);
    }
    70% {
      opacity: 1;
      transform: rotate(0.5deg) translateY(2px);
    }
    100% {
      transform: rotate(-2deg);
    }
  }
  @media (min-width: 1024px) {
    :global(.lp-motion) :global([data-lp-reveal]:not(.is-in)) .pp {
      opacity: 0;
    }
    :global(.lp-motion) :global(.is-in) .pp {
      animation: pp-hang 700ms var(--ease-out) 350ms both;
    }
  }
</style>
