---
// Tarjeta de un panorama (evento externo) en /panoramas. Sin afiche: fondo y emoji por categoría.
// El afiche se sirve desde el sitio de la ticketera o del productor: sin Referer y con carga diferida.
import { priceLabel, shortDate, type PublicPanorama } from "../../lib/panoramas";
import { CATEGORY_STYLE } from "./categoryStyle";

interface Props {
    panorama: PublicPanorama;
    /** "next" = muestra la próxima función; "past" = la última (sección "¿Fuiste?"). */
    mode?: "next" | "past";
}
const { panorama: p, mode = "next" } = Astro.props;
const fn = mode === "past" ? p.last : p.next;
const more = mode === "next" ? p.dates.filter((d) => !d.is_past && d.status !== "cancelled").length - 1 : 0;
const style = CATEGORY_STYLE[p.category];
const price = priceLabel(p.price);
const place = fn ? [fn.venue, fn.city].filter(Boolean).join(" · ") : p.cities.join(", ");
---

<a
    href={mode === "past" ? `${p.path}#fuiste` : p.path}
    class="group flex flex-col rounded-2xl overflow-hidden border border-gray-200 bg-white hover:border-black hover:shadow-md transition"
>
    <div class={`relative aspect-[4/5] overflow-hidden ${style.bg}`}>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-4" aria-hidden="true">
            <span class="text-5xl">{style.emoji}</span>
            <span class="mt-2 text-sm font-semibold text-white/90 font-['Unbounded']">{p.category_name}</span>
        </div>
        {p.image_url ? (
            <img
                src={p.image_url}
                alt={`Afiche de ${p.name}`}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition duration-500"
                onerror="this.remove()"
            />
        ) : null}
        {p.featured && <span class="absolute top-3 left-3 rounded-full bg-lime-400 text-black text-xs font-bold px-2.5 py-1">Destacado</span>}
        {fn?.status === "postponed" && <span class="absolute top-3 right-3 rounded-full bg-amber-400 text-black text-xs font-bold px-2.5 py-1">Postergado</span>}
        {mode === "past" && <span class="absolute bottom-3 left-3 rounded-full bg-black/80 text-white text-xs font-semibold px-2.5 py-1">¿Fuiste? Cuéntanos</span>}
    </div>
    <div class="flex flex-col gap-1 p-4 grow">
        <p class="text-xs uppercase tracking-wide text-lime-700 font-semibold">
            {p.category_name}{p.niche_label ? ` · ${p.niche_label}` : ""}
        </p>
        <h3 class="text-base font-semibold font-['Unbounded'] leading-snug line-clamp-2">{p.name}</h3>
        {fn && (
            <p class="text-sm text-gray-800 capitalize">
                {shortDate(fn.date)}{fn.start_time ? ` · ${fn.start_time}` : ""}
                {more > 0 && <span class="normal-case text-gray-500"> y {more} {more === 1 ? "fecha" : "fechas"} más</span>}
            </p>
        )}
        {place && <p class="text-sm text-gray-500 line-clamp-1">{place}</p>}
        {price && mode === "next" && <p class="mt-auto pt-2 text-sm font-semibold">{price}</p>}
    </div>
</a>
