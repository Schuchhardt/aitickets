# Variables de entorno de AI Tickets
#
# IMPORTANTE (Netlify > Site settings > Environment variables > Scopes):
# - El código Astro (src/**) lee import.meta.env.X y Vite las incrusta en TIEMPO DE BUILD => scope "Builds".
# - Las Netlify Functions (netlify/functions/**) leen process.env.X en runtime => scope "Functions".
# - Las que usan ambos lados (SUPABASE_*, SITE_URL, INTERNAL_API_SECRET, TURNSTILE_*) deben estar en
#   Builds Y Functions. En particular INTERNAL_API_SECRET y SITE_URL: si falta alguno de los dos scopes,
#   fallan los envíos de entradas/notificaciones servidor→servidor.

# --- Supabase (TODO es server-side con la service role; no hay anon key) --- [Builds + Functions]
SUPABASE_URL="https://<TU-PROYECTO>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<TU-SERVICE-ROLE-KEY>"

# --- Sitio --- [Builds + Functions]
SITE_URL=https://aitickets.cl

# Secreto para llamadas servidor→servidor (Astro → Netlify Functions, header x-internal-secret)
# Generar con: openssl rand -hex 32   [Builds + Functions]
INTERNAL_API_SECRET="your-random-hex-secret"

# --- Cloudflare Turnstile (captcha registro y compra) ---
# Site key (pública): registro.astro lee TURNSTILE_SITE_KEY; las funciones aceptan PUBLIC_TURNSTILE_SITE_KEY
# o TURNSTILE_SITE_KEY. Definir ambas con el mismo valor.   [Builds + Functions]
TURNSTILE_SITE_KEY="0x4AAAAAAA..."
PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA...secret"

# --- Google Maps (mapa en la página del evento; clave pública restringida por dominio) --- [Builds]
PUBLIC_GOOGLE_MAPS_API_KEY="AIza......................"

# --- Flow (pasarela de pago; payment-confirmation.astro + funciones) --- [Builds + Functions]
FLOW_API_KEY="your-flow-api-key"
FLOW_SECRET_KEY="your-flow-secret-key"
FLOW_BASE_URL="https://www.flow.cl/api"
# 1 = Webpay, 9 = todos los medios activos en la cuenta Flow
FLOW_PAYMENT_METHOD=1

# --- Email transaccional (Resend; dominio verificado email.aitickets.cl) --- [Builds + Functions]
RESEND_API_KEY="re_..."
RESEND_DOMAIN=email.aitickets.cl
# Webhook de entrega (aitickets_email_log: entregado / demorado / rebotó / spam de los correos de entradas).
# Resend > Webhooks > Add endpoint: URL https://aitickets.cl/api/webhooks/resend, eventos email.delivered,
# email.delivery_delayed, email.bounced y email.complained; copiar el "Signing secret" (whsec_...) aquí.
# Se lee en runtime (src/pages/api/webhooks/resend.ts). Sin ella la ruta responde 404.
# [Functions, SOLO PRODUCCIÓN]
RESEND_WEBHOOK_SECRET=""

# --- Newsletter (MailerLite) --- [Functions]
MAILERLITE_API_TOKEN="eyJ0QiLCJ................"
MAILERLITE_GROUP_ID="1234567890"

# --- Notificaciones internas (Slack: nuevos productores, etc.) --- [Builds + Functions]
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXX/YYY/ZZZ"

# --- Anthropic Claude (asistente IA del evento y generación de posts) --- [Builds + Functions]
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL=claude-opus-5-5

# --- OpenAI (imágenes con IA para posts y respaldo del asistente del evento) --- [Builds + Functions]
OPENAI_API_KEY="sk-..."
OPENAI_IMAGE_MODEL=gpt-image-1
# Modelo de ChatGPT para el asistente del evento cuando Claude falla (sin saldo, clave inválida, caída).
OPENAI_CHAT_MODEL=gpt-5-mini

# --- Asistente IA del evento (netlify/lib/assistant-llm.mjs) --- [Functions]
# Orden de proveedores: el primero responde y, si falla, el siguiente (solo los que tienen API key).
# Sin saldo/cuota, clave rechazada o modelo inválido avisan a SLACK_WEBHOOK_URL (máx. 1 aviso por hora).
AI_ASSISTANT_PROVIDERS=anthropic,openai

# --- Zernio (publicación en redes y anuncios en Meta, https://zernio.com) --- [Builds + Functions]
# Functions también: los anuncios (netlify/lib/zernio-ads.mjs) y el reporte semanal la leen en runtime.
ZERNIO_API_KEY="your-zernio-api-key"

# --- Anuncios pagados en Meta (Facebook e Instagram) vía Zernio --- [Builds + Functions]
# Con ZERNIO_API_KEY quedan disponibles en el panel (Promocionar > Anuncios). false los apaga (docs/runbooks/anuncios-zernio.md).
# Requiere el plan de Zernio con Ads (usage-based). Meta le cobra el gasto a la cuenta publicitaria de cada productora.
# ADS_ENABLED=true

# Clave para cifrar tokens guardados y firmar el state de OAuth (openssl rand -hex 32) [Builds]
TOKEN_ENCRYPTION_KEY="your-random-hex-key"

# =====================================================================================
# AUTONOMÍA (rama feat/autonomy). Todos los interruptores vienen APAGADOS por defecto:
# sin estas variables la app funciona igual que antes (solo Flow, sin outreach, sin dominios).
#
# Los deploy previews comparten la BD de producción y ejecutan código no confiable:
# las variables marcadas [SOLO PRODUCCIÓN] deben tener contexto "Production" únicamente
# (Netlify > Environment variables > Scopes and contexts), nunca "Deploy previews".
# =====================================================================================

# --- BD / migraciones automáticas (plugins/db-migrate, scripts/migrate.mjs) ---
# Cadena del Session pooler de Supavisor (Supabase > Connect > Session pooler), PUERTO 5432.
# El puerto 6543 (transaction pooler) se rechaza. Usuario postgres.<ref>.
# [Builds, SOLO PRODUCCIÓN] El plugin solo migra con CONTEXT=production.
SUPABASE_DB_URL="postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# Local: el runner también acepta DATABASE_URL; si es el host directo db.<ref>.supabase.co (solo IPv6)
# lo reescribe al session pooler. Uso: node --env-file=.env scripts/migrate.mjs --status
# DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"
# "false" desactiva las migraciones en el build de producción (por defecto activas).
MIGRATE_ON_BUILD=true
# "true" SOLO para el primer deploy, antes de configurar SUPABASE_DB_URL (avisa en vez de fallar).
ALLOW_MISSING_DB_URL=false
# Opcional: certificado CA de Supabase (PEM; "\n" se convierte en salto de línea) para verificar TLS.
# SUPABASE_DB_CA=""
# Opcional: host del session pooler usado al reescribir db.<ref>.supabase.co.
# SUPABASE_POOLER_HOST=aws-0-sa-east-1.pooler.supabase.com

# --- Pagos (netlify/lib/payments) --- [Functions + Builds]
# Razón social que aparece como comercio en Flow.
FLOW_MERCHANT_LEGAL_NAME="AI Tickets"
# Cargo por servicio: 8% del valor de las entradas + IVA (19% sobre el cargo), lo paga el comprador.
# added (por defecto) = "Cargo por servicio (8% + IVA)"; included | exempt | unknown solo si cambia el régimen.
SERVICE_FEE_TAX_MODE=added

# --- Sitios de productores y dominios --- [Builds + Functions]
SITES_ROOT_DOMAIN=aitickets.cl
# "true" solo cuando exista el proxy de <slug>.aitickets.cl.
SITES_WILDCARD_ENABLED=false
# Secreto compartido con el proxy de tenants (openssl rand -hex 32).
TENANT_PROXY_SECRET=""
# Hosts de la app principal (coma), además de SITES_ROOT_DOMAIN.
MAIN_HOSTS="aitickets.cl,www.aitickets.cl,aitickets.netlify.app"
# netlify | cloudflare | none. Si no se define: netlify cuando hay NETLIFY_AUTH_TOKEN, si no none
# (la solicitud queda pending_provider + aviso en Slack).
# DOMAIN_PROVIDER=netlify
# Token personal de Netlify para agregar domain aliases. [Functions, SOLO PRODUCCIÓN]
# Riesgo: puede cambiar TODOS los dominios y deploys del sitio (y da acceso a la cuenta de Netlify);
# nunca exponerlo en deploy previews (ejecutan código no confiable).
NETLIFY_AUTH_TOKEN=""
NETLIFY_SITE_ID=d00b677f-67cb-4336-999d-0dc681fb0879
SITES_MAX_NETLIFY_ALIASES=50
# Destino del CNAME que se le indica al productor.
SITES_CNAME_TARGET=aitickets.netlify.app
# Interruptor: "true" hace que el cron check-custom-domains no haga nada. Opcional.
# DOMAIN_CHECKS_DISABLED=true
# "true" omite emitir la Edge Function del router de tenants (netlify/tenant-router/emit.mjs). Opcional.
# TENANT_ROUTER_DISABLED=true
# Cloudflare for SaaS (futuro; hoy solo interfaz).
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_ACCOUNT_ID=""

# --- Outreach autónomo (netlify/lib/outreach) --- [Functions, SOLO PRODUCCIÓN]
# Interruptor maestro: en false no hay descubrimiento, enriquecimiento, llamadas al LLM ni envíos.
OUTREACH_ENABLED=false
# true = los correos se generan y se publican en Slack, nunca se envían.
OUTREACH_DRY_RUN=true
# Respuestas automáticas (solo plantilla fija para "interested"; el resto va a Slack).
OUTREACH_AUTO_REPLY=false
# dryrun | instantly. Nunca Mailgun para correo en frío (AUP de Mailgun).
OUTREACH_PROVIDER=dryrun
# Enviar exige además la evaluación de interés legítimo firmada (docs/legal/lia-outreach.md).
OUTREACH_LIA_APPROVED=false
OUTREACH_DAILY_CAP=20
OUTREACH_PER_MAILBOX_CAP=15
OUTREACH_MAX_FOLLOWUPS=2
OUTREACH_RECONTACT_DAYS=180
OUTREACH_AUTO_REPLY_MIN_CONFIDENCE=0.85
OUTREACH_COUNTRIES=CL
# Dominio separado para outreach (SPF/DKIM/DMARC propios), nunca mg.aitickets.cl.
OUTREACH_DOMAIN=""
OUTREACH_FROM_NAME=""
OUTREACH_UNSUB_MAILTO=""
# Secretos (openssl rand -hex 32).
# OUTREACH_UNSUB_SECRET es obligatorio para cualquier corrida de envío, incluso en dry-run
# (sin él, la corrida se omite porque no se puede generar el enlace de baja).
OUTREACH_UNSUB_SECRET=""
OUTREACH_WEBHOOK_SECRET=""
LEAD_TOKEN_SECRET=""
INSTANTLY_API_KEY=""
INSTANTLY_CAMPAIGN_ID=""
# Fuentes deshabilitadas por defecto (stubs).
GOOGLE_PLACES_API_KEY=""
LEADS_PLACES_MAX_QUERIES=0
LEADS_WEBSEARCH_MAX=0
# Modelo rápido para clasificar respuestas/enriquecer (por defecto el de ANTHROPIC_MODEL; en passline-watch,
# por defecto claude-haiku-4-5).
ANTHROPIC_MODEL_FAST=""
SLACK_OUTREACH_WEBHOOK_URL=""
# Límites opcionales (valores por defecto entre paréntesis).
# Tokens de Claude por corrida (150000) y por día (600000).
# OUTREACH_LLM_TOKENS_PER_RUN=150000
# OUTREACH_LLM_TOKENS_PER_DAY=600000
# Leads nuevos por corrida de descubrimiento (60) y lote de enriquecimiento (50).
# OUTREACH_DISCOVER_MAX_PER_RUN=60
# OUTREACH_ENRICH_BATCH=50

# --- Leads desde Passline (netlify/lib/leads/passline-watch.mjs) --- [Functions, SOLO PRODUCCIÓN]
# Solo resultados de búsqueda (Firecrawl search): passline.com NUNCA se visita (anti-bots de Cloudflare).
# Runbook: docs/runbooks/passline-leads.md. Los leads quedan con manual_only=true: el outreach automático
# nunca los toca; se contactan a mano desde Gmail (exporta el CSV con scripts/export-leads.mjs).
# Interruptor de la corrida diaria (función programada passline-watch, 11:00 UTC). Por defecto apagado.
LEADS_PASSLINE_ENABLED=false
# API key de Firecrawl (https://firecrawl.dev). Sin ella la corrida se omite.
FIRECRAWL_API_KEY=""
# Consultas propias separadas por ";" (opcional; por defecto stand-up/comedia/teatro/música en Santiago,
# Providencia, Ñuñoa, Valparaíso, Viña, Quilpué y Concepción).
# LEADS_PASSLINE_QUERIES="site:passline.com/eventos stand up santiago;site:passline.com/eventos teatro valparaíso"
# Leads a enriquecer (buscar web/Instagram/correo/WhatsApp) por corrida (15).
LEADS_ENRICH_PER_RUN=15
# Límites opcionales: créditos de Firecrawl por corrida (150), tokens de Claude por corrida (60000),
# resultados por consulta (10). El modelo es ANTHROPIC_MODEL_FAST (por defecto claude-haiku-4-5).
# LEADS_FIRECRAWL_CREDITS_PER_RUN=150
# LEADS_PASSLINE_TOKENS_PER_RUN=60000
# LEADS_PASSLINE_RESULTS_PER_QUERY=10

# --- Datos legales del operador (netlify/lib/legal.mjs) --- [Builds + Functions]
# Todos OPCIONALES: los datos públicos de Servicios Informáticos Sebastián Schuchhardt EIRL
# (RUT 77.893.286-5, domicilio Lican Ray 6742, Vitacura, correo contacto@aitickets.cl) ya están como
# valores por defecto en legal.mjs, así que legalReady() es true sin configurar nada. Definir solo para
# sobrescribirlos. La razón social y el RUT se muestran solo en /terms, /terminos-productores y /privacy.
# IMPORTANTE: necesitan scope Builds (además de Functions) porque /terms, /privacy y
# /terminos-productores se prerenderizan y leen estos valores en tiempo de build.
# LEGAL_ADDRESS=""
# LEGAL_PHONE=""
# Fecha de vigencia de términos y privacidad (YYYY-MM-DD). Por defecto, la de la versión vigente.
# LEGAL_EFFECTIVE_DATE=""
# Opcionales. Soporte por defecto soporte@aitickets.cl; contacto legal y privacidad por defecto contacto@aitickets.cl.
# LEGAL_SUPPORT_EMAIL=""
# LEGAL_CONTACT_EMAIL=""
# LEGAL_PRIVACY_EMAIL=""

# --- Correo transaccional --- [Functions]
# Remitente (por defecto "AI Tickets <no-reply@${RESEND_DOMAIN}>").
# MAIL_FROM="AI Tickets <no-reply@mg.aitickets.cl>"
# Copia oculta opcional de los correos de entradas (por defecto ninguna).
# TICKETS_BCC=""

# --- Verificación de email de productores --- [Builds + Functions]
# Firma HMAC de los enlaces de verificación (openssl rand -hex 32).
EMAIL_VERIFY_SECRET=""

# --- Reseñas e invitaciones --- [Builds + Functions]
# Firma HMAC de los links para calificar (correo de 24 h, página del evento) y de los enlaces de baja de las
# invitaciones (openssl rand -hex 32). Opcional: sin ella se deriva de EMAIL_VERIFY_SECRET / INTERNAL_API_SECRET.
# Cambiarla invalida los links ya enviados (los de baja incluidos): elígela una vez.
# También firma el enlace de baja del reporte semanal a productores.
# REVIEW_TOKEN_SECRET=""

# --- Sesión de asistentes ("Mis entradas") --- [Functions]
# Firma HMAC del link de acceso por correo (vence en 60 min) y de la cookie de sesión del asistente (90 días)
# (openssl rand -hex 32). Opcional: sin ella se deriva de EMAIL_VERIFY_SECRET / INTERNAL_API_SECRET.
# Cambiarla cierra la sesión de todos los asistentes.
# BUYER_SESSION_SECRET=""

# --- Reporte semanal a productores (domingos; docs/runbooks/reporte-semanal.md) --- [Functions]
# Usa ANTHROPIC_API_KEY (sugerencias con IA), INTERNAL_API_SECRET + SITE_URL (disparo de la background function)
# y SLACK_WEBHOOK_URL (resumen del envío). false apaga el envío del domingo (las vistas previas manuales siguen).
# WEEKLY_REPORTS_ENABLED=true
# Modelo de las sugerencias (por defecto ANTHROPIC_MODEL). off = sin IA: ideas con reglas fijas.
# WEEKLY_REPORT_MODEL=""
# WEEKLY_REPORT_AI=on

# --- Bitácora de uso del panel de productores (docs/specs/bitacora-panel.md) --- [Functions]
# Páginas, tiempo activo, clics, acciones y errores del panel; se consulta con get_producer_activity y
# list_dashboard_issues del MCP de admin. Encendida por defecto: false la apaga (el layout deja de registrar y
# /api/dashboard/journal responde 410). Retención 12 meses (función programada purge-producer-activity).
# PRODUCER_ACTIVITY_ENABLED=true

# --- MCP de administración (/api/admin/mcp; docs/api/admin.md) --- [Functions, SOLO PRODUCCIÓN]
# Solo el sha256 de la llave (node scripts/admin-key.mjs), nunca la llave. Se leen en runtime (process.env).
# Sin ADMIN_MCP_ENABLED=true o sin hash, el endpoint responde 404. Admite dos hashes separados por coma para rotar.
# ADMIN_MCP_ENABLED=true
# AITICKETS_ADMIN_KEY_SHA256=""
# Opcional: llave que solo ve herramientas de lectura no sensibles.
# AITICKETS_ADMIN_READONLY_KEY_SHA256=""

# --- Tests (solo local/CI; no configurar en Netlify) ---
# E2E se corre en local contra `netlify dev` / `npm run dev`, nunca contra previews ni producción.
# E2E_BASE_URL=http://localhost:4321
# E2E_REAL_EVENT_SLUG=""
# RUN_LLM_EVALS=0

# Nota: Sentry usa el DSN definido en sentry.client.config.js / sentry.server.config.js (no hay variable).
# CONTEXT, NETLIFY_DEV y PROD las define Netlify/Astro automáticamente.
FIRECRAWL_API_KEY=""

# "Continuar con Google" en registro/login de productores (src/lib/google-auth.ts). Requiere activar el
# proveedor Google en Supabase Auth y agregar <SITE_URL>/auth/google/callback en Auth > URL Configuration >
# Redirect URLs. Sin "true" el botón no se muestra.
GOOGLE_AUTH_ENABLED=""

# --- Didit: verificación de identidad de productores (cédula + prueba de vida) --- [Builds + Functions]
# Exigida para publicar eventos con entradas pagadas y para retirar (src/lib/producerIdentity.ts).
# Workflow creado en la consola de Didit (business.didit.me). Webhook: <SITE_URL>/api/identity/didit-webhook
# Sin DIDIT_API_KEY/DIDIT_WORKFLOW_ID el panel muestra "no disponible" y nadie puede verificarse.
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_WEBHOOK_SECRET=""
# DIDIT_BASE_URL=https://verification.didit.me

# Rutas internas /api/admin/* (devolución directa sin autorización del productor, revisión de documentos del evento,
# riesgo/reserva y contracargos) y scripts/admin-direct-refund.mjs. Mínimo 24 caracteres (openssl rand -hex 32).
# Sin ella esas rutas responden 503. Runbook: docs/runbooks/devolucion-directa.md. Scope: Functions.
ADMIN_API_SECRET=""
